{
  "name": "Jeti",
  "scopeName": "source.jeti",
  "fileTypes": [
    "np",
    "nh"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#character"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#objc-at-interface"
    },
    {
      "include": "#objc-at-implementation"
    },
    {
      "include": "#objc-at-end"
    },
    {
      "include": "#objc-at-property"
    },
    {
      "include": "#jeti-at-await"
    },
    {
      "include": "#objc-at-selector"
    },
    {
      "include": "#objc-at-class-protocol"
    },
    {
      "include": "#objc-at-access-control"
    },
    {
      "include": "#objc-at-exception"
    },
    {
      "include": "#jeti-at-defer"
    },
    {
      "include": "#jeti-soft-keywords"
    },
    {
      "include": "#jeti-noarc"
    },
    {
      "include": "#objc-at-synchronized"
    },
    {
      "include": "#objc-at-autoreleasepool"
    },
    {
      "include": "#objc-at-protocol-spec"
    },
    {
      "include": "#objc-at-dynamic-synthesize"
    },
    {
      "include": "#objc-at-defs-encode"
    },
    {
      "include": "#namespace-decl"
    },
    {
      "include": "#using-decl"
    },
    {
      "include": "#jeti-assume-markers"
    },
    {
      "include": "#objc-types"
    },
    {
      "include": "#objc-constants"
    },
    {
      "include": "#objc-special"
    },
    {
      "include": "#memory-management"
    },
    {
      "include": "#c-types"
    },
    {
      "include": "#c-storage-struct-enum"
    },
    {
      "include": "#c-typedef"
    },
    {
      "include": "#c-storage-modifiers"
    },
    {
      "include": "#c-gcc-keywords"
    },
    {
      "include": "#c-control"
    },
    {
      "include": "#c-operators"
    },
    {
      "include": "#block-syntax"
    },
    {
      "include": "#namespace-access"
    },
    {
      "include": "#method-signature"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.jeti",
          "match": "//.*$"
        },
        {
          "name": "comment.block.jeti",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.jeti",
          "match": "^\\s*(#\\s*(?:import|include))\\s+([<\"])([^>\"]*)([>\"])",
          "captures": {
            "1": {
              "name": "keyword.control.directive.include"
            },
            "2": {
              "name": "string.quoted.other.lt-gt.include"
            },
            "3": {
              "name": "string.quoted.other.lt-gt.include string.include.identifier"
            },
            "4": {
              "name": "string.quoted.other.lt-gt.include"
            }
          }
        },
        {
          "comment": "Function-like #define: the macro name stays unscoped (clang-objc renders it plain) and the parameter list gets variable.parameter.preprocessor (italic in most themes). The replacement body falls through to the top-level patterns so operators/strings/numbers inside it still highlight.",
          "name": "meta.preprocessor.macro.function-like.jeti",
          "match": "^\\s*(#\\s*define)\\s+([A-Za-z_][A-Za-z0-9_]*)\\(([^)]*)\\)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.define"
            },
            "3": {
              "name": "variable.parameter.preprocessor"
            }
          }
        },
        {
          "comment": "Object-like #define: name unscoped, body falls through.",
          "name": "meta.preprocessor.macro.jeti",
          "match": "^\\s*(#\\s*define)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.directive.define"
            }
          }
        },
        {
          "comment": "#pragma mark: only the directive colors; the description stays plain (clang-objc keeps it out of any keyword scope).",
          "name": "meta.preprocessor.pragma.mark.jeti",
          "match": "^\\s*(#\\s*pragma)\\s+(mark)\\b(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.directive.pragma"
            }
          }
        },
        {
          "name": "keyword.control.directive",
          "match": "^\\s*#\\s*(?:import|include|define|ifdef|ifndef|endif|pragma|if|else|elif|undef)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\(?:[\"'\\\\abfnrtv0]|x[0-9a-fA-F]{1,2})"
            }
          ]
        },
        {
          "name": "string.quoted.at",
          "begin": "@\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\(?:[\"'\\\\abfnrtv0]|x[0-9a-fA-F]{1,2})"
            }
          ]
        }
      ]
    },
    "character": {
      "patterns": [
        {
          "name": "string.quoted.single",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\(?:[\"'\\\\abfnrtv0]|x[0-9a-fA-F]{1,2})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex",
          "match": "\\b0[xX][0-9a-fA-F]+[uUlL]*\\b"
        },
        {
          "name": "constant.numeric.float",
          "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?[fFlL]?\\b"
        },
        {
          "name": "constant.numeric.float",
          "match": "\\b[0-9]+[eE][+-]?[0-9]+[fFlL]?\\b"
        },
        {
          "name": "constant.numeric.integer",
          "match": "\\b[0-9]+[uUlL]*\\b"
        }
      ]
    },
    "objc-at-interface": {
      "patterns": [
        {
          "name": "meta.interface-or-protocol.jeti",
          "begin": "(@interface)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:\\s*([A-Za-z_][A-Za-z0-9_]*))?",
          "beginCaptures": {
            "1": {
              "name": "storage.type"
            },
            "2": {
              "name": "entity.name.type"
            },
            "3": {
              "name": "punctuation.definition.entity.other.inherited-class"
            },
            "4": {
              "name": "entity.other.inherited-class"
            }
          },
          "end": "(@end)\\b",
          "endCaptures": {
            "1": {
              "name": "storage.type"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#objc-at-property"
            },
            {
              "include": "#jeti-at-await"
            },
            {
              "include": "#objc-at-selector"
            },
            {
              "include": "#objc-at-access-control"
            },
            {
              "include": "#method-signature"
            },
            {
              "include": "#c-types"
            },
            {
              "include": "#objc-types"
            },
            {
              "include": "#namespace-access"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "objc-at-implementation": {
      "patterns": [
        {
          "name": "meta.implementation.jeti",
          "begin": "(@implementation)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:\\s*([A-Za-z_][A-Za-z0-9_]*))?",
          "beginCaptures": {
            "1": {
              "name": "storage.type"
            },
            "2": {
              "name": "entity.name.type"
            },
            "3": {
              "name": "punctuation.definition.entity.other.inherited-class"
            },
            "4": {
              "name": "entity.other.inherited-class"
            }
          },
          "end": "(@end)\\b",
          "endCaptures": {
            "1": {
              "name": "storage.type"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#preprocessor"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#character"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#objc-at-property"
            },
            {
              "include": "#jeti-at-await"
            },
            {
              "include": "#objc-at-selector"
            },
            {
              "include": "#objc-at-access-control"
            },
            {
              "include": "#objc-at-dynamic-synthesize"
            },
            {
              "include": "#objc-at-exception"
            },
            {
              "include": "#jeti-at-defer"
            },
            {
              "include": "#jeti-soft-keywords"
            },
            {
              "include": "#method-signature"
            },
            {
              "include": "#objc-types"
            },
            {
              "include": "#objc-constants"
            },
            {
              "include": "#objc-special"
            },
            {
              "include": "#memory-management"
            },
            {
              "include": "#jeti-noarc"
            },
            {
              "include": "#c-types"
            },
            {
              "include": "#c-storage-struct-enum"
            },
            {
              "include": "#c-typedef"
            },
            {
              "include": "#c-storage-modifiers"
            },
            {
              "include": "#c-gcc-keywords"
            },
            {
              "include": "#c-control"
            },
            {
              "include": "#c-operators"
            },
            {
              "include": "#namespace-access"
            },
            {
              "include": "#block-syntax"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "objc-at-end": {
      "patterns": [
        {
          "name": "keyword.other",
          "match": "@endnamespace\\b"
        },
        {
          "name": "keyword.other",
          "match": "@end\\b"
        }
      ]
    },
    "objc-at-property": {
      "patterns": [
        {
          "name": "meta.property-directive.jeti",
          "begin": "(@property)\\s*",
          "beginCaptures": {
            "1": {
              "name": "storage.modifier"
            }
          },
          "end": "(?=;|$)",
          "patterns": [
            {
              "include": "#objc-property-attrs"
            },
            {
              "include": "#punctuation"
            },
            {
              "include": "#c-types"
            },
            {
              "include": "#objc-types"
            },
            {
              "include": "#namespace-access"
            }
          ]
        }
      ]
    },
    "jeti-at-await": {
      "patterns": [
        {
          "name": "keyword.control.await",
          "match": "@await\\b"
        }
      ]
    },
    "objc-at-selector": {
      "patterns": [
        {
          "name": "meta.selector.jeti",
          "begin": "(@selector)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "storage.type"
            },
            "2": {
              "name": "punctuation.definition.storage.type"
            }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.storage.type"
            }
          },
          "patterns": [
            {
              "name": "support.function.any-method.name-of-parameter",
              "match": "\\b(?:[a-zA-Z_:][\\w]*)+"
            }
          ]
        }
      ]
    },
    "objc-at-class-protocol": {
      "patterns": [
        {
          "name": "storage.type",
          "match": "@(?:class|protocol)\\b"
        }
      ]
    },
    "objc-at-access-control": {
      "patterns": [
        {
          "name": "storage.modifier",
          "match": "@(?:public|package|protected|private)\\b"
        }
      ]
    },
    "objc-at-exception": {
      "patterns": [
        {
          "name": "keyword.control.exception",
          "match": "@(?:try|catch|finally|throw)\\b"
        }
      ]
    },
    "jeti-at-defer": {
      "patterns": [
        {
          "name": "keyword.control.defer",
          "match": "@defer\\b"
        }
      ]
    },
    "jeti-soft-keywords": {
      "patterns": [
        {
          "name": "keyword.control.async",
          "match": "\\b(?:async|await|throws|when)\\b"
        }
      ]
    },
    "jeti-noarc": {
      "patterns": [
        {
          "name": "keyword.control.noarc",
          "match": "@noarc\\b"
        }
      ]
    },
    "objc-at-synchronized": {
      "patterns": [
        {
          "name": "keyword.control.synchronize",
          "match": "@synchronized\\b"
        }
      ]
    },
    "objc-at-autoreleasepool": {
      "patterns": [
        {
          "name": "keyword.control.autoreleasepool",
          "match": "@autoreleasepool\\b"
        }
      ]
    },
    "objc-at-protocol-spec": {
      "patterns": [
        {
          "name": "keyword.control.protocol-specification",
          "match": "@(?:required|optional)\\b"
        }
      ]
    },
    "objc-at-dynamic-synthesize": {
      "patterns": [
        {
          "name": "keyword.other.property.directive",
          "match": "@(?:dynamic|synthesize)\\b"
        }
      ]
    },
    "objc-at-defs-encode": {
      "patterns": [
        {
          "name": "keyword.other",
          "match": "@(?:defs|encode)\\b"
        }
      ]
    },
    "namespace-decl": {
      "patterns": [
        {
          "name": "meta.namespace.jeti",
          "begin": "(@namespace)\\s+([A-Za-z_][A-Za-z0-9_]*(?:::\\s*[A-Za-z_][A-Za-z0-9_]*)*)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.namespace"
            },
            "2": {
              "name": "entity.name.type.namespace"
            }
          },
          "end": "(@endnamespace)\\b",
          "endCaptures": {
            "1": {
              "name": "storage.type.namespace"
            }
          },
          "patterns": [
            {
              "include": "$self"
            },
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "using-decl": {
      "patterns": [
        {
          "name": "keyword.other.using",
          "match": "@using\\b"
        }
      ]
    },
    "objc-types": {
      "patterns": [
        {
          "name": "storage.type.id.objc",
          "match": "\\b(?:id|Class|SEL|BOOL|IMP|instancetype|NPZone|IBOutlet|IBAction|unichar)\\b"
        }
      ]
    },
    "objc-constants": {
      "patterns": [
        {
          "name": "constant.language",
          "match": "\\b(?:YES|NO|Nil|nil|NULL)\\b"
        }
      ]
    },
    "objc-special": {
      "patterns": [
        {
          "name": "variable.language.self",
          "match": "\\b(?:self|super|_cmd)\\b"
        }
      ]
    },
    "objc-property-attrs": {
      "comment": "clang objective-c.tmLanguage: keyword.other.property.attribute.objc covers the property attribute list AND the bare nullability words in property position (one rule, same scope).",
      "name": "keyword.other.property.attribute.jeti",
      "match": "\\b(getter|setter|readonly|readwrite|assign|retain|copy|nonatomic|atomic|strong|weak|nonnull|nullable|null_resettable|null_unspecified|class|direct)\\b"
    },
    "objc-protocol-qualifiers": {
      "comment": "clang objective-c.tmLanguage: storage.modifier.protocol.objc, included only by the 'method' rule (return type + parameter types). Jeti mirrors that: the include lives solely in method-signature's meta.return-type/meta.argument-type, so ivar nullability stays plain exactly as in clang. The __nullable/__nonnull spellings render the same and join the same class.",
      "name": "storage.modifier.protocol.jeti",
      "match": "\\b(in|out|inout|oneway|bycopy|byref|nonnull|nullable|_Nonnull|_Nullable|_Null_unspecified|__nullable|__nonnull|__unsafe_unretained)\\b"
    },
    "memory-management": {
      "patterns": [
        {
          "name": "storage.modifier",
          "match": "\\b(?:__block|__weak|__strong|__autoreleasing|__unsafe_unretained)\\b"
        }
      ]
    },
    "c-types": {
      "patterns": [
        {
          "name": "storage.type",
          "match": "\\b(?:void|char|short|int|long|float|double|signed|unsigned|_Bool|bool)\\b"
        }
      ]
    },
    "c-storage-struct-enum": {
      "patterns": [
        {
          "name": "storage.type.$1",
          "match": "\\b(enum|struct|union)\\b"
        }
      ]
    },
    "c-typedef": {
      "patterns": [
        {
          "name": "keyword.other.typedef",
          "match": "\\btypedef\\b"
        },
        {
          "name": "keyword.other.typeof",
          "match": "\\b(?:sizeof|typeof)\\b"
        }
      ]
    },
    "c-storage-modifiers": {
      "patterns": [
        {
          "name": "storage.modifier",
          "match": "\\b(?:const|extern|register|restrict|static|volatile|inline|auto)\\b"
        }
      ]
    },
    "c-gcc-keywords": {
      "patterns": [
        {
          "name": "keyword.other.asm",
          "match": "\\b(?:asm|__asm|__asm__)\\b"
        },
        {
          "name": "keyword.other.asm-qualifier",
          "match": "\\b(?:__volatile|__volatile__)\\b"
        },
        {
          "name": "keyword.other.gcc",
          "match": "\\b(?:__typeof|__typeof__|__alignof|__alignof__|__extension__|__const__|__inline__|__signed__|__restrict__|__restrict|__inline|__signed)\\b"
        }
      ]
    },
    "c-control": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(?:return|if|else|switch|case|default|while|do|for|break|continue|goto|sizeof)\\b"
        }
      ]
    },
    "c-operators": {
      "patterns": [
        {
          "name": "keyword.operator.sizeof",
          "match": "(?<!\\w)sizeof(?=\\s*[(\\[])"
        },
        {
          "name": "keyword.operator.increment",
          "match": "\\+\\+"
        },
        {
          "name": "keyword.operator.decrement",
          "match": "--"
        },
        {
          "name": "keyword.operator.assignment.compound",
          "match": "%=|\\+=|-=|\\*=(?<!\\()/="
        },
        {
          "name": "keyword.operator.assignment.compound.bitwise",
          "match": "&=|\\^=|<<=|>>=|\\|="
        },
        {
          "name": "keyword.operator.bitwise.shift",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison",
          "match": "!=|<=|>=|==|<|>"
        },
        {
          "name": "keyword.operator.logical",
          "match": "&&|!|\\|\\|"
        },
        {
          "name": "keyword.operator",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.assignment",
          "match": "="
        },
        {
          "name": "keyword.operator",
          "match": "%|\\*|/|-|\\+"
        },
        {
          "name": "keyword.operator.ternary",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.arrow",
          "match": "->"
        },
        {
          "name": "keyword.operator.variadic",
          "match": "(?<!\\.)\\.(?=\\s*\\.)"
        },
        {
          "name": "punctuation.vararg-ellipses",
          "match": "(?<!\\.)\\.\\.\\.(?!\\.)"
        },
        {
          "name": "keyword.operator.caret",
          "match": "\\^"
        }
      ]
    },
    "block-syntax": {
      "patterns": [
        {
          "name": "meta.block-literal.jeti",
          "match": "\\^(?:\\s*(?:void|int|char|float|double|long|short|unsigned|signed|id|BOOL)\\b)?\\s*\\(",
          "captures": {
            "0": {
              "name": "keyword.operator.caret"
            }
          }
        }
      ]
    },
    "namespace-access": {
      "patterns": [
        {
          "name": "entity.name.type.namespace",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)+"
        }
      ]
    },
    "method-signature": {
      "comment": "clang objective-c.tmLanguage 'method' rule: begin ^(-|+)\\s*, end (?=\\{|#)|;. meta.return-type and meta.argument-type each include the protocol-type-qualifier, so nullability words color only inside the signature (return + parameter types) and stay plain on ivars - exactly clang's context coverage.",
      "patterns": [
        {
          "name": "meta.function.objc",
          "begin": "^\\s*[-+]\\s*(?=\\()",
          "end": "(?=\\{|#)|;",
          "patterns": [
            {
              "name": "meta.return-type.objc",
              "begin": "(\\()",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.type.begin.objc"
                }
              },
              "end": "(\\))\\s*(\\w+\\b)",
              "endCaptures": {
                "1": {
                  "name": "punctuation.definition.type.end.objc"
                },
                "2": {
                  "name": "entity.name.function.objc"
                }
              },
              "patterns": [
                {
                  "include": "#objc-protocol-qualifiers"
                },
                {
                  "include": "#c-types"
                },
                {
                  "include": "#objc-types"
                },
                {
                  "include": "#namespace-access"
                },
                {
                  "include": "#comments"
                }
              ]
            },
            {
              "match": "\\b\\w+(?=:)",
              "name": "entity.name.function.name-of-parameter.objc"
            },
            {
              "name": "meta.argument-type.objc",
              "begin": "(:)\\s*(\\()",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.separator.arguments.objc"
                },
                "2": {
                  "name": "punctuation.definition.type.begin.objc"
                }
              },
              "end": "(\\))\\s*(\\w+\\b)?",
              "endCaptures": {
                "1": {
                  "name": "punctuation.definition.type.end.objc"
                },
                "2": {
                  "name": "variable.parameter.function.objc"
                }
              },
              "patterns": [
                {
                  "include": "#objc-protocol-qualifiers"
                },
                {
                  "include": "#c-types"
                },
                {
                  "include": "#objc-types"
                },
                {
                  "include": "#namespace-access"
                },
                {
                  "include": "#comments"
                }
              ]
            },
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement",
          "match": ";"
        },
        {
          "name": "punctuation.separator.delimiter",
          "match": ","
        },
        {
          "name": "punctuation.separator.namespace",
          "match": "::"
        }
      ]
    },
    "jeti-assume-markers": {
      "comment": "clangd colors NS_ASSUME_NONNULL_BEGIN/END uses via the `macro` semantic token (its TextMate grammar has zero ASSUME hits - verified). In Jeti the markers are true syntax (parser nonnull-region toggle, parser.rs parse_declaration), not macros, so the grammar carries the equivalent color with clang's functional-macro scope family.",
      "name": "entity.name.function.preprocessor.jeti-foundation",
      "match": "\\b(NP_ASSUME_NONNULL_BEGIN|NP_ASSUME_NONNULL_END|NS_ASSUME_NONNULL_BEGIN|NS_ASSUME_NONNULL_END)\\b"
    }
  }
}