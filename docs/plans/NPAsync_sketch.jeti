// ⚠️ 已取代：本草案的 `@launch` + Foundation `NPAsync` 类方案未采纳；现行设计见
// doc/async_nptask_plan.md（`async` 返回类型前修饰符 + 真类型 `NPTask<T>`）。原文按惯例保留。
// NPAsync 设计草稿 —— 把 C++ 的 async/await 示例逐行直译成 jeti/objc
//
// 分工（对应 C++ 的两层）：
//   C++ 核心语言    co_await / co_return           →  @await / return（编译器 desugar，已有）
//   C++ 标准库 <future>  std::async / std::future  →  NPAsync（Foundation 类，包 runtime 的 NPTask）
//
// @launch 判据（依据 AGENTS.md 的 @ 三条判据）：
//   表达式前缀位本就是开放上下文（先例 @selector(...)、@42 装箱）；
//   "创建 task 并交给调度器"是 C 槽位里没有、必须编译器/运行时机制的事；
//   裸 launch 与标识符歧义（`int launch = 1;` 必须仍能编过）——与 @await 同判。

#import <Foundation/Foundation.jeti>
#import <Foundation/NPAsync.jth>        // 提案：与 NPString / NPArray 并列入 Foundation

@interface Cooker : NPObject
- (int)slowAdd:(int)a b:(int)b;        // 体含 @await → async（无标注，链式传染）
- (void)sleepOneSecond;
- (void)prep;                          // async void 入口（blocking wrapper 语义）
@end

@implementation Cooker

// ── ① C++20 协程直译 ─────────────────────────────────────────────
//   task<int> slowAdd(int a, int b) {
//       co_await sleep_for(1s);          // 挂起点
//       co_return a + b;                 // co_return
//   }
//
//   jeti：方法体含 @await 即 async（C++20 co_await 判定风格，已定案）；
//   co_return == return（方法签名本身就是 task<int>，不需要 co_）。
- (int)slowAdd:(int)a b:(int)b {
    @await [self sleepOneSecond];        // co_await → @await
    return a + b;                        // co_return → return
}

- (void)sleepOneSecond {
    @await jeti_io_yield();              // M3：真正的让出点（挂起 → 调度器）
}

// ── ② std::async + std::future 直译 ──────────────────────────────
//   void prep() {
//       auto f1 = std::async(std::launch::async, slowAdd, 1, 2);  // 发车，不等待
//       auto f2 = std::async(std::launch::async, slowAdd, 3, 4);
//       int sum = f1.get() + f2.get();                            // future::get()
//       std::cout << sum << std::endl;
//   }
//
//   jeti：std::async → @launch 表达式（句即发车，返回 NPAsync 句柄）；
//         future::get() → [f join]（阻塞泵到完成；M3 后为非阻塞 yield 等待）。
- (void)prep {
    NPAsync *f1 = @launch [self slowAdd:1 b:2];
    NPAsync *f2 = @launch [self slowAdd:3 b:4];

    int sum = [f1 join] + [f2 join];     // future::get() → - (id)join
    NPLog(@"sum=%d", sum);               // 1+2 + 3+4 = 10
}

// ── ③ 发车后再 await（future 只存不用 + 后续 co_await）────────────
//   int a = f1.get();      // C++
//   int a = @await f1;     // jeti：@await 识别 NPAsync 句柄 →
//                          //   挂起等待而非阻塞泵（M3 调度器语义）
@end

int main() {
    Cooker *c = [[Cooker alloc] init];
    [c prep];                            // async void 可从同步上下文调用（已定案）
    return 0;
}

// ── NPAsync 的最小接口面（比照 std::future 裁剪）─────────────────
//
// @interface NPAsync : NPObject
// + (NPAsync *)launchOn:(id)target selector:(SEL)sel;   // @launch 的库形态（可选）
// - (id)join;            // future::get()：阻塞泵到完成，取结果槽
// - (BOOL)isFinished;    // future 非阻塞查询（C++ 无，但 ObjC 命名惯例自然）
// - (void)detach;        // fire-and-forget：不等、由调度器收尾（M3）
// @end
//
// 裁剪掉不做的（ObjC 一致性 / 单线程协作模型用不上）：
//   std::launch::deferred —— 惰性求值在"方法体含 @await 即 async"模型下
//     等价于"普通同步方法"，调用它就行，不需要第二种 task；
//   future::wait_for / wait_until —— M3 单线程协作调度器没有时钟等待语义，
//     真需要定时器应走 Foundation 的计时器词汇（NSTimer 风格），不混进 async；
//   shared_future / promise —— 多消费者等待属 M3 任务图（parent 字段已预留），
//     届时以 `[t addCompletionBlock:^(id r){...}]` 之类的 ObjC 风格补，不抄 C++ 词。
//
// ── 泛型问题：NPAsync<T> 还是 NPAsync + id？────────────────────────
//   项目已有 DataPack<T> monomorphization，`NPAsync<int> *f1` 技术上可行，
//   [f1 join] 可直接返回 int（免强转）。
//   保守路线（本草稿采用）：NPAsync + `- (id)join` + 调用方强转——与
//   objectAtIndex: 返回 id 的 ObjC 现状一致；泛型化作为独立增量后补。
