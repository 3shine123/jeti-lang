#ifndef NPMUTABLEDICTIONARY_NH
#define NPMUTABLEDICTIONARY_NH

#import <Foundation/NPDictionary.hje>

// Mutable counterpart of NPDictionary. Inherits the storage ivars
// (_keys / _values / _count / _capacity) and the querying API
// (count / objectForKey: / allKeys / allValues / copy / description).
//
// `setObject:forKey:` keeps value semantics: an equal key (isEqual:) is
// *replaced*, not appended, so `[d setObject:x forKey:@"k"]` twice leaves one
// entry. Unlike ObjC, a nil value is ignored rather than removing the key
// (use `removeObjectForKey:`), and a nil key is ignored rather than raising.
@interface NPMutableDictionary<K, V> : NPDictionary<K, V> {
@public
    // ivars inherited from NPDictionary
}

+ (NPMutableDictionary *)dictionary;
+ (NPMutableDictionary *)dictionaryWithCapacity:(size_t)capacity;
+ (NPMutableDictionary *)dictionaryWithObject:(V)value forKey:(K)key;

- (NPMutableDictionary *)init;
- (NPMutableDictionary *)initWithCapacity:(size_t)capacity;
- (NPMutableDictionary *)initWithDictionary:(NPDictionary *)other;

- (void)setObject:(V)value forKey:(K)key;
- (void)addEntriesFromDictionary:(NPDictionary *)other;
- (void)removeObjectForKey:(K)key;
- (void)removeAllObjects;

@end

#endif
