#ifndef NPSET_NH
#define NPSET_NH

#import <Foundation/NPObject.hje>
#import <Foundation/NPArray.hje>
#import <Foundation/NPPredicate.hje>

// Immutable unordered collection of unique objects — the ObjC NSSet model.
//
// Storage mirrors NPDictionary: a single object array plus a count. Membership
// is a linear scan that compares with `isEqual:`, so NPString/NPNumber elements
// have *value* semantics — a fresh `@"x"` literal finds an element stored under
// a different-but-equal string. There is no hash table, for the same reason
// NPDictionary has none: these sets are small, and hashing would need a
// `hash`/`isEqual:` pairing across every element class to stay correct.
//
// A nil object is ignored by every mutator rather than stored (matching
// ObjC's NSSet, which raises — here it is simply skipped, the same choice
// NPDictionary makes for nil keys).
@interface NPSet<T> : NPObject {
@public
    NPObject **_items;
    size_t _count;
    size_t _capacity;
}

// Class-side factories keep erased `id` params (the specialization still
// rewrites T positions in instance methods; factories stay bare to avoid
// nested-generic-in-template return types like NPArray<T>).
+ (NPSet *)set;
+ (NPSet *)setWithObject:(id)object;
+ (NPSet *)setWithObjects:(id *)objects count:(size_t)n;
+ (NPSet *)setWithArray:(NPArray *)array;

- (size_t)count;
- (BOOL)containsObject:(id)object;
- (id)anyObject;
- (NPArray *)allObjects;
// Set filtering yields an ARRAY (the plan's surface): the elements that pass,
// in storage order. A nil predicate filters nothing.
- (NPArray *)filteredArrayUsingPredicate:(NPPredicate *)pred;

// Shared mutator path. The immutable NPSet itself never grows (its factories
// build the storage in one shot), but NPMutableSet and NPOrderedSet inherit
// their storage from NPSet and their add-path must dispatch through THIS
// class's vtable — declaring the mutators only on NPMutableSet left
// NPOrderedSet's vtable without the slots, and an inherited call crashed on a
// NULL slot. Documented consequence: an "immutable" NPSet will also respond
// to addObject: at runtime; immutability here is by-convention, exactly like
// ObjC's immutable subclasses before `__attribute__((objc_subclassing_restricted))`.
- (void)addObject:(id)object;
- (void)addObjectsFromArray:(NPArray *)other;

// Growth helper. MUST be declared here (public segment), not left private to
// NPSet.jeti: NPMutableSet/NPOrderedSet run in their own owner TUs, and a
// private method only dispatches inside its owner TU — the subclasses'
// vtables would carry a NULL slot for it and `[self _grow]` from the shared
// addObject: would jump through NULL (the R1/R2 iron law, observed live).
- (void)_grow;

// Content equality, as in ObjC's NSSet: same count, and every element of one
// is contained (isEqual:) in the other. Non-set operands fall back to
// NSObject's identity comparison.
- (BOOL)isEqual:(id)object;

- (id)copy;
- (NPString *)description;

@end

#endif
