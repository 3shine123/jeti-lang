#import <Foundation/NPDictionary.hje>
#import <Foundation/NPString.hje>
#include <string.h>
#include <stdlib.h>

@implementation NPDictionary

- (void)dealloc {
    for (size_t i = 0; i < _count; i++) {
        if (_keys[i]) {
            jeti_release(_keys[i]);
        }
        if (_values[i]) {
            jeti_release(_values[i]);
        }
    }
    free(_keys);
    free(_values);
    _keys = NULL;
    _values = NULL;
    _count = 0;
    _capacity = 0;
    [super dealloc];
}

+ (NPDictionary *)dictionary {
    return [self dictionaryWithObjects:NULL forKeys:NULL count:0];
}

+ (NPDictionary *)dictionaryWithObject:(V)value forKey:(K)key {
    return [self dictionaryWithObjects:&value forKeys:&key count:1];
}

+ (NPDictionary *)dictionaryWithObjects:(id *)values forKeys:(id *)keys count:(size_t)n {
    @noarc {
        NPDictionary *dict = [[self alloc] init];
        if (!dict) return nil;
        if (n > 0 && values && keys) {
            NPObject **ks = (NPObject **)calloc(n, sizeof(NPObject *));
            NPObject **vs = (NPObject **)calloc(n, sizeof(NPObject *));
            if (ks && vs) {
                size_t stored = 0;
                for (size_t i = 0; i < n; i++) {
                    // A nil key names no entry; skipping it keeps `_count`
                    // honest instead of leaving a hole the scan would step
                    // through.
                    if (!keys[i]) {
                        continue;
                    }
                    ks[stored] = jeti_retain(keys[i]);
                    vs[stored] = values[i] ? jeti_retain(values[i]) : NULL;
                    stored++;
                }
                dict->_keys = ks;
                dict->_values = vs;
                dict->_count = stored;
                dict->_capacity = n;
            } else {
                free(ks);
                free(vs);
            }
        }
        return [dict autorelease];
    }
}

- (size_t)count {
    return _count;
}

// Linear scan with `isEqual:` — value semantics for NPString/NPNumber keys
// (see their `isEqual:` overrides). `_keys[i]` may be NULL only if a caller
// built the arrays by hand; guard anyway.
- (V)objectForKey:(K)key {
    if (!key) return NULL;
    for (size_t i = 0; i < _count; i++) {
        if (_keys[i] && [_keys[i] isEqual:key]) {
            return _values[i];
        }
    }
    return NULL;
}

- (BOOL)isEqual:(id)object {
    if (self == (NPObject *)object) return YES;
    if (!object) return NO;
    if (![object isKindOfClass:[NPDictionary class]]) {
        return [super isEqual:object];
    }
    NPDictionary *other = (NPDictionary *)object;
    if ([other count] != _count) return NO;
    for (size_t i = 0; i < _count; i++) {
        NPObject *mine = _values[i];
        NPObject *theirs = [other objectForKey:_keys[i]];
        if (mine == theirs) continue;
        if (!mine || !theirs) return NO;
        if (![mine isEqual:theirs]) return NO;
    }
    return YES;
}

- (NPArray *)allKeys {
    return [NPArray arrayWithObjects:_keys count:_count];
}

- (NPArray *)allValues {
    return [NPArray arrayWithObjects:_values count:_count];
}

// `-copy` honors the ObjC convention: the caller owns the result (+1).
// Returns an immutable NPDictionary even when invoked on a mutable subclass.
- (id)copy {
    return jeti_retain([NPDictionary dictionaryWithObjects:_values forKeys:_keys count:_count]);
}

- (NPString *)description {
    NPString *result = [NPString stringWithUTF8String:"{"];
    for (size_t i = 0; i < _count; i++) {
        if (i > 0) {
            result = [result stringByAppendingUTF8String:", "];
        }
        if (_keys[i]) {
            result = [result stringByAppendingString:[_keys[i] description]];
        } else {
            result = [result stringByAppendingUTF8String:"(null)"];
        }
        result = [result stringByAppendingUTF8String:" = "];
        if (_values[i]) {
            result = [result stringByAppendingString:[_values[i] description]];
        } else {
            result = [result stringByAppendingUTF8String:"(null)"];
        }
    }
    result = [result stringByAppendingUTF8String:"}"];
    return result;
}

@end
