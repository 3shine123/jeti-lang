#import <Foundation/NPURL.hje>
#include <string.h>
#include <stdlib.h>
#include <stdio.h>

@implementation NPURL

- (id)initWithString:(NPString *)str {
    self = [super init];
    if (self) {
        _scheme = NULL;
        _host = NULL;
        _port = NULL;
        _path = NULL;
        _query = NULL;
        _fragment = NULL;
        const char *s = str ? [str UTF8String] : NULL;
        if (!s) { return NULL; }
        // scheme://…  (RFC 3986: scheme = ALPHA *( ALPHA / DIGIT / + / - / . ))
        const char *scheme_end = strstr(s, "://");
        if (!scheme_end || scheme_end == s) { return NULL; }
        size_t scheme_len = (size_t)(scheme_end - s);
        const char *authority = scheme_end + 3;

        // Authority ends at the first '/', '?' or '#'.
        const char *auth_end = authority;
        while (*auth_end && *auth_end != '/' && *auth_end != '?' && *auth_end != '#') {
            auth_end++;
        }
        // Empty host is invalid (ObjC-aligned).
        if (auth_end == authority) { return NULL; }

        // userinfo 丢弃（user:pass@host 的 @ 前段）。
        const char *at = NULL;
        for (const char *p = authority; p < auth_end; p++) {
            if (*p == '@') { at = p; }
        }
        const char *hostp = at ? at + 1 : authority;

        // host[:port] — 方括号形态是 IPv6 字面量（`[::1]`、`[2001:db8::1]:8080`）：
        // 方括号内的 ':' 属于地址本身，不能当 port 分隔符。`-host` 返回去掉
        // 方括号的裸地址（ObjC 的 NSURL 同）；重建 absoluteString 时再补回。
        const char *host_start = hostp;
        const char *host_end = auth_end;
        const char *portp = NULL;      // port 起始；NULL = 未显式给出
        if (hostp < auth_end && *hostp == '[') {
            const char *close = NULL;
            for (const char *p = hostp + 1; p < auth_end; p++) {
                if (*p == ']') { close = p; break; }
            }
            if (!close) { return NULL; }            // 方括号未闭合：非法
            host_start = hostp + 1;
            host_end = close;
            if (close + 1 < auth_end) {
                if (close[1] != ':') { return NULL; }   // `]` 后只允许 ":port"
                portp = close + 2;
            }
        } else {
            const char *colon = NULL;
            for (const char *p = hostp; p < auth_end; p++) {
                if (*p == ':') { colon = p; break; }
            }
            host_end = colon ? colon : auth_end;
            if (colon && colon + 1 < auth_end) { portp = colon + 1; }
        }
        size_t host_len = (size_t)(host_end - host_start);
        // port 必须是非空数字拼写，否则按无 port 处理（"host:" → nil）。
        // 注意 initWithUTF8String: 按 strlen 取串——portp 是指向原串中段的裸
        // 指针，必须先按 auth_end 边界拷贝出来，否则 port 会把后面的
        // path/query/fragment 全吞进去（"8080" 变 "8080/a/b?…"）。
        if (portp) {
            int all_digits = 1;
            for (const char *p = portp; p < auth_end; p++) {
                if (*p < '0' || *p > '9') { all_digits = 0; break; }
            }
            if (all_digits) {
                size_t port_len = (size_t)(auth_end - portp);
                if (port_len > 0 && port_len < 16) {
                    char pbuf[16];
                    memcpy(pbuf, portp, port_len);
                    pbuf[port_len] = '\0';
                    _port = [[NPString alloc] initWithUTF8String:pbuf];
                }
            }
        }
        if (host_len > 0) {
            char buf[512];
            if (host_len < sizeof(buf)) {
                memcpy(buf, host_start, host_len);
                buf[host_len] = '\0';
                _host = [[NPString alloc] initWithUTF8String:buf];
            }
        }

        // Path: from auth_end up to '?' or '#'.
        const char *rest = auth_end;
        if (*rest == '/') {
            const char *path_end = rest;
            while (*path_end && *path_end != '?' && *path_end != '#') {
                path_end++;
            }
            size_t plen = (size_t)(path_end - rest);
            if (plen > 0 && plen < 1024) {
                char buf[1024];
                memcpy(buf, rest, plen);
                buf[plen] = '\0';
                _path = [[NPString alloc] initWithUTF8String:buf];
            }
            rest = path_end;
        }
        // Query: after '?', up to '#'.
        if (*rest == '?') {
            const char *q_end = rest + 1;
            while (*q_end && *q_end != '#') { q_end++; }
            size_t qlen = (size_t)(q_end - (rest + 1));
            if (qlen > 0 && qlen < 1024) {
                char buf[1024];
                memcpy(buf, rest + 1, qlen);
                buf[qlen] = '\0';
                _query = [[NPString alloc] initWithUTF8String:buf];
            }
            rest = q_end;
        }
        // Fragment: after '#', to the end.
        if (*rest == '#') {
            const char *f = rest + 1;
            if (*f) {
                _fragment = [[NPString alloc] initWithUTF8String:f];
            }
        }
        if (!_host) { return NULL; }
        {
            char buf[64];
            if (scheme_len < sizeof(buf)) {
                memcpy(buf, s, scheme_len);
                buf[scheme_len] = '\0';
                _scheme = [[NPString alloc] initWithUTF8String:buf];
            }
        }
        if (!_scheme) { return NULL; }
    }
    return self;
}

- (void)dealloc {
    if (_scheme) { jeti_release(_scheme); _scheme = NULL; }
    if (_host) { jeti_release(_host); _host = NULL; }
    if (_port) { jeti_release(_port); _port = NULL; }
    if (_path) { jeti_release(_path); _path = NULL; }
    if (_query) { jeti_release(_query); _query = NULL; }
    if (_fragment) { jeti_release(_fragment); _fragment = NULL; }
    [super dealloc];
}

+ (NPURL *)URLWithString:(NPString *)str {
    return [[self alloc] initWithString:str];
}

- (NPString *)scheme { return _scheme; }
- (NPString *)host { return _host; }

- (NPNumber *)port {
    if (!_port) return NULL;
    // 数字拼写 → NPNumber（ObjC 的 port 返回 NSNumber 对齐）。
    return [NPNumber numberWithLongLong:atoll([_port UTF8String])];
}

- (NPString *)path { return _path; }
- (NPString *)query { return _query; }
- (NPString *)fragment { return _fragment; }

- (NPString *)absoluteString {
    // 规范拼装：scheme://host[:port]path[?query][#fragment]
    // NPString 追加风格（NPArray description 同款）——snprintf 指针算术
    // 在生成 C 里不可靠，不复用。字面量一律走 *UTF8String: 变体——
    // appendString: 收 NPString *，塞 C 字面量运行期就崩。
    NPString *out = [_scheme stringByAppendingUTF8String:"://"];
    // IPv6 字面量的 host 裸存（不带方括号），重建时必须补回方括号，
    // 否则 "http://::1/x" 这种形态会被下一次解析判成非法。
    if (_host && strchr([_host UTF8String], ':')) {
        out = [out stringByAppendingUTF8String:"["];
        out = [out stringByAppendingUTF8String:[_host UTF8String]];
        out = [out stringByAppendingUTF8String:"]"];
    } else {
        out = [out stringByAppendingUTF8String:[_host UTF8String]];
    }
    if (_port) {
        out = [out stringByAppendingUTF8String:":"];
        out = [out stringByAppendingUTF8String:[_port UTF8String]];
    }
    if (_path) {
        out = [out stringByAppendingUTF8String:[_path UTF8String]];
    }
    if (_query) {
        out = [out stringByAppendingUTF8String:"?"];
        out = [out stringByAppendingUTF8String:[_query UTF8String]];
    }
    if (_fragment) {
        out = [out stringByAppendingUTF8String:"#"];
        out = [out stringByAppendingUTF8String:[_fragment UTF8String]];
    }
    return out;
}

@end
