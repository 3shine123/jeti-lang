#ifndef NPERROR_NH
#define NPERROR_NH

#import <Foundation/NPObject.hje>
#import <Foundation/NPString.hje>
#import <Foundation/NPDictionary.hje>

// Error domains, matching ObjC's convention of reversing-DNS prefixes.
#define NPErrorDomain            @"NPErrorDomain"
#define NPErrorFileIO            @"NPErrorFileIO"
#define NPErrorParse             @"NPErrorParse"

// The out-parameter shape used throughout Foundation for fallible methods:
//   - (BOOL)write:(NPString *)text error:(NPError **)outError;
// The callee allocates the error only when it returns NO, so the caller's
// read of `*outError` is guarded by the return value, not by nil-checking.
// Nullability annotates the INNER pointer (the error is nullable); the outer
// pointer is always nonnull because the callee writes through it.
@interface NPError : NPObject {
@public
    int         _code;
    NPString   *_domain;
    NPDictionary *_userInfo;
}

// Designated-ish constructors. `+errorWithCode:domain:` is the common case;
// userInfo is optional context (keys are strings, values are objects).
+ (NPError *)errorWithCode:(int)code domain:(NPString *)domain;
+ (NPError *)errorWithCode:(int)code domain:(NPString *)domain
                  userInfo:(nullable NPDictionary *)userInfo;
- (NPError *)initWithCode:(int)code domain:(NPString *)domain
                 userInfo:(nullable NPDictionary *)userInfo;

// A ready-made parse error — the shape every parser-ish method wants.
+ (NPError *)parseErrorWithMessage:(NPString *)message;
+ (NPError *)fileIOErrorWithMessage:(NPString *)message;

- (int)code;
- (NPString *)domain;
- (nullable NPDictionary *)userInfo;

@property (nonatomic, readonly, nonnull) NPString *localizedDescription;

@end

#endif
