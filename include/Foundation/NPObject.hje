#ifndef NPOBJECT_NH
#define NPOBJECT_NH

#include <stdint.h>
#include <stddef.h>

struct NPClass;

@interface jeti_root
- (instancetype)init;
- (void)dealloc;
- (void)release;
- (instancetype)retain;
- (BOOL)isKindOf:(Class)cls;
- (BOOL)isKindOfClass:(Class)cls;
- (BOOL)isEqual:(id)object;
- (id)description;
@end

@interface NPObject : jeti_root
+ (instancetype)alloc;
+ (instancetype)new;
- (instancetype)init;
- (void)dealloc;
- (void)release;
- (instancetype)retain;
@end

#endif