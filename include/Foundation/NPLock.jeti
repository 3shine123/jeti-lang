#import <Foundation/NPLock.hje>
#import <Foundation/NPObject.jeti>

// NPLock 实现：原子标志自旋锁。
//
// 原子访问用 clang/gcc 的 `__atomic_*` 内建函数（在普通内存上提供 acquire/
// release 语义，与 runtime.c 的 C11 `atomic_flag` 是同一套机制）。这样 ivar
// 保持普通 `int`，不必在头文件里引入 `_Atomic` 类型。

@implementation NPLock

- (void)lock {
    // 自旋直到抢到。协作式单线程运行期里没人持有，第一次即成功；
    // 真实线程下由持有者 unlock 后成功（见 .hje 的诚实边界）。
    while (__atomic_exchange_n(&_flag, 1, __ATOMIC_ACQUIRE) != 0) {
        // 空转等待
    }
    _depth = 1;
}

- (void)unlock {
    _depth = 0;
    __atomic_store_n(&_flag, 0, __ATOMIC_RELEASE);
}

- (BOOL)tryLock {
    if (__atomic_exchange_n(&_flag, 1, __ATOMIC_ACQUIRE) == 0) {
        _depth = 1;
        return 1;
    }
    return 0;
}

- (BOOL)isLocked {
    return (BOOL)(__atomic_load_n(&_flag, __ATOMIC_RELAXED) != 0);
}

@end
