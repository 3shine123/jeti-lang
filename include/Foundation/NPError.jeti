#import <Foundation/NPError.hje>
#import <Foundation/NPObject.jeti>
#import <Foundation/NPString.jeti>
#include <stdio.h>

@implementation NPError

- (NPError *)initWithCode:(int)code domain:(NPString *)domain
                 userInfo:(nullable NPDictionary *)userInfo {
    self = [super init];
    if (self) {
        _code = code;
        // The domain is a required argument here, so store the reference
        // without retaining: a string literal / constant outlives any error.
        // ARC injects no release for it (see golden/45's ARC notes), matching
        // how the rest of Foundation treats literal-backed strings.
        _domain = domain;
        _userInfo = userInfo;
    }
    return self;
}

+ (NPError *)errorWithCode:(int)code domain:(NPString *)domain {
    return [self errorWithCode:code domain:domain userInfo:nil];
}

+ (NPError *)errorWithCode:(int)code domain:(NPString *)domain
                  userInfo:(nullable NPDictionary *)userInfo {
    return [[self alloc] initWithCode:code domain:domain userInfo:userInfo];
}

+ (NPError *)parseErrorWithMessage:(NPString *)message {
    NPDictionary *info = @{ @"NSLocalizedDescription": message };
    return [self errorWithCode:1 domain:NPErrorParse userInfo:info];
}

+ (NPError *)fileIOErrorWithMessage:(NPString *)message {
    NPDictionary *info = @{ @"NSLocalizedDescription": message };
    return [self errorWithCode:2 domain:NPErrorFileIO userInfo:info];
}

- (int)code { return _code; }

- (NPString *)domain { return _domain ? _domain : @""; }

- (nullable NPDictionary *)userInfo { return _userInfo; }

- (NPString *)localizedDescription {
    if (_userInfo) {
        NPString *msg = [_userInfo objectForKey:@"NSLocalizedDescription"];
        if (msg) return msg;
    }
    char buf[128];
    snprintf(buf, sizeof(buf), "%s error %d", [[self domain] UTF8String], _code);
    return [NPString stringWithUTF8String:buf];
}

- (NPString *)description {
    char buf[160];
    snprintf(buf, sizeof(buf), "Error %d in %s: %s", _code,
             [[self domain] UTF8String], [[self localizedDescription] UTF8String]);
    return [NPString stringWithUTF8String:buf];
}

@end
