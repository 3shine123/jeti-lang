#import <Foundation/NPArray.hje>
#import <Foundation/NPString.hje>
#import <Foundation/NPSortDescriptor.hje>
#include <string.h>
#include <stdlib.h>
#include <stdio.h>

@implementation NPArray

- (void)dealloc {
    for (size_t i = 0; i < _count; i++) {
        if (_items[i]) {
            jeti_release(_items[i]);
        }
    }
    free(_items);
    _items = NULL;
    _count = 0;
    _capacity = 0;
    [super dealloc];
}

+ (id)arrayWithObjects:(id *)objs count:(size_t)n {
    NPArray *arr = [[self alloc] init];
    if (!arr) return nil;
    if (n > 0) {
        arr->_items = (NPObject **)malloc(n * sizeof(NPObject *));
        if (arr->_items) {
            for (size_t i = 0; i < n; i++) {
                arr->_items[i] = objs[i] ? jeti_retain(objs[i]) : NULL;
            }
            arr->_count = n;
            arr->_capacity = n;
        }
    }
    return jeti_autorelease(arr);
}

+ (id)arrayWithObject:(T)obj {
    return [self arrayWithObjects:&obj count:1];
}

+ (id)array {
    return [self arrayWithObjects:NULL count:0];
}

- (size_t)count {
    return _count;
}

- (T)objectAtIndex:(size_t)index {
    if (index >= _count) return NULL;
    return _items[index];
}

- (T)firstObject {
    return _count > 0 ? _items[0] : NULL;
}

- (T)lastObject {
    return _count > 0 ? _items[_count - 1] : NULL;
}

// Value semantics, matching ObjC: `containsObject:` / `indexOfObject:` use
// `isEqual:` (NPString/NPNumber compare by value), not pointer identity.
// A nil needle matches nothing (ObjC would raise; we return NO / not-found).
- (BOOL)containsObject:(T)obj {
    if (!obj) return NO;
    for (size_t i = 0; i < _count; i++) {
        if (_items[i] && [_items[i] isEqual:obj]) return YES;
    }
    return NO;
}

- (size_t)indexOfObject:(T)obj {
    if (!obj) return (size_t)-1;
    for (size_t i = 0; i < _count; i++) {
        if (_items[i] && [_items[i] isEqual:obj]) return i;
    }
    return (size_t)-1;
}

// Predicate filtering. The predicate owns all DSL knowledge; this loop only
// calls it per element. Hits are collected as *borrowed* element pointers and
// handed to arrayWithObjects:, which retains them — so the failure paths below
// need no refcount bookkeeping.
- (NPArray *)filteredArrayUsingPredicate:(NPPredicate *)pred {
    if (!pred) {
        return [NPArray arrayWithObjects:_items count:_count];
    }
    if (_count == 0) {
        return [NPArray arrayWithObjects:NULL count:0];
    }
    NPObject **hits = (NPObject **)malloc(_count * sizeof(NPObject *));
    if (!hits) {
        return [NPArray arrayWithObjects:NULL count:0];
    }
    size_t hit_count = 0;
    for (size_t i = 0; i < _count; i++) {
        if (_items[i] && [pred evaluateWithObject:_items[i]]) {
            hits[hit_count] = _items[i];
            hit_count++;
        }
    }
    NPArray *result = [NPArray arrayWithObjects:hits count:hit_count];
    free(hits);
    return result;
}

// (size_t)-1 = no match, matching indexOfObject:'s not-found spelling.
- (size_t)indexOfObjectMatchingPredicate:(NPPredicate *)pred {
    if (!pred) return (size_t)-1;
    for (size_t i = 0; i < _count; i++) {
        if (_items[i] && [pred evaluateWithObject:_items[i]]) {
            return i;
        }
    }
    return (size_t)-1;
}

// `-copy` honors the ObjC convention: the caller owns the result (+1).
// Returns an immutable NPArray even when invoked on a mutable subclass.
- (NPArray *)sortedArrayUsingDescriptors:(NPArray *)descriptors {
    // Nil/empty → unsorted copy (the container API's nil-tolerant stance).
    if (!descriptors || [descriptors count] == 0) {
        return [NPArray arrayWithObjects:_items count:_count];
    }
    NPArray *out = [NPArray arrayWithObjects:_items count:_count];
    if (!out || out->_count < 2) { return out; }
    size_t n = out->_count;
    NPObject **buf = out->_items;
    NPObject **scratch = (NPObject **)malloc(n * sizeof(NPObject *));
    if (!scratch) { return out; }
    // Same iterative bottom-up merge as sortedArrayUsingComparator:, but the
    // comparison walks the descriptor array: first descriptor with a nonzero
    // verdict wins; full ties → 0 (stable).
    for (size_t width = 1; width < n; width *= 2) {
        for (size_t lo = 0; lo < n; lo += 2 * width) {
            size_t mid = lo + width < n ? lo + width : n;
            size_t hi = lo + 2 * width < n ? lo + 2 * width : n;
            size_t i = lo, j = mid, k = lo;
            while (i < mid && j < hi) {
                int r = 0;
                for (size_t di = 0; di < [descriptors count]; di++) {
                    NPSortDescriptor *sd = [descriptors objectAtIndex:di];
                    r = [sd compareObject:buf[i] toObject:buf[j]];
                    if (r != 0) { break; }
                }
                // Left-first on ties keeps the sort stable.
                if (r <= 0) { scratch[k++] = buf[i++]; }
                else { scratch[k++] = buf[j++]; }
            }
            while (i < mid) { scratch[k++] = buf[i++]; }
            while (j < hi) { scratch[k++] = buf[j++]; }
        }
        for (size_t t = 0; t < n; t++) { buf[t] = scratch[t]; }
    }
    free(scratch);
    return out;
}

- (id)copy {
    return jeti_retain([NPArray arrayWithObjects:_items count:_count]);
}

- (NPArray *)sortedArrayUsingComparator:(int (^)(id, id))cmp {
    // Nil-tolerant: no comparator, no sort — an unsorted copy.
    if (!cmp) {
        return [NPArray arrayWithObjects:_items count:_count];
    }
    NPArray *out = [NPArray arrayWithObjects:_items count:_count];
    if (!out || out->_count < 2) { return out; }
    size_t n = out->_count;
    NPObject **buf = out->_items;
    NPObject **scratch = (NPObject **)malloc(n * sizeof(NPObject *));
    if (!scratch) { return out; }
    // Bottom-up stable merge, iterative — the whole sort lives in the method
    // body because a file-scope C helper's BLOCK parameter is dropped by the
    // file-level function emitter (the block-ivar drop's sibling); method
    // bodies call block parameters fine (NPTimer precedent).
    for (size_t width = 1; width < n; width *= 2) {
        for (size_t lo = 0; lo < n; lo += 2 * width) {
            size_t mid = lo + width < n ? lo + width : n;
            size_t hi = lo + 2 * width < n ? lo + 2 * width : n;
            size_t i = lo, j = mid, k = lo;
            while (i < mid && j < hi) {
                // Left-first on ties keeps the sort stable.
                if (cmp(buf[i], buf[j]) <= 0) { scratch[k++] = buf[i++]; }
                else { scratch[k++] = buf[j++]; }
            }
            while (i < mid) { scratch[k++] = buf[i++]; }
            while (j < hi) { scratch[k++] = buf[j++]; }
        }
        for (size_t t = 0; t < n; t++) { buf[t] = scratch[t]; }
    }
    free(scratch);
    return out;
}

- (NPString *)description {
    // ObjC NSArray description 形态：`(a, b)`（圆括号包裹）。
    NPString *result = [NPString stringWithUTF8String:"("];
    for (size_t i = 0; i < _count; i++) {
        if (i > 0) {
            result = [result stringByAppendingUTF8String:", "];
        }
        if (_items[i]) {
            result = [result stringByAppendingString:[_items[i] description]];
        } else {
            result = [result stringByAppendingUTF8String:"(null)"];
        }
    }
    result = [result stringByAppendingUTF8String:")"];
    return result;
}

@end