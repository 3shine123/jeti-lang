#ifndef NPARRAY_NH
#define NPARRAY_NH

#import <Foundation/NPObject.hje>
#import <Foundation/NPPredicate.hje>

// Generic since the modernization pass: `NPArray<T>` specializes via
// monomorphization (objectAtIndex: returns T, addObject-style params take T).
// The BARE spelling `NPArray` (no type args) keeps its pre-existing erased
// behavior and symbols — existing code needs zero migration.
@interface NPArray<T> : NPObject {
@public
    NPObject **_items;
    size_t _count;
    size_t _capacity;
}

+ (instancetype)arrayWithObjects:(id *)objs count:(size_t)n;
+ (instancetype)arrayWithObject:(T)obj;
+ (instancetype)array;

- (size_t)count;
- (T)objectAtIndex:(size_t)index;
- (T)firstObject;
- (T)lastObject;
- (BOOL)containsObject:(T)obj;
- (size_t)indexOfObject:(T)obj;
// Predicate filtering (doc/nppredicate_plan.md §3): NPPredicate owns the DSL
// parsing; the container only applies the parsed predicate per element. A nil
// predicate filters nothing — the same nil-tolerant stance the rest of this
// container API takes.
- (NPArray *)filteredArrayUsingPredicate:(NPPredicate *)pred;
- (size_t)indexOfObjectMatchingPredicate:(NPPredicate *)pred;
// Comparator sort (NSComparator shape: the block returns <0 / 0 / >0).
// Stable merge sort — equal elements keep their relative order. A nil
// comparator yields an unsorted copy (the nil-tolerant stance the rest of
// this container API takes). No file-static state: the block travels as a
// parameter end to end.
- (NPArray *)sortedArrayUsingComparator:(int (^)(id, id))cmp;
// Multi-key sort (NSSortDescriptor shape): descriptors earlier in the array
// take precedence; a tie at one level falls through to the next; full ties
// keep their relative order (stable). Descriptors compare via
// compareObject:toObject: (direction already folded in there). A nil/empty
// descriptor array returns an unsorted copy.
- (NPArray *)sortedArrayUsingDescriptors:(NPArray *)descriptors;
- (instancetype)copy;
- (NPString *)description;

@end

#endif