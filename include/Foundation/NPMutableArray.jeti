#import <Foundation/NPMutableArray.hje>
#import <Foundation/NPArray.jeti>
#include <string.h>
#include <stdlib.h>

@implementation NPMutableArray

- (NPMutableArray *)initWithCapacity:(size_t)capacity {
    self = [super init];
    if (self) {
        _items = NULL;
        _count = 0;
        _capacity = 0;
        if (capacity > 0) {
            NPObject **items = (NPObject **)malloc(capacity * sizeof(NPObject *));
            if (items) {
                _items = items;
                _capacity = capacity;
            }
        }
    }
    return self;
}

- (NPMutableArray *)init {
    return [self initWithCapacity:0];
}

- (NPMutableArray *)initWithArray:(NPArray *)other {
    self = [self init];
    if (self && other) {
        size_t n = [other count];
        for (size_t i = 0; i < n; i++) {
            [self addObject:[other objectAtIndex:i]];
        }
    }
    return self;
}

- (NPMutableArray *)initWithObjects:(id *)objs count:(size_t)n {
    self = [self init];
    if (self && n > 0 && objs) {
        for (size_t i = 0; i < n; i++) {
            [self addObject:objs[i]];
        }
    }
    return self;
}

+ (NPMutableArray *)arrayWithCapacity:(size_t)capacity {
    @noarc {
        return [[[self alloc] initWithCapacity:capacity] autorelease];
    }
}

+ (NPMutableArray *)array {
    @noarc {
        return [[[self alloc] init] autorelease];
    }
}

+ (NPMutableArray *)arrayWithObject:(T)obj {
    @noarc {
        NPMutableArray *arr = [self arrayWithCapacity:1];
        if (arr && obj) {
            [arr addObject:obj];
        }
        return arr;
    }
}

+ (NPMutableArray *)arrayWithObjects:(id *)objs count:(size_t)n {
    @noarc {
        NPMutableArray *arr = [self arrayWithCapacity:n];
        if (arr) {
            for (size_t i = 0; i < n; i++) {
                if (objs[i]) {
                    [arr addObject:objs[i]];
                }
            }
        }
        return arr;
    }
}

- (void)addObject:(T)obj {
    if (!obj) return;
    if (_count >= _capacity) {
        size_t newcap = _capacity == 0 ? 4 : _capacity * 2;
        NPObject **items = (NPObject **)realloc(_items, newcap * sizeof(NPObject *));
        if (!items) return;
        _items = items;
        _capacity = newcap;
    }
    _items[_count] = jeti_retain(obj);
    _count++;
}

- (void)addObjectsFromArray:(NPArray *)other {
    if (!other) return;
    size_t n = [other count];
    for (size_t i = 0; i < n; i++) {
        [self addObject:[other objectAtIndex:i]];
    }
}

- (void)insertObject:(T)obj atIndex:(size_t)index {
    if (!obj) return;
    if (index > _count) index = _count;
    if (_count >= _capacity) {
        size_t newcap = _capacity == 0 ? 4 : _capacity * 2;
        NPObject **items = (NPObject **)realloc(_items, newcap * sizeof(NPObject *));
        if (!items) return;
        _items = items;
        _capacity = newcap;
    }
    memmove(_items + index + 1, _items + index, (_count - index) * sizeof(NPObject *));
    _items[index] = jeti_retain(obj);
    _count++;
}

- (void)removeObjectAtIndex:(size_t)index {
    if (index >= _count) return;
    NPObject *removed = _items[index];
    memmove(_items + index, _items + index + 1, (_count - index - 1) * sizeof(NPObject *));
    _count--;
    if (removed) {
        jeti_release(removed);
    }
}

- (void)removeLastObject {
    if (_count == 0) return;
    [self removeObjectAtIndex:_count - 1];
}

- (void)removeObject:(T)obj {
    if (!obj) return;
    for (size_t i = 0; i < _count; i++) {
        if (_items[i] == obj) {
            [self removeObjectAtIndex:i];
            return;
        }
    }
}

- (void)removeAllObjects {
    for (size_t i = 0; i < _count; i++) {
        if (_items[i]) {
            jeti_release(_items[i]);
        }
    }
    _count = 0;
}

- (void)replaceObjectAtIndex:(size_t)index withObject:(T)obj {
    if (!obj || index >= _count) return;
    NPObject *old = _items[index];
    _items[index] = jeti_retain(obj);
    if (old) {
        jeti_release(old);
    }
}

- (void)exchangeObjectAtIndex:(size_t)a withObjectAtIndex:(size_t)b {
    if (a >= _count || b >= _count) return;
    NPObject *tmp = _items[a];
    _items[a] = _items[b];
    _items[b] = tmp;
}

- (void)setObject:(T)obj atIndex:(size_t)index {
    if (!obj || index >= _count) return;
    [self replaceObjectAtIndex:index withObject:obj];
}

// In-place filter: one compaction pass. The write cursor never overtakes the
// read cursor, so an unvisited element is never clobbered; kept elements keep
// the array's existing +1, a dropped element is released exactly once (a
// duplicated pointer in the array holds one ref per slot, so its each copy
// releases its own).
- (void)filterUsingPredicate:(NPPredicate *)pred {
    if (!pred) return;
    size_t write = 0;
    for (size_t i = 0; i < _count; i++) {
        NPObject *obj = _items[i];
        if (obj && [pred evaluateWithObject:obj]) {
            _items[write] = obj;
            write++;
        } else if (obj) {
            jeti_release(obj);
        }
    }
    _count = write;
}

// In-place comparator sort: sort a copy via the inherited
// sortedArrayUsingComparator: (stable merge sort), then copy back. A nil
// comparator leaves the array unchanged.
- (void)sortUsingComparator:(int (^)(id, id))cmp {
    if (!cmp) return;
    NPArray *sorted = [self sortedArrayUsingComparator:cmp];
    if (!sorted) return;
    for (size_t i = 0; i < _count; i++) {
        _items[i] = sorted->_items[i];
    }
}

// In-place multi-key sort: sort a copy via the inherited
// sortedArrayUsingDescriptors: (stable merge), then copy back. A nil/empty
// descriptor array leaves the array unchanged.
- (void)sortUsingDescriptors:(NPArray *)descriptors {
    if (!descriptors || [descriptors count] == 0) return;
    NPArray *sorted = [self sortedArrayUsingDescriptors:descriptors];
    if (!sorted) return;
    for (size_t i = 0; i < _count; i++) {
        _items[i] = sorted->_items[i];
    }
}

@end
