#import <Foundation/NPPredicate.hje>
#import <Foundation/NPString.hje>
#import <Foundation/NPNumber.hje>
#import <Foundation/NPArray.hje>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/*
 * NPPredicate — ObjC NSPredicate semantics on jeti's static dispatch.
 *
 * All cross-class operations (string/number/array access, comparisons) go
 * through ordinary message sends, which codegen lowers to vtable indexing —
 * so this owner TU links fine against the other Foundation TUs. There is NO
 * direct function call into another class's TU and NO layout mirroring.
 * Keys resolve through jeti_kvc_value (runtime.c): a walk of the isa chain
 * over the compile-time JETI_KVC_$_<Class> tables — table lookup, never
 * reflection. See doc/nppredicate_plan.md.
 */

@implementation NPPredicate

// ─── Node pool (declared in NPPredicate.jeti only; the ivars carry void *) ───
//
// Tags: 0 AND  1 OR  2 NOT  3 CMP  4 STROP  5 IN  6 BETWEEN  7 KEY  8 LIT
//       9 QUANT (ANY/ALL/NONE)
// CMP op: 0=eq 1=ne 2=lt 3=le 4=gt 5=ge
// STROP op: 0=begins 1=ends 2=contains 3=like 4=matches; bit 16 = [c] flag
// QUANT op: 0=ANY 1=ALL 2=NONE
typedef struct jeti_pred_node {
    int tag;
    int op;
    int a;          // child index (left / inner / list); -1 = none
    int b;          // child index (right); -1 = none
    char *text;     // KEY keypath (owned)
    NPObject *val;  // LIT payload (retained)
} jeti_pred_node;

// Parser cursor. Lives across the recursive descent; owns the growing pool.
typedef struct {
    const char *s;
    jeti_pred_node *nodes;
    size_t count;
    size_t cap;
    int failed;
} PredP;

static size_t pred_push(PredP *p, int tag, int op, int a, int b) {
    if (p->count == p->cap) {
        p->cap = p->cap ? p->cap * 2 : 16;
        p->nodes = (jeti_pred_node *)realloc(p->nodes, p->cap * sizeof(jeti_pred_node));
        if (!p->nodes) { p->failed = 1; return 0; }
    }
    jeti_pred_node *n = &p->nodes[p->count];
    memset(n, 0, sizeof(*n));
    n->tag = tag; n->op = op; n->a = a; n->b = b;
    return p->count++;
}

static size_t pred_push_key(PredP *p, const char *begin, size_t len) {
    size_t idx = pred_push(p, 7, 0, -1, -1);
    if (p->failed) return idx;
    p->nodes[idx].text = (char *)calloc(len + 1, 1);
    if (!p->nodes[idx].text) { p->failed = 1; return idx; }
    memcpy(p->nodes[idx].text, begin, len);
    return idx;
}

static size_t pred_push_lit_str(PredP *p, const char *begin, size_t len) {
    size_t idx = pred_push(p, 8, 0, -1, -1);
    if (p->failed) return idx;
    p->nodes[idx].text = (char *)calloc(len + 1, 1);
    if (!p->nodes[idx].text) { p->failed = 1; return idx; }
    memcpy(p->nodes[idx].text, begin, len);
    // Real NPString so isEqual: value semantics apply at comparison time.
    p->nodes[idx].val = (NPObject *)[NPString stringWithUTF8String:p->nodes[idx].text];
    if (p->nodes[idx].val) jeti_retain(p->nodes[idx].val);
    return idx;
}

// Quoted string literal → NPString (borrowed +0 convenience-ctor result, NULL
// with p->failed set on error). One escape implementation for both a primary
// literal and an aggregate element: a doubled quote is a literal quote.
static NPString *pred_str_lit(PredP *p) {
    if (*p->s != '\'') return NULL;
    p->s++;
    char *tmp = (char *)calloc(strlen(p->s) + 1, 1);
    if (!tmp) { p->failed = 1; return NULL; }
    size_t w = 0;
    while (*p->s && *p->s != '\'') {
        if (p->s[0] == '\'' && p->s[1] == '\'') { p->s++; }  // quote escape
        tmp[w++] = *p->s++;
    }
    if (*p->s != '\'') { free(tmp); pred_fail(p, "unterminated string"); return NULL; }
    p->s++;
    NPString *out = [NPString stringWithUTF8String:tmp];
    free(tmp);
    return out;
}

static size_t pred_push_lit_num(PredP *p, double d) {
    size_t idx = pred_push(p, 8, 0, -1, -1);
    if (p->failed) return idx;
    p->nodes[idx].val = (NPObject *)[NPNumber numberWithDouble:d];
    if (p->nodes[idx].val) jeti_retain(p->nodes[idx].val);
    return idx;
}

static void pred_fail(PredP *p, const char *msg) {
    if (!p->failed) {
        fprintf(stderr, "*** NPPredicate: %s near '%.16s'\n", msg, p->s);
        p->failed = 1;
    }
}

static void pred_skipws(PredP *p) {
    while (*p->s == ' ' || *p->s == '\t' || *p->s == '\n' || *p->s == '\r') p->s++;
}

static int pred_word(PredP *p, const char *w) {
    size_t n = strlen(w);
    if (strncmp(p->s, w, n) != 0) return 0;
    char c = p->s[n];
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') return 0;
    p->s += n;
    return 1;
}

// Case-insensitive operator word with optional [c]/[d] modifier; sets *ci.
static int pred_opword(PredP *p, const char *w, int *ci) {
    if (!pred_word(p, w)) return 0;
    pred_skipws(p);
    *ci = 0;
    if (p->s[0] == '[' && (p->s[1] == 'c' || p->s[1] == 'C') && p->s[2] == ']') {
        *ci = 1;
        p->s += 3;
    } else if (p->s[0] == '[' && (p->s[1] == 'd' || p->s[1] == 'D') && p->s[2] == ']') {
        p->s += 3;   // diacritic-insensitive: accepted, no-op (ASCII domain)
    }
    return 1;
}

static size_t pred_or(PredP *p);
static size_t pred_cmp_rest(PredP *p, size_t left);

// Aggregate literal `{ a, b, ... }` → an NPArray of the elements (the
// right-hand side of BETWEEN/IN): numbers and quoted strings, as the header
// documents (`age BETWEEN {10, 20}`, `name IN {'ann', 'bob'}`). Elements are
// borrowed +0 convenience-ctor objects; the array retains them, so no local
// retain is needed.
static size_t pred_agg_lit(PredP *p) {
    p->s++;   // '{'
    NPObject *elems[16];
    size_t n = 0;
    for (;;) {
        pred_skipws(p);
        if (*p->s == '}') { p->s++; break; }
        if (!*p->s) { pred_fail(p, "unterminated aggregate"); break; }
        if (*p->s == ',') { p->s++; continue; }
        if (*p->s == '\'') {
            NPString *sv = pred_str_lit(p);
            if (!sv) break;                              // pred_str_lit set the error
            if (n < sizeof(elems) / sizeof(elems[0])) elems[n++] = (NPObject *)sv;
            continue;
        }
        char *end = NULL;
        double d = strtod(p->s, &end);
        if (end == p->s) { pred_fail(p, "expected number in aggregate"); break; }
        p->s = end;
        if (n < sizeof(elems) / sizeof(elems[0])) {
            elems[n++] = (NPObject *)[NPNumber numberWithDouble:d];
        }
    }
    size_t idx = pred_push(p, 8, 0, -1, -1);
    if (p->failed) return idx;
    p->nodes[idx].val = (NPObject *)[NPArray arrayWithObjects:elems count:n];
    if (p->nodes[idx].val) jeti_retain(p->nodes[idx].val);
    return idx;
}

// primary := '(' or ')' | '!' primary | literal | [ANY|ALL|NONE] key cmp...
static size_t pred_primary(PredP *p) {
    pred_skipws(p);
    if (p->failed) return 0;
    if (*p->s == '(') {
        p->s++;
        size_t inner = pred_or(p);
        pred_skipws(p);
        if (*p->s != ')') { pred_fail(p, "expected ')'"); return inner; }
        p->s++;
        return inner;
    }
    if (*p->s == '\'') {
        NPString *sv = pred_str_lit(p);
        if (!sv) return 0;
        const char *bytes = [sv UTF8String];
        return pred_push_lit_str(p, bytes, bytes ? strlen(bytes) : 0);
    }
    if (*p->s == '{') return pred_agg_lit(p);
    if ((*p->s >= '0' && *p->s <= '9')
        || (*p->s == '-' && p->s[1] >= '0' && p->s[1] <= '9')) {
        char *end = NULL;
        double d = strtod(p->s, &end);
        p->s = end;
        return pred_push_lit_num(p, d);
    }
    if (pred_word(p, "TRUE") || pred_word(p, "YES")) return pred_push_lit_num(p, 1);
    if (pred_word(p, "FALSE") || pred_word(p, "NO")) return pred_push_lit_num(p, 0);
    if (pred_word(p, "nil") || pred_word(p, "NULL")) {
        size_t idx = pred_push(p, 8, 0, -1, -1);
        p->nodes[idx].val = NULL;   // nil literal
        return idx;
    }
    // Quantifier over an array-valued key: ANY/ALL/NONE <key> <cmp>
    int quant = -1;
    if (pred_word(p, "ANY")) quant = 0;
    else if (pred_word(p, "ALL")) quant = 1;
    else if (pred_word(p, "NONE")) quant = 2;
    if (quant >= 0) {
        pred_skipws(p);
        const char *kb = p->s;
        while ((*p->s >= 'a' && *p->s <= 'z') || (*p->s >= 'A' && *p->s <= 'Z')
               || (*p->s >= '0' && *p->s <= '9') || *p->s == '_' || *p->s == '.') p->s++;
        if (p->s == kb) { pred_fail(p, "expected key after ANY/ALL/NONE"); return 0; }
        size_t kidx = pred_push_key(p, kb, (size_t)(p->s - kb));
        // The per-element condition compares the element itself: an empty key
        // path resolves to the receiver (see pred_leaf), so `ANY tags = 'dev'`
        // and `ANY tags LIKE '*dev*'` both spell the element as the subject.
        pred_skipws(p);
        size_t subject = pred_push_key(p, p->s, 0);
        size_t cmp = pred_cmp_rest(p, subject);
        if (p->failed) return 0;
        return pred_push(p, 9, quant, (int)kidx, (int)cmp);
    }
    // key path (identifier with dots)
    if ((*p->s >= 'a' && *p->s <= 'z') || (*p->s >= 'A' && *p->s <= 'Z') || *p->s == '_') {
        const char *b = p->s;
        while ((*p->s >= 'a' && *p->s <= 'z') || (*p->s >= 'A' && *p->s <= 'Z')
               || (*p->s >= '0' && *p->s <= '9') || *p->s == '_' || *p->s == '.') p->s++;
        return pred_push_key(p, b, (size_t)(p->s - b));
    }
    pred_fail(p, "unexpected token");
    return 0;
}

// comparison := primary [cmpop primary | STROP primary | IN primary | BETWEEN primary]
// NOTE: keep the operator words in plain assignments. jeti's parser rejects
// anonymous-struct initializers and NULL inside static initializer lists, and
// codegen drops file-level variable declarations — inline literals are the
// only portable spelling here.
static size_t pred_cmp(PredP *p) {
    pred_skipws(p);
    if (p->failed) return 0;
    // NOT / ! bind looser than comparisons: NOT a = 5 parses NOT (a = 5),
    // matching NSPredicate precedence.
    if (pred_word(p, "NOT") || (*p->s == '!' && p->s[1] != '=')) {
        size_t inner = pred_cmp(p);
        return pred_push(p, 2, 0, (int)inner, -1);
    }
    size_t left = pred_primary(p);
    if (p->failed) return left;
    return pred_cmp_rest(p, left);
}

// Operator tail of a comparison, given an already-parsed left operand. The
// quantifier path reuses it with the aggregate element as the left side.
static size_t pred_cmp_rest(PredP *p, size_t left) {
    pred_skipws(p);
    const char *toks[8];
    int ops[8];
    toks[0] = "<=";  ops[0] = 3;
    toks[1] = ">=";  ops[1] = 4;
    toks[2] = "!=";  ops[2] = 1;
    toks[3] = "<>";  ops[3] = 1;
    toks[4] = "==";  ops[4] = 0;
    toks[5] = "=";   ops[5] = 0;
    toks[6] = "<";   ops[6] = 2;
    toks[7] = ">";   ops[7] = 4;
    for (int i = 0; i < 8; i++) {
        size_t n = strlen(toks[i]);
        if (strncmp(p->s, toks[i], n) == 0) {
            p->s += n;
            size_t right = pred_primary(p);
            return pred_push(p, 3, ops[i], (int)left, (int)right);
        }
    }
    int ci = 0;
    const char *strops[5];
    int sbases[5];
    strops[0] = "BEGINSWITH";  sbases[0] = 0;
    strops[1] = "ENDSWITH";    sbases[1] = 1;
    strops[2] = "CONTAINS";    sbases[2] = 2;
    strops[3] = "LIKE";        sbases[3] = 3;
    strops[4] = "MATCHES";     sbases[4] = 4;
    for (int i = 0; i < 5; i++) {
        if (pred_opword(p, strops[i], &ci)) {
            size_t right = pred_primary(p);
            return pred_push(p, 4, sbases[i] | (ci ? 16 : 0), (int)left, (int)right);
        }
    }
    if (pred_word(p, "IN")) {
        size_t right = pred_primary(p);
        return pred_push(p, 5, 0, (int)left, (int)right);
    }
    if (pred_word(p, "BETWEEN")) {
        size_t right = pred_primary(p);
        return pred_push(p, 6, 0, (int)left, (int)right);
    }
    return left;   // bare key/literal as a boolean
}

static size_t pred_and(PredP *p) {
    size_t left = pred_cmp(p);
    for (;;) {
        pred_skipws(p);
        if (p->failed) return left;
        int ci;
        int matched = 0;
        if (pred_opword(p, "AND", &ci)) matched = 1;
        else if (p->s[0] == '&' && p->s[1] == '&') { p->s += 2; matched = 1; }
        if (!matched) break;
        size_t right = pred_cmp(p);
        left = pred_push(p, 0, 0, (int)left, (int)right);
    }
    return left;
}

static size_t pred_or(PredP *p) {
    size_t left = pred_and(p);
    for (;;) {
        pred_skipws(p);
        if (p->failed) return left;
        int ci;
        int matched = 0;
        if (pred_opword(p, "OR", &ci)) matched = 1;
        else if (p->s[0] == '|' && p->s[1] == '|') { p->s += 2; matched = 1; }
        if (!matched) break;
        size_t right = pred_and(p);
        left = pred_push(p, 1, 0, (int)left, (int)right);
    }
    return left;
}

// Entry. On success *out_root is the root node index and the caller owns the
// pool. Returns 0 (and frees the pool) on malformed input — no global state.
static int pred_parse(const char *src, jeti_pred_node **out_nodes,
                      size_t *out_count, size_t *out_root) {
    PredP p;
    memset(&p, 0, sizeof(p));
    p.s = src;
    size_t root = pred_or(&p);
    pred_skipws(&p);
    if (!p.failed && *p.s != '\0') pred_fail(&p, "trailing characters");
    if (p.failed) {
        for (size_t i = 0; i < p.count; i++) {
            free(p.nodes[i].text);
            if (p.nodes[i].val) jeti_release(p.nodes[i].val);
        }
        free(p.nodes);
        return 0;
    }
    *out_nodes = p.nodes;
    *out_count = p.count;
    *out_root = root;
    return 1;
}

// ─── Lifecycle & public API ─────────────────────────────────────────────────

- (void)dealloc {
    jeti_pred_node *nodes = (jeti_pred_node *)_nodes;
    if (nodes) {
        for (size_t i = 0; i < _node_count; i++) {
            free(nodes[i].text);
            if (nodes[i].val) jeti_release(nodes[i].val);
        }
        free(nodes);
        _nodes = NULL;
        _node_count = 0;
        _node_cap = 0;
    }
    if (_format) { jeti_release(_format); _format = NULL; }
    [super dealloc];
}

+ (NPPredicate *)predicateWithFormat:(NPString *)format {
    return [[self alloc] initWithFormat:format args:NULL count:0];
}

+ (NPPredicate *)predicateWithFormat:(NPString *)format object:(id)arg {
    id args[2] = { arg, NULL };
    return [[self alloc] initWithFormat:format args:args count:1];
}

- (NPPredicate *)initWithFormat:(NPString *)format args:(id *)args count:(size_t)n {
    self = [super init];
    if (!self) return nil;
    _nodes = NULL;
    _node_count = 0;
    _node_cap = 0;
    _format = NULL;
    if (!format) return self;

    // %@ substitution BEFORE parsing: one arg per %@, rendered quoted
    // (strings) so the lexer sees literals. ObjC renders numbers unquoted;
    // the lexer accepts either since a quoted number is a string literal
    // and comparisons fall back to numeric coercion of the description.
    NPString *expanded = [self _expandFormat:format args:args count:n];
    // expanded is +0 borrowed (convenience ctor); _format owns its copy.
    _format = [expanded copy];

    jeti_pred_node *nodes = NULL;
    size_t count = 0, root = 0;
    if (!pred_parse([expanded UTF8String], &nodes, &count, &root)) {
        fprintf(stderr, "*** NPPredicate: malformed format string: %s\n",
                [expanded UTF8String]);
        abort();
    }
    _nodes = nodes;
    _node_count = count;
    _node_cap = count;
    _root = (size_t)root;
    return self;
}

// One arg per %@. Objects render via description; nil renders as nil.
- (NPString *)_expandFormat:(NPString *)format args:(id *)args count:(size_t)n {
    const char *src = [format UTF8String];
    if (!src) src = "";
    size_t cap = strlen(src) * 2 + 64;
    char *buf = (char *)calloc(cap, 1);
    if (!buf) return [NPString stringWithUTF8String:""];
    size_t w = 0, used = 0;
    for (size_t i = 0; src[i]; i++) {
        if (src[i] == '%' && src[i + 1] == '@') {
            NPString *desc = NULL;
            const char *rep = "nil";
            if (used < n && args[used]) {
                desc = [args[used] description];
                rep = [desc UTF8String];
            }
            used++;
            size_t need = strlen(rep) + 3;
            while (w + need + 1 > cap) { cap *= 2; buf = (char *)realloc(buf, cap); }
            buf[w++] = '\'';
            for (size_t k = 0; rep[k]; k++) {
                if (rep[k] == '\'') buf[w++] = '\'';   // quote doubling
                buf[w++] = rep[k];
            }
            buf[w++] = '\'';
            // desc is borrowed (description returns +0) — do not release.
            i++;
        } else {
            if (w + 2 > cap) { cap *= 2; buf = (char *)realloc(buf, cap); }
            buf[w++] = src[i];
        }
    }
    buf[w] = '\0';
    NPString *result = [NPString stringWithUTF8String:buf];
    free(buf);
    return result;
}

- (NPString *)predicateFormat {
    return _format;
}

// valueForKey: — ObjC KVC entry point over the compile-time tables.
- (id)valueForKey:(NPString *)key {
    id v = jeti_kvc_value(self, [key UTF8String]);
    if (!v) {
        fprintf(stderr, "*** NPPredicate: key '%s' is not key-value coding "
                "compliant for the receiver\n", [key UTF8String]);
        abort();
    }
    return v;
}

- (BOOL)evaluateWithObject:(id)object {
    if (_node_count == 0) return NO;
    return pred_eval_idx((jeti_pred_node *)_nodes, (int)_root, object) ? YES : NO;
}

@end

// ─── Static engine (after @end; message sends here lower to vtable
// dispatch, so cross-TU class access is safe) ────────────────────────────────

static int pred_eval_idx(jeti_pred_node *nodes, int idx, id object);

// Leaf → value: LIT payload, or KEY resolved through the KVC tables (dot
// paths chain lookups segment by segment).
static id pred_leaf(jeti_pred_node *nodes, int idx, id object) {
    if (idx < 0) return NULL;
    jeti_pred_node *n = &nodes[idx];
    if (n->tag == 8) return n->val;
    if (n->tag == 7) {
        id cur = object;
        const char *s = n->text;
        while (cur && *s) {
            const char *dot = strchr(s, '.');
            size_t len = dot ? (size_t)(dot - s) : strlen(s);
            char seg[128];
            if (len >= sizeof(seg)) return NULL;
            memcpy(seg, s, len);
            seg[len] = '\0';
            cur = jeti_kvc_value(cur, seg);
            s = dot ? dot + 1 : s + len;
        }
        return cur;
    }
    return NULL;
}

static int pred_is_npnumber(id v) {
    if (!v) return 0;
    return [v isKindOfClass:[NPNumber class]] ? 1 : 0;
}

static int pred_is_npstring(id v) {
    if (!v) return 0;
    return [v isKindOfClass:[NPString class]] ? 1 : 0;
}

static int pred_is_nparray(id v) {
    if (!v) return 0;
    return [v isKindOfClass:[NPArray class]] ? 1 : 0;
}

static double pred_num(id v) {
    return [(NPNumber *)v doubleValue];
}

// Value comparison. Numeric when both sides are NPNumber (or one side is a
// number and the other a numeric string — ObjC coerces); equality via
// isEqual: otherwise; nil only equals nil.
static int pred_compare(id a, id b, int op) {
    if (!a || !b) {
        int eq = (a == b);
        if (op == 0) return eq;
        if (op == 1) return !eq;
        return 0;
    }
    int numeric = (pred_is_npnumber(a) && pred_is_npnumber(b))
        || (pred_is_npnumber(a) && pred_is_npstring(b))
        || (pred_is_npstring(a) && pred_is_npnumber(b));
    if (numeric) {
        double x = pred_is_npnumber(a) ? pred_num(a) : strtod([(NPString *)a UTF8String], NULL);
        double y = pred_is_npnumber(b) ? pred_num(b) : strtod([(NPString *)b UTF8String], NULL);
        switch (op) {
            case 0: return x == y;
            case 1: return x != y;
            case 2: return x <  y;
            case 3: return x <= y;
            case 4: return x >  y;
            case 5: return x >= y;
        }
        return 0;
    }
    // Object path: equality only (ordering of arbitrary objects is undefined,
    // as in ObjC without comparators).
    int eq = [(NPObject *)a isEqual:b] ? 1 : 0;
    if (op == 0) return eq;
    if (op == 1) return !eq;
    return 0;
}

// case-insensitive helpers
static char pred_lc(char c) {
    return (c >= 'A' && c <= 'Z') ? (char)(c - 'A' + 'a') : c;
}
static int pred_streq_ci(const char *a, const char *b) {
    while (*a && *b) {
        if (pred_lc(*a) != pred_lc(*b)) return 0;
        a++; b++;
    }
    return *a == *b;
}
static int pred_has_prefix(const char *s, const char *pre, int ci) {
    size_t n = strlen(pre);
    if (strlen(s) < n) return 0;
    if (!ci) return strncmp(s, pre, n) == 0;
    for (size_t i = 0; i < n; i++) {
        if (pred_lc(s[i]) != pred_lc(pre[i])) return 0;
    }
    return 1;
}
static int pred_contains(const char *s, const char *pat, int ci) {
    if (!*pat) return 1;
    for (; *s; s++) {
        if (ci) {
            size_t k = 0;
            while (pat[k] && s[k] && pred_lc(s[k]) == pred_lc(pat[k])) k++;
            if (!pat[k]) return 1;
        } else if (strncmp(s, pat, strlen(pat)) == 0) {
            return 1;
        }
    }
    return 0;
}

// LIKE wildcards: * any run, ? one char.
static int pred_like(const char *s, const char *pat, int ci) {
    while (*pat) {
        if (*pat == '*') {
            while (*pat == '*') pat++;
            if (!*pat) return 1;
            for (; *s; s++) {
                if (pred_like(s, pat, ci)) return 1;
            }
            return 0;
        }
        if (!*s) return 0;
        if (*pat != '?') {
            if (ci) { if (pred_lc(*s) != pred_lc(*pat)) return 0; }
            else if (*s != *pat) return 0;
        }
        s++; pat++;
    }
    return *s == '\0';
}

// POSIX ERE subset: . * + ? [] [^] ^ $ ( ) |. Full-match backtracking
// matcher. '^' is honored only at the pattern start, '$' only at the end;
// branches and group bodies are copied into fixed 128-byte buffers and
// longer pieces simply fail to match (subset limit).
static int pred_re_seq(const char *re, const char *s, const char *end);

// first top-level '|' (paren depth 0, char classes skipped), or NULL.
static const char *pred_re_top_alt(const char *re) {
    int depth = 0;
    const char *p = re;
    while (*p) {
        if (*p == '[') {
            const char *close = strchr(p, ']');
            if (!close) return NULL;
            p = close + 1;
            continue;
        }
        if (*p == '(') depth++;
        else if (*p == ')') {
            if (depth) depth--;
        } else if (*p == '|' && depth == 0) {
            return p;
        }
        p++;
    }
    return NULL;
}

// position just past the ')' matching the '(' at re, or NULL.
static const char *pred_re_group_end(const char *re) {
    int depth = 0;
    const char *p = re;
    while (*p) {
        if (*p == '[') {
            const char *close = strchr(p, ']');
            if (!close) return NULL;
            p = close + 1;
            continue;
        }
        if (*p == '(') depth++;
        else if (*p == ')') {
            depth--;
            if (depth == 0) return p + 1;
        }
        p++;
    }
    return NULL;
}

// does ONE input char c match the single-char element at re?
static int pred_re_one(const char *re, char c) {
    if (*re == '.') return c != '\0';
    if (*re == '[') {
        const char *close = strchr(re, ']');
        if (!close) return 0;
        int neg = 0;
        const char *p = re + 1;
        if (*p == '^') {
            neg = 1;
            p++;
        }
        int found = 0;
        while (p < close) {
            if (p + 2 < close && p[1] == '-') {
                if (c >= p[0] && c <= p[2]) found = 1;
                p += 3;
            } else {
                if (c == *p) found = 1;
                p++;
            }
        }
        return found != neg;
    }
    return c == *re;
}

// group body repeated zero or more times, then rest matches the remainder.
static int pred_grep(const char *body, const char *rest, const char *s, const char *end) {
    if (pred_re_seq(rest, s, end)) return 1;
    for (int k = 1; k <= (int)(end - s); k++) {
        if (pred_re_seq(body, s, s + k) && pred_grep(body, rest, s + k, end)) return 1;
    }
    return 0;
}

// does re match s[0..end) in full? (backtracking)
static int pred_re_seq(const char *re, const char *s, const char *end) {
    const char *bar = pred_re_top_alt(re);
    if (bar) {
        size_t blen = (size_t)(bar - re);
        char branch[128];
        if (blen >= sizeof(branch)) return 0;
        memcpy(branch, re, blen);
        branch[blen] = '\0';
        if (pred_re_seq(branch, s, end)) return 1;
        return pred_re_seq(bar + 1, s, end);
    }
    if (*re == '\0') return s == end;
    if (*re == '$' && re[1] == '\0') return s == end;
    const char *eend;
    if (*re == '(') {
        eend = pred_re_group_end(re);
        if (!eend) return 0;
        char q = *eend;
        const char *rest = eend;
        if (q == '*' || q == '+' || q == '?') rest = eend + 1;
        size_t blen = (size_t)((eend - 1) - (re + 1));
        char body[128];
        if (blen >= sizeof(body)) return 0;
        memcpy(body, re + 1, blen);
        body[blen] = '\0';
        if (q == '*') return pred_grep(body, rest, s, end);
        if (q == '?') {
            if (pred_re_seq(rest, s, end)) return 1;
        }
        int start = 0;
        if (q == '+') start = 1;
        for (int k = start; k <= (int)(end - s); k++) {
            if (!pred_re_seq(body, s, s + k)) continue;
            if (q == '+') {
                if (pred_grep(body, rest, s + k, end)) return 1;
            } else {
                if (pred_re_seq(rest, s + k, end)) return 1;
            }
        }
        return 0;
    } else if (*re == '[') {
        const char *close = strchr(re, ']');
        if (close) eend = close + 1;
        else eend = re + 1;
    } else {
        eend = re + 1;
    }
    char q = *eend;
    const char *rest = eend;
    int limit = 1;
    int least = 0;
    if (q == '*') {
        limit = (int)(end - s);
        rest = eend + 1;
    } else if (q == '+') {
        limit = (int)(end - s);
        least = 1;
        rest = eend + 1;
    } else if (q == '?') {
        rest = eend + 1;
    } else {
        least = 1;
    }
    for (int k = limit; k >= least; k--) {
        int ok = 1;
        for (int i = 0; i < k; i++) {
            if (!pred_re_one(re, s[i])) {
                ok = 0;
                break;
            }
        }
        if (ok && pred_re_seq(rest, s + k, end)) return 1;
    }
    return 0;
}

// MATCHES entry: full match of s against re (ERE subset).
static int pred_re_match(const char *re, const char *s) {
    if (*re == '^') re++;
    return pred_re_seq(re, s, s + strlen(s));
}

static int pred_matches(const char *re, const char *s, int ci) {
    if (ci) {
        char a[256];
        char b[256];
        size_t i = 0;
        for (; re[i] && i < sizeof(a) - 1; i++) a[i] = pred_lc(re[i]);
        a[i] = '\0';
        for (i = 0; s[i] && i < sizeof(b) - 1; i++) b[i] = pred_lc(s[i]);
        b[i] = '\0';
        return pred_re_match(a, b);
    }
    return pred_re_match(re, s);
}

// STROP (tag 4).
static int pred_strop(jeti_pred_node *nodes, int idx, id object) {
    jeti_pred_node *n = &nodes[idx];
    id l = pred_leaf(nodes, n->a, object);
    id r = pred_leaf(nodes, n->b, object);
    if (!l || !r) return 0;
    if (!pred_is_npstring(l) || !pred_is_npstring(r)) return 0;
    const char *s = [(NPString *)l UTF8String];
    const char *pat = [(NPString *)r UTF8String];
    if (!s || !pat) return 0;
    int ci = n->op & 16;
    switch (n->op & 15) {
        case 0: return pred_has_prefix(s, pat, ci);
        case 1: {
            size_t sl = strlen(s), pl = strlen(pat);
            if (pl > sl) return 0;
            return ci ? pred_streq_ci(s + sl - pl, pat) : strcmp(s + sl - pl, pat) == 0;
        }
        case 2: return pred_contains(s, pat, ci);
        case 3: return pred_like(s, pat, ci);
        case 4: return pred_matches(pat, s, ci);
    }
    return 0;
}

// IN (tag 5): right side is an NPArray (or array literal) — membership via
// value comparison.
static int pred_in(jeti_pred_node *nodes, int idx, id object) {
    jeti_pred_node *n = &nodes[idx];
    id l = pred_leaf(nodes, n->a, object);
    id r = pred_leaf(nodes, n->b, object);
    if (!l || !r || !pred_is_nparray(r)) return 0;
    size_t cnt = [(NPArray *)r count];
    for (size_t i = 0; i < cnt; i++) {
        if (pred_compare(l, [(NPArray *)r objectAtIndex:i], 0)) return 1;
    }
    return 0;
}

// BETWEEN (tag 6): right side is a 2-element array {lo, hi}.
static int pred_between(jeti_pred_node *nodes, int idx, id object) {
    jeti_pred_node *n = &nodes[idx];
    id l = pred_leaf(nodes, n->a, object);
    id r = pred_leaf(nodes, n->b, object);
    if (!l || !r || !pred_is_nparray(r)) return 0;
    if ([(NPArray *)r count] != 2) return 0;
    id lo = [(NPArray *)r objectAtIndex:0];
    id hi = [(NPArray *)r objectAtIndex:1];
    return pred_compare(l, lo, 4) && pred_compare(l, hi, 3);
}

// Quantifier (tag 9) over an NPArray-valued key.
static int pred_quant(jeti_pred_node *nodes, int idx, id object) {
    jeti_pred_node *n = &nodes[idx];
    id coll = pred_leaf(nodes, n->a, object);
    if (!coll || !pred_is_nparray(coll)) return n->op == 2;   // NONE over nil: vacuous
    size_t cnt = [(NPArray *)coll count];
    int any = 0, all = 1;
    for (size_t i = 0; i < cnt; i++) {
        if (pred_eval_idx(nodes, n->b, [(NPArray *)coll objectAtIndex:i])) any = 1;
        else all = 0;
    }
    if (n->op == 0) return any;
    if (n->op == 1) return all && cnt > 0;
    return !any;
}

static int pred_eval_idx(jeti_pred_node *nodes, int idx, id object) {
    if (idx < 0) return 0;
    jeti_pred_node *n = &nodes[idx];
    switch (n->tag) {
        case 0: return pred_eval_idx(nodes, n->a, object) && pred_eval_idx(nodes, n->b, object);
        case 1: return pred_eval_idx(nodes, n->a, object) || pred_eval_idx(nodes, n->b, object);
        case 2: return !pred_eval_idx(nodes, n->a, object);
        case 3: {
            id l = pred_leaf(nodes, n->a, object);
            id r = pred_leaf(nodes, n->b, object);
            return pred_compare(l, r, n->op);
        }
        case 4: return pred_strop(nodes, idx, object);
        case 5: return pred_in(nodes, idx, object);
        case 6: return pred_between(nodes, idx, object);
        case 9: return pred_quant(nodes, idx, object);
        default: return 0;
    }
}
