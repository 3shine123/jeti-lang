// full_syntax_test.jeti —— Jeti 全部已实现语法汇测（单文件，一测全量）
//
// 覆盖：C 超集基础 / 类·继承·协议·命名空间·泛型·容器·variadic / 表达式全家
//       控制流（for-in·switch 模式） / 运行时块（try·synchronized·pool·defer·noarc·weak）
//       nullability 全位 / throws(裸拼写)·async throws / 消息内括号 await / 内联 asm / Foundation 走查
//
// 配套 tests/full_syntax_test.s（ARM64 外部汇编，test_all 自动链接同名 .s）。
// 预期：exit=0，输出确定（无地址/无时序依赖）。
#import <Foundation/Foundation.hje>
#include <stdio.h>
#include <stdarg.h>
#include <string.h>
#include <time.h>

// ═══════════════════════════════════════════════════════════════════
// §1  C 超集基础：struct/union/enum/typedef/fnptr/设计初始化/宏/typeof
// ═══════════════════════════════════════════════════════════════════

// 宏与 #pragma mark（原位透传）
#define FSQ_MAX(a, b)        ((a) > (b) ? (a) : (b))
#define FSQ_NAME             "full-syntax"
#pragma mark - §1 C superset

// 依赖拓扑：Inner 定义在 Outer 之前声明使用（曾因定义落在用户之后报 incomplete type）
struct FsInner { int a; int b; };
typedef struct FsOuterTag FsOuterAlias;          // tag 仅前向
struct FsOuterTag { struct FsInner i; int tag; };

// 函数指针字段、多维数组字段、位域（宽度按 C 语义近似——保留解析）
// 字段名不能用 `id`（ObjC 类型关键字）；`in` 是上下文关键词，可作字段名
struct FsWidget {
    int wid;
    int (*cb)(int);            // fnptr 字段
    int cells[2][3];           // 多维数组字段
    unsigned flags : 3;        // 位域
    int in;
};
typedef int FsRow4[4];                          // typedef 数组
union FsMix { int i; float f; char bytes[4]; }; // union（tag 与 struct 区分）

// enum + enum switch：typedef 带体形态（tag+别名同名的前向形态不被支持）
typedef enum FsMode {
    FS_MODE_OFF = 0, FS_MODE_LOW = 1, FS_MODE_HIGH = 2
} FsMode;                                       // enum 参数位用真实 tag（曾误发 struct）

// __attribute__：packed / aligned / unused / format
struct FsPacked { char c; int v; } __attribute__((packed));
static int fs_format_fn(const char *fmt, ...) __attribute__((format(printf, 1, 2)));

// extern 汇编符号（tests/full_syntax_test.s，ARM64）
extern int fs_asm_square(int x);
extern int fs_asm_add3(int a, int b, int c);

// struct 值比较目标（checker 改写为 jeti_struct_eq_*）
struct FsPoint { int x; int y; };
typedef struct FsPoint FsPointT;                // 别名形态也做 ==（struct_alias_tags）

// 顶层 __asm__ 声明：原样透传（.section 指令形态）
__asm__(".text\n");

static int fs_double_it(int v) { return v * 2; }

static int fs_format_fn(const char *fmt, ...) {
    va_list ap;
    va_start(ap, fmt);
    int n = vprintf(fmt, ap);
    va_end(ap);
    return n;
}

static void sec1_c_superset(void) {
    printf("== §1 C superset ==\n");

    // 逗号声明符列表：指针逐声明符重放（曾解析失败）
    int x1 = 10, x2 = 20;
    int *pa = &x1, *pb = &x2;
    (*pa)++;                    // 后置 ++ 的括号包裹（*p++ 曾被 C 误读）
    ++*pb;
    printf("1.1 ptrs %d %d\n", *pa, *pb);

    // 逗号声明符 + 函数指针类型：T (*name)(params)
    int (*fp)(int) = fs_double_it;
    printf("1.2 fnptr %d\n", fp(21));

    // C 风格强转：struct 指针 / void* / fnptr
    struct FsWidget w;
    memset(&w, 0, sizeof(w));
    void *vp = &w;
    struct FsWidget *wp = (struct FsWidget *)vp;
    wp->wid = 7;
    printf("1.3 cast %d\n", ((struct FsWidget *)vp)->wid);

    // struct 定义 + 字段走查（多维数组、位域、`in` 字段）
    // struct 成员 fn-ptr 直接调用（w.cb(3)）——C 超集成员调用，原别名中转 workaround 已随修废除
    w.cb = fs_double_it;
    w.cells[0][0] = 1; w.cells[0][1] = 2; w.cells[1][2] = 5;
    w.flags = 5;
    w.in = 99;
    printf("1.4 widget %d %d %d %d %d\n", w.cb(3), w.cells[1][2], (int)w.flags, w.in, wp->wid);

    // typedef 数组
    FsRow4 row = { 1, 2, 3, 4 };
    printf("1.5 row4 %d\n", row[0] + row[3]);

    // union
    union FsMix m;
    m.i = 0x40490FDB;           // 3.14159f 的位型
    printf("1.6 union %.2f\n", (double)m.f);

    // enum + switch
    FsMode mode = FS_MODE_HIGH;
    const char *ms = "?";
    switch (mode) {
        case FS_MODE_OFF:  ms = "off"; break;
        case FS_MODE_LOW:  ms = "low"; break;
        case FS_MODE_HIGH: ms = "high"; break;
    }
    printf("1.7 enum %s(%d)\n", ms, (int)mode);

    // 设计初始化器 6 形态
    struct FsPoint p1 = { .x = 1, .y = 2 };                 // ① 完整指定
    struct FsPoint p2 = { .y = 5 };                         // ② 部分+零填充
    struct FsPoint p3 = { .x = 1, 7 };                      // ③ 位置+指定混合
    FsOuterAlias o = { .i.a = 3, .tag = 9 };                // ⑥ 嵌套成员路径
    struct FsPoint pts[3] = { [0].x = 4, [2].y = 6 };       // ⑤ 数组元素指定
    printf("1.8 desig %d %d %d %d %d\n", p1.x + p1.y, p2.y, p3.y, o.tag + o.i.a, pts[2].y);

    // ④ 复合字面量 + 指定（cast 后跟 {）
    struct FsPoint p4 = (struct FsPoint){ .x = 8, .y = 9 };
    printf("1.9 compound %d\n", p4.x * p4.y);

    // struct == / != 值比较（复用 C 运算符，checker 改写；指针比较语义不受影响）
    struct FsPoint a = { 1, 2 }, b = { 1, 2 }, c = { 1, 3 };
    FsPointT t1 = { 2, 3 }, t2 = { 2, 3 };
    printf("1.10 eq %d %d %d\n", a == b, a != c, t1 == t2);
    printf("1.11 ptreq %d\n", (void *)&a == (void *)&a);

    // goto / C 标签语句（asm goto 的前提）
    int hits = 0, pass = 0;
    for (int i = 0; i < 3; i++) {
        if (i == 1) goto skip;
        hits++;
    skip:;
        pass++;
    }
    printf("1.12 goto %d %d\n", hits, pass);

    // __typeof__ / __alignof__ / builtin
    __typeof__(x1) same = 77;
    unsigned ali = __alignof__(int);
    int expect = __builtin_expect(x1 > 5, 1);
    int compat = __builtin_types_compatible_p(__typeof__(same), int);
    printf("1.13 typeof %d %u %d %d\n", same, ali, expect, compat);

    // __attribute__((packed)) 生效（1 + 4 = 5，对齐被压掉）
    printf("1.14 packed %zu\n", sizeof(struct FsPacked));

    // for 头逗号声明列表（一个声明、一个类型）
    int acc = 0;
    for (int i = 0, j = 6; i < j; i++, j--) { acc += i + j; }
    printf("1.15 forcomma %d\n", acc);

    // 宏 + format attribute 函数
    printf("1.16 macro %d %s\n", FSQ_MAX(3, FSQ_MAX(4, 2)), FSQ_NAME);
    fs_format_fn("1.17 vfn %d %d\n", 1, 2);

    // xx_t 类型（POSIX typedef 识别）
    clock_t t0 = clock();
    time_t tt = 0;
    printf("1.18 xx_t %d\n", (int)(t0 >= (clock_t)0) + (int)(tt == 0));

    // 外部汇编（tests/full_syntax_test.s）
    printf("1.19 asm %d %d\n", fs_asm_square(9), fs_asm_add3(1, 2, 3));

    // `in` 作标识符（上下文关键词，不进 KW_TABLE）
    int in = 5;
    struct FsWidget in_w;
    in_w.in = in * 2;
    printf("1.20 in %d %d\n", in, in_w.in);

    // 1.21 类型强转表达式：浮点截断 / 符号重解释 / fnptr 强转
    double fs_cd = 3.9;
    long fs_cl = (long)fs_cd;                   // 截断取整 → 3
    unsigned fs_cu = (unsigned)(fs_cd * 10.0);  // 39 → 39
    int (*fs_cfp)(int) = (int (*)(int))fs_double_it;
    printf("1.21 castx %ld %u %d\n", fs_cl, fs_cu, fs_cfp(30));

    // 1.22 故意触发的类型强转警告用例（两边同源：看各自 clang 是否都报）
    //   变量 int → char *：-Wint-to-pointer-cast（默认开；字面量 int→指针 clang 特判不报）
    //   void * → (int)：-Wvoid-pointer-to-int-cast（默认开）
    //   int * → (int)：-Wpointer-to-int-cast（默认开）
    // 运行时安全：只判非空不 deref，输出确定
    int fs_i2p = 123;
    char *fs_badp1 = (char *)123;           // 探针证实：无警告（字面量特判）
    char *fs_badp2 = (char *)fs_i2p;        // 有警告
    void *fs_vp = (void *)&fs_i2p;
    int fs_addr = (int)(void *)fs_vp;       // 有警告（经 void * 中转）
    int fs_addr2 = (int)&fs_i2p;            // 有警告：-Wpointer-to-int-cast
    printf("1.22 castwarn %d %d %d %d\n", fs_badp1 != NULL, fs_badp2 != NULL, fs_addr != 0, fs_addr2 != 0);
}

// ═══════════════════════════════════════════════════════════════════
// §2  类 / 继承 / 协议 / 命名空间 / 泛型 / 容器 / 分发三件套 / variadic
// ═══════════════════════════════════════════════════════════════════

// 协议：required + optional + 父协议链（Colored < Drawable）
@protocol FsDrawable
- (void)draw;
@end

@protocol FsColored <FsDrawable>
@required
- (int)color;
@optional
- (void)decorate;
@end

// @class 前向声明：先声明、后定义、再使用（曾因 elaborator 丢弃报 unknown type）
@class FsForwardUser;

// —— FsForwardUser 的真定义（对上面的 @class 兑现）——
@interface FsForwardUser : NPObject
- (int)poke;
@end

@implementation FsForwardUser
- (int)poke { return 7; }
@end

// 泛型类（monomorphization：Box<T> 按使用点特化）
@interface FsBox<T> : NPObject {
@public
    T _value;
}
- (FsBox *)initWith:(T)v;
- (T)value;
- (void)setValue:(T)v;
@end

@implementation FsBox<T>
- (FsBox *)initWith:(T)v {
    self = [super init];
    if (self) { _value = v; }
    return self;
}
- (T)value { return _value; }
- (void)setValue:(T)v { _value = v; }
@end

// 命名空间：类 + 跨命名空间继承 + @using 短名
@namespace FsEngine

@interface FsRenderable : NPObject
- (int)render;
@end

@implementation FsRenderable
- (int)render { return 1; }
@end

@protocol FsNode <FsDrawable>
- (int)nodeId;
@end

@endnamespace

// @using 短名导入 + 冲突检测的前提（此处无冲突）
@using FsEngine;

// 跨命名空间继承（Engine::Renderable 形态）
@interface FsSprite : FsEngine::FsRenderable <FsColored> {
@public
    int _id;
}
@property (nonatomic, copy, nullable) NPString *label;   // 属性位 nullability
@property (nonatomic, nonnull) NPString *tag;
- (FsSprite *)initWithId:(int)i;
- (int)sum:(int)first, ...;                              // variadic 继承目标
+ (int)classSum:(int)first, ...;                         // 类方法 variadic
@end

@implementation FsSprite
@synthesize label;
@synthesize tag;

- (FsSprite *)initWithId:(int)i {
    self = [super init];
    if (self) { _id = i; }
    return self;
}
- (void)draw { printf("2.x draw sprite\n"); }            // FsDrawable 经 FsColored 传入
- (int)color { return 0x00FF00; }
- (int)render {
    // super 调用：沿 vtable 槽位调父类实现
    return 10 + [super render];
}
- (int)sum:(int)first, ... {
    va_list ap;
    va_start(ap, first);
    int total = first;
    int v;
    while ((v = va_arg(ap, int)) != 0) { total += v; }
    va_end(ap);
    return total;
}
+ (int)classSum:(int)first, ... {
    va_list ap;
    va_start(ap, first);
    int total = first;
    for (int i = 0; i < 2; i++) { total += va_arg(ap, int); }
    va_end(ap);
    return total;
}
@end

// 泛型容器特化（typed container：objectAtIndex: 返回元素类型）
@interface FsTypedStore : NPObject
- (void)run;
@end

@implementation FsTypedStore
- (void)run {
    NPMutableArray<NPString *> *arr = [NPMutableArray array];
    [arr addObject:@"one"];
    [arr addObject:@"two"];
    // typed read：元素类型流经（泛型真检查），下标改写 a[0] → [a objectAtIndex:0]
    NPString *s0 = [arr objectAtIndex:0];
    NPString *s1 = arr[1];
    printf("2.6 typed %s %s %zu\n", [s0 UTF8String], [s1 UTF8String], [arr count]);

    // 泛型类特化：FsBox<NPMutableString *>（嵌套泛型）
    // initWith 收 const char *（裸 C 串）——传 @"..." 对象当 C 串读会出垃圾
    FsBox<NPMutableString *> *box = [[FsBox alloc] initWith:[NPMutableString stringWithUTF8String:"boxed"]];
    printf("2.7 box %s\n", [[box value] UTF8String]);
    [box setValue:[NPMutableString stringWithUTF8String:"reboxed"]];
    printf("2.8 box %s\n", [[box value] UTF8String]);
}
@end

static void sec2_objects(void) {
    printf("== §2 objects ==\n");

    // 2.1 继承 + super + 协议一致性（required 全实现，optional 不实现也合法）
    FsSprite *sp = [[FsSprite alloc] initWithId:42];
    printf("2.1 render %d color %d\n", [sp render], [sp color]);
    [sp draw];

    // 2.2 属性：合成 getter/setter + nullable/nonnull 属性位
    sp.label = nil;
    sp.tag = @"t";
    printf("2.2 prop %s %s\n", sp.label ? "n" : "nil", [sp.tag UTF8String]);

    // 2.3 分发三件套：isKindOfClass:（isa 链）/ respondsToSelector:（vtable 槽位）/ isEqual:（root 指针身份）
    BOOL kind = [sp isKindOfClass:[FsSprite class]];
    BOOL kindSuper = [sp isKindOfClass:[FsEngine::FsRenderable class]];
    BOOL resp = [sp respondsToSelector:@selector(color)];
    BOOL respMissing = [sp respondsToSelector:@selector(decorate)];
    BOOL eqSelf = [sp isEqual:sp];
    BOOL eqOther = [sp isEqual:([[FsSprite alloc] initWithId:42])];
    printf("2.3 dispatch %d %d %d %d %d %d\n", kind, kindSuper, resp, respMissing, eqSelf, eqOther);

    // 2.4 variadic 方法：单段 + 类方法 + 继承（子类沿 vtable 槽位调父类 variadic）
    printf("2.4 variadic %d %d\n", [sp sum:1, 2, 3, 0], [FsSprite classSum:10, 20, 0]);

    // 2.5 命名空间内类 + @using 短名
    FsEngine::FsRenderable *r = [[FsEngine::FsRenderable alloc] init];
    printf("2.5 ns %d\n", [r render]);

    // 2.5b @class 前向声明 + 后置定义的使用
    FsForwardUser *fu = [[FsForwardUser alloc] init];
    printf("2.5b fwd %d\n", [fu poke]);

    // 2.6/2.7/2.8 容器 + 泛型
    FsTypedStore *store = [[FsTypedStore alloc] init];
    [store run];

    // 2.9 [[self class] alloc] 运行期类派发 + id 万能型 + @public ivar 访问
    id asId = sp;
    FsSprite *back = (FsSprite *)asId;
    printf("2.9 id %d\n", back->_id);

    // 2.10 消息发送 nil 安全（nil 守卫：返回 0/nil，不崩）
    FsSprite *nilsp = nil;
    printf("2.10 nilmsg %d %d\n", [nilsp render], [nilsp respondsToSelector:@selector(color)]);
}

// ═══════════════════════════════════════════════════════════════════
// §3  表达式全家：装箱字面量 / 容器字面量 / block / @selector / 运算符
// ═══════════════════════════════════════════════════════════════════

// block typedef（作参数类型 + __block 捕获目标）
typedef int (^FsIntBlock)(int, int);

static int fs_call_block(FsIntBlock b, int x, int y) { return b(x, y); }

static void sec3_expressions(void) {
    printf("== §3 expressions ==\n");
    FsSprite *sp = [[FsSprite alloc] initWithId:3];

    // 3.1 装箱字面量：@int / @double / @YES @NO / @'c' / @(expr)
    NPNumber *ni = @42;
    NPNumber *nd = @1.5;
    NPNumber *nb = @YES;
    NPNumber *nc = @'A';
    int xv = 20;
    NPNumber *ne = @(xv * 2 + 1);
    printf("3.1 box %d %.1f %d %d %d\n",
           [ni intValue], [nd doubleValue], [nb boolValue], [nc charValue], [ne intValue]);

    // 3.2 数组字面量 @[...]（装箱元素同型 → 推断 NPArray<NPNumber *>）
    NPArray *nums = @[ @1, @2, @3 ];
    NPNumber *head = (NPNumber *)[nums objectAtIndex:0];   // 强转紧跟消息发送（曾误记不支持）
    printf("3.2 arr %zu %d\n", [nums count], [head intValue]);

    // 3.3 字典字面量 @{}：多对（值的 parse 层曾吃逗号炸掉）+ 空字典
    NPDictionary *d = @{ @"a": @1, @"b": @(xv), @"c": @"cee" };
    NPDictionary *empty = @{};
    NPNumber *dv = [d objectForKey:@"b"];
    NPString *dc = [d objectForKey:@"c"];
    printf("3.3 dict %zu %zu %d %s\n",
           [d count], [empty count], [dv intValue], [dc UTF8String]);

    // 3.4 可变数组全家 + 下标读写改写（ma[0] → setObject:atIndex:/objectAtIndex:）
    // 字符串字面量已 interning（同内容同对象）：containsObject:/indexOfObject:
    // 可直接用字面量查询（指针相等成立，原"必须同一变量"约束已随修废除）
    NPMutableArray *ma = [NPMutableArray arrayWithCapacity:4];
    NPString *z = @"z";
    [ma addObject:@"x"];
    [ma insertObject:@"y" atIndex:0];
    [ma replaceObjectAtIndex:1 withObject:z];
    BOOL has = [ma containsObject:@"z"];        // interning：字面量直查命中
    int idx = (int)[ma indexOfObject:@"z"];     // 同上
    [ma removeObjectAtIndex:0];
    ma[0] = @"w";                       // 写侧下标改写
    NPString *m0 = ma[0];               // 读侧下标改写
    printf("3.4 marr %d %d %s\n", has, idx, [m0 UTF8String]);

    // 3.5 可变字典：插入-值语义替换-删除 + allKeys
    NPMutableDictionary *md = [NPMutableDictionary dictionary];
    [md setObject:@1 forKey:@"k1"];
    [md setObject:@2 forKey:@"k2"];
    [md setObject:@9 forKey:@"k1"];     // isEqual: 值语义 → 替换而非追加
    NPArray *keys = [md allKeys];
    [md removeObjectForKey:@"k2"];
    printf("3.5 mdict %zu %zu %d\n", [keys count], [md count], [[md objectForKey:@"k1"] intValue]);

    // 3.6 block：字面量 / 返回类型推断（曾硬编码 ^void）/ __block 捕获改写 / 传参
    FsIntBlock mul = ^int(int a, int b) { return a * b; };
    FsIntBlock add = ^(int a, int b) { return a + b; };     // 推断 int
    __block int counter = 0;
    void (^bump)(void) = ^{ counter++; };                    // __block 捕获可变
    bump(); bump(); bump();
    printf("3.6 block %d %d %d\n", mul(6, 7), add(2, 3), counter);
    printf("3.7 blockarg %d\n", fs_call_block(mul, 5, 6));

    // 3.8 @selector：SEL 是 struct（不能 ==/!= 比较）；respondsToSelector 用字面量
    // poke 不在 FsSprite 的 vtable → 常量 0；color 在 → 1
    SEL s1 = @selector(poke);
    (void)s1;
    printf("3.8 sel %d %d\n",
           [sp respondsToSelector:@selector(poke)],
           [sp respondsToSelector:@selector(color)]);

    // 3.9 字符串全家：拼接 / 值相等 / 长度 / description
    NPString *base = [NPString stringWithUTF8String:"jeti"];
    NPString *joined = [base stringByAppendingString:@"-full"];
    BOOL eq = [joined isEqualToString:@"jeti-full"];
    NPString *desc = [joined description];
    printf("3.9 str %s %d %zu %s\n", [joined UTF8String], eq, [joined length], [desc UTF8String]);

    // 3.10 NPMutableString 追加链（构造收 C 串；appendString: 收对象——探针已证）
    NPMutableString *mstr = [NPMutableString stringWithUTF8String:"a"];
    [mstr appendString:@"b"];
    [mstr appendString:@"c"];
    printf("3.10 mstr %s %zu\n", [mstr UTF8String], [mstr length]);

    // 3.11 嵌套消息发送作实参（variadic 嵌套形态）
    printf("3.11 nested %d\n", [sp sum:[sp sum:1, 2, 0], 10, 0]);

    // 3.12 复合赋值 / 位 / 移位 / 逻辑短路 / 三目 / 逗号运算符 / sizeof
    int bits = 0xF0;
    bits |= 0x0F; bits &= 0x3C; bits ^= 0xFF; bits <<= 2; bits >>= 1;
    int zero = 0;
    int shortcir = (zero != 0) && (10 / zero > 0);           // 短路防除零
    int tern = (bits > 100) ? bits : -bits;
    int comma = (zero = 3, zero * 2);
    printf("3.12 ops %d %d %d %d %zu\n", bits, shortcir, tern, comma, sizeof(struct FsPoint));

    // 3.13 前后置 ++/--：值/指针解引用（(*p)-- 曾被 C 误读为 *(p--)）
    int post = 5;
    int po = post++;
    int pr = --post;
    int *pip = &post;
    (*pip)--;
    printf("3.13 incdec %d %d %d\n", po, pr, post);

    // 3.14 Class 运行期身份：[obj class] 特判（直接读 isa）
    Class cls = [FsSprite class];
    printf("3.14 class %d %d\n", cls == [FsSprite class], [sp class] == cls);

    // 3.15 NPLog %@ 展开（对象 → description → %s）
    NPLog(@"3.15 nplog %@ %d", joined, 7);
}

// ═══════════════════════════════════════════════════════════════════
// §4  控制流 + 运行时块：for-in / switch 模式 / try / synchronized /
//     autoreleasepool / defer / noarc / weak
// ═══════════════════════════════════════════════════════════════════

// typed catch 链的两个异常类（类型不同 → isa 依次匹配）
@interface FsErrLow : NPObject
@end
@implementation FsErrLow
@end

@interface FsErrHigh : FsErrLow
@end
@implementation FsErrHigh
@end

static void sec4_control_runtime(void) {
    printf("== §4 control/runtime ==\n");

    // 4.1 for-in：NPArray 遍历（desugar：集合只求值一次，元素借用零 ARC 注入）
    NPArray *arr = @[ @"aa", @"bb", @"cc" ];
    int seen = 0;
    NPString *last = nil;
    for (NPString *item in arr) {
        seen++;
        last = item;
    }
    printf("4.1 forin %d %s\n", seen, [last UTF8String]);

    // 4.2 嵌套 for-in + 空数组（体不执行）
    NPArray *outer = @[ @1, @2 ];
    int pairs = 0;
    for (NPNumber *o in outer) {
        for (NPString *i in arr) { pairs++; }
    }
    NPArray *empty = @[];
    int empt = 0;
    for (NPString *i in empty) { empt++; }
    printf("4.2 nest %d %d\n", pairs, empt);

    // 4.3 while / do-while / continue
    int w = 0, dw = 0, cont = 0;
    while (w < 3) { w++; }
    do { dw++; } while (dw < 4);
    for (int i = 0; i < 6; i++) {
        if (i % 2 == 0) continue;
        cont += i;
    }
    printf("4.3 loops %d %d %d\n", w, dw, cont);

    // 4.4 switch 模式匹配 M1：Bind 臂（isKindOfClass:）+ default + break
    NPObject *subj = [[FsSprite alloc] initWithId:5];
    int t1 = 0;
    switch (subj) {
        case FsErrHigh *e:
            t1 = 1;
            break;
        case FsSprite *s:
            t1 = 2;                    // 命中：臂内 s 已绑定并强转
            break;
        default:
            t1 = 9;
            break;
    }
    printf("4.4 pat-bind %d\n", t1);

    // 4.5 对象字面量臂（isEqual: 值语义）
    NPString *sv = @"hit";
    int t2 = 0;
    switch (sv) {
        case @"no":
            t2 = 1;
            break;
        case @"hit":
            t2 = 2;
            break;
        default:
            t2 = 9;
            break;
    }
    printf("4.5 pat-lit %d\n", t2);

    // 4.6 悬空比较臂（首个命中臂生效）+ when 守卫（上下文关键词）+ 多值常量
    int n = 42;
    int t3 = 0;
    switch (n) {
        case > 100:
            t3 = 1;
            break;
        case > 10:
            t3 = 2;
            break;
        default:
            t3 = 3;
    }
    int t4 = 0;
    switch (n) {
        case 7:
            t4 = 1;
            break;
        case 40, 41, 42, 43:           // 多值常量（逗号，曾发成 case (1,2,3)）
            t4 = 2;
            break;
        default:
            t4 = 3;
    }
    int t5 = 0;
    switch (subj) {
        case FsSprite *s when s->_id == 999:
            t5 = 1;
            break;
        case FsSprite *s when s->_id == 5:
            t5 = 2;                    // when 守卫：守卫不过 → 落下一臂
            break;
        default:
            t5 = 9;
            break;
    }
    printf("4.6 pat-cond %d %d %d\n", t3, t4, t5);

    // 4.7 switch 内嵌套循环的 break 绑定循环（非 switch）
    int t6 = 0;
    switch (n) {
        case > 0:
            for (int i = 0; i < 5; i++) {
                if (i == 3) break;     // 只退循环
                t6++;
            }
            t6 += 100;
            break;
        default:
            t6 = -1;
    }
    printf("4.7 pat-loopbreak %d\n", t6);

    // 4.8 @try/@catch（typed 链）/ @finally 恒执行
    // typed @catch 是 isKindOf 链（ObjC 语义，精确 isa 匹配偏差已修）：
    // 父类臂接住子类实例；第一个匹配臂消费异常（后臂不重复执行）。
    int order = 0;
    @try {
        order += 1;
        @throw [[FsErrHigh alloc] init];
        order += 100;                  // 不可达
    }
    @catch (FsErrLow *e) {
        order += 10;                   // 父类臂 isKindOf 命中子类实例
    }
    @catch (FsErrHigh *e) {
        order += 20;                   // 不可达（第一臂已消费，防双捕）
    }
    @finally {
        order += 200;
    }
    printf("4.8 try %d\n", order);     // 1 + 10 + 200 = 211

    // 4.9 嵌套 @try：内层未捕获 → 内层 @finally 先跑 → 外层捕获
    int trace = 0;
    @try {
        @try {
            @throw [[FsErrLow alloc] init];
        }
        @finally {
            trace += 1;                // 内层 finally 先执行
        }
    }
    @catch (FsErrLow *e) {
        trace += 10;
    }
    printf("4.9 nest %d\n", trace);

    // 4.10 catch 内重抛 → 传播到外层（jmp_buf 已恢复父级，不会重入本帧）
    int rethrown = 0;
    @try {
        @try {
            @throw [[FsErrLow alloc] init];
        }
        @catch (FsErrLow *e) {
            rethrown = 1;
            @throw e;                  // 重抛
        }
    }
    @catch (FsErrLow *e) {
        rethrown += 10;
    }
    printf("4.10 rethrow %d\n", rethrown);

    // 4.11 @synchronized（真互斥块：jeti_syncLock + cleanup 解锁）
    FsSprite *lock = [[FsSprite alloc] initWithId:1];
    int guarded = 0;
    @synchronized (lock) {
        guarded += 5;
    }
    printf("4.11 sync %d\n", guarded);

    // 4.12 @autoreleasepool：嵌套池（pop 只结算本池对象）
    int pooled = 0;
    @autoreleasepool {
        NPString *p1 = [NPString stringWithUTF8String:"pool1"];
        @autoreleasepool {
            NPString *p2 = [NPString stringWithUTF8String:"pool2"];
            pooled += [p2 length];
        }
        pooled += [p1 length];
    }
    printf("4.12 pool %d\n", pooled);

    // 4.13 @defer：LIFO + 提前 return 触发 + 循环体每轮执行
    int defer_log = 0;
    {
        @defer { defer_log += 1; }     // 后注册 → 先执行
        @defer { defer_log += 10; }
        defer_log += 100;
    }                                   // 块出口：LIFO → +10 → +1
    printf("4.13 defer %d\n", defer_log);

    int defer_loop = 0;
    for (int i = 0; i < 3; i++) {
        @defer { defer_loop += 1; }    // 每轮迭代结束执行
        defer_loop += 10;
    }
    printf("4.14 deferloop %d\n", defer_loop);

    // 4.15 @noarc：块内手动管理，计数平衡（alloc=1 → retain=2 → release×2 → 0）
    @noarc {
        NPObject *owned = [[NPObject alloc] init];
        [owned retain];
        [owned release];
        [owned release];
    }
    printf("4.15 noarc ok\n");

    // 4.16 __weak：置 nil 源对象后 weak 引用清零（zeroing weak）
    // 源对象须是 owned（alloc+init = +1，ARC 作用域尾注入 release → dealloc →
    // weakClearAll 槽位清零）；便利构造器返回 autoreleased 对象不会销毁，
    // 验证不了 zeroing。赋值路径走 unregister→assign→register 重注册。
    __weak NPString *weakref = nil;
    {
        NPString *strong = [[NPString alloc] initWithUTF8String:"weak-target"];
        weakref = strong;
        printf("4.16 weak %d\n", weakref != nil);
    }
    printf("4.17 weakzero %d\n", weakref == nil);
}

// ═══════════════════════════════════════════════════════════════════
// §5  nullability 全位 / throws / await / 内联 asm / Foundation 走查
// ═══════════════════════════════════════════════════════════════════

// NP_ASSUME_NONNULL 区域：真语法非宏；未标注指针 → nonnull，nullable 显式退出
NP_ASSUME_NONNULL_BEGIN
@interface FsGuarded : NPObject {
@public
    NPString *inRegion;                 // ivar 位：区域内默认 nonnull
    nullable NPString *optIvar;         // ivar 位显式 nullable
}
- (void)take:(NPString *)s;             // 参数位：区域默认 nonnull
- (void)optOut:(nullable NPString *)s;  // 区域内显式退出
- (NPString *)produce;                  // 返回位：区域默认 nonnull
@end
NP_ASSUME_NONNULL_END

@implementation FsGuarded
- (void)take:(NPString *)s { printf("5.1 region take %s\n", [s UTF8String]); }
- (void)optOut:(nullable NPString *)s { printf("5.2 opt %s\n", s ? [s UTF8String] : "(nil)"); }
- (NPString *)produce { return @"made"; }
@end

// 区域外：未标注 → unspecified（渐进采用，两种拼写都接受）
@interface FsAnnotated : NPObject
- (void)pre:(nonnull NPString *)a post:(NPString * _Nonnull)b;
- (nullable NPString *)maybe;
- (NPString * _Nullable)maybeC;
@end

@implementation FsAnnotated
- (void)pre:(nonnull NPString *)a post:(NPString * _Nonnull)b {
    printf("5.3 anno %s %s\n", [a UTF8String], [b UTF8String]);
}
- (nullable NPString *)maybe { return nil; }
- (NPString * _Nullable)maybeC { return @"c"; }
@end

// 顶层函数：返回位 + 参数位注解
static nullable NPString *fs_maybe_fn(void) { return nil; }
static void fs_take_fn(nonnull NPString *s) { printf("5.4 fn %s\n", [s UTF8String]); }

// enum 参数（真实 tag 关键字——曾误发 struct）+ struct 按值传参
@interface FsModes : NPObject
- (int)mix:(FsMode)m point:(struct FsPoint)p;
@end
@implementation FsModes
- (int)mix:(FsMode)m point:(struct FsPoint)p {
    return (int)m + p.x * 10 + p.y;
}
@end

// throws：声明标注（尾置、`;`/`{` 之前）——语句位是 @throw
@interface FsParser : NPObject
- (int)strictParse:(NPString *)s throws(FsErrLow *);   // 带类型
- (int)looseParse:(NPString *)s throws;                 // 裸标注（体内必须真抛）
@end

@implementation FsParser
- (int)strictParse:(NPString *)s throws(FsErrLow *) {
    if ([s length] > 3) {
        @throw [[FsErrLow alloc] init];                  // 类型与声明一致
    }
    return [s length];
}
- (int)looseParse:(NPString *)s throws {
    if (s == nil) {
        @throw [[FsErrLow alloc] init];
    }
    return 0;
}
@end

// await / async 软关键字：async 修饰符是签名一部分（头文件可见）；入口 = async void 方法
// 被同步上下文调用 → 自动 blocking wrapper（体内泵调度器），main 照常调用
@interface FsFetcher : NPObject
- (async int)compute:(int)n;                             // async 修饰符 + 体内 await
- (int)helper:(int)n;                                    // 纯同步（无修饰符无 await）
+ (async void)runAll;                                    // 入口（类方法 async void）
@end

@implementation FsFetcher
- (int)helper:(int)n { return n + 1; }
- (async int)compute:(int)n {
    int a = [self helper:n];                             // 同步调用（await 打在非 async 操作数上是 rule 6 警告）
    return a * 2;
}
+ (async void)runAll {
    FsFetcher *f = [[FsFetcher alloc] init];
    int x = await [f compute:20];                        // 跨方法 await 链
    printf("5.7 async %d\n", x);
}
@end

static void sec5_misc(void) {
    printf("== §5 nullability/throws/async/asm ==\n");

    // 5.1–5.2 区域默认 + 显式退出
    FsGuarded *g = [[FsGuarded alloc] init];
    [g take:@"region"];
    [g optOut:nil];
    printf("5.2b produce %s\n", [[g produce] UTF8String]);
    g->inRegion = @"ivar";
    g->optIvar = nil;
    printf("5.2c ivar %s %d\n", [g->inRegion UTF8String], g->optIvar == nil);

    // 5.3–5.4 区域外两种拼写 + 函数位
    FsAnnotated *a = [[FsAnnotated alloc] init];
    [a pre:@"x" post:@"y"];
    printf("5.4b fns %d %s\n", [a maybe] == nil, [[a maybeC] UTF8String]);
    fs_take_fn(@"fnarg");
    printf("5.4c fnret %d\n", fs_maybe_fn() == nil);

    // 5.5 enum 参数 + struct 按值
    FsModes *mo = [[FsModes alloc] init];
    struct FsPoint pp = { 1, 2 };
    printf("5.5 mix %d\n", [mo mix:FS_MODE_LOW point:pp]);

    // 5.6 throws 声明对账：两形态都真抛 + 调用方捕获
    FsParser *ps = [[FsParser alloc] init];
    int caught = 0;
    @try {
        [ps strictParse:@"toolong"];
    }
    @catch (FsErrLow *e) { caught += 1; }
    @try {
        [ps looseParse:nil];
    }
    @catch (FsErrLow *e) { caught += 10; }
    @try {
        [ps looseParse:@"ok"];                            // 不抛
        caught += 100;
    }
    @catch (FsErrLow *e) { caught += 1000; }
    printf("5.6 throws %d\n", caught);

    // 5.7 async 入口：唯一同步桥 blockOn（v1 规则3；语句位裸调用已被规则2废除）
    [NPTask blockOn:async ^ void { await [FsFetcher runAll]; }];

    // 5.8 内联 asm：basic / extended(volatile+clobber) / 命名操作数 / 读写 / asm goto
    asm("nop");
    int ao = 0, aa = 10, ab = 20;
    asm volatile("add %w0, %w1, %w2\n\tsub %w0, %w0, #1"
                 : "=r"(ao) : "r"(aa), "r"(ab) : "cc");
    int sh = 0, v = 7;
    asm("mov %w[res], %w[val]\n\tlsl %w[res], %w[res], #2"
        : [res] "=r"(sh) : [val] "r"(v) : "cc");
    int rw = 3;
    asm("lsl %w0, %w0, #2" : "+r"(rw));
    int ag = 0;
    asm goto("cmp %w0, #0\n\tb.eq %l[z]" : : "r"(ag) : "cc" : z);
    goto after;
z:
    printf("5.8 asmgoto hit\n");
after:
    printf("5.8 asm %d %d %d\n", ao, sh, rw);

    // 5.9 Foundation 走查：NPNumber 全家 / NPString copy / NPArray copy
    NPNumber *n1 = [NPNumber numberWithInt:7];
    NPNumber *n2 = @7;                                     // 装箱 → 同工厂
    printf("5.9 num %lld %.2f %d %d\n",
           [n1 longLongValue], [[NPNumber numberWithDouble:2.5] doubleValue],
           [n1 isEqualToNumber:n2], [@YES boolValue]);

    NPString *orig = [NPString stringWithUTF8String:"cp"];
    NPString *cp = [orig copy];                            // copy → +1 契约
    printf("5.9b strcopy %s %d\n", [cp UTF8String], [orig isEqual:cp] == NO);

    NPArray *src = @[ @"p", @"q" ];
    NPArray *arrcp = [src copy];
    printf("5.9c arrcopy %zu %s\n", [arrcp count], [[arrcp objectAtIndex:1] UTF8String]);
}

// ═══════════════════════════════════════════════════════════════════
// §5.10  async × throws × 消息内 await（2026-10-13 定案）
// ═══════════════════════════════════════════════════════════════════
//
// throws 注解 = 裸软关键字 throws / throws(T *)：同步与异步同一拼写，
// 在声明尾（`;`/`{` 之前）解析；`@throws` 已废除（报迁移诊断），
// `@throw` 语句保留 @。位置消歧规则：`throws:`（尾随冒号）是选择子
// 分段；`- (int)throws` 是名叫 throws 的方法（返回类型后首个 token
// 即方法名）；只有参数表之后、`;`/`{` 之前的 throws 才是注解。
//
// 消息发送内的 await 必须加小括号：实参 `[a m:(await [a n])]`、
// 接收者 `[(await [a n]) m]`。这不是优先级规则而是禁令——裸写
// `[a m:await [a n]]` 会被读成 await 盖住整条消息链（Swift 语义），
// parser 直接拒绝。await 外层的 cast/分组括号不受影响：
// `(int)(await …)` 先驱动后转换；cast 包住任务句柄（`await (int)[…]`）
// 是用户错误，由 C 编译器硬错误兜底。

@interface FsNetErr : NPObject @end

@interface FsApi : NPObject
- (async int)load:(int)uid throws(FsNetErr *);           // async + 带类型注解
- (async FsApi *)box:(int)uid;                           // async 对象结果（接收者位用）
- (int)decode:(int)raw;
- (int)wrap:(int)v;
- (int)value;
- (FsApi *)asObj;
+ (async void)runAll10;                                  // §5.10 入口（同步调 async void → blocking wrapper）
@end

@implementation FsApi
// 注意：本文件是三后端汇测，async 方法体内不放裸 @throw——legacy 模式下
// throws 注解不随降级传入 jeti_async_state_* 合成函数，checker 对账会报
// escapes（checked 下 EH 改写先行所以无此问题）。真抛+传播钉在 golden/48。
- (async int)load:(int)uid throws(FsNetErr *) {
    return await [self decode:uid];
}
- (async FsApi *)box:(int)uid {
    (void)uid;
    return await [self asObj];
}
- (int)decode:(int)raw { return raw * 10; }
- (int)wrap:(int)v { return v + 1; }
- (int)value { return 7; }
- (FsApi *)asObj { return self; }

// 入口走类方法 async void（与 5.7 同型、已验证路径；顶层 async 函数路径
// 的两个既有缺口——static 修饰符不被认作 async、await 同步调用误驱动——
// 不在本文件钉住范围）
+ (async void)runAll10 {
    printf("== §5.10 async throws / msg-await ==\n");
    FsApi *api = [[FsApi alloc] init];
    // 注解拼写（throws/throws(T)）在此钉住；失败 await 的传播语义不在
    // full_syntax 重复——@try 跨 await 与 async 体内裸 @throw 都只有
    // checked 后端支持（legacy sjlj 的 jmp_buf 活不过挂起点，且 throws
    // 注解不随降级传入状态机函数），golden/48 已在默认模式钉住。
    printf("5.10 ok %d\n", await [api load:3]);          // 30
    // 消息实参位与接收者位的强制括号形态
    printf("5.10b msgawait %d %d\n",
           [api wrap:(await [api load:4])],              // 实参位 → 41
           [(await [api box:2]) value]);                 // 接收者位 → 7
}
@end

// ─── main ─────────────────────────────────────────────────────────
int main(void) {
    sec1_c_superset();
    sec2_objects();
    sec3_expressions();
    sec4_control_runtime();
    sec5_misc();
    [NPTask blockOn:async ^ void { await [FsApi runAll10]; }];
    printf("ALL SECTIONS DONE\n");
    return 0;
}

