#import <stdio.h>
#import <stdlib.h>
#import <string.h>
#import <time.h>
#import <termios.h>
#import <unistd.h>
#import <sys/select.h>
#import <Foundation/Foundation.hje>
#include <stdio.h>

// ==========================================================
// 1. 终端非阻塞原始模式
// ==========================================================
static struct termios orig_termios;

static void disableRawMode() {
    tcsetattr(STDIN_FILENO, TCSAFLUSH, &orig_termios);
    printf("\033[?25h"); 
    fflush(stdout);
}

static void enableRawMode() {
    tcgetattr(STDIN_FILENO, &orig_termios);
    atexit(disableRawMode);
    
    struct termios raw = orig_termios;
    raw.c_lflag &= ~(ECHO | ICANON);
    tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw);
    printf("\033[?25l"); 
    fflush(stdout);
}

static int kbhit() {
    struct timeval tv = {0, 200000}; // 200ms 每步，既能实时反应，又给足思考时间
    fd_set fds;
    FD_ZERO(&fds);
    FD_SET(STDIN_FILENO, &fds);
    return select(STDIN_FILENO + 1, &fds, NULL, NULL, &tv);
}

// ==========================================================
// 2. 怪物类（压力点：多参数 Init 与状态存活判定）
// ==========================================================
@interface Monster : NPObject {
    int _x;
    int _y;
    int _hp;
    int _atk;
    BOOL _alive;
}
- (id)initWithX:(int)x y:(int)y hp:(int)h atk:(int)a; // 💥 压力测试：多参数签名
- (int)x;
- (int)y;
- (int)hp;
- (int)atk;
- (BOOL)alive;
- (void)takeDamage:(int)dmg;
- (void)wanderWithWidth:(int)w height:(int)h;
@end

@implementation Monster
- (id)initWithX:(int)x y:(int)y hp:(int)h atk:(int)a {
    self = [super init]; // 💥 验证你刚修复的 init 逻辑
    if (self) {
        _x = x;
        _y = y;
        _hp = h;
        _atk = a;
        _alive = YES;
    }
    return self;
}
- (int)x { return _x; }
- (int)y { return _y; }
- (int)hp { return _hp; }
- (int)atk { return _atk; }
- (BOOL)alive { return _alive; }

- (void)takeDamage:(int)dmg {
    _hp -= dmg;
    if (_hp <= 0) {
        _hp = 0;
        _alive = NO;
    }
}

- (void)wanderWithWidth:(int)w height:(int)h {
    if (!_alive) return;
    // 随机上下左右乱晃，增加地牢动态感
    int dir = rand() % 4;
    if (dir == 0 && _x > 1) _x--;
    if (dir == 1 && _x < w - 2) _x++;
    if (dir == 2 && _y > 1) _y--;
    if (dir == 3 && _y < h - 2) _y++;
}
@end

// ==========================================================
// 3. 玩家英雄类
// ==========================================================
@interface Player : NPObject {
    int _x;
    int _y;
    int _hp;
    int _maxHp;
    int _atk;
    int _exp;
}
- (id)init;
- (int)x;
- (int)y;
- (int)hp;
- (int)atk;
- (int)exp;
- (void)moveX:(int)dx y:(int)dy width:(int)w height:(int)h;
- (void)takeDamage:(int)dmg;
- (void)heal:(int)amount;
- (void)addExp:(int)amount;
@end

@implementation Player
- (id)init {
    self = [super init];
    if (self) {
        _x = 2;
        _y = 2;
        _hp = 100;
        _maxHp = 100;
        _atk = 15;
        _exp = 0;
    }
    return self;
}
- (int)x { return _x; }
- (int)y { return _y; }
- (int)hp { return _hp; }
- (int)atk { return _atk; }
- (int)exp { return _exp; }

- (void)moveX:(int)dx y:(int)dy width:(int)w height:(int)h {
    _x += dx;
    _y += dy;
    // 墙壁碰撞防御
    if (_x < 1) _x = 1;
    if (_x > w - 2) _x = w - 2;
    if (_y < 1) _y = 1;
    if (_y > h - 2) _y = h - 2;
}

- (void)takeDamage:(int)dmg {
    _hp -= dmg;
    if (_hp < 0) _hp = 0;
}

- (void)heal:(int)amount {
    _hp += amount;
    if (_hp > _maxHp) _hp = _maxHp;
}

- (void)addExp:(int)amount {
    _exp += amount;
    if (_exp >= 100) { // 升级逻辑
        _exp -= 100;
        _atk += 5;
        _maxHp += 20;
        _hp = _maxHp;
    }
}
@end

// ==========================================================
// 4. 地牢核心驱动引擎（纵向多对象治理中心）
// ==========================================================
@interface DungeonEngine : NPObject {
    int _width;
    int _height;
    int _dungeonFloor;
    BOOL _gameOver;
    Player *_player;
    Monster *_m1;
    Monster *_m2;
    int _potionX;
    int _potionY;
    int _stairsX;
    int _stairsY;
    char _logMessage[64];
}
- (id)initWithWidth:(int)w height:(int)h;
- (BOOL)gameOver;
- (void)processInfut:(char)ch;
- (void)updateWithCritBlock:(int (^)(int))critBlock; // 💥 压力测试：接收高级闭包
- (void)render;
- (void)refreshFloor;
- (void)dealloc;
@end

@implementation DungeonEngine
- (id)initWithWidth:(int)w height:(int)h {
    self = [super init];
    if (self) {
        _width = w;
        _height = h;
        _dungeonFloor = 1;
        _gameOver = NO;
        strcpy(_logMessage, "欢迎来到暗黑地牢! WASD移动。找 > 下楼。");
        
        _player = [[Player alloc] init];
        _m1 = NULL;
        _m2 = NULL;
        
        [self refreshFloor]; // 生成当前层物品和怪物
    }
    return self;
}

- (BOOL)gameOver { return _gameOver; }

- (void)refreshFloor {
    // 💥 内存留存高强度测试：如果进入下一层，必须释放上一层的怪物，重新alloc！
    if (_m1) { NPObject_release(_m1); _m1 = NULL; }
    if (_m2) { NPObject_release(_m2); _m2 = NULL; }
    
    // 动态随着层数增加怪物强度
    int monsterHp = 20 + _dungeonFloor * 5;
    int monsterAtk = 5 + _dungeonFloor * 2;
    
    _m1 = [[Monster alloc] initWithX:(rand()%(_width-4)+2) y:(rand()%(_height-4)+2) hp:monsterHp atk:monsterAtk];
    _m2 = [[Monster alloc] initWithX:(rand()%(_width-4)+2) y:(rand()%(_height-4)+2) hp:monsterHp atk:monsterAtk];
    
    // 刷新药水和楼梯
    _potionX = rand() % (_width - 4) + 2;
    _potionY = rand() % (_height - 4) + 2;
    _stairsX = _width - 3;
    _stairsY = _height - 3;
}

- (void)processInfut:(char)ch {
    if (ch == 'w' || ch == 'W') [_player moveX:0 y:-1 width:_width height:_height];
    else if (ch == 's' || ch == 'S') [_player moveX:0 y:1 width:_width height:_height];
    else if (ch == 'a' || ch == 'A') [_player moveX:-1 y:0 width:_width height:_height];
    else if (ch == 'd' || ch == 'D') [_player moveX:1 y:0 width:_width height:_height];
    else if (ch == 'q' || ch == 'Q') _gameOver = YES;
}

- (void)updateWithCritBlock:(int (^)(int))critBlock {
    if (_gameOver) return;
    
    // 让怪物们随机游走
    [_m1 wanderWithWidth:_width height:_height];
    [_m2 wanderWithWidth:_width height:_height];
    
    int px = [_player x];
    int py = [_player y];
    
    // 1. 检查是否踩到恢复药水
    if (px == _potionX && py == _potionY) {
        [_player heal:30];
        strcpy(_logMessage, "🥤 咕嘟咕嘟...你喝下生命药水，恢复 30 HP！");
        _potionX = -1; _potionY = -1; // 药水消失
    }
    
    // 2. 检查是否踩到下一层楼梯
    if (px == _stairsX && py == _stairsY) {
        _dungeonFloor++;
        [_player addExp:40];
        [self refreshFloor]; // 💥 触发大规模内存刷新销毁
        strcpy(_logMessage, "🪜 成功深入下一层地牢！怪物变强了！经验+40");
        return;
    }
    
    // 3. 跨对象战斗判定：检查是否碰到怪物 1
    if ([_m1 alive] && px == [_m1 x] && py == [_m1 y]) {
        int rawAtk = [_player atk];
        int finalAtk = critBlock(rawAtk); // 💥 压力点：跨类执行外部传入的闭包！
        
        [_m1 takeDamage:finalAtk];
        [_player takeDamage:[_m1 atk]];
        
        if (finalAtk > rawAtk) {
            snprintf(_logMessage, sizeof(_logMessage), "⚔️ 暴击！💥 砍中哥布林 %d 伤！被反击 %d 伤", finalAtk, [_m1 atk]);
        } else {
            snprintf(_logMessage, sizeof(_logMessage), "⚔️ 挥剑！砍中哥布林 %d 伤！被反击 %d 伤", finalAtk, [_m1 atk]);
        }
        
        if (![_m1 alive]) {
            [_player addExp:50];
            strcpy(_logMessage, "💀 击杀哥布林！经验值 +50！");
        }
    }
    
    // 4. 检查是否碰到怪物 2
    if ([_m2 alive] && px == [_m2 x] && py == [_m2 y]) {
        int finalAtk = critBlock([_player atk]);
        [_m2 takeDamage:finalAtk];
        [_player takeDamage:[_m2 atk]];
        
        snprintf(_logMessage, sizeof(_logMessage), "⚔️ 遭遇幽灵！重创它 %d 伤！被吸血 %d 伤", finalAtk, [_m2 atk]);
        if (![_m2 alive]) {
            [_player addExp:50];
            strcpy(_logMessage, "💀 驱散了幽灵！经验值 +50！");
        }
    }
    
    // 5. 死亡判定
    if ([_player hp] <= 0) {
        _gameOver = YES;
    }
}

- (void)render {
    printf("\033[H"); // 光标归位
    printf("===================================================\n");
    printf("        🏰  MICRIT ROGUE: 随机地牢压力测试         \n");
    printf("===================================================\n");
    
    int px = [_player x], py = [_player y];
    
    for (int i = 0; i < _height; i++) {
        for (int j = 0; j < _width; j++) {
            if (i == 0 || i == _height - 1 || j == 0 || j == _width - 1) {
                printf("#"); // 地牢石墙
            } else if (i == py && j == px) {
                printf("@"); // 🕹️ 玩家英雄
            } else if (_m1 && [_m1 alive] && i == [_m1 y] && j == [_m1 x]) {
                printf("G"); // 👹 怪物1: Goblin
            } else if (_m2 && [_m2 alive] && i == [_m2 y] && j == [_m2 x]) {
                printf("G"); // 👻 怪物2: Ghost
            } else if (i == _potionY && j == _potionX) {
                printf("H"); // 🥤 药水 Healing Potion
            } else if (i == _stairsY && j == _stairsX) {
                printf(">"); // 🪜 下楼的楼梯
            } else {
                printf("."); // 🧱 地牢空地
            }
        }
        printf("\n");
    }
    
    printf("---------------------------------------------------\n");
    printf(" ⚜️  【第 %d 层】| ❤️  HP: %d | ⚔️  ATK: %d | 🧪 EXP: %d/100\n", 
           _dungeonFloor, [_player hp], [_player atk], [_player exp]);
    printf(" 📜 事件播报: %s\n", _logMessage);
    printf("===================================================\n");
}

- (void)dealloc {
    if (_player) NPObject_release(_player);
    if (_m1) NPObject_release(_m1);
    if (_m2) NPObject_release(_m2);
    [super dealloc];
}
@end

// ==========================================================
// 5. 主程序入口
// ==========================================================
int main() {
    @autoreleasepool {
        srand(time(NULL));
        enableRawMode();
        printf("\033[2J\033[H"); // 开局大洗屏
        
        // 构建 32宽 x 12高 的随机暗黑地牢
        DungeonEngine *engine = [[DungeonEngine alloc] initWithWidth:32 height:12];
        
        // 💥 高阶压力测试闭包：每一帧用于处理复杂的暴击几率运算
        int (^critBlock)(int) = ^int(int baseAtk) {
            // 35% 概率触发双倍暴击伤
            if (rand() % 100 < 35) {
                return baseAtk * 2;
            }
            return baseAtk;
        };
        
        while (![engine gameOver]) {
            [engine render];
            
            if (kbhit()) {
                char ch;
                if (read(STDIN_FILENO, &ch, 1) == 1) {
                    [engine processInfut:ch];
                }
            }
            
            // 每一帧都把高阶闭包灌进引擎
            [engine updateWithCritBlock:critBlock];
        }
        
        disableRawMode();
        
        printf("\n===================================================\n");
        printf("                    GAME OVER                      \n");
        printf("===================================================\n");
        printf(" 💀 你在地牢深处耗尽了最后一点力气，不幸力竭阵亡！\n");
        printf("===================================================\n");
        
        if (engine) NPObject_release(engine);
    }
    return 0;
}