#import <stdio.h>
#import <stdlib.h>
#import <Foundation/Foundation.hje>
#import <string.h>

// ==========================================================
// 1. @protocol 声明：定义地牢中所有战斗单位的生存法则
// ==========================================================
@protocol Fighter

- (void)takeDamage:(int)amount;
- (void)attack:(id)target;

@end


// ==========================================================
// 2. Base Class 基类声明：基础游戏实体
// ==========================================================
@interface GameEntity : NPObject <Fighter>

@property char *name;
@property int hp;
@property int attackPower;

- (instancetype)initWithName:(char *)name hp:(int)hp attack:(int)attack;
- (void)displayStatus;

@end


// ==========================================================
// 3. Subclass 子类声明：守护精灵（作为弱引用测试对象）
// ==========================================================
@interface Spirit : GameEntity

- (void)castHeal:(GameEntity *)target;

@end


// ==========================================================
// 4. Subclass 子类声明：地牢勇士（引入弱引用和必杀技 Block）
// ==========================================================
@interface Hero : GameEntity

// 弱引用守护灵：一旦 Spirit 被销毁，这里会自动置为 nil，完美避免内存野指针崩溃
@property (weak) Spirit *companion;
@property int exp;

- (void)levelUp;

@end


// ==========================================================
// 5. Subclass 子类声明：深渊魔物
// ==========================================================
@interface Monster : GameEntity

@property char *monsterType;

- (instancetype)initWithName:(char *)name hp:(int)hp attack:(int)attack type:(char *)type;

@end


// ==========================================================
// ==========================================================
// @implementation 各类具体实现
// ==========================================================
// ==========================================================

@implementation GameEntity

@synthesize name = _name;
@synthesize hp = _hp;
@synthesize attackPower = _attackPower;

- (instancetype)initWithName:(char *)name hp:(int)hp attack:(int)attack {
    self = [super init];
    if (self) {
        _name = name;
        _hp = hp;
        _attackPower = attack;
    }
    return self;
}

- (void)takeDamage:(int)amount {
    _hp -= amount;
    if (_hp < 0) _hp = 0;
    printf(" [%s] 受到 %d 点伤害！(剩余生命: %d/%d)\n", _name, amount, _hp, 100);
}

- (void)attack:(id)target {
    printf(" ⚔️ [%s] 挥动武器，砍向 [%s]！\n", _name, [target name]);
    [target takeDamage:_attackPower];
}

- (void)displayStatus {
    printf(" -> 实体状态: [%s] | HP: %d | ATK: %d\n", _name, _hp, _attackPower);
}

- (void)dealloc {
    printf(" 👻 [%s] 离开了这个地牢世界...\n", _name);
}

@end


@implementation Spirit

- (void)castHeal:(GameEntity *)target {
    int healAmount = 25;
    [target setHp:[target hp] + healAmount];
    printf(" ✨ [守护精灵 %s] 施展了治愈之光！为 [%s] 恢复了 %d 点生命！\n", 
           [self name], [target name], healAmount);
}

@end


@implementation Hero

@synthesize companion = _companion;
@synthesize exp = _exp;

- (void)levelUp {
    _exp += 50;
    [self setAttackPower:[self attackPower] + 15];
    printf(" ⭐⭐⭐ [%s] 战意高涨！等级提升！当前攻击力: %d\n", [self name], [self attackPower]);
}

@end


@implementation Monster

@synthesize monsterType = _monsterType;

- (instancetype)initWithName:(char *)name hp:(int)hp attack:(int)attack type:(char *)type {
    self = [super initWithName:name hp:hp attack:attack];
    if (self) {
        _monsterType = type;
    }
    return self;
}

// 多态重写：怪物有概率暴击
- (void)attack:(id)target {
    int damage = [self attackPower];
    if (rand() % 100 < 30) { // 30% 暴击率
        damage *= 2;
        printf(" ⚡💥 [%s](%s) 触发暴击！疯狂地扑向 [%s]！\n", 
               [self name], _monsterType, [target name]);
    } else {
        printf(" 👹 [%s](%s) 嘶吼着抓向 [%s]！\n", 
               [self name], _monsterType, [target name]);
    }
    [target takeDamage:damage];
}

@end


// ==========================================================
// 6. 游戏主循环及逻辑入口
// ==========================================================
int main(int argc, const char * argv[]) {
    @autoreleasepool {
        printf("\n======================================================\n");
        printf("       ⚔️ 欢迎来到 Micrit 纯静态地牢冒险 ⚔️\n");
        printf("======================================================\n\n");

        // 1. 初始化勇士
        Hero *hero = [[Hero alloc] initWithName:"雷恩" hp:120 attack:25];
        [hero displayStatus];

        // 2. 建立精灵契约（使用块作用域测试弱引用置空机制）
        {
            printf("\n--> 呼唤古老誓约，召唤守护精灵...\n");
            Spirit *fairy = [[Spirit alloc] initWithName:"小光" hp:50 attack:5];
            
            // 绑定弱引用：此时 fairy 的地址会注册到 hero 的 weak_slots 中
            hero.companion = fairy;
            
            printf("--> 守护誓约建立成功！\n");
            if (hero.companion) {
                printf(" [状态验证] 勇士 %s 的守护精灵 %s 当前【存活】！\n", 
                       [hero name], [hero.companion name]);
            }
            
            // 精灵施展治愈
            [fairy castHeal:hero];
            
            printf("--> 精灵能量耗尽，即将重归虚无...\n");
        } 
        // 💥 超出局部作用域！fairy 在此处被 ARC 释放。
        // 期望触发 Micrit 底层：自动遍历 weak_slots，将 hero.companion 强行抹成 nil (NULL)！

        printf("\n--> 已经走出精灵作用域\n");
        printf("--> 再次验证勇士的守护灵状态：\n");
        if (hero.companion == nil) {
            printf(" ✨ [弱引用安全验证成功] hero.companion 自动归零 (nil)！完美规避了野指针崩溃！\n");
        } else {
            printf(" ❌ [验证失败] 依然存在残留指针！\n");
        }

        // 3. 遭遇深渊恶魔
        printf("\n------------------------------------------------------\n");
        printf(" ⚠️ 警告：前方迷雾中走出一尊恐怖的存在...\n");
        Monster *boss = [[Monster alloc] initWithName:"深渊炎魔" hp:180 attack:18 type:"恶魔BOSS"];
        [boss displayStatus];
        printf("------------------------------------------------------\n\n");

        // 4. 第一回合战斗 (多态方法派发)
        printf("==== [第一回合开始] ====\n");
        [hero attack:boss];
        [boss attack:hero];
        
        // 5. 战意积攒，准备释放终极必杀技 Block！
        printf("\n==== [第二回合：雷恩积蓄力量] ====\n");
        int rage_multiplier = 3; // 💥 捕获外部战意倍率变量！
        
        // 定义必杀技闭包
        int (^ultimateSlash)(int) = ^int(int baseDamage) {
            printf(" 🔥 [究极奥义·断空斩] 爆裂释放！(战意倍率: x%d)\n", rage_multiplier);
            return baseDamage * rage_multiplier;
        };

        // 计算必杀伤害
        int finalDamage = ultimateSlash([hero attackPower]);
        printf(" 💥 终极伤害计算完成: %d 点！\n", finalDamage);
        
        // 施加最终一击
        [boss takeDamage:finalDamage];

        // 6. 战斗结算
        printf("\n==== [战斗结算] ====\n");
        if ([boss hp] <= 0) {
            printf(" 🎉 恭喜！[%s] 击败了 [%s]！地牢重归和平！\n", [hero name], [boss name]);
            [hero levelUp];
        } else {
            printf(" 💀 [%s] 未能击败强敌，倒在了地牢深处...\n", [hero name]);
        }
        
        printf("\n======================================================\n");
        printf("                    地牢探险结束\n");
        printf("======================================================\n\n");
    }
    return 0;
}