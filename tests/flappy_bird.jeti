#import <stdio.h>
#import <stdlib.h>
#import <string.h>
#import <time.h>
#import <termios.h>
#import <unistd.h>
#import <sys/select.h>
#import <Foundation/Foundation.hje>

// ==========================================================
// 1. 终端非阻塞模式控制（Tick 调整为 150ms，手感最佳）
// ==========================================================
static struct termios orig_termios;

static void disableRawMode() {
    tcsetattr(STDIN_FILENO, TCSAFLUSH, &orig_termios);
    printf("\033[?25h"); 
    fflush(stdout);
}

static void enableRawMode() {
    tcgetattr(STDIN_FILENO, &orig_termios);
    atexit(disableRawMode);
    
    struct termios raw = orig_termios;
    raw.c_lflag &= ~(ECHO | ICANON);
    tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw);
    printf("\033[?25l"); 
    fflush(stdout);
}

static int kbhit() {
    struct timeval tv = {0, 150000}; // 150ms 游戏时钟
    fd_set fds;
    FD_ZERO(&fds);
    FD_SET(STDIN_FILENO, &fds);
    return select(STDIN_FILENO + 1, &fds, NULL, NULL, &tv);
}

// ==========================================================
// 2. 小鸟类（改用平滑的恒定速度物理模型）
// ==========================================================
@interface Bird : NPObject {
    int _y;
}
- (instancetype)init;
- (int)y;
- (void)flap;
- (void)fall;
@end

@implementation Bird
- (instancetype)init {
    self = [super init];
    if (self) {
        _y = 6; // 初始处于中部高度
    }
    return self;
}
- (int)y { return _y; }

- (void)flap {
    _y -= 2; // 振翅：瞬间向上高飞 2 格
    if (_y < 1) _y = 1;
}

- (void)fall {
    _y += 1; // 重力：每帧极其平稳地下落 1 格
}
@end

// ==========================================================
// 3. 障碍管道类（改用安全的单列 ASCII 逻辑）
// ==========================================================
@interface Pipe : NPObject {
    int _x;
    int _gapY;
    int _gapHeight;
}
- (id)init;
- (int)x;
- (int)gapY;
- (int)gapHeight;
- (void)moveLeft;
- (void)resetWithWidth:(int)width height:(int)height;
@end

@implementation Pipe
- (id)init {
    self = [super init];
    if (self) {
        _x = 0;
        _gapY = 4;
        _gapHeight = 4; // 缺口高度固定为 4 个格子
    }
    return self;
}
- (int)x { return _x; }
- (int)gapY { return _gapY; }
- (int)gapHeight { return _gapHeight; }

- (void)moveLeft {
    _x--;
}

- (void)resetWithWidth:(int)width height:(int)height {
    _x = width - 2; // 在最右侧边缘内墙生成
    _gapY = rand() % (height - _gapHeight - 3) + 2; // 随机缺口 Y 坐标
}
@end

// ==========================================================
// 4. 游戏核心引擎
// ==========================================================
@interface FlappyEngine : NPObject {
    int _width;
    int _height;
    int _score;
    BOOL _gameOver;
    Bird *_bird;
    Pipe *_pipe;
}
- (id)initWithWidth:(int)w height:(int)h;
- (BOOL)gameOver;
- (void)processInfut:(char)ch;
- (void)update;
- (void)renderWithScoreBlock:(int (^)(int))scoreBlock;
- (void)dealloc;
@end

@implementation FlappyEngine
- (id)initWithWidth:(int)w height:(int)h {
    self = [super init];
    if (self) {
        _width = w;
        _height = h;
        _score = 0;
        _gameOver = NO;
        
        _bird = [[Bird alloc] init];
        _pipe = [[Pipe alloc] init];
        [_pipe resetWithWidth:_width height:_height];
    }
    return self;
}

- (BOOL)gameOver { return _gameOver; }

- (void)processInfut:(char)ch {
    if (ch == ' ' || ch == 'w' || ch == 'W') {
        [_bird flap]; // 按空格或者 W 向上飞
    } else if (ch == 'q' || ch == 'Q') {
        _gameOver = YES;
    }
}

- (void)update {
    if (_gameOver) return;
    
    [_bird fall];
    [_pipe moveLeft];
    
    int birdX = 6; // 小鸟固定横坐标
    int birdY = [_bird y];
    
    // 1. 触地暴毙判定
    if (birdY >= _height - 1) {
        _gameOver = YES;
        return;
    }
    
    // 2. 单列精确碰撞判定
    if ([_pipe x] == birdX) {
        // 如果鸟的 Y 坐标不在管道的缺口范围内
        if (birdY < [_pipe gapY] || birdY >= ([_pipe gapY] + [_pipe gapHeight])) {
            _gameOver = YES;
            return;
        }
    }
    
    // 3. 得分与循环刷新
    if ([_pipe x] <= 1) {
        [_pipe resetWithWidth:_width height:_height];
        _score++;
    }
}

- (void)renderWithScoreBlock:(int (^)(int))scoreBlock {
    // 强制光标归位 (0,0)，由于下方严格等宽，不再需要全屏 clear 导致闪烁
    printf("\033[H"); 
    
    printf("===================================================\n");
    printf("         🕊️  MICRIT 终端笨鸟先飞 (Flappy Bird)      \n");
    printf("===================================================\n");
    
    int birdX = 6;
    int birdY = [_bird y];
    int pipeX = [_pipe x];
    int gapY = [_pipe gapY];
    int gapH = [_pipe gapHeight];
    
    for (int i = 0; i < _height; i++) {
        for (int j = 0; j < _width; j++) {
            if (i == 0 || i == _height - 1 || j == 0 || j == _width - 1) {
                printf("#"); // 严格的单字节外墙
            } else if (i == birdY && j == birdX) {
                printf(">"); // 🐦 极其标准的小鸟，只占 1 个横向位！
            } else if (j == pipeX) {
                if (i < gapY || i >= (gapY + gapH)) {
                    printf("X"); // 🧱 严格单字节的管道身体
                } else {
                    printf(" "); // 🕳️ 严格单字节的缺口
                }
            } else {
                printf(" "); // 🌌 深空
            }
        }
        printf("\n");
    }
    
    int formattedScore = scoreBlock(_score);
    printf(" [CURRENT SCORE]: %d pts | (SPACE to Flap, Q to Quit) \n", formattedScore);
    printf("===================================================\n");
}

- (void)dealloc {
    if (_bird) NPObject_release(_bird);
    if (_pipe) NPObject_release(_pipe);
    [super dealloc];
}
@end

// ==========================================================
// 5. 主程序入口
// ==========================================================
int main() {
    @autoreleasepool {
        srand(time(NULL));
        enableRawMode();
        
        // 只有开局时进行一次彻底的物理清屏
        printf("\033[2J\033[H"); 
        
        FlappyEngine *engine = [[FlappyEngine alloc] initWithWidth:32 height:16];
        
        int multiplier = 100;
        int (^arcadeScoreBlock)(int) = ^int(int rawScore) {
            return rawScore * multiplier;
        };
        
        while (![engine gameOver]) {
            [engine renderWithScoreBlock:arcadeScoreBlock];
            
            if (kbhit()) {
                char ch;
                if (read(STDIN_FILENO, &ch, 1) == 1) {
                    [engine processInfut:ch];
                }
            }
            
            [engine update];
        }
        
        disableRawMode();
        
        printf("\n===================================================\n");
        printf("                    GAME OVER                      \n");
        printf("===================================================\n");
        printf(" 💀 提示：小鸟完美坠毁，但编译器类型和 ARC 链路运行极度完美！\n");
        printf("===================================================\n");
        
        if (engine) NPObject_release(engine);
    }
    return 0;
}