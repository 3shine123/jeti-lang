// lang-test/using_cyber_final_regression_test.jeti
// Jeti 语言 @using 特性及别名级联消息传递回归测试 - 第六弹（终极收官大压测）
// 聚焦：三大 @using 精准解析、类方法静态符号决议、带状态捕获 Block 长链跨空间投递、三元+自增+别名接收者大决战

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.hje>

// ============================================================================
// 1. 命名空间「Cyber::Security」：入侵载荷与核心数据
// ============================================================================
@namespace Cyber
    @namespace Security
        @interface IntrusionPayload : NPObject {
            @public
            int _threatLevel; // 威胁等级 1 - 100
            const char* _exploitName;
        }
        @property int threatLevel;
        @property (readonly) const char* exploitName;

        // + 号类方法：测试短名称激活后的静态符号类方法派发
        + (Cyber::Security::IntrusionPayload*)createBufferOverflow;
        + (Cyber::Security::IntrusionPayload*)createZeroDay;

        - (id)initWithName:(const char*)name threat:(int)t;
        @end

        @implementation IntrusionPayload
        @synthesize threatLevel = _threatLevel;
        @synthesize exploitName = _exploitName;

        + (Cyber::Security::IntrusionPayload*)createBufferOverflow {
            return [[Cyber::Security::IntrusionPayload alloc] initWithName:"缓冲区溢出漏洞注入" threat:65];
        }
        + (Cyber::Security::IntrusionPayload*)createZeroDay {
            return [[Cyber::Security::IntrusionPayload alloc] initWithName:"高级0-Day木马攻击" threat:99];
        }

        - (id)initWithName:(const char*)name threat:(int)t {
            self = [super init];
            if (self) {
                _exploitName = name;
                _threatLevel = t;
            }
            return self;
        }
        @end
    @endnamespace
@endnamespace

// ============================================================================
// 2. 命名空间「Cyber::Infrastructure」：主机防御防火墙
// ============================================================================
@namespace Cyber
    @namespace Infrastructure
        // 声明入侵防护策略计算的高阶回调 Block
        typedef int (^MitigationFormulaBlock)(int rawThreat);

        @interface MainframeFirewall : NPObject {
            @public
            const char* _hostDomain;
            int _defenseRating; // 防御系数 Base Rating
        }
        @property int defenseRating;
        @property (readonly) const char* hostDomain;

        - (id)initWithDomain:(const char*)domain rating:(int)r;
        // 传递攻击载荷参数，此处定义仍采用全称类型，确保符号隔离解析严密
        - (int)analyzeAndBlockPayload:(Cyber::Security::IntrusionPayload*)payload withFormula:(MitigationFormulaBlock)formula;
        @end

        @implementation MainframeFirewall
        @synthesize defenseRating = _defenseRating;
        @synthesize hostDomain = _hostDomain;

        - (id)initWithDomain:(const char*)domain rating:(int)r {
            self = [super init];
            if (self) {
                _hostDomain = domain;
                _defenseRating = r;
            }
            return self;
        }

        - (int)analyzeAndBlockPayload:(Cyber::Security::IntrusionPayload*)payload withFormula:(MitigationFormulaBlock)formula {
            if (!payload) return 0;
            printf("[%s] 防火墙拦截器启动，正检测攻击特征: %s, 初始威胁系数: %d\n", 
                   _hostDomain, [payload exploitName], [payload threatLevel]);
            
            int evaluatedThreat = [payload threatLevel];
            if (formula) {
                // 执行跨命名空间传递进来的计算闭包
                evaluatedThreat = formula([payload threatLevel]);
            }
            
            int breachProbability = evaluatedThreat * 500 / _defenseRating;
            if (breachProbability > 100) breachProbability = 100; // 穿透率最高 100%
            return breachProbability;
        }
        @end
    @endnamespace
@endnamespace

// ============================================================================
// 3. 命名空间「Cyber::Exploits」：黑客扩充攻击模组
// ============================================================================
@namespace Cyber
    @namespace Exploits
        @interface ProxyBypass : NPObject {
            @public
            const char* _proxyName;
            int _amplificationFactor;
        }
        @property int amplificationFactor;
        @property (readonly) const char* proxyName;

        - (id)initWithName:(const char*)name factor:(int)f;
        - (void)infectFirewall:(Cyber::Infrastructure::MainframeFirewall*)fw;
        @end

        @implementation ProxyBypass
        @synthesize amplificationFactor = _amplificationFactor;
        @synthesize proxyName = _proxyName;

        - (id)initWithName:(const char*)name factor:(int)f {
            self = [super init];
            if (self) {
                _proxyName = name;
                _amplificationFactor = f;
            }
            return self;
        }

        - (void)infectFirewall:(Cyber::Infrastructure::MainframeFirewall*)fw {
            if (fw) {
                int originalRating = [fw defenseRating];
                // 干扰防火墙，降低其防御系数
                [fw setDefenseRating:(originalRating / _amplificationFactor)];
                printf("[恶意篡改] 挂载旁路代理「%s」! 防火墙防御系数从 %d 暴跌至: %d\n", 
                       _proxyName, originalRating, [fw defenseRating]);
            }
        }
        @end
    @endnamespace
@endnamespace


// ============================================================================
// 4. 顶级作用域：三大 @using 收官终极配置
// ============================================================================

// 【Form 1】：精准导入攻击载荷类，后续直接调用「IntrusionPayload」
@using Cyber::Security::IntrusionPayload;

// 【Form 2】：别名映射，后续直接使用「DefenseGrid」代表防火墙核心
@using DefenseGrid = Cyber::Infrastructure::MainframeFirewall;

// 【Form 3】：批量导入黑客攻击空间，后续直接简写使用「ProxyBypass」
@using namespace Cyber::Exploits;


int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("====================================================================\n");
        printf(">>>  jetic 编译器「赛博防御综合验证 - 三大 @using & 终极收官」  <<<\n");
        printf("====================================================================\n\n");

        // ----------------------------------------------------
        // 回归校验点 1：Form 1 短名称 + 类方法消息派发
        printf("--- 1. 测试 Form 1 短名称类消息传递及静态工厂 (+ Method) ---\n");
        
        IntrusionPayload* overflow = [IntrusionPayload createBufferOverflow];
        printf("[数据生成] 成功利用短名称激活 + 类方法: 载荷=%s | 威胁值=%d\n", 
               [overflow exploitName], [overflow threatLevel]);

        // ----------------------------------------------------
        // 回归校验点 2：Form 2 别名「DefenseGrid」实例化与属性读写
        printf("\n--- 2. 测试 Form 2 别名类的实例化与 Property 读写控制 ---\n");
        
        DefenseGrid* myGrid = [[DefenseGrid alloc] initWithDomain:"mainframe.pentagon.gov" rating:1000];
        printf("[安全报告] 别名实例化完成: 目标主机=%s | 初始防御系数=%d\n", 
               [myGrid hostDomain], [myGrid defenseRating]);

        // ----------------------------------------------------
        // 回归校验点 3：Form 3 空间批量导入与跨模块联调
        printf("\n--- 3. 测试 Form 3 命名空间批量导入及旁路攻击挂载 ---\n");
        
        ProxyBypass* rootkit = [[ProxyBypass alloc] initWithName:"暗影透传Rootkit" factor:2];
        printf("[黑客资产] 成功抓取 Form 3 空间内的扩展插件: %s\n", [rootkit proxyName]);

        // 执行跨空间注入，降低其防御值
        [rootkit infectFirewall:myGrid];

        // ----------------------------------------------------
        // 回归校验点 4：高阶防御抵灾 Block 跨空间长链深度传递
        printf("\n--- 4. 测试加密防御 Block 高阶闭包跨命名空间深度三层投递 ---\n");

        __block int adaptivePatchLevel = 10;
        __block int intrusionAnalysedCounter = 0;

        // 闭包定义使用全称签名保证严密
        Cyber::Infrastructure::MitigationFormulaBlock sandboxMitigator = ^int(int threat) {
            intrusionAnalysedCounter++;
            adaptivePatchLevel += 20; // 修改捕获的 __block 外部变量
            // 防御算法：沙箱减缓威胁
            return threat - adaptivePatchLevel;
        };

        // 进行第一波溢出注入校验
        int breachProbA = [myGrid analyzeAndBlockPayload:overflow withFormula:sandboxMitigator];
        
        IntrusionPayload* zeroDayAttack = [IntrusionPayload createZeroDay];
        int breachProbB = [myGrid analyzeAndBlockPayload:zeroDayAttack withFormula:sandboxMitigator];

        printf("\n[多维渗透测试最终状态报告]：\n");
        printf("          -> 溢出漏洞注入导致的主机穿透概率: %d%%\n", breachProbA);
        printf("          -> 高级0-Day木马导致的主机穿透概率: %d%%\n", breachProbB);
        printf("[闭包状态捕获验证]：\n");
        printf("          -> 防御闭包累计被沙箱调用执行次数: %d (预期为 2)\n", intrusionAnalysedCounter);
        printf("          -> 被捕获的外部自增修补阈值最终变化为: %d (预期为 50)\n", adaptivePatchLevel);

        // ----------------------------------------------------
        // 回归校验点 5：魔鬼优先级边界大决战（对齐你刚才修复的完美状态）
        printf("\n--- 5. 终极收官回归：别名接收者、三元判断与逗号表达式副作用自增 ---\n");

        int isQuantumDecryptActive = 1;
        int cyberneticStepCounter = 5555;

        // 强迫 Parser 解析三元真分支内，带括号自增副作用、别名对象作为 Receiver 的高级消息传递
        int finalVerifiedRating = (isQuantumDecryptActive > 0) ? [((cyberneticStepCounter++, myGrid)) defenseRating] : 0;

        printf("[终极收官断言] 编译器语法降维翻译完美！生成的 C99 树结构坚不可摧！\n");
        printf("          -> 副作用计数器自增值: %d (预期为 5556)\n", cyberneticStepCounter);
        printf("          -> 动态通过表达式链抓取的最终防火墙防御系数: %d\n", finalVerifiedRating);

        // ----------------------------------------------------
        // 6. 内存拓扑树安全销毁
        printf("\n--- 6. 正在深度擦除赛博空间临时资产物理内存... ---\n");
        [overflow release];
        [zeroDayAttack release];
        [myGrid release];
        [rootkit release];

        printf("\n====================================================================\n");
        printf(">>> 伟大的胜利！全部回归测试圆满结束，你的编译器已经完美无瑕！ <<<\n");
        printf("====================================================================\n");
    }
    return 0;
}