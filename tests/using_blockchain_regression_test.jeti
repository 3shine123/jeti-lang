// lang-test/using_blockchain_regression_test.jeti
// Jeti 语言 @using 特性及别名级联消息传递回归测试 - 第五弹（高压一致性验证）
// 聚焦：三大 @using 精准解析、+号类方法符号决议、带状态捕获 Block 三层链式传递、三元+自增+别名接收者回归

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.hje>

// ============================================================================
// 1. 命名空间「Ledger::Core」：底层账本与区块结构
// ============================================================================
@namespace Ledger
    @namespace Core
        @interface TransactionBlock : NPObject {
            @public
            int _txCount; // 交易笔数
            const char* _blockHash;
        }
        @property int txCount;
        @property (readonly) const char* blockHash;

        // + 号静态工厂方法：测试短名称激活后的静态符号类方法派发
        + (Ledger::Core::TransactionBlock*)createGenesisBlock;
        + (Ledger::Core::TransactionBlock*)createStandardBlock;

        - (id)initWithHash:(const char*)hash count:(int)c;
        @end

        @implementation TransactionBlock
        @synthesize txCount = _txCount;
        @synthesize blockHash = _blockHash;

        + (Ledger::Core::TransactionBlock*)createGenesisBlock {
            return [[Ledger::Core::TransactionBlock alloc] initWithHash:"0000000000abc123" count:1];
        }
        + (Ledger::Core::TransactionBlock*)createStandardBlock {
            return [[Ledger::Core::TransactionBlock alloc] initWithHash:"00000000ff987d6a" count:500];
        }

        - (id)initWithHash:(const char*)hash count:(int)c {
            self = [super init];
            if (self) {
                _blockHash = hash;
                _txCount = c;
            }
            return self;
        }
        @end
    @endnamespace
@endnamespace

// ============================================================================
// 2. 命名空间「Network::Engine」：共识校验引擎
// ============================================================================
@namespace Network
    @namespace Engine
        // 声明共识签名校验的高阶回调 Block
        typedef int (^SignatureVerifyBlock)(int rawCount);

        @interface ValidatorEngine : NPObject {
            @public
            const char* _nodeIdentity;
            int _stakeAmount; // 权益质押代币数量
        }
        @property int stakeAmount;
        @property (readonly) const char* nodeIdentity;

        - (id)initWithIdentity:(const char*)idInfo stake:(int)s;
        // 传递区块参数，定义处仍用全称，确保符号解析严密
        - (int)validateBlock:(Ledger::Core::TransactionBlock*)block withVerifier:(SignatureVerifyBlock)verifier;
        @end

        @implementation ValidatorEngine
        @synthesize stakeAmount = _stakeAmount;
        @synthesize nodeIdentity = _nodeIdentity;

        - (id)initWithIdentity:(const char*)idInfo stake:(int)s {
            self = [super init];
            if (self) {
                _nodeIdentity = idInfo;
                _stakeAmount = s;
            }
            return self;
        }

        - (int)validateBlock:(Ledger::Core::TransactionBlock*)block withVerifier:(SignatureVerifyBlock)verifier {
            if (!block) return 0;
            printf("[%s] 节点启动共识校验，正在处理区块哈希: %s, 包含交易: %d 笔\n", 
                   _nodeIdentity, [block blockHash], [block txCount]);
            
            int processYield = [block txCount];
            if (verifier) {
                // 执行外层多级传递进来的 Block
                processYield = verifier([block txCount]);
            }
            
            int rewardScore = processYield * _stakeAmount / 1000;
            if (rewardScore > 5000) rewardScore = 5000; // 单块奖励上限
            return rewardScore;
        }
        @end
    @endnamespace
@endnamespace

// ============================================================================
// 3. 命名空间「Network::Extensions」：网络路由插件升级
// ============================================================================
@namespace Network
    @namespace Extensions
        @interface RouterPlugin : NPObject {
            @public
            const char* _pluginName;
            int _bandwidthMultiplier;
        }
        @property int bandwidthMultiplier;
        @property (readonly) const char* pluginName;

        - (id)initWithName:(const char*)name multiplier:(int)m;
        - (void)attachToValidator:(Network::Engine::ValidatorEngine*)validator;
        @end

        @implementation RouterPlugin
        @synthesize bandwidthMultiplier = _bandwidthMultiplier;
        @synthesize pluginName = _pluginName;

        - (id)initWithName:(const char*)name multiplier:(int)m {
            self = [super init];
            if (self) {
                _pluginName = name;
                _bandwidthMultiplier = m;
            }
            return self;
        }

        - (void)attachToValidator:(Network::Engine::ValidatorEngine*)validator {
            if (validator) {
                int originalStake = [validator stakeAmount];
                // 模拟插件对节点的加权影响
                [validator setStakeAmount:(originalStake * _bandwidthMultiplier)];
                printf("[路由升级] 成功激活超级插件「%s」! 节点共识权重从 %d 飙升至: %d\n", 
                       _pluginName, originalStake, [validator stakeAmount]);
            }
        }
        @end
    @endnamespace
@endnamespace


// ============================================================================
// 4. 顶级作用域：三大 @using 镜像大集成
// ============================================================================

// 【Form 1】：精准导入区块类，后续直接调用「TransactionBlock」
@using Ledger::Core::TransactionBlock;

// 【Form 2】：别名映射，后续直接使用「ConsensusNode」代表验证引擎
@using ConsensusNode = Network::Engine::ValidatorEngine;

// 【Form 3】：批量空间导入，后续直接简写「RouterPlugin」
@using namespace Network::Extensions;


int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("====================================================================\n");
        printf(">>>    jetic 编译器「区块链综合验证 - 三大 @using & 复合边界」     <<<\n");
        printf("====================================================================\n\n");

        // ----------------------------------------------------
        // 回归校验点 1：Form 1 短名称 + 类方法消息派发
        printf("--- 1. 测试 Form 1 短名称类消息传递及静态工厂 (+ Method) ---\n");
        
        TransactionBlock* genesis = [TransactionBlock createGenesisBlock];
        printf("[区块生成] 成功利用短名称调用 + 方法: 哈希=%s | 交易=%d\n", 
               [genesis blockHash], [genesis txCount]);

        // ----------------------------------------------------
        // 回归校验点 2：Form 2 别名「ConsensusNode」实例化与属性控制
        printf("\n--- 2. 测试 Form 2 别名类的实例化与 Property 读写 ---\n");
        
        ConsensusNode* mainNode = [[ConsensusNode alloc] initWithIdentity:"东京-主网验证节点-01" stake:2000];
        printf("[节点报告] 别名实例化完成: %s | 初始权重: %d\n", 
               [mainNode nodeIdentity], [mainNode stakeAmount]);

        // ----------------------------------------------------
        // 回归校验点 3：Form 3 空间导入与多态联调
        printf("\n--- 3. 测试 Form 3 命名空间批量导入及插件挂载 ---\n");
        
        RouterPlugin* lightningModule = [[RouterPlugin alloc] initWithName:"闪电网络共识加速器" multiplier:2];
        printf("[网络报告] 抓取到 Form 3 空间内的插件: %s\n", [lightningModule pluginName]);

        // 跨命名空间修改属性
        [lightningModule attachToValidator:mainNode];

        // ----------------------------------------------------
        // 回归校验点 4：高阶签名校验 Block 跨空间三层流动
        printf("\n--- 4. 测试加密校验 Block 高阶闭包跨命名空间深度投递 ---\n");

        __block int gasPriceMod = 50;
        __block int totalBlocksValidated = 0;

        // 闭包定义使用全称签名
        Network::Engine::SignatureVerifyBlock cryptographicVerifier = ^int(int txs) {
            totalBlocksValidated++;
            gasPriceMod += 15; // 修改捕获的 __block 外部变量
            return txs * 2 + gasPriceMod;
        };

        // 进行区块共识验证
        int scoreGenesis = [mainNode validateBlock:genesis withVerifier:cryptographicVerifier];
        
        TransactionBlock* standardBlock = [TransactionBlock createStandardBlock];
        int scoreStandard = [mainNode validateBlock:standardBlock withVerifier:cryptographicVerifier];

        printf("\n[共识记账最终账本报告]：\n");
        printf("          -> 创世区块验证节点获得信用分: %d\n", scoreGenesis);
        printf("          -> 标称区块验证节点获得信用分: %d\n", scoreStandard);
        printf("[闭包捕获状态断言]：\n");
        printf("          -> 共识闭包累计执行次数: %d (预期为 2)\n", totalBlocksValidated);
        printf("          -> 被捕获的外部 Gas 调整最终值: %d (预期为 80)\n", gasPriceMod);

        // ----------------------------------------------------
        // 回归校验点 5：魔鬼优先级边界大决战（对齐你刚刚修复的完美状态）
        printf("\n--- 5. 回归核心：别名接收者、三元判断与逗号表达式副作用自增 ---\n");

        int isNetworkCongested = 1;
        int blockchainStepCounter = 7777;

        // 强迫 Parser 解析三元真分支内，带括号自增副作用、别名对象作为 Receiver 的高级消息传递
        int finalVerifiedStake = (isNetworkCongested > 0) ? [((blockchainStepCounter++, mainNode)) stakeAmount] : 0;

        printf("[终极复合断言] 编译树状态稳如泰山，未发生任何代码退化！\n");
        printf("          -> 副作用计数器自增值: %d (预期为 7778)\n", blockchainStepCounter);
        printf("          -> 动态通过表达式链抓取的节点质押权重: %d\n", finalVerifiedStake);

        // ----------------------------------------------------
        // 6. 内存拓扑树清理
        printf("\n--- 6. 正在释放分布式节点拓扑资产内存... ---\n");
        [genesis release];
        [standardBlock release];
        [mainNode release];
        [lightningModule release];

        printf("\n====================================================================\n");
        printf(">>> 奇迹！综合压力与别名优先级测试全线绿灯！你太强了！  <<<\n");
        printf("====================================================================\n");
    }
    return 0;
}