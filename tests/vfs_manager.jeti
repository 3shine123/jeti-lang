#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.hje>

// ==========================================================
// 1. @class 前向声明测试
// ==========================================================
@class DirectoryNode;
@class FSNode;

// ==========================================================
// 2. @protocol 契约声明：文件系统标准节点行为
// ==========================================================
@protocol FSItem
- (int)calculateSize;
- (void)dumpMetadataWithIndent:(int)indent;
@end


// ==========================================================
// 3. Base Class 基类：FSNode (抽象文件/目录基类)
// ==========================================================
@interface FSNode : NPObject <FSItem> {
@public
    char *_name;
    
    // 💥 弱引用父目录：防止父子节点相互持有产生 Retain Cycle 内存泄漏！
    // 同时也测试父节点销毁后，此弱指针自动抹零为 nil
    @public (weak) DirectoryNode *_parent;
}
@property char *name;
@property (weak) DirectoryNode *parent;

- (instancetype)initWithName:(char *)name;

@end


// ==========================================================
// 4. Subclass 子类：FileNode (具体文件节点)
// ==========================================================
@interface FileNode : FSNode {
@public
    int _fileSize;
    char *_mimeType;
}
@property int fileSize;
@property char *mimeType;

- (instancetype)initWithName:(char *)name size:(int)size mime:(char *)mime;

@end


// ==========================================================
// 5. Subclass 子类：DirectoryNode (目录节点，容器)
// ==========================================================
#define MAX_CHILDREN 16

@interface DirectoryNode : FSNode {
@public
    // 💥 存储子节点的对象指针数组
    FSNode *_children[MAX_CHILDREN];
    int _childCount;
}
@property int childCount;

- (instancetype)initWithName:(char *)name;
- (BOOL)addChildNode:(FSNode *)child;

// 💥 高阶特性：利用 Block 闭包遍历子目录，并支持通过 C 语言原生二级指针 (*stop) 提前终止遍历
- (void)enumerateChildrenUsingBlock:(void (^)(FSNode *node, BOOL *stop))block;

@end


// ==========================================================
// 6. Category 声明：为所有节点注入绝对路径解析和安全审计分类
// ==========================================================
@interface FSNode (PathResolution)
- (char *)absolutePath;
- (BOOL)isSandboxCompliantWithRoot:(char *)rootPath;
@end


// ==========================================================
// ==========================================================
// @implementation 类具体实现区 (C99 标准)
// ==========================================================
// ==========================================================

@implementation FSNode

@synthesize name = _name;
@synthesize parent = _parent;

- (instancetype)initWithName:(char *)name {
    self = [super init];
    if (self) {
        _name = (char *)malloc(strlen(name) + 1);
        strcpy(_name, name);
        _parent = nil;
    }
    return self;
}

// 多态虚方法基类实现
- (int)calculateSize {
    return 0;
}

- (void)dumpMetadataWithIndent:(int)indent {
    // 留给子类重写
}

- (void)dealloc {
    printf(" 🗑️ [注销节点] 物理内存清理 ➔ 基础节点 '%s' 已销毁。\n", _name);
    if (_name) {
        free(_name);
    }
}

@end


@implementation FileNode

@synthesize fileSize = _fileSize;
@synthesize mimeType = _mimeType;

- (instancetype)initWithName:(char *)name size:(int)size mime:(char *)mime {
    self = [super initWithName:name];
    if (self) {
        _fileSize = size;
        _mimeType = (char *)malloc(strlen(mime) + 1);
        strcpy(_mimeType, mime);
    }
    return self;
}

// 💥 重写多态计算大小方法
- (int)calculateSize {
    return _fileSize;
}

- (void)dumpMetadataWithIndent:(int)indent {
    for (int i = 0; i < indent; i++) printf("  ");
    printf("📄 [文件] %s (%d KB, 格式: %s)\n", _name, _fileSize, _mimeType);
}

- (void)dealloc {
    printf(" 🗑️ [注销文件] 数据区释放 ➔ 文件 '%s' 彻底销毁。\n", _name);
    if (_mimeType) {
        free(_mimeType);
    }
}

@end


@implementation DirectoryNode

@synthesize childCount = _childCount;

- (instancetype)initWithName:(char *)name {
    self = [super initWithName:name];
    if (self) {
        _childCount = 0;
        for (int i = 0; i < MAX_CHILDREN; i++) {
            _children[i] = nil;
        }
    }
    return self;
}

- (BOOL)addChildNode:(FSNode *)child {
    if (child == nil || _childCount >= MAX_CHILDREN) {
        return NO;
    }
    
    // 1. 将子目录的 parent 强行绑定弱引用关系（利用 mt_weak_assign 底层注册）
    [child setParent:self];
    
    // 2. 强引用持有子节点（计数加1）
    _children[_childCount] = child;
    NPObject_retain(child);
    _childCount++;
    
    return YES;
}

// 💥 实现计算总大小：递归计算目录及所有子项的总内存占用
- (int)calculateSize {
    int totalSize = 0;
    for (int i = 0; i < _childCount; i++) {
        totalSize += [_children[i] calculateSize];
    }
    return totalSize;
}

- (void)dumpMetadataWithIndent:(int)indent {
    for (int i = 0; i < indent; i++) printf("  ");
    printf("📁 [目录] %s/ (包含 %d 个子节点, 累计大小: %d KB)\n", _name, _childCount, [self calculateSize]);
    
    for (int i = 0; i < _childCount; i++) {
        [_children[i] dumpMetadataWithIndent:(indent + 1)];
    }
}

// 💥 核心高阶 Block 遍历器：带退出标记（*stop）
- (void)enumerateChildrenUsingBlock:(void (^)(FSNode *node, BOOL *stop))block {
    if (block == nil) return;
    
    BOOL stopExecution = NO;
    for (int i = 0; i < _childCount; i++) {
        // 传入当前节点，并传入指向外层局部 bool 变量的指针
        block(_children[i], &stopExecution);
        if (stopExecution) {
            printf("   ⚠️ [遍历中断] 闭包控制流触发了提前中断信号！\n");
            break;
        }
    }
}

- (void)dealloc {
    printf(" 🗑️ [注销目录] 容器递归注销 ➔ 开始清退目录 '%s' 下持有的所有子树...\n", _name);
    // 💥 静态 ARC 级联释放：强引用释放导致子节点计数清零，触发链式析构
    for (int i = 0; i < _childCount; i++) {
        if (_children[i]) {
            NPObject_release(_children[i]);
            _children[i] = nil;
        }
    }
}

@end


// ==========================================================
// 💥 分类实现区：利用弱引用链向上回溯解析绝对路径 (Recursive Path Walk)
// ==========================================================
@implementation FSNode (PathResolution)

- (char *)absolutePath {
    // 💥 极限挑战：通过不断访问 [self parent] 弱引用属性，逆向寻找根节点并拼装路径
    char *parts[32];
    int partCount = 0;
    
    FSNode *current = self;
    while (current != nil) {
        parts[partCount++] = [current name];
        // 💥 弱属性读取拦截：如果 parent 已被析构，此处读取将自动自愈返回 nil
        current = (FSNode *)[current parent]; 
        if (partCount >= 32) break;
    }
    
    // 分配大块 C 字符串缓冲区，逆序拼接
    char *result = (char *)malloc(512);
    strcpy(result, "");
    
    for (int i = partCount - 1; i >= 0; i--) {
        strcat(result, "/");
        strcat(result, parts[i]);
    }
    
    return result;
}

- (BOOL)isSandboxCompliantWithRoot:(char *)rootPath {
    char *myPath = [self absolutePath];
    BOOL result = NO;
    // 检查此文件路径是否位于合法的沙盒根路径下
    if (strstr(myPath, rootPath) == myPath) {
        result = YES;
    }
    free(myPath);
    return result;
}

@end


// ==========================================================
// 7. 主控台程序
// ==========================================================
int main(int argc, const char * argv[]) {
    @autoreleasepool {
        printf("\n======================================================\n");
        printf("    💾 Micrit 静态层级虚拟文件系统(VFS)与安全沙盒 💾    \n");
        printf("======================================================\n\n");

        // 1. 初始化根节点 (Root)
        DirectoryNode *root = [[DirectoryNode alloc] initWithName:"root"];

        // 2. 建立目录结构
        DirectoryNode *usr = [[DirectoryNode alloc] initWithName:"usr"];
        DirectoryNode *bin = [[DirectoryNode alloc] initWithName:"bin"];
        [root addChildNode:(FSNode *)usr];
        [root addChildNode:(FSNode *)bin];

        // usr 下建立 local 和 data
        DirectoryNode *local = [[DirectoryNode alloc] initWithName:"local"];
        FileNode *dbFile = [[FileNode alloc] initWithName:"database.db" size:240 mime:"application/sql"];
        [usr addChildNode:(FSNode *)local];
        [local addChildNode:(FSNode *)dbFile];

        // bin 下添加可执行脚本
        FileNode *shFile = [[FileNode alloc] initWithName:"init.sh" size:4 mime:"text/x-shellscript"];
        FileNode *execFile = [[FileNode alloc] initWithName:"compiler" size:1024 mime:"application/octet-stream"];
        [bin addChildNode:(FSNode *)shFile];
        [bin addChildNode:(FSNode *)execFile];

        printf(" --- 📊 VFS 目录层级结构展示 ---\n");
        [root dumpMetadataWithIndent:0];
        printf(" --------------------------------\n\n");

        // 3. 绝对路径逆向解析测试 (多层 Category 寻址 & 弱引用 parent 属性读取)
        char *dbPath = [dbFile absolutePath];
        char *execPath = [execFile absolutePath];
        printf(" 🔍 [路径审计] 文件 'database.db' ➔ %s\n", dbPath);
        printf(" 🔍 [路径审计] 文件 'compiler'    ➔ %s\n\n", execPath);
        free(dbPath);
        free(execPath);

        // 💥 安全沙盒权限检查 (Category + 符号解析)
        char *allowedRoot = "/root/usr";
        printf(" 🛡️ [沙盒防火墙] 限制根路径: '%s'\n", allowedRoot);
        printf("   - 'database.db' 合规性: %s\n", [dbFile isSandboxCompliantWithRoot:allowedRoot] ? "✅ 合规 (PASS)" : "❌ 违规 (BLOCKED)");
        printf("   - 'compiler'    合规性: %s\n\n", [execFile isSandboxCompliantWithRoot:allowedRoot] ? "✅ 合规 (PASS)" : "❌ 违规 (BLOCKED)");

        // -----------------------------------------------------
        // 4. 闭包高阶遍历与实时容量警报测试 (Block with Out Reference)
        // -----------------------------------------------------
        printf(" --- ⚡ [高阶遍历] 扫描 'bin' 目录中的超大文件(限额 500 KB)... ---\n");
        
        int sizeLimit = 500;
        // 💥 定义过滤器闭包，捕获 sizeLimit。
        // 并通过 C 语言二级指针形式修改 stop 指针以提前终止外层大循环
        void (^spaceScanner)(FSNode *, BOOL *) = ^void(FSNode *item, BOOL *stop) {
            int size = [item calculateSize];
            char *path = [item absolutePath];
            printf("   [扫描中...] 检查项: %s | 大小: %d KB\n", path, size);
            free(path);
            
            if (size > sizeLimit) {
                printf("   🚨 [容量警报] 文件 %s 超出安全存储上限！必须熔断！\n", [item name]);
                *stop = YES; // 💥 通过解引用修改外部循环执行状态！
            }
        };

        // 触发遍历
        [bin enumerateChildrenUsingBlock:spaceScanner];
        printf(" ----------------------------------------------------\n\n");

        // -----------------------------------------------------
        // 5. 双向弱引用自动置空机制的极限破坏测试 (Weak Link Nilling Test)
        // -----------------------------------------------------
        printf(" --- 🧬 [局部破坏实验：模拟删除 usr 目录] ---\n");
        {
            printf("  --> 将 'database.db' 的临时弱引用传出给一个外部监控器变量...\n");
            // 外部强指针持有临时监控变量，但监控变量内部是弱引用 parent
            // 我们这里用一个临时栈变量来做弱引用解析
        }
        
        // 彻底释放 usr 强节点
        printf("  --> 主动释放 'usr' 目录...\n");
        // usr 从 root 剪钩，或者我们直接对其强引用递减并销毁
        // 在 VFS 实战中，我们将 root 手动销毁，验证整体级联析构
        NPObject_release(root); // root 会析构 usr/bin，usr 会析构 local，local 会析构 dbFile

        // 💥 关键点：当 root 销毁后，所有子文件都被级联析构。
        // usr、local、bin、dbFile、shFile 应该全部安全地走完 dealloc 的 printf，验证 100% 内存无泄漏！
        // 此时，根据 FILO 栈式 ARC，所有后定义的临时变量、局部包装器指针会在下方安全退出，绝不发生 UAF 悬空野指针崩溃！
        
        printf("\n======================================================\n");
        printf("                    VFS 安全审计通关                    \n");
        printf("======================================================\n\n");
    }
    return 0;
}