#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface ExceptionThrower : NPObject
- (void)throwIfNegative:(int)val throws;
@end

@implementation ExceptionThrower
- (void)throwIfNegative:(int)val throws {
    printf("  checking %d...\n", val);
    if (val < 0) {
        printf("  throwing!\n");
        @throw [NPObject alloc];
    }
    printf("  OK\n");
}
@end

int main() {
    @autoreleasepool {
        ExceptionThrower *t = [[ExceptionThrower alloc] init];
        printf("Test 1: positive value\n");
        @try {
            [t throwIfNegative:5];
        } @catch(id exc) {
            printf("  caught exception!\n");
        } @finally {
            printf("  finally (test 1)\n");
        }

        printf("Test 2: negative value (throws)\n");
        @try {
            [t throwIfNegative:-1];
        } @catch(id exc) {
            printf("  caught exception!\n");
        } @finally {
            printf("  finally (test 2)\n");
        }
    }
    return 0;
}
