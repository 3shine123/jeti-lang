#include <stdio.h>
#import <Foundation/Foundation.hje>

@protocol Speaker
- (void)speak;
- (const char *)name;
@end

@interface Cat : NPObject <Speaker>
- (void)speak;
- (const char *)name;
@end

@interface Dog : NPObject <Speaker>
- (void)speak;
- (const char *)name;
@end

@implementation Cat
- (void)speak {
    printf("Meow!\n");
}
- (const char *)name {
    return "Cat";
}
@end

@implementation Dog
- (void)speak {
    printf("Woof!\n");
}
- (const char *)name {
    return "Dog";
}
@end

int main() {
    @autoreleasepool {
        id<Speaker> a = [[Cat alloc] init];
        id<Speaker> b = [[Dog alloc] init];
        [a speak];
        printf("  from %s\n", [a name]);
        [b speak];
        printf("  from %s\n", [b name]);
    }
    return 0;
}
