#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.hje>

// 定义一个“可配置/可描述”的协议
@protocol NPStringParsable
- (char *)toString;
@end

// ==========================================
// @interface: NPStringBuilder
// ==========================================
@interface NPStringBuilder : NPObject <NPStringParsable> {
@private
    char *_buffer;
    int _length;
    int _capacity;
}

// 属性暴露：当前字符串长度
@property int length;

// 构造与析构
- (instancetype)init;
- (instancetype)initWithString:(char *)initialStr;
- (void)dealloc;

// 工具核心方法
- (void)appendStr:(char *)str;
- (void)appendInt:(int)num;
- (void)clear;
- (char *)toString; // 实现协议方法

@end

// ==========================================
// @implementation: NPStringBuilder
// ==========================================
@implementation NPStringBuilder

- (instancetype)init {
    self = [super init];
    if (self) {
        self->_capacity = 16;
        self->_buffer = (char *)malloc(self->_capacity);
        self->_buffer[0] = '\0';
        self->_length = 0;
    }
    return self;
}

- (instancetype)initWithString:(char *)initialStr {
    self = [super init];
    if (self) {
        int initLen = strlen(initialStr);
        self->_capacity = initLen > 16 ? initLen * 2 : 32;
        self->_buffer = (char *)malloc(self->_capacity);
        strcpy(self->_buffer, initialStr);
        self->_length = initLen;
    }
    return self;
}

// 静态 ARC 会在变量生命周期结束时自动调用这个 dealloc
- (void)dealloc {
    if (self->_buffer) {
        free(self->_buffer);
        self->_buffer = NULL;
    }
    printf("[Tool Log] NPStringBuilder deallocated, dynamic memory freed.\n");
}

- (int)length {
    return self->_length;
}

- (void)appendStr:(char *)str {
    if (!str) return;
    int appendLen = strlen(str);
    int needed = self->_length + appendLen + 1;
    
    // 动态扩容机制
    if (needed > self->_capacity) {
        while (self->_capacity < needed) {
            self->_capacity *= 2;
        }
        self->_buffer = (char *)realloc(self->_buffer, self->_capacity);
    }
    
    strcat(self->_buffer, str);
    self->_length += appendLen;
}

- (void)appendInt:(int)num {
    char tmp[32];
    sprintf(tmp, "%d", num);
    [self appendStr:tmp];
}

- (void)clear {
    if (self->_buffer) {
        self->_buffer[0] = '\0';
        self->_length = 0;
    }
}

- (char *)toString {
    return self->_buffer;
}

@end

// ==========================================
// 工具函数的静态多态测试 (接受 id 类型)
// ==========================================
void PrintParsedToolObject(id <NPStringParsable> obj) {
    // 静态转译器会通过 Universal Vtable 动态派发 -toString
    printf("[Parsed Output]: %s\n", [obj toString]);
}

// ==========================================
// Main Function
// ==========================================
int main() {
    printf("=== Micrit Tooling Test: String Builder ===\n\n");

    // 1. 初始化工具对象
NPStringBuilder *sb = [[NPStringBuilder alloc] initWithString:"BaseURL: https://api.micrit.org"];

    // 2. 链式/连续调用工具方法拼装数据
    [sb appendStr:"/v1/user/"];
    [sb appendInt:8888];
    [sb appendStr:"?status="];
    [sb appendStr:"active"];
    
    // 3. 读取属性（点语法转译测试）
    printf("Generated URL Length: %d\n", sb.length);
    
    // 4. 协议与动态派发测试 (id 类型传入)
    PrintParsedToolObject(sb);
    
    // 5. 复用工具对象
    [sb clear];
    [sb appendStr:"[Log] System status OK. CPU: "];
    [sb appendInt:42];
    [sb appendStr:"%"];
    
    PrintParsedToolObject(sb);

    printf("\n=== Exiting Main (ARC should auto-trigger dealloc) ===\n");
    // sb 变量离开作用域，CFG 驱动的 Liveness Analysis 将在此处自动插入 release 并销毁 sb
    return 0;
}