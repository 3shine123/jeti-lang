#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface MathUtils : NPObject
+ (int)divide:(int)a by:(int)b @throws;
@end

@implementation MathUtils
+ (int)divide:(int)a by:(int)b @throws {
    if (b == 0) {
        @throw [NPObject alloc];
    }
    return a / b;
}
@end

int main() {
    @autoreleasepool {
        // Test 1: normal path — no exception
        printf("10/2 = %d\n", [MathUtils divide:10 by:2]);

        // Test 2: exception + catch + finally
        printf("\nTrying 10/0...\n");
        @try {
            int r = [MathUtils divide:10 by:0];
            printf("  result: %d\n", r);  // never reached
        } @catch(id exc) {
            printf("  division by zero caught!\n");
        } @finally {
            printf("  finally always runs\n");
        }

        // Test 3: nested @try — outer catches what inner @throw bypasses
        printf("\nNested try test:\n");
        @try {
            @try {
                printf("  inner try: about to throw\n");
                @throw [NPObject alloc];
                printf("  inner try: after throw (never printed)\n");
            } @finally {
                printf("  inner finally: cleanup\n");
            }
        } @catch(id exc) {
            printf("  outer catch: caught the throw\n");
        }

        printf("\nAll exception tests passed.\n");
    }
    return 0;
}
