#import <stdio.h>
#import <stdlib.h>
#import <string.h>
#import <time.h>
#import <termios.h>
#import <unistd.h>
#import <sys/select.h>
#import <Foundation/Foundation.hje>
#include <stdio.h>

// ==========================================================
// 1. 终端非阻塞原始模式
// ==========================================================
static struct termios orig_termios;

static void disableRawMode() {
    tcsetattr(STDIN_FILENO, TCSAFLUSH, &orig_termios);
    printf("\033[?25h"); 
    fflush(stdout);
}

static void enableRawMode() {
    tcgetattr(STDIN_FILENO, &orig_termios);
    atexit(disableRawMode);
    
    struct termios raw = orig_termios;
    raw.c_lflag &= ~(ECHO | ICANON);
    tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw);
    printf("\033[?25l"); 
    fflush(stdout);
}

static int kbhit() {
    struct timeval tv = {0, 100000}; // 100ms 高频键盘响应响应
    fd_set fds;
    FD_ZERO(&fds);
    FD_SET(STDIN_FILENO, &fds);
    return select(STDIN_FILENO + 1, &fds, NULL, NULL, &tv);
}

// ==========================================================
// 2. 井字棋核心引擎类
// ==========================================================
@interface TicTacToeEngine : NPObject {
    char _board[9];      // 💥 压力点：一维数组模拟 3x3 矩阵
    int _cursorX;        // 动态 UI 光标 X (0~2)
    int _cursorY;        // 动态 UI 光标 Y (0~2)
    char _currentTurn;   // 当前回合：'X' 或 'O'
    BOOL _gameOver;
    char _winner;        // 'X', 'O', 'D' (平局 Draw), ' ' (未结束)
    char _logMessage[64];
}
- (id)init;
- (BOOL)gameOver;
- (char)winner;
- (void)processInfut:(char)ch;
- (void)updateAndCheckWinWithBlock:(void (^)(char))resultBlock; // 💥 压力点：注入高阶闭包
- (void)render;
@end

@implementation TicTacToeEngine
- (id)init {
    self = [super init]; // 💥 继续严防死守 init 返回值对齐
    if (self) {
        for (int i = 0; i < 9; i++) {
            _board[i] = ' '; // 初始化棋盘为空白
        }
        _cursorX = 1;
        _cursorY = 1;        // 默认光标在九宫格中心
        _currentTurn = 'X';  // 默认由先手 X 开始
        _gameOver = NO;
        _winner = ' ';
        strcpy(_logMessage, "游戏开始！请使用 WASD 移动光标，[空格键]落子。");
    }
    return self;
}

- (BOOL)gameOver { return _gameOver; }
- (char)winner { return _winner; }

- (void)processInfut:(char)ch {
    if (_gameOver) return;
    
    // 动态 UI 光标移动与越界防御
    if (ch == 'w' || ch == 'W') { if (_cursorY > 0) _cursorY--; }
    else if (ch == 's' || ch == 'S') { if (_cursorY < 2) _cursorY++; }
    else if (ch == 'a' || ch == 'A') { if (_cursorX > 0) _cursorX--; }
    else if (ch == 'd' || ch == 'D') { if (_cursorX < 2) _cursorX++; }
    else if (ch == ' ') { // 空格键落子
        int idx = _cursorY * 3 + _cursorX; // 💥 扁平数组坐标映射公式
        
        if (_board[idx] == ' ') {
            _board[idx] = _currentTurn;
            snprintf(_logMessage, sizeof(_logMessage), "玩家 %c 成功在棋盘 (%d, %d) 落子！", _currentTurn, _cursorX + 1, _cursorY + 1);
            
            // 切换回合玩家
            _currentTurn = (_currentTurn == 'X') ? 'O' : 'X';
        } else {
            strcpy(_logMessage, "⚠️ 警告：该位置已有棋子，请移动光标另选格子！");
        }
    }
}

- (void)updateAndCheckWinWithBlock:(void (^)(char))resultBlock {
    if (_gameOver) return;
    
    char w = ' ';
    
    // 1. 扫描 3 行获胜组合
    for (int i = 0; i < 3; i++) {
        if (_board[i*3] != ' ' && _board[i*3] == _board[i*3+1] && _board[i*3] == _board[i*3+2]) {
            w = _board[i*3];
        }
    }
    // 2. 扫描 3 列获胜组合
    for (int i = 0; i < 3; i++) {
        if (_board[i] != ' ' && _board[i] == _board[i+3] && _board[i] == _board[i+6]) {
            w = _board[i];
        }
    }
    // 3. 扫描 2 条对角线
    if (_board[0] != ' ' && _board[0] == _board[4] && _board[0] == _board[8]) w = _board[0];
    if (_board[2] != ' ' && _board[2] == _board[4] && _board[2] == _board[6]) w = _board[2];
    
    // 如果有玩家胜出
    if (w != ' ') {
        _winner = w;
        _gameOver = YES;
        resultBlock(_winner); // 💥 触发闭包回调
        return;
    }
    
    // 4. 扫描全盘检查是否平局 (Draw)
    BOOL isFull = YES;
    for (int i = 0; i < 9; i++) {
        if (_board[i] == ' ') {
            isFull = NO;
            break;
        }
    }
    
    if (isFull) {
        _winner = 'D'; // 'D' 代表 Draw
        _gameOver = YES;
        resultBlock(_winner); // 💥 平局同样触发闭包结算
    }
}

- (void)render {
    printf("\033[H"); // 光标归位复动，实现流畅不闪烁
    printf("===================================================\n");
    printf("         ❌ ⭕ MICRIT 终端智能井字棋 (Tic-Tac-Toe)  \n");
    printf("===================================================\n");
    printf("  操作说明: WASD 移动选中框 | [空格键] 落子 | Q 退出 \n\n");
    
    // 严格等宽的九宫格渲染逻辑
    for (int y = 0; y < 3; y++) {
        printf("                 "); // 居中排版偏移
        for (int x = 0; x < 3; x++) {
            char cell = _board[y * 3 + x];
            
            // 如果正好是当前光标所在网格，用中括号包围强化视觉
            if (y == _cursorY && x == _cursorX) {
                if (cell == ' ') printf("[%c]", '_');
                else printf("[%c]", cell);
            } else {
                if (cell == ' ') printf(" . ");
                else printf(" %c ", cell);
            }
            
            if (x < 2) printf("|"); // 列分割线
        }
        printf("\n");
        if (y < 2) printf("                 ---+---+---\n"); // 行分割线
    }
    
    printf("\n---------------------------------------------------\n");
    if (!_gameOver) {
        printf(" 📢 当前战局：轮到【 玩家 %c 】运筹帷幄！\n", _currentTurn);
    } else {
        if (_winner == 'D') {
            printf(" 🤝 战局结果：棋逢对手，不分伯仲！本局平局 (Draw)！\n");
        } else {
            printf(" 🎉 战局结果：大获全胜！恭喜【 玩家 %c 】斩获胜利！\n", _winner);
        }
    }
    printf(" 📜 棋局播报: %s\n", _logMessage);
    printf("===================================================\n");
}
@end

// ==========================================================
// 3. 主程序入口
// ==========================================================
int main() {
    @autoreleasepool {
        srand(time(NULL));
        enableRawMode();
        printf("\033[2J\033[H"); // 华丽的开局物理全清屏
        
        TicTacToeEngine *engine = [[TicTacToeEngine alloc] init];
        
        // 💥 闭包极限压榨：捕获多重上下文环境局部变量
        int matchId = 101;
        int rewardScore = 500;
        
        void (^celebrationBlock)(char) = ^void(char finalWinner) {
            // 在闭包内高强度访问和格式化外部捕获的局部变量
            if (finalWinner == 'D') {
                printf(" 【赛事中心】战局 #%d 结束。平局无额外奖励。再接再厉！\n", matchId);
            } else {
                printf(" 【赛事中心】战局 #%d 完美闭幕！胜利者将独享 %d 点天梯积分！\n", matchId, rewardScore);
            }
        };
        
        // 游戏非阻塞主循环
        while (![engine gameOver]) {
            [engine render];
            
            if (kbhit()) {
                char ch;
                if (read(STDIN_FILENO, &ch, 1) == 1) {
                    if (ch == 'q' || ch == 'Q') break;
                    [engine processInfut:ch];
                }
            }
            
            // 每一帧将闭包传入状态机，监测连线结果
            [engine updateAndCheckWinWithBlock:celebrationBlock];
        }
        
        // 最后一帧渲染，锁定最终胜负画面
        [engine render];
        
        disableRawMode();
        
        printf("\n===================================================\n");
        printf("                    THANK YOU                      \n");
        printf("===================================================\n");
        printf(" 🏁 终端棋局结束。Micrit 语言高级闭包与一维映射测试完毕！\n");
        printf("===================================================\n");
        
        if (engine) NPObject_release(engine);
    }
    return 0;
}