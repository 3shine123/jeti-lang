// lang-test/vfs_event_bus_test.jeti
// Jeti 语言全新压测案例：「操作系统虚拟文件系统 (VFS) 与异步 I/O 监听总线」
// 核心轰炸点：@protocol 接口多态 + 泛型 Buffer<T> + 父子节点 __weak 弱引用 + Category 静态扩展 + Block 事件响应

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.hje>

// ============================================================================
// 1. 命名空间一：System::IO (底层泛型 I/O 环形缓冲区)
// ============================================================================
@namespace System::IO

    // 🌟 泛型组件：通用 I/O 数据块缓冲区 Buffer<T>
    @interface Buffer<T> : NPObject {
        @public
        T _ring[3];
        int _head;
        int _tail;
        int _count;
    }
    @property (readonly) int count;

    - (id)init;
    - (BOOL)enqueue:(T)item;
    - (T)dequeue;
    @end

    @implementation Buffer<T>
    @synthesize count = _count;

    - (id)init {
        self = [super init];
        if (self) {
            _head = 0;
            _tail = 0;
            _count = 0;
            _ring[0] = nil;
            _ring[1] = nil;
            _ring[2] = nil;
        }
        return self;
    }

    - (BOOL)enqueue:(T)item {
        if (_count < 3) {
            _ring[_tail] = [item retain];
            _tail = (_tail + 1) % 3;
            _count++;
            printf("[System::IO::Buffer<T>] 成功写入数据块！当前队列积压: %d\n", _count);
            return YES;
        }
        printf("[System::IO::Buffer<T>] 缓冲区溢出 (Overflow)！写入拒绝。\n");
        return NO;
    }

    - (T)dequeue {
        if (_count > 0) {
            T item = _ring[_head];
            _ring[_head] = nil;
            _head = (_head + 1) % 3;
            _count--;
            return [item autorelease];
        }
        return nil;
    }

    - (void)dealloc {
        printf("[System::IO::Buffer<T>] 物理 I/O 环形缓冲区被销毁。\n");
        for (int i = 0; i < 3; i++) {
            if (_ring[i]) [_ring[i] release];
        }
        [super dealloc];
    }
    @end
@endnamespace


// ============================================================================
// 2. 命名空间二：System::VFS (虚拟文件系统抽象树)
// ============================================================================
@namespace System::VFS

    // 抽象接口：文件系统节点协议
    @protocol FSNodeProtocol
    - (const char*)nodeName;
    - (int)calculateSize;
    - (void)syncToDisk;
    @end

    // 前向声明目录节点
    @class DirectoryNode;

    // 具体类 1：文件节点
    @interface FileNode : NPObject <FSNodeProtocol> {
        @public
        const char* _fileName;
        int _bytesSize;
        // 核心：指向父目录的弱引用 __weak，打破 Parent <-> Child 循环引用！
        __weak DirectoryNode* _parentDir;
    }
    @property const char* fileName;
    @property int bytesSize;
    @property (nonatomic, weak) DirectoryNode* parentDir;

    - (id)initWithName:(const char*)name size:(int)sz;
    @end

    @implementation FileNode
    @synthesize fileName = _fileName;
    @synthesize bytesSize = _bytesSize;
    @synthesize parentDir = _parentDir;

    - (id)initWithName:(const char*)name size:(int)sz {
        self = [super init];
        if (self) {
            _fileName = name;
            _bytesSize = sz;
            _parentDir = nil;
        }
        return self;
    }

    - (const char*)nodeName { return _fileName; }
    - (int)calculateSize { return _bytesSize; }

    - (void)syncToDisk {
        printf("[FileNode] 刷盘刷入扇区 -> 文件: %s (%d KB)\n", _fileName, _bytesSize);
    }

    - (void)dealloc {
        printf("[FileNode] 文件 [%s] 节点物理解构已从内存移出。\n", _fileName);
        [super dealloc];
    }
    @end


    // 具体类 2：目录节点 (可包含多个节点)
    @interface DirectoryNode : NPObject <FSNodeProtocol> {
        @public
        const char* _dirName;
        NPObject<FSNodeProtocol>* _children[2];
        int _childCount;
    }
    @property const char* dirName;

    - (id)initWithName:(const char*)name;
    - (void)addChildNode:(NPObject<FSNodeProtocol>*)node;
    @end

    @implementation DirectoryNode
    @synthesize dirName = _dirName;

    - (id)initWithName:(const char*)name {
        self = [super init];
        if (self) {
            _dirName = name;
            _childCount = 0;
            _children[0] = nil;
            _children[1] = nil;
        }
        return self;
    }

    - (void)addChildNode:(NPObject<FSNodeProtocol>*)node {
        if (_childCount < 2 && node) {
            _children[_childCount] = [node retain];
            
            // 如果添加的是 FileNode，强行设置其 parentDir 弱引用
            // (利用类型检查或协议尝试)
            FileNode* file = (FileNode*)node;
            [file setParentDir:self];

            _childCount++;
            printf("[DirectoryNode] 目录 [%s] 成功装载节点 [%s]\n", _dirName, [node nodeName]);
        }
    }

    - (const char*)nodeName { return _dirName; }

    - (int)calculateSize {
        int total = 0;
        for (int i = 0; i < _childCount; i++) {
            total += [_children[i] calculateSize];
        }
        return total;
    }

    - (void)syncToDisk {
        printf("[DirectoryNode] 正在递归同步目录 [%s] 下的所有子节点...\n", _dirName);
        for (int i = 0; i < _childCount; i++) {
            [_children[i] syncToDisk];
        }
    }

    - (void)dealloc {
        printf("[DirectoryNode] 目录 [%s] 正在销毁其内部子节点树...\n", _dirName);
        for (int i = 0; i < _childCount; i++) {
            if (_children[i]) [_children[i] release];
        }
        [super dealloc];
    }
    @end
@endnamespace


// ============================================================================
// 3. Category 注入扩展：给 FileNode 添加压缩与加密诊断功能
// ============================================================================
@interface System::VFS::FileNode (Compression)
- (void)compressWithAlgorithm:(const char*)algo;
@end

@implementation System::VFS::FileNode (Compression)
- (void)compressWithAlgorithm:(const char*)algo {
    printf("[Category 扩展] 文件 [%s] 正在执行 [%s] 压缩优化，体积缩减 30%%\n", 
           _fileName, algo);
}
@end


// ============================================================================
// 4. 命名空间三：System::Notifier (异步事件通知总线)
// ============================================================================
@namespace System::Notifier

    typedef void (^IOMonitorBlock)(const char* eventType, System::VFS::FileNode* targetFile);

    @interface EventBus : NPObject {
        @public
        IOMonitorBlock _listener;
    }
    - (void)registerListener:(IOMonitorBlock)block;
    - (void)emitEvent:(const char*)evt forFile:(System::VFS::FileNode*)file;
    @end

    @implementation EventBus
    - (id)init {
        self = [super init];
        if (self) { _listener = nil; }
        return self;
    }

    - (void)registerListener:(IOMonitorBlock)block {
        _listener = block;
    }

    - (void)emitEvent:(const char*)evt forFile:(System::VFS::FileNode*)file {
        printf("[EventBus] 捕获到底层系统事件 [%s]\n", evt);
        if (_listener) {
            _listener(evt, file);
        }
    }

    - (void)dealloc {
        printf("[EventBus] 监听总线销毁。\n");
        [super dealloc];
    }
    @end
@endnamespace


// ============================================================================
// 5. 导入机制与类型别名定义
// ============================================================================

// Form 3: 引入整个 VFS 命名空间
@using namespace System::VFS;

// Form 2: 别名 1 - 单态化泛型文件缓冲区
@using FileQueue = System::IO::Buffer<System::VFS::FileNode*>*;

// Form 2: 别名 2 - 简写事件总线
@using Bus = System::Notifier::EventBus*;


// ============================================================================
// 6. 主程序测试入口
// ============================================================================
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("=========================================================\n");
        printf(">>>  jetic 压测套件：「VFS 虚拟文件系统与异步总线」 <<<\n");
        printf("=========================================================\n\n");

        // ----------------------------------------------------
        // 测试点 1：协议 (Protocol) 多态与 VFS 目录树构建
        printf("--- 1. 测试 @protocol 接口多态性与递归树算法 ---\n");

        DirectoryNode* rootDir = [[DirectoryNode alloc] initWithName:"/usr/bin"];
        
        FileNode* sysLog = [[FileNode alloc] initWithName:"kernel.log" size:256];
        FileNode* userConfig = [[FileNode alloc] initWithName:"settings.json" size:64];

        [rootDir addChildNode:sysLog];
        [rootDir addChildNode:userConfig];

        // 验证多态计算
        printf("[VFS 校验] 根目录 [%s] 递归汇总计算总容量: %d KB (预期: 320)\n", 
               [rootDir nodeName], [rootDir calculateSize]);

        // 调用 Category 注入函数
        [sysLog compressWithAlgorithm:"ZSTD"];

        // ----------------------------------------------------
        // 测试点 2：ObjC 单态化泛型队列 (FileQueue) 入队与出队
        printf("\n--- 2. 测试泛型别名 Buffer<FileNode*> 的异步刷盘队列 ---\n");

        FileQueue ioQueue = [[System::IO::Buffer<System::VFS::FileNode*> alloc] init];

        [ioQueue enqueue:sysLog];
        [ioQueue enqueue:userConfig];

        // 释放本地强引用（交由树和队列持存）
        [sysLog release];
        [userConfig release];

        // ----------------------------------------------------
        // 测试点 3：__weak 弱引用与 Parent 指针安全性校验
        printf("\n--- 3. 校验父子节点 __weak 弱引用 (防止循环引用) ---\n");

        __weak DirectoryNode* weakDirRef = [sysLog parentDir];
        if (weakDirRef) {
            printf("[弱引用验证] 文件 sysLog 的父目录指针正常指向: %s\n", [weakDirRef nodeName]);
        }

        // ----------------------------------------------------
        // 测试点 4：Block 闭包状态捕获与 EventBus 事件派发
        printf("\n--- 4. 测试 EventBus 闭包监听与环境变量捕获 ---\n");

        Bus bus = [[System::Notifier::EventBus alloc] init];

        int capturedMagicCode = 0xDEADBEEF;

        // 注册带捕获环境的 Block
        [bus registerListener:^void(const char* evt, FileNode* file) {
            printf("  [监听器回调] 收到通知！魔数标记: 0x%X\n", capturedMagicCode);
            printf("              事件类型: %s | 触发目标文件: %s\n", 
                   evt, [file fileName]);
        }];

        // 从泛型队列弹出一个文件，并为其触发事件通知
        FileNode* dequeuedFile = [ioQueue dequeue];
        [bus emitEvent:"FILE_MODIFIED" forFile:dequeuedFile];

        // 手动刷盘
        [dequeuedFile syncToDisk];

        // ----------------------------------------------------
        // 测试点 5：恶心边界 —— 消息接收者嵌套三元与自减副作用
        printf("\n--- 5. 边界求值测试：方括号内三元运算符 + 自减副作用 ---\n");

        int flag = 1;
        int sideEffectCounter = 99;

        // 方括号内极其恶心的求值表达式
        const char* resultName = [(flag ? ((sideEffectCounter--, dequeuedFile)) : nil) nodeName];
        
        printf("[副作用断言] 计算成功！自减后计数器: %d (预期: 98) | 提取文件名: %s\n", 
               sideEffectCounter, resultName);

        // ----------------------------------------------------
        // 6. 拓扑清理
        printf("\n--- 6. 开始安全物理销毁 VFS 结构树 ---\n");
        [bus release];
        [ioQueue release];
        [rootDir release]; // rootDir 释放将级联释放 children，并触发 FileNode 的 dealloc

        printf("\n=========================================================\n");
        printf(">>>   恭喜！VFS 虚拟文件系统与异步总线测试顺利通过！  <<<\n");
        printf("=========================================================\n");
    }
    return 0;
}