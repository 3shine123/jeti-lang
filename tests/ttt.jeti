#include <stdio.h>

#import <Foundation/Foundation.hje>

@interface Game : NPObject
@property int board[9];
- (void)initBoard;
- (void)play:(int)pos player:(int)p;
@end

@implementation Game
- (void)initBoard {
    for (int i = 0; i < 9; i++) {
        self.board[i] = 0;
    }
}
- (void)play:(int)pos player:(int)p {
    if (pos >= 0 && pos < 9) {
        self.board[pos] = p;
    }
}
@end

int main() {
    Game *game = [Game alloc];
    [game initBoard];
    [game play:4 player:1]; // 占据中心
    return 0;
}