// 基于 NPFoundation 框架的 Objective-C 风格工具类测试

#import <Foundation/Foundation.hje>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// ============ 1. 模拟一个简单的学生/数据对象 ============
@interface NPStudent : NPObject
{
    const char* name;
    int score;
    int studentId;
}
- (id)initWithName:(const char*)aName studentId:(int)sId score:(int)aScore;
- (const char*)getName;
- (int)getStudentId;
- (int)getScore;
- (void)displayInfo;
@end

@implementation NPStudent
- (id)initWithName:(const char*)aName studentId:(int)sId score:(int)aScore
{
    self = [super init];
    if (self) {
        // 简化处理，实际中可能需要 strdup
        name = aName;
        studentId = sId;
        score = aScore;
    }
    return self;
}

- (const char*)getName { return name; }
- (int)getStudentId { return studentId; }
- (int)getScore { return score; }

- (void)displayInfo
{
    printf("[学号: %04d] 姓名: %-8s | 分数: %d\n", studentId, name, score);
}
@end


// ============ 2. 核心工具类：数据统计管理器 ============
#define MAX_RECORDS 20

@interface NPDataCollector : NPObject
{
    NPStudent* records[MAX_RECORDS];
    int currentCount;
    const char* className;
}
- (id)initWithClassName:(const char*)cName;
- (BOOL)addStudent:(NPStudent*)student;
- (void)printAllRecords;
- (double)calculateAverageScore;
- (NPStudent*)findHighestScorer;
- (void)clearAllRecords;
@end

@implementation NPDataCollector

- (id)initWithClassName:(const char*)cName
{
    self = [super init];
    if (self) {
        className = cName;
        currentCount = 0;
        for (int i = 0; i < MAX_RECORDS; i++) {
            records[i] = nil;
        }
    }
    return self;
}

- (BOOL)addStudent:(NPStudent*)student
{
    if (currentCount >= MAX_RECORDS || student == nil) {
        return NO;
    }
    
    // 模仿 ObjC 的内存管理：加入集合时增加引用计数（如果你的语言支持的话）
    // [student retain]; 
    
    records[currentCount] = student;
    currentCount++;
    return YES;
}

- (void)printAllRecords
{
    printf("\n=== 班级: %s (当前总人数: %d) ===\n", className, currentCount);
    for (int i = 0; i < currentCount; i++) {
        if (records[i]) {
            [records[i] displayInfo];
        }
    }
    printf("======================================\n");
}

- (double)calculateAverageScore
{
    if (currentCount == 0) return 0.0;
    
    int totalScore = 0;
    for (int i = 0; i < currentCount; i++) {
        totalScore += [records[i] getScore];
    }
    return (double)totalScore / currentCount;
}

- (NPStudent*)findHighestScorer
{
    if (currentCount == 0) return nil;
    
    NPStudent* topStudent = records[0];
    for (int i = 1; i < currentCount; i++) {
        if ([records[i] getScore] > [topStudent getScore]) {
            topStudent = records[i];
        }
    }
    return topStudent;
}

- (void)clearAllRecords
{
    for (int i = 0; i < currentCount; i++) {
        if (records[i]) {
            [records[i] release]; // 释放持有的对象
            records[i] = nil;
        }
    }
    currentCount = 0;
}

- (void)dealloc
{
    [self clearAllRecords];
    [super dealloc];
}
@end


// ============ 3. 程序入口：功能测试 ============
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf(">>> 开始 NPFoundation 工具类测试 <<<\n");

        // 1. 初始化工具管理类
        NPDataCollector* collector = [[NPDataCollector alloc] initWithClassName:"宇宙航天一班"];

        // 2. 创建测试数据
        NPStudent* s1 = [[NPStudent alloc] initWithName:"艾伦" studentId:1001 score:95];
        NPStudent* s2 = [[NPStudent alloc] initWithName:"三笠" studentId:1002 score:98];
        NPStudent* s3 = [[NPStudent alloc] initWithName:"阿尔敏" studentId:1003 score:92];
        NPStudent* s4 = [[NPStudent alloc] initWithName:"利威尔" studentId:1004 score:100];

        // 3. 将数据组装进工具类
        [collector addStudent:s1];
        [collector addStudent:s2];
        [collector addStudent:s3];
        [collector addStudent:s4];

        // 4. 测试打印功能
        [collector printAllRecords];

        // 5. 测试算法统计功能
        double avg = [collector calculateAverageScore];
        printf("\n[统计结果] 班级平均分: %.2f\n", avg);

        NPStudent* top = [collector findHighestScorer];
        if (top != nil) {
            printf("[荣誉榜] 最高分获得者: %s (%d分)\n", [top getName], [top getScore]);
        }

        // 6. 内存清理测试
        printf("\n>>> 正在释放内存... <<<\n");
        // 容器 dealloc 会释放内部持有的学生，无需手动释放
        [collector release];

        printf(">>> 测试顺利结束！ <<<\n");
    }
    return 0;
}