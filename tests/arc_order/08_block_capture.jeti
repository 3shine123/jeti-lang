#import <Foundation/Foundation.hje>

// ARC order 08: a block literal captures an owned local, and the block is
// CALLED inside the exit expression. The capture must be established (block
// constructed) and the call must complete before the local is released.

@interface AO08Holder : NPObject
- (int)value;
@end

@implementation AO08Holder
- (void)dealloc {
    NPLog(@"ao08 dealloc");
    [super dealloc];
}
- (int)value { return 7; }
@end

int ao08_run(void) {
    AO08Holder *h = [[AO08Holder alloc] init];
    // NOTE: `^int()` (empty parameter list), not `^int(void)` — the latter is
    // a separate pre-existing parser bug (it emits a parameter literally named
    // `void`). Unrelated to ARC ordering.
    int (^blk)(void) = ^int() {
        return [h value];
    };
    return blk() - 7;
}

int main() {
    NPLog(@"ao08 r=%d", ao08_run());
    return 0;
}
