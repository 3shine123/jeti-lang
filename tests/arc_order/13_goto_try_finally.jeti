#import <Foundation/Foundation.hje>

// ARC order 13: `goto` inside a @try body. The jump leaves the inner block
// (so its local is released), stays inside the @try (so the @finally still
// runs on normal completion).

@interface AO13Item : NPObject
@end

@implementation AO13Item
- (void)dealloc {
    NPLog(@"ao13 dealloc");
    [super dealloc];
}
@end

int main() {
    @try {
        {
            AO13Item *x = [[AO13Item alloc] init];
            goto inside;
        }
    inside:
        NPLog(@"ao13 after goto");
    }
    @finally {
        NPLog(@"ao13 finally");
    }
    NPLog(@"ao13 done");
    return 0;
}
