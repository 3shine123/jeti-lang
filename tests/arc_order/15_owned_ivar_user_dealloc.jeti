#import <Foundation/Foundation.hje>

// ARC order 15: a class WITH a user `dealloc` owns its ivar policy. ARC must
// NOT add a synthesized release on top of it — the body below already releases
// both ivars, so a second release would double-free.
//
// This is the shape `tests/space_dodge.jeti` uses (handwritten
// `NPObject_release(_obs)` in dealloc), which regressed when ARC synthesized
// ivar release for every class regardless.

@interface AO15Child : NPObject
@end

@implementation AO15Child
- (void)dealloc {
    NPLog(@"ao15 child dealloc");
    [super dealloc];
}
@end

@interface AO15Owner : NPObject {
@public
    AO15Child *_a;
    AO15Child *_b;
}
@end

@implementation AO15Owner
- (instancetype)init {
    self = [super init];
    if (self) {
        _a = [[AO15Child alloc] init];
        _b = [[AO15Child alloc] init];
    }
    return self;
}
- (void)dealloc {
    NPLog(@"ao15 owner dealloc");
    if (_a) NPObject_release(_a);
    if (_b) NPObject_release(_b);
    [super dealloc];
}
@end

int main() {
    AO15Owner *o = [[AO15Owner alloc] init];
    NPLog(@"ao15 done using");
    return 0;
}
