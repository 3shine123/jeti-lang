#import <Foundation/Foundation.hje>

// ARC order 05: early return inside a branch, plus a later return in the same
// body. Every exit evaluates its own expression before releasing, and every
// path releases exactly once (the branch that returns must not rob the
// fall-through path of its release).

@interface AO05Holder : NPObject {
@public
    NPString *_s;
}
- (NPString *)text;
@end

@implementation AO05Holder
- (instancetype)init {
    self = [super init];
    if (self) { _s = [[NPString alloc] initWithUTF8String:"hello"]; }
    return self;
}
- (void)dealloc {
    _s = nil;
    NPLog(@"ao05 dealloc");
    [super dealloc];
}
- (NPString *)text { return _s; }
@end

int ao05_probe(int cond) {
    AO05Holder *h = [[AO05Holder alloc] init];
    if (cond) {
        return [[h text] length] - 5;
    }
    NPLog(@"ao05 fallthrough");
    return [[h text] length];
}

int main() {
    int a = ao05_probe(1);
    int b = ao05_probe(0);
    NPLog(@"ao05 a=%d b=%d", a, b);
    return (a == 0 && b == 5) ? 0 : 1;
}
