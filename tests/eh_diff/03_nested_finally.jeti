// 差分用例 3:嵌套 @finally 执行顺序 —— inner finally 在传播给外层 catch 之前执行
#import <Foundation/Foundation.hje>

int main() {
    @try {
        @try {
            NPLog(@"inner try");
            @throw @"inner-err";
        }
        @finally {
            NPLog(@"inner finally");
        }
    }
    @catch (NPString *e) {
        NPLog(@"outer caught");
    }
    @finally {
        NPLog(@"outer finally");
    }
    NPLog(@"end");
    return 0;
}
