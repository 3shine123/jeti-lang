// 差分用例 4:catch 内 rethrow —— 必须传播到外层 catch,不得重入本层
#import <Foundation/Foundation.hje>

@interface Err : NPObject @end
@implementation Err
@end

int main() {
    @try {
        @try {
            @throw [[Err alloc] init];
        }
        @catch (Err *e) {
            NPLog(@"inner caught, rethrow");
            @throw e;
        }
    }
    @catch (Err *e2) {
        NPLog(@"outer caught");
    }
    NPLog(@"end");
    return 0;
}
