// 差分用例 1:跨帧释放 —— 中间帧持有 owned 对象,异常穿透时必须释放
// ObjC 基准:unwind 经过 middle 时 ARC 释放 m;catch 结束后运行时释放被抛对象
#import <Foundation/Foundation.hje>

@interface Item : NPObject @end
@implementation Item
- (void)dealloc {
    NPLog(@"Item dealloc");
}
@end

@interface Thrower : NPObject @end
@implementation Thrower
+ (void)boom {
    @throw [[Item alloc] init];
}
+ (void)middle {
    Item *m = [[Item alloc] init];
    NPLog(@"middle created m");
    [Thrower boom];
}
@end

int main() {
    // 与 .m 对齐:基准在 @autoreleasepool 内跑,抛出对象的最后一个引用随池
    // drain 释放(catch 之后)。return 放在池外——池 pop 仍先于返回,stderr 一致。
    @autoreleasepool {
        @try {
            [Thrower middle];
        }
        @catch (Item *e) {
            NPLog(@"caught");
        }
        NPLog(@"--- end ---");
    }
    return 0;
}
