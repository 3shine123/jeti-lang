// 差分用例 5:typed catch 链 —— 类型不匹配的 catch 必须放行给外层
#import <Foundation/Foundation.hje>

@interface A : NPObject @end
@implementation A
@end

@interface B : NPObject @end
@implementation B
@end

int main() {
    @try {
        @try {
            @throw [[B alloc] init];
        }
        @catch (A *a) {
            NPLog(@"caught A (wrong)");
        }
    }
    @catch (B *b) {
        NPLog(@"caught B");
    }
    NPLog(@"end");
    return 0;
}
