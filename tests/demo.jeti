#import <Foundation/Foundation.hje>
#include <stdio.h>

int main(void) {
    int i;
    scanf("%d", &i);
    switch (i) {
        case < 3:
            printf("123\n");
            break;
        case > 3:
            printf("456\n");
            break;
        default:
            printf("Other\n");
    }

    return 0;
}