#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface Node : NPObject
@property int value;
@property (nonatomic, weak) Node *next;
@end

@implementation Node
- (void)dealloc {
    printf("dealloc %d\n", self.value);
}
@end

int main() {
    Node *n1 = [Node new];
    n1.value = 1;
    {
        Node *n2 = [Node new];
        n2.value = 2;
        n1.next = n2;
        printf("n2 created\n");
    }
    if (n1.next == nil) {
        printf("weak auto-nilled\n");
    }
    printf("done\n");
    return 0;
}
