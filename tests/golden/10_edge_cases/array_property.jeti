#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface Board : NPObject
@property int board[9];
@end

@implementation Board
@end

int main() {
    Board *b = [[Board alloc] init];
    b.board[0] = 1;
    b.board[4] = 2;
    b.board[8] = 3;
    printf("%d %d %d\n", b.board[0], b.board[4], b.board[8]);
    return 0;
}
