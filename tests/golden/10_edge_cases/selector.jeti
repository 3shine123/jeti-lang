#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface Foo : NPObject
- (void)bar:(int)x;
@end

@implementation Foo
- (void)bar:(int)x {
    printf("bar:%d\n", x);
}
@end

int main() {
    SEL s1 = @selector(bar:);
    SEL s2 = @selector(bar:);
    if (s1.hash == s2.hash) {
        printf("stable\n");
    }
    return 0;
}
