#include <stdio.h>
#import <Foundation/Foundation.hje>

#define DOUBLE(x) ((x) * 2)
#define MIN(a, b) ((a) < (b) ? (a) : (b))

@interface Calculator : NPObject
+ (int)compute;
@end

@implementation Calculator
+ (int)compute {
    int a = 10;
    int b = 20;
    int doubled = DOUBLE(a);
    int min = MIN(a, b);
    printf("DOUBLE(%d) = %d\n", a, doubled);
    printf("MIN(%d, %d) = %d\n", a, b, min);
    return doubled + min;
}
@end

int main() {
    @autoreleasepool {
        int result = [Calculator compute];
        printf("result = %d\n", result);
    }
    return 0;
}