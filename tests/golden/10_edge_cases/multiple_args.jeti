#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface Calculator : NPObject
- (int)compute:(int)a b:(int)b c:(int)c;
@end

@implementation Calculator
- (int)compute:(int)a b:(int)b c:(int)c {
    return a + b * c;
}
@end

int main() {
    Calculator *c = [[Calculator alloc] init];
    int r = [c compute:2 b:3 c:4];
    printf("result=%d\n", r);
    return 0;
}
