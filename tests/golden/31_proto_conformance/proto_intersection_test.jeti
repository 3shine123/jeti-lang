#import <Foundation/Foundation.hje>
#include <stdio.h>

// Protocol intersection `P & Q` (route map item #3):
//  1. composed protocol declaration  @protocol R <P & Q>
//  2. intersection type on receivers id<Drawable & Serializable>
// `&` joins protocols into one conjunction list — the receiver must satisfy
// ALL of them. Codegen is untouched: the uniform vtable makes dispatch
// receiver-type-agnostic; the checker enforces the constraint at compile time.

@protocol Drawable
@required
- (void)draw;
@end

@protocol Serializable
@required
- (const char *)serialize;
@end

// Composition: Renderable requires everything from Drawable & Serializable
@protocol Renderable <Drawable & Serializable>
@required
- (int)renderPriority;
@end

// Canvas conforms via the composed protocol (parents: Drawable, Serializable)
@interface Canvas <Renderable>
@end

@implementation Canvas
- (void)draw { printf("draw\n"); }
- (const char *)serialize { return "canvas"; }
- (int)renderPriority { return 5; }
@end

void render(id<Drawable & Serializable> item) {
    [item draw];
    printf("ser=%s\n", [item serialize]);
}

int main() {
    Canvas *c = [[Canvas alloc] init];
    render(c);
    printf("prio=%d\n", [c renderPriority]);
    return 0;
}
