// Protocol conformance: all required methods implemented — must compile cleanly.
#import <Foundation/Foundation.hje>
#include <stdio.h>

@protocol Drawable
@required
- (void)draw;
- (int)area;
@optional
- (void)highlight;
@end

@protocol Colored <Drawable>
@required
- (int)color;
@end

@interface Square <Colored>
@end

@implementation Square
- (void)draw { printf("square draw\n"); }
- (int)area { return 9; }
- (int)color { return 0xFF0000; }
@end

int main() {
    Square *s = [[Square alloc] init];
    [s draw];
    printf("area=%d color=%d\n", [s area], [s color]);
    return 0;
}
