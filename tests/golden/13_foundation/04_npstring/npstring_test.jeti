#include <stdio.h>
#include <string.h>
#import <Foundation/Foundation.hje>

int main() {
    @autoreleasepool {
        NPString *s1 = [NPString stringWithUTF8String:"hello"];
        NPString *s2 = [NPString stringWithUTF8String:"world"];

        NPString *s3 = [s1 stringByAppendingUTF8String:" "];
        s3 = [s3 stringByAppendingString:s2];

        printf("%s\n", [s3 UTF8String]);
        printf("len=%zu\n", [s3 length]);

        if ([s1 isEqualToString:[NPString stringWithUTF8String:"hello"]]) {
            printf("equal\n");
        }

        NPString *sub = [s3 substringFromIndex:6];
        printf("%s\n", [sub UTF8String]);

        printf("hash=%u\n", [s1 hash]);

        NPString *upper = [s1 uppercaseString];
        printf("upper=%s\n", [upper UTF8String]);

        NPString *lower = [upper lowercaseString];
        printf("lower=%s\n", [lower UTF8String]);

        if ([s3 hasPrefix:[NPString stringWithUTF8String:"hello"]]) {
            printf("has prefix\n");
        }
        if ([s3 hasSuffix:[NPString stringWithUTF8String:"world"]]) {
            printf("has suffix\n");
        }
    }
    return 0;
}