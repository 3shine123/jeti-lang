#import <Foundation/Foundation.hje>
#include <stdio.h>

// ObjC type-introspection dispatch trio on the root class:
//   isKindOfClass:      — isa-chain walk (official ObjC spelling)
//   respondsToSelector: — uniform vtable NULL-slot check (compiler pseudo-method)
//   isEqual:            — identity on jeti_root; NPString/NPNumber override with VALUE equality

@interface Dog : NPObject
- (void)speak;
@end

@implementation Dog
- (void)speak { printf("woof\n"); }
@end

@interface Cat : NPObject
@end

@implementation Cat
@end

int main() {
    @autoreleasepool {
        Dog *d = [[Dog alloc] init];
        NPObject *o = d;

        // isKindOfClass: walks the isa chain; nil receiver is safe (and warns)
        printf("kind Dog=%d kind NPObject=%d kind Cat=%d kind nil=%d\n",
               [o isKindOfClass:[Dog class]],
               [o isKindOfClass:[NPObject class]],
               [o isKindOfClass:[Cat class]],
               [nil isKindOfClass:[Dog class]]);

        // respondsToSelector: static dispatch — speak exists (vtable slot), noSuchMethod does not
        printf("respond speak=%d respond missing=%d respond nil=%d\n",
               [o respondsToSelector:@selector(speak)],
               [o respondsToSelector:@selector(noSuchMethod)],
               [nil respondsToSelector:@selector(speak)]);

        // isEqual: on NPString is VALUE equality (as in ObjC's NSString), so two
        // distinct @"abc" objects compare equal; isEqualToString: agrees.
        NPString *a = @"abc";
        NPString *b = @"abc";
        printf("eq same=%d eq other=%d eq str-content=%d\n",
               [a isEqual:a], [a isEqual:b], [a isEqualToString:b]);

        // the guarded idiom this trio enables. The send itself must name the
        // declaring class — `NPObject *` does not promise `speak` (ObjC makes
        // the same demand: "no visible @interface"), so cast after the guard.
        if ([o respondsToSelector:@selector(speak)]) {
            [(Dog *)o speak];
        }
        if ([o isKindOfClass:[Dog class]]) {
            printf("dispatch via isKindOfClass OK\n");
        }
    }
    return 0;
}
