#include <stdio.h>
#import <Foundation/Foundation.hje>

int main() {
    @autoreleasepool {
        NPString *a = @"a";
        NPString *b = @"b";
        NPString *c = @"c";

        // 1. arrayWithObjects:count: + count + objectAtIndex
        id objs[3];
        objs[0] = a;
        objs[1] = b;
        objs[2] = c;
        NPArray *arr = [NPArray arrayWithObjects:objs count:3];
        printf("count=%zu elem0=%s elem1=%s elem2=%s\n",
            [arr count],
            [[arr objectAtIndex:0] UTF8String],
            [[arr objectAtIndex:1] UTF8String],
            [[arr objectAtIndex:2] UTF8String]);

        // 2. firstObject / lastObject
        printf("first=%s last=%s\n",
            [[arr firstObject] UTF8String], [[arr lastObject] UTF8String]);

        // 3. arrayWithObject: / array (empty)
        NPArray *single = [NPArray arrayWithObject:b];
        printf("single=%zu first=%s\n", [single count], [[single firstObject] UTF8String]);
        NPArray *empty = [NPArray array];
        printf("empty=%zu first=%p\n", [empty count], (void *)[empty firstObject]);

        // 4. containsObject: / indexOfObject:
        printf("contains b=%d idx b=%zu idx z=%zu\n",
            [arr containsObject:b], [arr indexOfObject:b], [arr indexOfObject:NULL]);

        // 5. @[] literal
        NPArray *lit = @[ @"x", @"y" ];
        printf("lit count=%zu last=%s\n", [lit count], [[lit lastObject] UTF8String]);

        // 6. copy (returns a distinct immutable NPArray, +1 → released by ARC)
        NPArray *copy = [arr copy];
        printf("copy count=%zu src_count=%zu\n", [copy count], [arr count]);

        // 7. description
        printf("desc=%s\n", [[arr description] UTF8String]);
    }
    return 0;
}