/* NPDateFormatter golden（.hje 多 TU 正规流程：声明伞头 + 预编译库）。
 *
 * 语义对齐 ObjC 的 NSDateFormatter（v1 子集：ISO 8601 / 日期 / 时间 / token
 * pattern；时区只做 UTC 与固定偏移，见 .hje 的诚实边界）：
 *   B1  ISO 8601 格式化：0 → 1970-01-01T00:00:00Z；-1 → 1969-12-31T23:59:59Z
 *   B2  日期/时间形：0 → 1970-01-01 / 00:00:00；3661 → 01:01:01
 *   B3  固定偏移：+480 → 1970-01-01T08:00:00+08:00
 *   B4  解析往返（ISO 带 Z / 带小数秒 / 带 +08:00 / 纯日期 / 纯时间）
 *   B5  非法输入 → nil（月份越界、非日期串、尾部残留）
 *   B6  token pattern：yyyy/MM/dd HH:mm
 * 期望输出（逐行 GOLDEN-MATCH）：
 *   B1 ok … B6 ok
 *
 * 换算基准已用 Python 的 datetime 独立交叉核对（epoch ↔ 公历）。
 */
#import <Foundation/Foundation.hje>
#import <Foundation/NPDateFormatter.hje>
#include <stdio.h>
#include <string.h>

static const char *fmt(NPDateFormatter *f, double s) {
    NPDate *d = [NPDate dateWithTimeIntervalSince1970:s];
    NPString *r = [f stringFromDate:d];
    return r ? [r UTF8String] : "(nil)";
}

static int fmt_is(NPDateFormatter *f, double s, const char *want) {
    return strcmp(fmt(f, s), want) == 0;
}

// 解析后按同一 formatter 回写，比较字符串（往返恒等）。
static int rt_is(NPDateFormatter *f, const char *in, const char *want) {
    NPString *s = [NPString stringWithUTF8String:in];
    NPDate *d = [f dateFromString:s];
    if (!d) { return 0; }
    NPString *back = [f stringFromDate:d];
    if (!back) { return 0; }
    return strcmp([back UTF8String], want) == 0;
}

static int parses(NPDateFormatter *f, const char *in) {
    NPString *s = [NPString stringWithUTF8String:in];
    return [f dateFromString:s] != NULL;
}

int main(void) {
    NPDateFormatter *iso = [NPDateFormatter iso8601Formatter];
    NPDateFormatter *day = [NPDateFormatter dateOnlyFormatter];
    NPDateFormatter *tim = [NPDateFormatter timeOnlyFormatter];

    // B1：ISO 8601
    if (fmt_is(iso, 0, "1970-01-01T00:00:00Z")
        && fmt_is(iso, -1, "1969-12-31T23:59:59Z")
        && fmt_is(iso, 1761395696, "2025-10-25T12:34:56Z")) {
        printf("B1 ok\n");
    } else {
        printf("B1 FAIL %s %s %s\n", fmt(iso, 0), fmt(iso, -1), fmt(iso, 1761395696));
    }

    // B2：日期 / 时间形
    if (fmt_is(day, 0, "1970-01-01")
        && fmt_is(tim, 0, "00:00:00")
        && fmt_is(tim, 3661, "01:01:01")) {
        printf("B2 ok\n");
    } else {
        printf("B2 FAIL %s %s %s\n", fmt(day, 0), fmt(tim, 0), fmt(tim, 3661));
    }

    // B3：固定偏移（东八区）
    NPDateFormatter *off = [NPDateFormatter iso8601Formatter];
    [off setUTCOffsetMinutes:480];
    if ([off utcOffsetMinutes] == 480 && fmt_is(off, 0, "1970-01-01T08:00:00+08:00")) {
        printf("B3 ok\n");
    } else {
        printf("B3 FAIL %d %s\n", [off utcOffsetMinutes], fmt(off, 0));
    }

    // B4：解析往返
    int b4 = rt_is(iso, "2026-10-25T12:34:56Z", "2026-10-25T12:34:56Z")
          && rt_is(iso, "1970-01-01T00:00:00Z", "1970-01-01T00:00:00Z")
          && rt_is(iso, "2026-10-25T12:34:56.789Z", "2026-10-25T12:34:56Z")
          && rt_is(off, "1970-01-01T08:00:00+08:00", "1970-01-01T08:00:00+08:00")
          && rt_is(day, "2026-10-25", "2026-10-25")
          && rt_is(tim, "12:34:56", "12:34:56");
    if (b4) { printf("B4 ok\n"); } else { printf("B4 FAIL\n"); }

    // B5：非法输入 → nil
    if (!parses(iso, "2026-13-01T00:00:00Z")
        && !parses(iso, "not a date")
        && !parses(day, "2026-10-25x")
        && !parses(tim, "25:00:00")) {
        printf("B5 ok\n");
    } else {
        printf("B5 FAIL\n");
    }

    // B6：token pattern
    NPDateFormatter *pat = [NPDateFormatter formatterWithPattern:[NPString stringWithUTF8String:"yyyy/MM/dd HH:mm"]];
    if (fmt_is(pat, 1761395696, "2025/10/25 12:34")
        && rt_is(pat, "2026/10/25 12:34", "2026/10/25 12:34")) {
        printf("B6 ok\n");
    } else {
        printf("B6 FAIL %s\n", fmt(pat, 1761395696));
    }
    return 0;
}
