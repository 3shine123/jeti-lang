// test: NPLog basic output
#include <stdio.h>
#import <Foundation/Foundation.hje>

int main() {
    @autoreleasepool {
        NPLog(@"hello world");
        NPLog(@"number: %d", 100);
        NPLog(@"string: %s", "test");
        NPLog(@"percent: 50%%");
    }
    printf("NPLog basic OK\n");
    return 0;
}