// golden/35_variadic_method — 真 variadic 方法支持
// 覆盖：单段 selector、多段 selector、C-style 形态、继承、嵌套消息发送多实参、
//       字符串实参、va_list 转发（printf 家族封装的标准形态）
#import <Foundation/Foundation.hje>
#include <stdarg.h>
#include <stdio.h>

// ── 1. 单段 selector variadic：va_arg 逐个取参 ──
@interface Summer : NPObject
- (int)sum:(int)first, ...;
@end

@implementation Summer
- (int)sum:(int)first, ... {
    va_list ap;
    va_start(ap, first);
    int total = first;
    // 括号赋值 + 比较的复合形态：验证 `(v = va_arg(...)) != 0` 的括号边界
    // （曾经 codegen 把 `!= 0` 吞进 va_arg 实参括号，见 AGENTS.md 修复记录）。
    int v;
    while ((v = va_arg(ap, int)) != 0) {
        total += v;
    }
    va_end(ap);
    return total;
}
@end

// ── 2. 多段 selector variadic：前两个固定参数 + 变参 ──
@interface Formatter : NPObject
- (int)format:(const char *)tag count:(int)n values:(int)first, ...;
- (void)print:(const char *)fmt, ...;
@end

@implementation Formatter
- (int)format:(const char *)tag count:(int)n values:(int)first, ... {
    va_list ap;
    va_start(ap, first);
    int total = first;
    for (int i = 1; i < n; i++) {
        total += va_arg(ap, int);
    }
    va_end(ap);
    printf("[%s] count=%d total=%d\n", tag, n, total);
    return total;
}

// va_list 转发：variadic 方法封装 vprintf 家族（NSString stringWithFormat: 的标准实现形态）
- (void)print:(const char *)fmt, ... {
    va_list ap;
    va_start(ap, fmt);
    vprintf(fmt, ap);
    va_end(ap);
}
@end

// ── 3. 继承：子类不重写，沿 vtable 槽位调用父类 variadic 方法 ──
@interface PowerSummer : Summer
@end

@implementation PowerSummer
@end

// ── 4. 返回指针的 variadic：拼接字符串实参 ──
@interface Joiner : NPObject
- (NPString *)join:(const char *)first, ...;
@end

@implementation Joiner
- (NPString *)join:(const char *)first, ... {
    va_list ap;
    va_start(ap, first);
    NPString *acc = [NPString stringWithUTF8String:first];
    const char *part;
    while ((part = va_arg(ap, const char *)) != 0) {
        acc = [acc stringByAppendingString:[NPString stringWithUTF8String:part]];
    }
    va_end(ap);
    return acc;
}
@end

int main() {
    Summer *s = [[Summer alloc] init];

    // 基本调用：逗号实参透传给 variadic 槽位
    printf("sum1=%d\n", [s sum:1, 2, 3, 4, 0]);          // 10
    printf("sum2=%d\n", [s sum:10, 20, 0]);              // 30
    printf("sum3=%d\n", [s sum:7, 0]);                   // 7（只有固定参数）

    // 嵌套消息发送：内层 variadic 结果作为外层实参
    printf("nested=%d\n", [s sum:[s sum:1, 1, 0], 100, 0]); // 2+100=102

    // 多段 selector
    Formatter *f = [[Formatter alloc] init];
    [f format:"fmt" count:3 values:5, 15, 25];           // total=45
    int fv = [f format:"ret" count:2 values:100, 200];   // total=300
    printf("fmt return=%d\n", fv);

    // va_list 转发（printf 风格）
    [f print:"%s=%d %s=%d\n", "a", 1, "b", 2];

    // 继承：PowerSummer 没有自己的 sum:，派发走父类实现
    PowerSummer *p = [[PowerSummer alloc] init];
    printf("inherited=%d\n", [p sum:1000, 2000, 0]);     // 3000

    // 对象返回值：variadic 拼接 NPString
    Joiner *j = [[Joiner alloc] init];
    NPString *joined = [j join:"alpha", "-", "beta", "-", "gamma", (const char *)0];
    printf("joined=%s\n", [joined UTF8String]);

    return 0;
}
