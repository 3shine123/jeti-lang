#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.hje>

@interface MathError : NPObject {
    char *_msg;
}
- (instancetype)initWithMessage:(const char *)msg;
- (const char *)message;
- (void)dealloc;
@end

@implementation MathError
- (instancetype)initWithMessage:(const char *)msg {
    self = [super init];
    if (self) { _msg = strdup(msg); }
    return self;
}
- (const char *)message { return _msg; }
- (void)dealloc { if (_msg) free(_msg); [super dealloc]; }
@end

static int divide(int a, int b) @throws(MathError *) {
    if (b == 0) {
        MathError *e = [[MathError alloc] initWithMessage:"division by zero"];
        @throw e;
    }
    return a / b;
}

int main() {
    @autoreleasepool {
        // Test 1: successful division
        int r1 = divide(10, 2);
        printf("10/2 = %d\n", r1);

        // Test 2: division by zero (caught)
        @try {
            int r2 = divide(10, 0);
            printf("10/0 = %d\n", r2);
        }
        @catch (MathError *e) {
            printf("Caught: %s\n", [e message]);
            [e release];
        }

        printf("Done.\n");
    }
    return 0;
}