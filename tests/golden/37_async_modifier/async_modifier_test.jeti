#import <Foundation/Foundation.jth>
#include <stdio.h>

// async method modifier (soft keywords, docs/plans/async_soft_keywords_plan.md):
// - `(async T)` — the modifier is part of the signature: the method
//   suspends, its body returns T directly, `await` unwraps to T
// - bare `(NPTask<T>)` — an ORDINARY sync method that merely returns a task
//   object (the two forms are statically distinguishable)
// - lazy start: a bare async call only creates the task; `[task start]` runs
//   it — at statement position in hosted code it drives to completion there
// - NPTask<void>: await-able, no value

@interface Fetcher : NPObject
- (async int)compute:(int)n;
- (async void)runAll;
- (NPTask<int>)loadCachedValue;   // sync method returning a task object
- (int)plain:(int)n;
@end

@implementation Fetcher
- (async int)compute:(int)n {
    int raw = await n;            // suspension point
    return raw * 2;
}
- (async void)runAll {
    int x = await [self compute:21];          // await across a call chain
    NPTask<int> *t = [self loadCachedValue];  // sync call: just a task object
    int y = await t;                          // form B: await a task variable
    int z = [self plain:5];                   // plain sync call, no task involved
    printf("runAll x=%d y=%d z=%d\n", x, y, z);
}
- (NPTask<int>)loadCachedValue {
    return [self compute:42];    // form A: lazy — created but NOT started here
}
- (int)plain:(int)n {
    return n + 1;
}
@end

int main() {
    Fetcher *f = [[Fetcher alloc] init];
    NPTask<void> *task = [f runAll];   // lazy: created, not executed
    [task start];                      // hosted statement position: drives to
                                       // completion here, f still ARC-alive
    return 0;
}
