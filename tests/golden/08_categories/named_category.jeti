#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface Calculator : NPObject
- (int)add:(int)a to:(int)b;
@end

@implementation Calculator
- (int)add:(int)a to:(int)b {
    return a + b;
}
@end

@interface Calculator (Advanced)
- (int)multiply:(int)a by:(int)b;
@end

@implementation Calculator (Advanced)
- (int)multiply:(int)a by:(int)b {
    return a * b;
}
@end

int main() {
    Calculator *c = [[Calculator alloc] init];
    int sum = [c add:3 to:4];
    int prod = [c multiply:3 by:4];
    printf("sum=%d prod=%d\n", sum, prod);
    return 0;
}
