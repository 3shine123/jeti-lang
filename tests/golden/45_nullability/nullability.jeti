// Nullability (M1) — `nullable` / `nonnull` / `NP_ASSUME_NONNULL` region.
//
// Every case here must COMPILE AND RUN. The error paths live in
// tests/negative/ (nullable_to_nonnull.jeti etc.) — this file is the positive
// half: annotations that are correct must stay silent, and narrow must work.
#import <Foundation/Foundation.hje>

@interface Port : NPObject
// Unannotated → unspecified, accepts anything (progressive adoption).
- (void)loose:(NPString *)s;
// Annotated both spellings.
- (void)wantNonnull:(nonnull NPString *)s;
- (void)wantNullable:(nullable NPString *)s;
// C-pointer spelling, same meaning.
- (void)wantNonnullC:(NPString * _Nonnull)s;
- (void)wantNullableC:(_Nullable NPString *)s;
// Return position, both spellings.
- (nullable NPString *)maybe;
- (nonnull NPString *)sure;
- (NPString * _Nullable)maybeC;
@end

@implementation Port
- (void)loose:(NPString *)s { NPLog(@"loose %s", s ? [s UTF8String] : "(nil)"); }
- (void)wantNonnull:(nonnull NPString *)s { NPLog(@"nonnull %s", [s UTF8String]); }
- (void)wantNullable:(nullable NPString *)s { NPLog(@"nullable %s", s ? [s UTF8String] : "(nil)"); }
- (void)wantNonnullC:(NPString * _Nonnull)s { NPLog(@"nonnullC %s", [s UTF8String]); }
- (void)wantNullableC:(_Nullable NPString *)s { NPLog(@"nullableC %s", s ? [s UTF8String] : "(nil)"); }
- (nullable NPString *)maybe { return nil; }
- (nonnull NPString *)sure { return @"sure"; }
- (NPString * _Nullable)maybeC { return @"maybeC"; }
@end

// Property attributes: `(nullable)` / `(nonnull)` land on the property's type.
@interface Holder : NPObject
@property (nonatomic, copy, nullable) NPString *title;
@property (nonatomic, nonnull) NPString *tag;
@end

@implementation Holder
@synthesize title;
@synthesize tag;
@end

// Region default: an unannotated pointer inside the region is nonnull, an
// explicit `nullable` opts out, and a non-pointer is left alone.
NP_ASSUME_NONNULL_BEGIN
@interface Region : NPObject
- (void)need:(NPString *)s;
- (void)opt:(nullable NPString *)s;
- (void)scalar:(int)n;
- (void)optOut:(_Null_unspecified NPString *)s;
@end
NP_ASSUME_NONNULL_END

@implementation Region
- (void)need:(NPString *)s { NPLog(@"region need %s", [s UTF8String]); }
- (void)opt:(nullable NPString *)s { NPLog(@"region opt %s", s ? [s UTF8String] : "(nil)"); }
- (void)scalar:(int)n { NPLog(@"region scalar %d", n); }
- (void)optOut:(_Null_unspecified NPString *)s { NPLog(@"region optOut %s", s ? [s UTF8String] : "(nil)"); }
@end

// Top-level function: return + parameter positions.
static nullable NPString *fn_maybe(void) { return nil; }
static void fn_take(nonnull NPString *s) { NPLog(@"fn %s", [s UTF8String]); }

// Flow-sensitive narrowing: every `wantNonnull:` call below is guarded, so the
// nullable→nonnull diagnostic must stay silent for all of them.
static void guarded(Port *p, nullable NPString *s) {
    if (s) {
        [p wantNonnull:s];              // narrowed in then-arm
    }
    if (!s) {
        return;                          // early exit ⇒ s nonnull after
    }
    [p wantNonnull:s];
    if (s != nil) {
        [p wantNonnull:s];              // explicit != nil
    }
    if (nil == s) {
        return;
    }
    [p wantNonnull:s];
    if (s == NULL) {
        return;
    }
    [p wantNonnull:s];
    if ((s)) {
        [p wantNonnull:s];              // parenthesized condition
    }
}

// A nullable RETURN flows into a nonnull local — allowed (the diagnostic only
// guards the nonnull-parameter direction), and this must still run.
static void nullableReturn(void) {
    NPString *m = fn_maybe();
    Port *p = (Port *)0;
    (void)p;
    NPLog(@"ret %s", m ? [m UTF8String] : "(nil)");
}

// --- NPError + out-param: the middle level of a double pointer is annotated
// (`NPError * _Nullable *`) — the error object may be nil, the out-pointer
// itself is always valid because the callee writes through it. A prefix
// annotation on a double pointer is REJECTED (clang does the same — it refuses
// to guess the level), so the postfix spelling is the only way to say it.
static BOOL parseNum(NPString *text, int *outVal, NPError * _Nullable * outErr) {
    if (text == nil) {
        *outErr = [NPError parseErrorWithMessage:@"empty input"];
        return NO;
    }
    *outVal = [text length];
    return YES;
}

// --- Blocks: parameters and return type accept both spellings, and the
// checker enforces them at the invocation site — including through a typedef
// (the form essentially all real block code uses).
typedef void (^SinkBlock)(nonnull NPString *s);
typedef nullable NPString * (^GetterBlock)(void);

static void call_blocks(void) {
    SinkBlock sink = ^(nonnull NPString *v) { NPLog(@"block sink %s", [v UTF8String]); };
    GetterBlock get = ^nullable NPString * { return nil; };
    sink(@"from-block");
    NPLog(@"block get=%s", get() ? "non-nil" : "nil");
}

// --- ARC + nullability: releasing a nullable local is legal (jeti_release is
// nil-safe by contract: `if (!obj) return;` in runtime.c). The checker's
// nil-safe whitelist makes a jeti-visible `nonnull` declaration of one
// unenforceable rather than a compile error for every ARC program.
static void arc_nullable_release(void) {
    @noarc {
        nullable NPObject *o = [[NPObject alloc] init];
        jeti_release(o);
        jeti_release(nil);
        NPLog(@"arc released");
    }
}

int main(void) {
    Port *p = [Port new];
    [p loose:nil];
    [p wantNonnull:@"a"];
    [p wantNullable:nil];
    [p wantNonnullC:@"b"];
    [p wantNullableC:nil];
    NPLog(@"ret maybe=%s sure=%s maybeC=%s",
          [p maybe] ? "non-nil" : "nil",
          [[p sure] UTF8String],
          [[p maybeC] UTF8String]);

    Holder *h = [Holder new];
    h.title = nil;
    h.tag = @"t";
    NPLog(@"prop title=%s tag=%s",
          h.title ? [h.title UTF8String] : "(nil)",
          [h.tag UTF8String]);

    Region *r = [Region new];
    [r need:@"n"];
    [r opt:nil];
    [r scalar:5];
    [r optOut:nil];

    guarded(p, nil);
    guarded(p, @"g");
    fn_take(@"f");
    nullableReturn();

    int v = 0;
    NPError *err = nil;
    NPLog(@"parse ok=%d v=%d err=%s", parseNum(@"abc", &v, &err), v, err ? "set" : "nil");
    NPError *err2 = nil;
    BOOL ok2 = parseNum(nil, &v, &err2);
    NPLog(@"parse ok=%d err=%s", ok2,
          err2 ? [[err2 localizedDescription] UTF8String] : "nil");

    call_blocks();
    arc_nullable_release();
    return 0;
}
