// Boxing literals — every form must produce a real NPNumber.
//
//   @123 / @1.5   — literal value, typed by the literal itself
//   @(expr)       — factory chosen by the expression's STATIC type (parser has
//                   no types; the checker rewrites it, since the C99 backend
//                   cannot use `_Generic`)
//   @YES / @NO    — boxed BOOL
//   @'c'          — boxed character
#import <Foundation/Foundation.hje>

int main(void) {
    int i = 41;
    double d = 2.5;
    char c = 'A';

    // 1. literal forms (pre-existing)
    NPNumber *n1 = @123;
    NPNumber *n2 = @1.5;
    NPLog(@"1 literal: %d %.1f", [n1 intValue], [n2 doubleValue]);

    // 2. boxed expression — one factory per static type
    NPNumber *n3 = @(i + 1);      // int    → numberWithInt:
    NPNumber *n4 = @(d * 2.0);    // double → numberWithDouble:
    NPNumber *n5 = @(c + 0);      // char+int promotes to int
    NPLog(@"2 expr: %d %.1f %d", [n3 intValue], [n4 doubleValue], [n5 intValue]);

    // 3. boxed BOOL
    NPNumber *n6 = @YES;
    NPNumber *n7 = @NO;
    NPLog(@"3 bool: %d %d", [n6 boolValue], [n7 boolValue]);

    // 4. boxed character, round-tripped through charValue
    NPNumber *n8 = @'A';
    NPNumber *n9 = @(c);
    NPLog(@"4 char: %c %d %c", [n8 charValue], [n8 intValue], [n9 charValue]);

    // 5. boxed result used directly as a receiver (chained dispatch)
    NPLog(@"5 chain: %d", [@(i * 2) intValue]);

    // 6. boxed results inside a literal array
    NPArray *arr = @[ @1, @(i + 1), @YES ];
    // A C-style cast directly on a message send is fine (it used to be avoided
    // here on a stale "parser gap" note — verified working since).
    NPNumber *head = (NPNumber *)[arr objectAtIndex:0];
    NPNumber *mid = (NPNumber *)[arr objectAtIndex:1];
    NPNumber *tail = (NPNumber *)[arr objectAtIndex:2];
    NPLog(@"6 array: %d %d %d %d",
          [arr count], [head intValue], [mid intValue], [tail boolValue]);

    // 7. same value, both spellings — equality is value-based
    NPLog(@"7 eq: %d %d",
          [@(i + 1) isEqualToNumber:@42],
          [@YES isEqualToNumber:@(1 == 1)]);

    return 0;
}
