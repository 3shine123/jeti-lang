#include <stdio.h>
#import <Foundation/Foundation.hje>

// Test: a single generic class instantiated with two different types
@interface Buffer<T> : NPObject {
    @public
    T _data[2];
    int _len;
}
- (void)add:(T)item;
- (T)get;
@end

@implementation Buffer
- (void)add:(T)item {
    if (_len < 2) _data[_len++] = item;
}
- (T)get {
    if (_len > 0) {
        _len--;
        T item = _data[_len];
        _data[_len] = 0;
        return item;
    }
    return 0;
}
@end

@interface A : NPObject @end
@implementation A @end

@interface B : NPObject @end
@implementation B @end

int main() {
    @autoreleasepool {
        Buffer<A*> *aBuf = [[Buffer alloc] init];
        Buffer<B*> *bBuf = [[Buffer alloc] init];
        printf("Two instantiations of Buffer exist\n");
    }
    return 0;
}