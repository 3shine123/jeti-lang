// golden/36_macros — jeti-syntax macro expansion (dual-track preprocessor)
//
// Track 1 (jeti): macro bodies containing jeti syntax ([recv msg], @throw,
// ^{...}) are parsed by jetic and expanded at the source level before
// lexing — the definition never reaches the C prelude.
// Track 2 (C): plain C bodies pass through verbatim and are expanded by the
// C compiler as before.
#import <Foundation/Foundation.hje>
#include <stdio.h>

// ── jeti-track macros (expanded by jetic) ──
#define TAG(o)          [o tag]
#define BUMP(o, n)      [o addTo:n times:1]
#define SAFE_TAG(o)     ((o) ? TAG(o) : -1)     // macro inside macro argument
#define LOG(x)          NPLog(@"tag=%d", x)     // body contains @literal

// ── C-track macros (expanded by clang, unchanged behavior) ──
#define TWICE(x)        ((x) + (x))
#define CAT(a, b)       a ## b
#define NAME            "cat"

@interface Widget { int uid; }
+ (id) alloc;
- (id) init;
- (int) tag;
- (int) addTo:(int)v times:(int)k;
@end
@implementation Widget
+ (id) alloc { return jeti_alloc(self); }
- (id) init   { return self; }
- (int) tag   { return uid; }
- (int) addTo:(int)v times:(int)k { uid += v * k; return uid; }
@end

int main() {
    jeti_meta_init();
    Widget *w = [[Widget alloc] init];
    [w addTo:7 times:0];

    // jeti-track: object-like / function-like sends
    printf("%d\n", TAG(w));            // 0  (uid: addTo:7 times:0 adds 7*0)
    printf("%d\n", BUMP(w, 3));        // 3  (uid += 3*1)
    // jeti-track macro inside a macro argument (arg expanded first)
    printf("%d\n", TWICE(TAG(w)));     // 6  (arg expanded first)
    // nested: SAFE_TAG's body references TAG
    printf("%d\n", SAFE_TAG(w));       // 3  (nested body refs TAG)
    // jeti-track: body with an @ literal
    LOG(42);                           // tag=42
    // C-track: paste + stringify + plain arithmetic
    printf("%d\n", CAT(1, 2));         // 12
    printf("%s\n", NAME);              // cat
    return 0;
}
