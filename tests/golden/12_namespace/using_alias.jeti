// test: @using with alias syntax (C++ style)
#include <stdio.h>
#import <Foundation/Foundation.hje>

@namespace Game
    @interface Player : NPObject {
        @public
        int level;
    }
    - (id)initWithLevel:(int)l;
    @end

    @implementation Player
    - (id)initWithLevel:(int)l {
        self = [super init];
        if (self) level = l;
        return self;
    }
    @end
@endnamespace

@namespace UI
    @interface HUD : NPObject {
        @public
        int value;
    }
    - (id)initWithValue:(int)v;
    @end

    @implementation HUD
    - (id)initWithValue:(int)v {
        self = [super init];
        if (self) value = v;
        return self;
    }
    @end
@endnamespace

@using GamePlayer = Game::Player;
@using UIHUD = UI::HUD;

int main() {
    @autoreleasepool {
        GamePlayer *p = [[GamePlayer alloc] initWithLevel:10];
        UIHUD *h = [[UIHUD alloc] initWithValue:42];
        printf("[alias] Player level=%d, HUD value=%d\n", p->level, h->value);
        [p release]; [h release];
    }
    return 0;
}
