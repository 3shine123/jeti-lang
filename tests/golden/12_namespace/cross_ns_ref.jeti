// test: cross-namespace references in method params and @using inside @namespace
#include <stdio.h>
#import <Foundation/Foundation.hje>

@namespace Game
    @interface Player : NPObject {
        @public
        int health;
    }
    - (id)init;
    @end

    @implementation Player
    - (id)init {
        self = [super init];
        if (self) health = 100;
        return self;
    }
    @end
@endnamespace

@namespace UI
    @interface HUD : NPObject {}
    - (void)showHealth:(Game::Player *)player;
    @end

    @implementation HUD
    - (void)showHealth:(Game::Player *)player {
        printf("[cross] Player health: %d\n", player->health);
    }
    @end
@endnamespace

// @using inside main, NOT inside a namespace
@using namespace Game;

int main() {
    @autoreleasepool {
        Player *p = [[Player alloc] init];
        UI::HUD *hud = [[UI::HUD alloc] init];
        [hud showHealth:p];
        [p release];
        [hud release];
    }
    return 0;
}
