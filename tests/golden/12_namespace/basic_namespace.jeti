// test: basic @namespace with class definition and usage
#include <stdio.h>
#import <Foundation/Foundation.hje>

@namespace Game
    @interface Player : NPObject {
        @public
        int health;
    }
    - (id)init;
    - (int)getHealth;
    @end

    @implementation Player
    - (id)init {
        self = [super init];
        if (self) health = 100;
        return self;
    }
    - (int)getHealth { return health; }
    @end

    @interface Enemy : NPObject {
        @public
        int hp;
    }
    - (id)initWithHP:(int)h;
    @end

    @implementation Enemy
    - (id)initWithHP:(int)h {
        self = [super init];
        if (self) hp = h;
        return self;
    }
    @end
@endnamespace

int main() {
    @autoreleasepool {
        Game::Player *p = [[Game::Player alloc] init];
        Game::Enemy *e = [[Game::Enemy alloc] initWithHP:50];
        printf("[basic] Player health: %d\n", [p getHealth]);
        printf("[basic] Enemy HP: %d\n", e->hp);
        [p release];
        [e release];
    }
    return 0;
}
