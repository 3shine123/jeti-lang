// test: nested @namespace with deep qualified access
#include <stdio.h>
#import <Foundation/Foundation.hje>

@namespace Game
    @namespace Entities
        @interface Player : NPObject {
            @public
            int id;
        }
        - (id)initWithId:(int)i;
        @end

        @implementation Player
        - (id)initWithId:(int)i {
            self = [super init];
            if (self) id = i;
            return self;
        }
        @end

        @interface Enemy : NPObject {
            @public
            int level;
        }
        - (id)initWithLevel:(int)l;
        @end

        @implementation Enemy
        - (id)initWithLevel:(int)l {
            self = [super init];
            if (self) level = l;
            return self;
        }
        @end
    @endnamespace

    @namespace Items
        @interface Potion : NPObject {
            @public
            int healAmount;
        }
        - (id)initWithHeal:(int)h;
        @end

        @implementation Potion
        - (id)initWithHeal:(int)h {
            self = [super init];
            if (self) healAmount = h;
            return self;
        }
        @end
    @endnamespace
@endnamespace

int main() {
    @autoreleasepool {
        Game::Entities::Player *p = [[Game::Entities::Player alloc] initWithId:1];
        Game::Entities::Enemy *e = [[Game::Entities::Enemy alloc] initWithLevel:5];
        Game::Items::Potion *pot = [[Game::Items::Potion alloc] initWithHeal:30];
        printf("[nested] Player id=%d, Enemy level=%d, Potion heal=%d\n",
               p->id, e->level, pot->healAmount);
        [p release]; [e release]; [pot release];
    }
    return 0;
}
