// @defer — scope-exit execution (Go-style). Golden test.
// Every section has deterministic printf markers; expected stdout in
// defer_test.out (rerun-stable, ARC/MRC identical — all prints are literals).
// Semantics under test: LIFO order, early return, loop-body per-iteration +
// continue/break firing body defers, NO double-fire of outer defers on break,
// nested plain blocks, same-function @throw, block-literal fresh scope, ARC
// order (defer runs before the scope-end release). See AGENTS.md `@defer`.
#import "Foundation/Foundation.hje"
#include <stdio.h>

@interface Tracker : NPObject
- (void)dealloc;
@end

@implementation Tracker
- (void)dealloc { printf("  tracker dealloc\n"); }
@end

static void section(const char *name) { printf("== %s ==\n", name); }

// 1. LIFO at natural end + defer firing on an early return
static int lifo(int x) {
    if (x == 1) {
        @defer { printf("  early defer\n"); }
        printf("  early body\n");
        return 10;
    }
    @defer { printf("  second (LIFO last)\n"); }
    @defer { printf("  first (LIFO first)\n"); }
    printf("  normal body\n");
    return 20;
}

// 2. loop body: defer fires EVERY iteration; continue and break fire it too
static int loops(void) {
    for (int i = 0; i < 3; i++) {
        @defer { printf("  iter-defer %d\n", i); }
        if (i == 1) { printf("  continue at 1\n"); continue; }
        if (i == 2) { printf("  break at 2\n"); break; }
        printf("  iter %d\n", i);
    }
    @defer { printf("  fn defer (after loop)\n"); }
    printf("  loops done\n");
    return 0;
}

// 3. outer defer must fire ONCE (function end), never on the loop's break
static int outer_once(void) {
    @defer { printf("  outer defer\n"); }
    for (int i = 0; i < 1; i++) {
        @defer { printf("  inner defer\n"); }
        printf("  before break\n");
        break;
    }
    printf("  after loop\n");
    return 0;
}

// 4. nested plain blocks: inner defer at inner end, outer at outer end
static int nested(void) {
    @defer { printf("  outer-block defer\n"); }
    {
        @defer { printf("  inner-block defer\n"); }
        printf("  inner body\n");
    }
    printf("  after inner\n");
    return 0;
}

// 5. same-function @throw: defer fires before the throw unwinds to @catch
static int thrower(void) {
    @try {
        @defer { printf("  defer-before-throw\n"); }
        printf("  before throw\n");
        @throw @"boom";
    } @catch (NPString *e) {
        printf("  caught\n");
    }
    return 0;
}

// 6. ARC order: the injected scope-end release lands AFTER the defer splice,
// so the deferred code runs while the object is still alive.
static int arc_order(void) {
    Tracker *t = [[Tracker alloc] init];
    @defer { printf("  defer sees tracker alive\n"); }
    printf("  arc body end\n");
    return 0;
}

// 7. block literal: its own function — its defers attach to the literal body
// with a fresh scope and fire when the block is invoked.
typedef void (^SimpleBlock)(void);
static int block_scope(void) {
    SimpleBlock b = ^{
        @defer { printf("  block defer\n"); }
        printf("  block body\n");
    };
    b();
    printf("  after block\n");
    return 0;
}

int main() {
    section("LIFO + early return");
    int a = lifo(1);
    int b = lifo(0);
    printf("  a=%d b=%d\n", a, b);

    section("loop body");
    loops();

    section("outer defer fires once");
    outer_once();

    section("nested blocks");
    nested();

    section("defer before throw");
    thrower();

    section("ARC order");
    arc_order();

    section("block literal scope");
    block_scope();

    printf("ALL OK\n");
    return 0;
}
