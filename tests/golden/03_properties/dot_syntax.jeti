#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface Person : NPObject
@property char *name;
@property int age;
@end

@implementation Person
@end

int main() {
    Person *p = [[Person alloc] init];
    p.name = "Alice";
    p.age = 30;
    printf("%s is %d years old\n", p.name, p.age);
    return 0;
}
