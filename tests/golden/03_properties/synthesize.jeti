#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface Person : NPObject
@property int age;
@property int score;
@end

@implementation Person
@synthesize age = _age;
@synthesize score;
@end

int main() {
    Person *p = [Person new];
    p.age = 25;
    p.score = 100;
    printf("age=%d score=%d\n", p.age, p.score);
    return 0;
}
