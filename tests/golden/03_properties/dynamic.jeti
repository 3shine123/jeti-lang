#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface Box : NPObject
@property int size;
@end

@implementation Box
@dynamic size;
- (int)size {
    return 99;
}
- (void)setSize:(int)s {
    printf("setSize called with %d\n", s);
}
@end

int main() {
    Box *b = [[Box alloc] init];
    b.size = 42;
    printf("Size: %d\n", b.size);
    return 0;
}
