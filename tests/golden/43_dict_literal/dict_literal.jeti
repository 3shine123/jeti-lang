// Dictionary literals — `@{ key: value, ... }`.
//
// A single-entry dictionary used to be the only shape that parsed: the value
// was parsed with `parse_expression()`, whose comma operator swallowed the
// separator, so any further entry collided with "expected '}'". Values are now
// parsed with `parse_assignment()`, one level below the comma.
//
// Keys compare with `isEqual:` (value semantics for NPString/NPNumber), so a
// lookup by an equal-but-distinct literal finds the entry — the point of a
// dictionary, and what makes a fresh `@"key"` usable at all.
#import <Foundation/Foundation.hje>
#include <stdio.h>

int main(void) {
    int i = 41;

    // 1. multi-entry literal + count
    NPDictionary *d = @{ @"a": @1, @"b": @2, @"c": @3 };
    printf("1 count: %lu\n", (unsigned long)[d count]);

    // 2. lookup with a fresh key literal (string literals are interned —
    //    same contents → same object — and isEqual: value semantics is
    //    the guarantee either way)
    printf("2 lookup: %d %d %s\n",
           [[d objectForKey:@"a"] intValue],
           [[d objectForKey:@"c"] intValue],
           [d objectForKey:@"missing"] ? "found" : "nil");

    // 3. empty dictionary — `@{}` is a dictionary, not an empty array
    NPDictionary *e = @{};
    printf("3 empty: %lu %s\n",
           (unsigned long)[e count],
           [e objectForKey:@"a"] ? "found" : "nil");

    // 4. allKeys / allValues (insertion order)
    NPArray *ks = [d allKeys];
    NPArray *vs = [d allValues];
    printf("4 keys: %s %s %s\n",
           [[ks objectAtIndex:0] UTF8String],
           [[ks objectAtIndex:1] UTF8String],
           [[ks objectAtIndex:2] UTF8String]);
    printf("4 values: %d %d %d\n",
           [[vs objectAtIndex:0] intValue],
           [[vs objectAtIndex:1] intValue],
           [[vs objectAtIndex:2] intValue]);

    // 5. boxed-expression values and number keys (value semantics on NPNumber)
    NPDictionary *n = @{ @1: @"one", @(i + 1): @"two" };
    printf("5 numbers: %lu %s %s\n",
           (unsigned long)[n count],
           [[n objectForKey:@1] UTF8String],
           [[n objectForKey:@42] UTF8String]);

    // 6. nested literal inside an array literal
    NPArray *mixed = @[ @{ @"k": @"v" }, @[ @1, @2 ] ];
    NPDictionary *inner = [mixed objectAtIndex:0];
    printf("6 nested: %s %d\n",
           [[inner objectForKey:@"k"] UTF8String],
           (int)[[mixed objectAtIndex:1] count]);

    // 7. mutable dictionary: insert / replace / remove, value-based
    NPMutableDictionary *m = [NPMutableDictionary dictionary];
    [m setObject:@10 forKey:@"x"];
    [m setObject:@20 forKey:@"y"];
    [m setObject:@11 forKey:@"x"];   // equal key → replaced, not appended
    printf("7 mutate: %lu %d\n", (unsigned long)[m count], [[m objectForKey:@"x"] intValue]);
    [m removeObjectForKey:@"x"];
    printf("7 remove: %lu %s\n",
           (unsigned long)[m count],
           [m objectForKey:@"x"] ? "found" : "nil");

    // 8. copy is immutable and value-equal
    NPDictionary *c = [d copy];
    printf("8 copy: %d %lu\n", [c isEqual:d], (unsigned long)[c count]);

    // 9. description
    printf("9 desc: %s\n", [[@{ @"k": @7 } description] UTF8String]);

    return 0;
}
