#import <Foundation/Foundation.hje>

// async/await (soft keywords, docs/plans/async_soft_keywords_plan.md):
// - `(async T)` marks a suspending method; the signature tells the truth
// - `await e` marks a suspension point; it lowers to `jeti_task_await`
//   (lazy tasks: auto-start if not started, result cached — multi-await safe)
// - a bare async call from sync code is legal (form A: lazy task creation,
//   the handle is a first-class value); at STATEMENT position it is the entry
//   form — hosted code drives it to completion right there

@interface Fetcher : NPObject
- (async int)compute:(int)n;
- (async int)twice:(int)n;
- (async void)runAll;
@end

@implementation Fetcher
- (async int)compute:(int)n {
    int raw = await n;           // suspension point
    return raw * 2;
}
- (async int)twice:(int)n {
    int a = await [self compute:n];    // await across a call chain
    int b = await [self compute:a];    // ...and twice in one body
    return a + b;
}
// async void: the entry method — driven at its statement-position call
- (async void)runAll {
    int x = await [self twice:3];
    NPLog(@"result=%d", x);      // 3 -> 6 -> 12 => a+b = 18
}
@end

int main() {
    // Async Semantics v1 rules 2/3: a bare async call is a checker error and
    // statement positions no longer auto-drive — the only sync→async bridge
    // is +[NPTask blockOn:], with the awaited call inside the block.
    // (The receiver is allocated inside the block: block thunks capture
    // params + self only until the stage-3 spawn work lands.)
    [NPTask blockOn:async void ^ {
        Fetcher *f = [[Fetcher alloc] init];
        await [f runAll];
    }];
    return 0;
}
