#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface Item : NPObject
@end

@implementation Item
- (void)dealloc {
    printf("dealloc\n");
}
@end

int main() {
    for (int i = 0; i < 3; i++) {
        @autoreleasepool {
            Item *a = [Item new];
            printf("iteration %d\n", i);
        }
    }
    printf("done\n");
    return 0;
}
