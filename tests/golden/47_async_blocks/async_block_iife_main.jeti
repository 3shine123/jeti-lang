// Golden: async block IIFE in a plain function (main) — §5 self-context.
// v1 rule 2: a bare IIFE statement position was removed — invoking an async
// block yields a task handle and MUST be awaited; sync `main` enters through
// the blockOn bridge (rule 3). There is no `self` in scope in main; the
// hidden capture argument is `(NPObject *)0` (a block body that actually
// uses `self` there is already a checker error). Expected:
//   iife=42
//   main done
#import <Foundation/Foundation.hje>
#import <stdio.h>

int main(void) {
    long r = [NPTask blockOn:async ^ void {
        int v = await (async ^ int (void) {
            return 42;
        })();
        printf("iife=%d\n", v);
    }];
    (void)r;
    printf("main done\n");
    return 0;
}
