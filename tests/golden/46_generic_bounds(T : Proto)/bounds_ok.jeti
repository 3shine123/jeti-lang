// Generic protocol bounds (`T : Proto`) — positive golden test.
// Conforming instantiation, escape channels (id / bare spelling),
// multi-param bounds, subclass chain. Prints probes and exits 0.

#include <stdio.h>
#import <Foundation/Foundation.hje>

@protocol Greetable
- (NPString *)greeting;
@end

@protocol Comparable
- (int)compare:(id)other;
@end

@interface Dog : NPObject <Greetable>
- (NPString *)greeting;
@end

@implementation Dog
- (NPString *)greeting { return @"woof"; }
@end

@interface Num : NPObject <Comparable>
- (int)compare:(id)other;
@end

@implementation Num
- (int)compare:(id)other { return 0; }
@end

@interface Box<T : Greetable> : NPObject {
    T _value;
}
- (instancetype)initWithValue:(T)value;
- (T)value;
@end

@implementation Box
- (instancetype)initWithValue:(T)value {
    self = [super init];
    if (self) {
        _value = value;
    }
    return self;
}
- (T)value { return _value; }
@end

@interface Pair<K, V : Comparable> : NPObject {
    K _k;
    V _v;
}
- (instancetype)initWithValue:(K)k value:(V)v;
@end

@implementation Pair
- (instancetype)initWithValue:(K)k value:(V)v {
    self = [super init];
    if (self) {
        _k = k;
        _v = v;
    }
    return self;
}
@end

@interface MutableBox<T : Greetable> : Box<T>
- (void)noop;
@end

@implementation MutableBox
- (void)noop { }
@end

int main() {
    Box<Dog *> *b = [[Box<Dog *> alloc] initWithValue:[[Dog alloc] init]];
    // NOTE: no UTF8String print here — printing a generic-boxed value in the
    // same TU as further specializations trips a pre-existing codegen bug
    // (reproduces without bounds too; see ROADMAP known-limits).
    (void)[b value];
    Box<id> *e = [[Box<id> alloc] initWithValue:[[Dog alloc] init]];
    (void)e;
    Box *bare = [[Box alloc] initWithValue:[[Dog alloc] init]];
    (void)bare;
    printf("escapes-ok\n");
    Pair<Dog *, Num *> *p = [[Pair<Dog *, Num *> alloc] initWithValue:[[Dog alloc] init] value:[[Num alloc] init]];
    (void)p;
    printf("pair-ok\n");
    return 0;
}
