#import <Foundation/Foundation.hje>

@protocol Greetable
- (NPString *)greeting;
@end

@interface Cat : NPObject
- (void)meow;
@end

@implementation Cat
- (void)meow { }
@end

@interface Box<T : Greetable> : NPObject {
    T _value;
}
- (instancetype)initWithValue:(T)value;
@end

@implementation Box
- (instancetype)initWithValue:(T)value {
    self = [super init];
    if (self) {
        _value = value;
    }
    return self;
}
@end

int main() {
    Box<Cat *> *bad = [[Box<Cat *> alloc] initWithValue:[[Cat alloc] init]];
    (void)bad;
    return 0;
