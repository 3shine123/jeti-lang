// lang-test/cross_file_test.jeti
// 主程序入口：联动编译压测

#import "diamond_base.hje"
// 引入具体的实现细节类声明（这里假设转译器能够感知同目录或通过命令行联动编译）
#import "diamond_impl-F.jeti"
#include <stdio.h>

int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("==================================================\n");
        printf(">>>  jetic 编译器「多文件交叉依赖与菱形协议」压测  <<<\n");
        printf("==================================================\n\n");

        // 1. 测试跨文件前置声明与双向循环互锁对象的实例化
        printf("--- 测试点 1: 跨文件前置声明与双向互锁依赖 ---\n");
        NPShipSystem* system = [[NPShipSystem alloc] initWithId:2026];
        NPCraftPilot* pilot = [[NPCraftPilot alloc] initWithName:"指挥官凯克特斯"];

        // 双向绑定
        [system linkPilot:pilot];
        
        printf("[符号断言] 双向互锁指针解析成功！\n");
        printf("船只系统绑定的飞行员: %s\n", system->currentPilot->pilotName);
        printf("飞行员反向绑定的系统ID: %d\n", pilot->boundSystem->systemStatusId);

        // 2. 测试菱形协议网络符号汇聚
        printf("\n--- 测试点 2: 菱形协议树多重挂载与符号分发 ---\n");
        NPDiamondAbuser* abuser = [[NPDiamondAbuser alloc] init];

        // 依次调用来自不同层级协议的方法
        [abuser leftBranchAction];
        [abuser rightBranchAction];
        [abuser executeCoreTask]; // 最终汇聚到最顶层基协议

        printf("[状态检查] 菱形冲突计数器累加值: %d (预期为 115)\n", [abuser collisionCounter]);

        // 3. 内存清理
        [system release];
        [pilot release];
        [abuser release];

        printf("\n==================================================\n");
        printf(">>>     神作中的神作！多文件联动编译全线打通！    <<<\n");
        printf("==================================================\n");
    }
    return 0;
}