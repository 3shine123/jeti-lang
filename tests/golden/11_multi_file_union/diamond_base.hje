// 菱形继承与多重协议的前置声明文件

#import <Foundation/Foundation.jeti>

// 1. 菱形继承协议网
@protocol NPBaseProtocol <NPObject>
- (void)executeCoreTask;
@end

@protocol NPLeftProtocol <NPBaseProtocol>
- (void)leftBranchAction;
@end

@protocol NPRightProtocol <NPBaseProtocol>
- (void)rightBranchAction;
@end

// 2. 两个互相引用的类的前置声明（打破文件包含死锁）
@class NPCraftPilot;
@interface NPShipSystem : NPObject
{
    @public
    // 互引用指针，测试编译器在未完全解析 NPCraftPilot 时对指针大小和符号的计算
    NPCraftPilot* currentPilot; 
    int systemStatusId;
}
- (id)initWithId:(int)sid;
- (void)linkPilot:(id)pilot;
@end