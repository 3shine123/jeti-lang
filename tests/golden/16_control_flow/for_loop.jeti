#include <stdio.h>
#include <stdlib.h>
#import <Foundation/Foundation.hje>

int main() {
    int sum = 0;
    for (int i = 1; i <= 10; i++) {
        sum += i;
    }
    printf("1+2+...+10 = %d\n", sum);

    for (int i = 10; i >= 1; i--) {
        printf("%d", i);
        if (i > 1) printf(", ");
        else printf("\n");
    }
    return 0;
}