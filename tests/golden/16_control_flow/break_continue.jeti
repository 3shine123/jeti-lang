#include <stdio.h>
#import <Foundation/Foundation.hje>

int main() {
    for (int i = 0; i < 10; i++) {
        if (i == 4) continue;
        if (i == 8) break;
        printf("%d ", i);
    }
    printf("\n");

    int sum = 0;
    for (int i = 1; i <= 100; i++) {
        sum += i;
        if (sum > 20) break;
    }
    printf("sum=%d\n", sum);
    return 0;
}