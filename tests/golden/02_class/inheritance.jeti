#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface Animal : NPObject
- (void)speak;
@end

@interface Dog : Animal
@end

@implementation Animal
- (void)speak {
    printf("Animal speaks\n");
}
@end

@implementation Dog
@end

int main() {
    Dog *d = [[Dog alloc] init];
    [d speak];
    return 0;
}
