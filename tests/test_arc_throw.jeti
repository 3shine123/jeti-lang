#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface Obj : NPObject
- (void)doSomething;
@end
@implementation Obj
- (void)doSomething { printf("done\n"); }
@end

int main() {
    @autoreleasepool {
        id obj = [[Obj alloc] init];
        @try {
            [obj doSomething];
        }
        @catch (id e) {
            printf("caught\n");
        }
        [obj release];
    }
    return 0;
}