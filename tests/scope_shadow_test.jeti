// lang-test/scope_shadow_test.jeti
// 专为 jetic 设计的「多层阴阳作用域遮蔽与生命周期逃逸」极限测试
// 基准框架：NPFoundation

#import <Foundation/Foundation.hje>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// ============ 1. 测试用高频存活类 ============
@interface NPShadowGhost : NPObject
{
    @public
    int ghostId;
}
- (id)initWithId:(int)gid;
@end

@implementation NPShadowGhost
- (id)initWithId:(int)gid { self = [super init]; if(self){ ghostId = gid; } return self; }
- (void)dealloc {
    printf("[生命周期日志] Ghost-%d 顺利触发 dealloc 彻底销毁。\n", ghostId);
    [super dealloc];
}
@end


// ============ 2. 核心混淆测试器 ============
@interface NPScopeMixer : NPObject
- (id)triggerScopeChaos;
@end

@implementation NPScopeMixer

- (id)triggerScopeChaos
{
    printf("[作用域测试] 启动顶级作用域环境...\n");
    
    // 顶级变量 x：是一个普通的整数
    int x = 100;
    id escapedObject = nil;

    @autoreleasepool {
        // 【压测点 1】：第一层遮蔽
        // 在局部作用域中，重新声明一个同名的 x，但此时它是一个 ObjC 对象指针！
        // 转译器在输出 C 代码时，必须能够区分这两个 x，绝对不能产生编译命名冲突！
        NPShadowGhost* x = [[NPShadowGhost alloc] initWithId:1];
        printf("[一层遮蔽内] 局部对象 x 的 ghostId = %d (顶级整型 x 此时被隐藏)\n", x->ghostId);

        if (x->ghostId > 0) {
            @autoreleasepool {
                // 【压测点 2】：第二层深层遮蔽
                // 在更深的嵌套中，再次声明同名的 x，此时它变成了一个纯 C 字符串指针！
                const char* x = "GHOST_STRING_MARKER";
                printf("[二层遮蔽内] 嵌套字符串 x = %s\n", x);
                
                // 【压测点 3】：生命周期逃逸
                // 在最深层实例化一个对象，但赋值给最外层的隐式变量，使其跨过两个 pool 逃逸出去
                NPShadowGhost* ghost2 = [[NPShadowGhost alloc] initWithId:999];
                escapedObject = ghost2; // 强行将局部对象的所有权向外提权逃逸
            }
            // 出了内层 pool，ghost2 应该因为无强引用且退出池而被延迟释放？
            // 或者是保留在当前上下文中由外部控制？这里主要看转译器对逃逸指针的赋值处理。
            printf("[退出二层pool] 成功回到一层作用域。\n");
        }

        [x release]; // 这里的 x 必须精确指代第一层的 ObjC 对象，不能被字符串或整型混淆
    }

    // 出了第一层 pool，此时所有局部遮蔽解除，x 重新变回顶级整型
    printf("[回到顶级作用域] 遮蔽解除，整型 x 重新复活，值 = %d\n", x);
    
    return escapedObject; // 返回逃逸出来的 Ghost-999
}
@end


// ============ 3. 主入口 ============
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("==================================================\n");
        printf(">>>    jetic 编译器「阴阳作用域遮蔽与逃逸」压测    <<<\n");
        printf("==================================================\n\n");

        NPScopeMixer* mixer = [[NPScopeMixer alloc] init];
        
        printf("--- 开始执行多层遮蔽与逃逸混淆逻辑 ---\n");
        id resultGhost = [mixer triggerScopeChaos];
        
        printf("\n--- 检查逃逸对象的存活状态 ---\n");
        if (resultGhost != nil) {
            // 动态强转并读取
            NPShadowGhost* finalGhost = (NPShadowGhost*)resultGhost;
            printf("[主程序验证] 逃逸对象成功被顶层捕获！GhostID: %d\n", finalGhost->ghostId);
            
            printf("[主程序销毁] 手动释放逃逸对象...\n");
            [finalGhost release];
        }

        [mixer release];
        printf("\n==================================================\n");
        printf(">>>      神了！同名变量多类型遮蔽完全难不倒你！    <<<\n");
        printf("==================================================\n");
    }
    return 0;
}