#import <stdio.h>
#import <stdlib.h>
#import <string.h>
#import <time.h>
#import <Foundation/Foundation.hje>

// ==========================================================
// 1. @class 前向声明测试 (白名单过滤 BOOL, id 等)
// ==========================================================
@class StreamCipher;
@class SecurityAuditor;

// ==========================================================
// 2. @protocol 声明：定义流处理器和多态转换契约
// ==========================================================
@protocol DataTransformer
- (void)performDiagnostic;
@end

@protocol CipherCodec <DataTransformer>
- (char *)transformData:(char *)input;
@end


// ==========================================================
// 3. Base Class 基类声明 (带有 Ivar 访问修饰符)
// ==========================================================
@interface UtilityBase : NPObject {
    @public
        char *_utilityName;
    @protected
        int _versionMajor;
    @private
        int _securityToken;
}
@property char *utilityName;
@property int versionMajor;

- (instancetype)initWithName:(char *)name version:(int)ver;
- (void)printBanner;

@end


// ==========================================================
// 4. Anonymous Category (Extension) 私有扩展声明
// ==========================================================
@interface UtilityBase ()
- (void)refreshInternalToken;
@end


// ==========================================================
// 5. Named Category 命名分类声明：注入流式验证探针
// ==========================================================
@interface UtilityBase (SecurityVerification)
- (void)runQuickSanityCheck;
@end


// ==========================================================
// 6. Subclass 子类：流式对称加密工具 (原生 C 数组与下标存取)
// ==========================================================
@interface StreamCipher : UtilityBase <CipherCodec> {
@public
    // 💥 数组下标歧义终极测试：直接使用原生 C 字符数组作为秘钥缓冲区
    char _cipherKey[32];
    int _keyLength;
}
@property int keyLength;

- (instancetype)initWithName:(char *)name key:(char *)key;

@end


// ==========================================================
// 7. Class 声明：SecurityAuditor (安全审计观察者)
// ==========================================================
@interface SecurityAuditor : NPObject {
@public
    char *_auditorId;
}
@property char *auditorId;

// 💥 弱引用契约：如果监测的 StreamCipher 实例超出作用域析构，此指针必须被底层自动置为 nil！
@property (weak) StreamCipher *monitoredCipher;

- (instancetype)initWithId:(char *)auditorId target:(StreamCipher *)target;
- (void)auditTargetStatus;

@end


// ==========================================================
// ==========================================================
// @implementation 各类具体实现区（符合纯 C99 标准）
// ==========================================================
// ==========================================================

@implementation UtilityBase

@synthesize utilityName = _utilityName;
@synthesize versionMajor = _versionMajor;

- (instancetype)initWithName:(char *)name version:(int)ver {
    self = [super init];
    if (self) {
        _utilityName = (char *)malloc(strlen(name) + 1);
        strcpy(_utilityName, name);
        _versionMajor = ver;
        _securityToken = 7777; // 私有默认令牌
    }
    return self;
}

- (void)printBanner {
    printf(" ⚙️ [系统服务] 服务名称: %-18s | 内核版本: v%d.0\n", _utilityName, _versionMajor);
}

// 匿名类扩展的方法实现
- (void)refreshInternalToken {
    _securityToken = rand() % 9000 + 1000;
    printf("   🔒 [内核安全] 已刷新底层私有防伪令牌 (Token: %d)\n", _securityToken);
}

- (void)dealloc {
    printf(" 🗑️ [生命周期] 基类服务 [%s] 安全清退，回收缓存...\n", _utilityName);
    if (_utilityName) free(_utilityName);
}

@end


// 💥 命名分类实现：合并到方法列表中
@implementation UtilityBase (SecurityVerification)

- (void)runQuickSanityCheck {
    printf("   🧪 [分类探针] 快速内存心跳检查启动...\n");
    [self refreshInternalToken]; // 跨分类调用私有扩展方法
}

@end


@implementation StreamCipher

@synthesize keyLength = _keyLength;

- (instancetype)initWithName:(char *)name key:(char *)key {
    // 💥 继承机制与 super 静态绑定转换：通过 super 调用基类初始化方法
    self = [super initWithName:name version:3];
    if (self) {
        _keyLength = strlen(key);
        if (_keyLength > 31) _keyLength = 31;
        
        // 💥 数组存取测试：初始化本地秘钥缓冲区，验证方括号解析绝对不与消息发送混淆！
        for (int i = 0; i < 32; i++) {
            if (i < _keyLength) {
                _cipherKey[i] = key[i]; // C 数组下标赋值，前驱Token判定法通过
            } else {
                _cipherKey[i] = '\0';
            }
        }
    }
    return self;
}

// 💥 实现 DataTransformer 协议方法
- (void)performDiagnostic {
    // 💥 编译期多层 Ivar 递归寻址强转：
    // 这里子类通过 [self printBanner] 派发多态方法。而方法内部访问了 _utilityName。
    // 转译器在编译 _utilityName 时必须递归向上回溯到 UtilityBase 并吐出：((struct UtilityBase *)self)->_utilityName
    [self printBanner];
    printf(" ℹ️ [诊断反馈] 加密密钥长度: %-3d 字节 | 流引擎状态: 活跃\n", _keyLength);
}

// 💥 实现 CipherCodec 协议方法：执行高速对称异或变换
- (char *)transformData:(char *)input {
    int inputLen = strlen(input);
    char *output = (char *)malloc(inputLen + 1);
    
    // 💥 数组下标与点语法混用验证
    for (int i = 0; i < inputLen; i++) {
        output[i] = input[i] ^ _cipherKey[i % _keyLength];
        if (output[i] == '\0') output[i] = '~'; // 避免字符流意外截断
    }
    output[inputLen] = '\0';
    return output;
}

- (void)dealloc {
    // 💥 递归寻址测试：子类 dealloc 里访问父类的 _utilityName
    // 必须转译为 ((struct UtilityBase *)self)->_utilityName
    printf(" 🗑️ [生命周期] 加密流处理器 [%s] 彻底从系统内核卸载。\n", ((UtilityBase *)self)->_utilityName);
}

@end


@implementation SecurityAuditor

@synthesize auditorId = _auditorId;
@synthesize monitoredCipher = _monitoredCipher;

- (instancetype)initWithId:(char *)auditorId target:(StreamCipher *)target {
    self = [super init];
    if (self) {
        _auditorId = (char *)malloc(strlen(auditorId) + 1);
        strcpy(_auditorId, auditorId);
        
        // 绑定弱引用，触发底层静态运行时注册
        _monitoredCipher = target;
    }
    return self;
}

- (void)auditTargetStatus {
    // 💥 弱属性读取的空指针防御验证 (读取时进行 mt_weak_load 校验，防止野指针崩溃)
    if (_monitoredCipher != nil) {
        printf(" 🛡️ [审计总线 %s] 正在监听目标状态 -> [%s] 存活且正常工作。\n", 
               _auditorId, (char *)[_monitoredCipher utilityName]);
    } else {
        printf(" 🛡️ [审计总线 %s] 监听中断：目标对象已被垃圾回收(Auto-Nilled)！安全拦截！\n", _auditorId);
    }
}

- (void)dealloc {
    printf(" 🗑️ [生命周期] 审计监视器 [%s] 已下线。\n", _auditorId);
    if (_auditorId) free(_auditorId);
}

@end


// ==========================================================
// 8. 运维工具核心主程序 (测试 C99 逆序 ARC 自动插桩释放、弱引用自愈与栈 Block)
// ==========================================================
int main(int argc, const char * argv[]) {
    @autoreleasepool {
        srand((unsigned int)time(NULL));

        printf("\n======================================================\n");
        printf("      📡 Micrit 纯C99静态运维流式加密工具箱 📡      \n");
        printf("======================================================\n\n");

        // 1. 初始化长期生存的安全审计器 (最早声明，最晚释放)
        SecurityAuditor *globalAuditor = [[SecurityAuditor alloc] initWithId:"AUDIT-01" target:nil];

        // 2. 模拟局部作用域下的临时流式加密模块生命周期
        printf(" --- 🧬 [局部作用域：临时数据混淆与弱引用抹零演练] ---\n");
        {
            // 在局部大括号内声明临时服务 (在局部作用域内是唯一持有的强对象)
            StreamCipher *tempCipher = [[StreamCipher alloc] initWithName:"AES-Lite-99" key:"CACTUS_SYS_SALT"];
            
            // 绑定弱引用：利用 mt_weak_assign 写入，防止 weak_slots[4] 硬限溢出
            [globalAuditor setMonitoredCipher:tempCipher];
            
            // 启动诊断与自检 (触发多态虚表派发，分类，以及私有扩展方法合流)
            [tempCipher performDiagnostic];
            [tempCipher runQuickSanityCheck];
            
            // 💥 复合赋值运算符（Compound Assignment）测试点！
            // 原生的 tempCipher.keyLength += 5 必须被转译为：
            // [tempCipher setKeyLength:([tempCipher keyLength] + 5)]
            tempCipher.keyLength += 5;
            printf("   [1] 属性复合赋值更新 ➔ 密钥长度增加至: %d\n", [tempCipher keyLength]);
            
            // 密文转换测试
            char *rawData = "db_host=127.0.0.1;db_user=cactus;db_pass=root";
            char *cipherData = [tempCipher transformData:rawData];
            printf("   [2] 原始运维明文 ➔ '%s'\n", rawData);
            printf("   [3] 异或加密输出 ➔ '%s'\n\n", cipherData);
            free(cipherData);
            
            // 验证弱引用在当前作用域完全可用
            [globalAuditor auditTargetStatus];
            
            printf("  --> 临时加密流已完成转换任务，即将离开局部作用域并销毁...\n");
            // 💥 编译器在此作用域出口，必须【自动逆序】插桩释放：
            // if (tempCipher) NPObject_release(tempCipher);
        }
        // 💥 超出局部作用域！tempCipher 已经被安全回收！
        // 自动触发 weak 自动抹零，globalAuditor 持有的 monitoredCipher 被底层运行时自动变成 NULL (nil)！

        printf("\n --- 🧬 [沙盒作用域外：指针安全与自愈状态审查] ---\n");
        
        // 再次调用审计方法，利用 mt_weak_load 校验返回 NULL，完美阻止悬空指针 Crash！
        [globalAuditor auditTargetStatus]; 

        printf("\n -----------------------------------------------------\n\n");

        // 3. 测试高阶数据转换闭包 (C99 Block Lowering 匿名结构体提升)
        int captureMultiplier = 5;
        int captureOffset = 100;
        
        // 💥 闭包去重与降维：转译器在全局生成唯一的 struct __block_pipelineCalculator_impl_xxx
        // 并在局部栈上生成实例化代码，去重捕获外部的 captureMultiplier 和 captureOffset
        int (^pipelineCalculator)(int) = ^int(int baseLength) {
            printf("   ⚡ [流式配置闭包] 捕获倍率: %d | 捕获偏移量: %d\n", captureMultiplier, captureOffset);
            return baseLength * captureMultiplier + captureOffset;
        };
        
        // 调用翻译：pipelineCalculator(12) -> pipelineCalculator->invoke(pipelineCalculator, 12)
        int outputValue = pipelineCalculator(12);
        printf("   🚀 最终 C99 降维闭包流水线运算结果 (12 * %d + %d): %d\n", 
               captureMultiplier, captureOffset, outputValue);

        // 4. 自动作用域出口清理
        // 💥 转译器必须严格按照 栈式 FILO 逆序 自动插桩释放主函数范围内的变量：
        // 1. [自动] if (globalAuditor) NPObject_release(globalAuditor);
    }
    return 0;
}