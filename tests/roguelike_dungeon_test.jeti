// lang-test/roguelike_dungeon_test.jeti
// Jeti 地牢探险游戏 - 纯文本 Roguelike

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#import <Foundation/Foundation.hje>

#define MAP_W 40
#define MAP_H 20

#define COLOR_RED     "\033[31m"
#define COLOR_GREEN   "\033[32m"
#define COLOR_YELLOW  "\033[33m"
#define COLOR_CYAN    "\033[36m"
#define COLOR_MAGENTA "\033[35m"
#define COLOR_RESET   "\033[0m"

// ============================================================================
// 实体基类（隐式根类）
// ============================================================================

@interface Entity
@property int x;
@property int y;
@property int collected;
@property char symbol;
@property const char* color;
@property const char* name;
- (id)initWithX:(int)x y:(int)y sym:(char)s col:(const char*)c name:(const char*)n;
@end

@implementation Entity
- (id)initWithX:(int)x y:(int)y sym:(char)s col:(const char*)c name:(const char*)n {
    self = [super init];
    if (self) { [self setX:x]; [self setY:y]; [self setSymbol:s]; [self setColor:c]; [self setName:n]; [self setCollected:0]; }
    return self;
}
@end

// ============================================================================
// 地牢游戏主类
// ============================================================================

@interface DungeonGame : NPObject
@property int gameOver;
@property int victory;
@property int turnCount;
@property int score;
@property int playerX;
@property int playerY;
- (id)init;
- (void)render;
- (void)processCommand:(const char*)cmd;
- (void)run;
@end

@implementation DungeonGame

- (id)init {
    self = [super init];
    if (self) {
        [self setGameOver:0]; [self setVictory:0]; [self setTurnCount:0]; [self setScore:0];
        [self setPlayerX:MAP_W / 2]; [self setPlayerY:MAP_H / 2];
    }
    return self;
}

- (void)render {
    printf("\033[2J\033[H");
    printf("%s╔", COLOR_YELLOW);
    for (int i = 0; i < MAP_W; i++) printf("═");
    printf("╗%s\n", COLOR_RESET);

    for (int i = 0; i < MAP_H; i++) {
        printf("%s║%s", COLOR_YELLOW, COLOR_RESET);
        for (int j = 0; j < MAP_W; j++) {
            if ([self playerX] == j && [self playerY] == i) {
                printf("%s@%s", COLOR_CYAN, COLOR_RESET);
            } else {
                printf(" ");
            }
        }
        printf("%s║%s\n", COLOR_YELLOW, COLOR_RESET);
    }

    printf("%s╚", COLOR_YELLOW);
    for (int i = 0; i < MAP_W; i++) printf("═");
    printf("╝%s\n", COLOR_RESET);
    printf("%s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n", COLOR_CYAN, COLOR_RESET);
    printf("  %sJeti 地牢探险%s  回合: %d\n", COLOR_YELLOW, COLOR_RESET, [self turnCount]);
    printf("  [W]上 [S]下 [A]左 [D]右  [Q]退出\n");
    printf("  > ");
}

- (void)processCommand:(const char*)cmd {
    if (strlen(cmd) == 0) return;
    char ch = cmd[0];
    int dx = 0, dy = 0;
    if (ch == 'q' || ch == 'Q') { [self setGameOver:1]; return; }
    if (ch == 'w' || ch == 'W') { dy = -1; }
    else if (ch == 's' || ch == 'S') { dy = 1; }
    else if (ch == 'a' || ch == 'A') { dx = -1; }
    else if (ch == 'd' || ch == 'D') { dx = 1; }
    else { return; }
    int nx = [self playerX] + dx;
    int ny = [self playerY] + dy;
    if (nx < 1 || nx >= MAP_W - 1 || ny < 1 || ny >= MAP_H - 1) return;
    [self setPlayerX:nx]; [self setPlayerY:ny];
    [self setTurnCount:[self turnCount] + 1];
}

- (void)run {
    printf("\033[2J\033[H");
    printf("%s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n", COLOR_CYAN, COLOR_RESET);
    printf("  %s★ Jeti 地牢探险 ★%s\n", COLOR_YELLOW, COLOR_RESET);
    printf("  按 [Enter] 开始...");
    fflush(stdout);
    char buf[16];
    fgets(buf, sizeof(buf), stdin);
    while (![self gameOver] && ![self victory]) {
        [self render];
        fflush(stdout);
        char cmd[16];
        if (!fgets(cmd, sizeof(cmd), stdin)) break;
        size_t len = strlen(cmd);
        if (len > 0 && cmd[len - 1] == '\n') cmd[len - 1] = '\0';
        [self processCommand:cmd];
    }
    [self render];
    printf("  %s游戏结束！共 %d 回合%s\n", COLOR_YELLOW, [self turnCount], COLOR_RESET);
    printf("  按 [Enter] 退出...");
    fflush(stdout);
    fgets(buf, sizeof(buf), stdin);
}
@end

// ============================================================================
// 主函数
// ============================================================================

int main(int argc, const char* argv[]) {
    @autoreleasepool {
        DungeonGame* game = [[DungeonGame alloc] init];
        [game run];
        [game release];
    }
    return 0;
}