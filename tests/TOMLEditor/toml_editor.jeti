// toml_editor.jeti — Jeti 全特性 TOML 编辑器
// 编译: jetic run tests/TOMLEditor/toml_editor.jeti -fno-jeti-arc
// 特性覆盖: @namespace, @protocol, @interface, @implementation, @property,
//           @synthesize, @category, @selector, 继承, 泛型<T>, Block,
//           @try/@catch/@throw, @autoreleasepool, @public, @public weak,
//           instancetype, setjmp/longjmp 异常

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <termios.h>
#include <unistd.h>
#include <errno.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <time.h>
#include <setjmp.h>
#import <Foundation/Foundation.jeti>
#import "toml_editor_types.hje"

// ── C helpers ────────────────────────────────────────────────────────────────

static int starts_with(const char *s, const char *prefix) {
    return strncmp(s, prefix, strlen(prefix)) == 0;
}

static char *strdup_or_null(const char *s) {
    return s ? strdup(s) : NULL;
}

static void trim_trailing(char *s) {
    if (!s || !*s) return;
    int len = (int)strlen(s);
    while (len > 0 && (s[len-1] == ' ' || s[len-1] == '\t' || s[len-1] == '\r')) s[--len] = '\0';
}

static void trim_leading(const char **p) {
    while (**p == ' ' || **p == '\t') (*p)++;
}

// ── read_line with full terminal support ─────────────────────────────────────

@namespace TOML

    static int read_line(char *buf, int size) {
        if (!isatty(STDIN_FILENO)) {
            if (!fgets(buf, size, stdin)) return 0;
            int len = (int)strlen(buf);
            while (len > 0 && (buf[len-1] == '\n' || buf[len-1] == '\r')) buf[--len] = '\0';
            return len;
        }
        struct termios old, raw;
        tcgetattr(STDIN_FILENO, &old);
        raw = old;
        raw.c_lflag &= ~(ECHO | ICANON);
        raw.c_cc[VMIN] = 1;
        raw.c_cc[VTIME] = 0;
        tcsetattr(STDIN_FILENO, TCSANOW, &raw);
        int pos = 0, len = 0;
        while (len < size - 1) {
            char c;
            if (read(STDIN_FILENO, &c, 1) <= 0) break;
            if (c == '\x1b') {
                char seq[2];
                if (read(STDIN_FILENO, &seq[0], 1) <= 0) break;
                if (read(STDIN_FILENO, &seq[1], 1) <= 0) break;
                if (seq[0] == '[') {
                    if (seq[1] == 'D' && pos > 0) {
                        pos--;
                        printf("\033[D");
                        fflush(stdout);
                    } else if (seq[1] == 'C' && pos < len) {
                        pos++;
                        printf("\033[C");
                        fflush(stdout);
                    } else if (seq[1] == '3' && pos < len) {
                        memmove(&buf[pos], &buf[pos+1], len-pos-1);
                        len--;
                        buf[len] = '\0';
                        write(STDOUT_FILENO, &buf[pos], (size_t)(len-pos));
                        write(STDOUT_FILENO, " \b", 2);
                        for (int i = len; i > pos; i--) printf("\b");
                        fflush(stdout);
                    }
                    if (seq[1] < 0x40 || seq[1] > 0x7E) {
                        char extra;
                        while (read(STDIN_FILENO, &extra, 1) > 0) {
                            if (extra >= 0x40 && extra <= 0x7E) break;
                        }
                    }
                }
                continue;
            }
            if (c == '\n' || c == '\r') {
                buf[len] = '\0';
                break;
            }
            if (c == '\x08' || c == 127) {
                if (pos > 0) {
                    memmove(&buf[pos-1], &buf[pos], len-pos);
                    len--;
                    pos--;
                    buf[len] = '\0';
                    write(STDOUT_FILENO, "\b", 1);
                    write(STDOUT_FILENO, &buf[pos], (size_t)(len-pos));
                    write(STDOUT_FILENO, " \b", 2);
                    for (int i = len; i > pos; i--) write(STDOUT_FILENO, "\b", 1);
                    fflush(stdout);
                }
                continue;
            }
            if (c >= 0x20) {
                if (pos < len) memmove(&buf[pos+1], &buf[pos], len-pos);
                buf[pos] = c;
                len++; pos++;
                buf[len] = '\0';
                write(STDOUT_FILENO, &c, 1);
                if (pos < len) {
                    write(STDOUT_FILENO, &buf[pos], (size_t)(len-pos));
                    for (int i = len; i > pos; i--) write(STDOUT_FILENO, "\b", 1);
                }
                fflush(stdout);
            }
        }
        putchar('\n');
        tcsetattr(STDIN_FILENO, TCSANOW, &old);
        return len;
    }

@endnamespace // @namespace TOML

// ── @implementation: value types ────────────────────────────────────────────

@namespace TOML

    @implementation String

    - (instancetype)initWithString:(const char *)val {
        if (self = [super init]) { _value = strdup(val ? val : ""); }
        return self;
    }
    - (void)dealloc {
        if (_value) free(_value);
        [super dealloc];
    }
    - (const char *)typeName { return "string"; }
    - (void)printOn:(int)indent {
        printf("\"%s\"", _value ? _value : "");
    }
    - (id)copyValue {
        return [[String alloc] initWithString:_value];
    }
    - (const char *)value { return _value ? _value : ""; }
    - (void)setValue:(const char *)val {
        if (_value) free(_value);
        _value = strdup(val ? val : "");
    }

    @end

    @implementation Integer

    - (instancetype)initWithLong:(long long)val {
        if (self = [super init]) { _value = val; }
        return self;
    }
    - (const char *)typeName { return "integer"; }
    - (void)printOn:(int)indent { printf("%lld", _value); }
    - (id)copyValue { return [[Integer alloc] initWithLong:_value]; }
    - (long long)value { return _value; }
    - (void)setValue:(long long)val { _value = val; }

    @end

    @implementation Float

    - (instancetype)initWithDouble:(double)val {
        if (self = [super init]) { _value = val; }
        return self;
    }
    - (const char *)typeName { return "float"; }
    - (void)printOn:(int)indent { printf("%g", _value); }
    - (id)copyValue { return [[Float alloc] initWithDouble:_value]; }
    - (double)value { return _value; }
    - (void)setValue:(double)val { _value = val; }

    @end

    @implementation Bool

    - (instancetype)initWithBool:(BOOL)val {
        if (self = [super init]) { _value = val; }
        return self;
    }
    - (const char *)typeName { return "bool"; }
    - (void)printOn:(int)indent { printf(_value ? "true" : "false"); }
    - (id)copyValue { return [[Bool alloc] initWithBool:_value]; }
    - (BOOL)value { return _value; }
    - (void)setValue:(BOOL)val { _value = val; }

    @end

    @implementation Array

    - (instancetype)init {
        if (self = [super init]) {
            _capacity = 16;
            _items = (id *)calloc(_capacity, sizeof(id));
            _count = 0;
        }
        return self;
    }
    - (void)dealloc {
        for (int i = 0; i < _count; i++) [_items[i] release];
        if (_items) free(_items);
        [super dealloc];
    }
    - (int)count { return _count; }
    - (id)at:(int)idx { return (idx >= 0 && idx < _count) ? _items[idx] : nil; }
    - (void)add:(id)val {
        if (!val) return;
        if (_count >= _capacity) {
            _capacity *= 2;
            _items = (id *)realloc(_items, _capacity * sizeof(id));
        }
        _items[_count++] = [val retain];
    }
    - (void)removeAt:(int)idx {
        if (idx < 0 || idx >= _count) return;
        [_items[idx] release];
        memmove(&_items[idx], &_items[idx+1], (_count-idx-1)*sizeof(id));
        _count--;
    }
    - (void)each:(void (^)(int idx, id val))block {
        for (int i = 0; i < _count; i++) block(i, _items[i]);
    }
    - (const char *)typeName { return "array"; }
    - (void)printOn:(int)indent {
        if (_count == 0) {
            printf("[]");
            return;
        }
        printf("[\n");
        for (int i = 0; i < _count; i++) {
            for (int j = 0; j < indent+1; j++) printf("    ");
            [_items[i] printOn:indent+1];
            printf("\n");
        }
        for (int j = 0; j < indent; j++) printf("    ");
        printf("]");
    }
    - (id)copyValue {
        Array *c = [[Array alloc] init];
        for (int i = 0; i < _count; i++) {
            id v = [_items[i] copyValue];
            [c add:v];
            [v release];
        }
        return c;
    }

    @end

@endnamespace // @namespace TOML

// ── @implementation: Table ──────────────────────────────────────────────────

@namespace TOML

    @implementation Table

    - (instancetype)init {
        if (self = [super init]) {
            _capacity = 32;
            _keys = (char **)calloc(_capacity, sizeof(char *));
            _values = (id *)calloc(_capacity, sizeof(id));
            _count = 0;
        }
        return self;
    }
    - (void)dealloc {
        for (int i = 0; i < _count; i++) {
            if (_keys[i]) free(_keys[i]);
            [_values[i] release];
        }
        if (_keys) free(_keys);
        if (_values) free(_values);
        [super dealloc];
    }
    - (int)count { return _count; }
    - (int)indexOf:(const char *)key {
        for (int i = 0; i < _count; i++) if (strcmp(_keys[i], key) == 0) return i;
        return -1;
    }
    - (id)get:(const char *)key {
        int idx = [self indexOf:key];
        return (idx >= 0) ? _values[idx] : nil;
    }
    - (void)set:(id)val forKey:(const char *)key {
        if (!key) return;
        int idx = [self indexOf:key];
        if (idx >= 0) {
            if (_values[idx] != val) {
                [_values[idx] release];
                _values[idx] = [val retain];
            }
        } else {
            if (_count >= _capacity) {
                _capacity *= 2;
                _keys = (char **)realloc(_keys, _capacity*sizeof(char*));
                _values = (id *)realloc(_values, _capacity*sizeof(id));
            }
            _keys[_count] = strdup(key);
            _values[_count] = [val retain];
            _count++;
        }
    }
    - (void)remove:(const char *)key {
        int idx = [self indexOf:key];
        if (idx < 0) return;
        if (_keys[idx]) free(_keys[idx]);
        [_values[idx] release];
        memmove(&_keys[idx], &_keys[idx+1], (_count-idx-1)*sizeof(char*));
        memmove(&_values[idx], &_values[idx+1], (_count-idx-1)*sizeof(id));
        _count--;
    }
    - (const char *)atKey:(int)idx { return (idx >= 0 && idx < _count) ? _keys[idx] : NULL; }
    - (id)atVal:(int)idx { return (idx >= 0 && idx < _count) ? _values[idx] : nil; }
    - (void)each:(void (^)(int idx, id val))block {
        for (int i = 0; i < _count; i++) block(i, _values[i]);
    }
    - (const char *)typeName { return "table"; }
    - (void)printOn:(int)indent { printf("<table %d keys>", _count); }
    - (id)copyValue {
        Table *c = [[Table alloc] init];
        for (int i = 0; i < _count; i++) {
            id v = [_values[i] copyValue];
            [c set:v forKey:_keys[i]];
            [v release];
        }
        return c;
    }

    // Convenience setters
    - (void)setString:(const char *)val forKey:(const char *)key {
        id s = [[String alloc] initWithString:val];
        [self set:s forKey:key];
        [s release];
    }
    - (void)setInteger:(long long)val forKey:(const char *)key {
        id n = [[Integer alloc] initWithLong:val];
        [self set:n forKey:key];
        [n release];
    }
    - (void)setFloat:(double)val forKey:(const char *)key {
        id n = [[Float alloc] initWithDouble:val];
        [self set:n forKey:key];
        [n release];
    }
    - (void)setBool:(BOOL)val forKey:(const char *)key {
        id b = [[Bool alloc] initWithBool:val];
        [self set:b forKey:key];
        [b release];
    }

    @end

    // ── @category: Table (Debug) ─────────────────────────────────────────────

    @implementation Table (Debug)

    - (void)dump {
        printf("Table<%p> count=%d capacity=%d\n", self, _count, _capacity);
        for (int i = 0; i < _count; i++) {
            printf("  [%d] \"%s\" -> %s\n", i, _keys[i], [_values[i] typeName]);
        }
    }
    - (int)keyCount { return _count; }

    @end

@endnamespace // @namespace TOML

// ── @implementation: Parser ─────────────────────────────────────────────────

@namespace TOML

    // Exception for parse errors
    @interface ParseError : NPObject {
        char *_msg;
    }
    - (instancetype)initWithMessage:(const char *)msg;
    - (const char *)message;
    - (void)dealloc;
    @end

    @implementation ParseError
    - (instancetype)initWithMessage:(const char *)msg {
        if (self = [super init]) { _msg = strdup(msg ? msg : "parse error"); }
        return self;
    }
    - (void)dealloc {
        if (_msg) free(_msg);
        [super dealloc];
    }
    - (const char *)message { return _msg ? _msg : ""; }
    @end

    // Forward static decls
    static id parse_value(const char **p);

    static void THROW(const char *msg) throws(ParseError *) {
        ParseError *e = [[ParseError alloc] initWithMessage:msg];
        @throw e;
    }

    @implementation Parser

    + (char *)parseKey:(const char **)p {
        trim_leading(p);
        if (**p == '"') {
            (*p)++;
            int cap = 64, len = 0;
            char *buf = (char *)malloc(cap);
            while (**p && **p != '"') {
                if (**p == '\\' && *(*p+1)) {
                    (*p)++;
                    switch (**p) {
                        case '"':
                        case '\\':
                            buf[len++] = **p;
                            break;
                        case 'n':
                            buf[len++] = '\n';
                            break;
                        case 't':
                            buf[len++] = '\t';
                            break;
                        default:
                            buf[len++] = **p;
                            break;
                    }
                } else {
                    buf[len++] = **p;
                }
                (*p)++;
                if (len >= cap-4) {
                    cap *= 2;
                    buf = (char *)realloc(buf, cap);
                }
            }
            if (**p == '"') (*p)++;
            buf[len] = '\0';
            return buf;
        }
        if (**p == '\'') {
            (*p)++;
            int cap = 64, len = 0;
            char *buf = (char *)malloc(cap);
            while (**p && **p != '\'') {
                buf[len++] = **p;
                (*p)++;
                if (len >= cap-4) {
                    cap *= 2;
                    buf = (char *)realloc(buf, cap);
                }
            }
            if (**p == '\'') (*p)++;
            buf[len] = '\0';
            return buf;
        }
        // Bare key
        int cap = 64, len = 0;
        char *buf = (char *)malloc(cap);
        while (**p && !strchr(" \t=#[]\n\r", **p)) {
            buf[len++] = **p;
            (*p)++;
            if (len >= cap-4) {
                cap *= 2;
                buf = (char *)realloc(buf, cap);
            }
        }
        buf[len] = '\0';
        return buf;
    }

    static id parse_string(const char **p) {
        if (**p == '"') {
            (*p)++;
            int cap = 256, len = 0;
            char *buf = (char *)malloc(cap);
            while (**p && **p != '"') {
                if (**p == '\\' && *(*p+1)) {
                    (*p)++;
                    switch (**p) {
                        case '"':
                        case '\\':
                            buf[len++] = **p;
                            break;
                        case 'n':
                            buf[len++] = '\n';
                            break;
                        case 't':
                            buf[len++] = '\t';
                            break;
                        case 'r':
                            buf[len++] = '\r';
                            break;
                        default:
                            buf[len++] = **p;
                            break;
                    }
                } else {
                    buf[len++] = **p;
                }
                (*p)++;
                if (len >= cap-8) {
                    cap *= 2;
                    buf = (char *)realloc(buf, cap);
                }
            }
            if (**p == '"') (*p)++;
            buf[len] = '\0';
            id s = [[String alloc] initWithString:buf];
            free(buf);
            return s;
        }
        if (**p == '\'') {
            (*p)++;
            int cap = 256, len = 0;
            char *buf = (char *)malloc(cap);
            while (**p && **p != '\'') {
                buf[len++] = **p;
                (*p)++;
                if (len >= cap-8) {
                    cap *= 2;
                    buf = (char *)realloc(buf, cap);
                }
            }
            if (**p == '\'') (*p)++;
            buf[len] = '\0';
            id s = [[String alloc] initWithString:buf];
            free(buf);
            return s;
        }
        return nil;
    }

    + (id)parseValue:(const char *)p {
        trim_leading(&p);
        if (*p == '\0') return nil;
        // String
        if (*p == '"' || *p == '\'') return parse_string(&p);
        // Boolean
        if (strncmp(p, "true", 4) == 0 && !isalnum(p[4])) return [[Bool alloc] initWithBool:YES];
        if (strncmp(p, "false", 5) == 0 && !isalnum(p[5])) return [[Bool alloc] initWithBool:NO];
        // Integer/Float
        char *end = NULL;
        long long int_val = strtoll(p, &end, 0);
        if (end != p) {
            const char *rem = end;
            while (*rem == ' ' || *rem == '\t') rem++;
            if (*rem == '.' || *rem == 'e' || *rem == 'E') {
                double dbl_val = strtod(p, &end);
                return [[Float alloc] initWithDouble:dbl_val];
            }
            // Check within parsed portion
            const char *ck = p;
            while (ck < end) {
                if (*ck == '.' || *ck == 'e' || *ck == 'E') {
                    double d = strtod(p, NULL);
                    return [[Float alloc] initWithDouble:d];
                }
                ck++;
            }
            return [[Integer alloc] initWithLong:int_val];
        }
        // Inline table
        if (*p == '{') {
            p++;
            Table *t = [[Table alloc] init];
            while (*p && *p != '}') {
                char *key = [Parser parseKey:&p];
                if (!key) break;
                trim_leading(&p);
                if (*p == '=') {
                    p++;
                    trim_leading(&p);
                }
                id val = parse_value(&p);
                if (val) {
                    [t set:val forKey:key];
                    [val release];
                }
                free(key);
                trim_leading(&p);
                if (*p == ',') {
                    p++;
                    trim_leading(&p);
                }
            }
            if (*p == '}') p++;
            return t;
        }
        // Inline array
        if (*p == '[') {
            p++;
            Array *a = [[Array alloc] init];
            while (*p && *p != ']') {
                trim_leading(&p);
                if (*p == ']' || *p == '\0') break;
                id val = parse_value(&p);
                if (val) {
                    [a add:val];
                    [val release];
                } else {
                    p++;
                }
                trim_leading(&p);
                if (*p == ',') {
                    p++;
                    trim_leading(&p);
                }
            }
            if (*p == ']') p++;
            return a;
        }
        return nil;
    }

    static id parse_value(const char **p) {
        return [Parser parseValue:*p];
    }

    + (id)parse:(const char *)input {
        Table *root = [[Table alloc] init];
        char *buf = strdup(input ? input : "");
        if (!buf) return root;

        Table *currentTable = root;
        char *line = buf;

        while (line && *line) {
            char *next = strchr(line, '\n');
            if (next) *next++ = '\0';

            // Trim trailing
            char *end = line + strlen(line);
            while (end > line && (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r')) end--;
            *end = '\0';

            char *trimmed = line;
            while (*trimmed == ' ' || *trimmed == '\t') trimmed++;

            if (*trimmed == '\0' || *trimmed == '#') {
                line = next;
                continue;
            }

            @try {

                // Array of tables: [[...]]
                if (starts_with(trimmed, "[[")) {
                    const char *p = trimmed + 2;
                    int first = 1;
                    Table *target = root;
                    while (*p && *p != ']') {
                        trim_leading(&p);
                        if (*p == ']') break;
                        char *part = [Parser parseKey:&p];
                        if (!part) break;
                        trim_leading(&p);
                        if (*p == '.') {
                            p++;
                            trim_leading(&p);
                        }
                        if (first) {
                            id existing = [target get:part];
                            if (!existing || ![existing isKindOf:[Array class]]) {
                                existing = [[Array alloc] init];
                                [target set:existing forKey:part];
                                [existing release];
                            }
                            Array *arr = (Array *)existing;
                            Table *newTable = [[Table alloc] init];
                            [arr add:newTable];
                            [newTable release];
                            target = newTable;
                            first = 0;
                        } else {
                            id existing = [target get:part];
                            if (!existing || ![existing isKindOf:[Table class]]) {
                                existing = [[Table alloc] init];
                                [target set:existing forKey:part];
                                [existing release];
                            }
                            target = (Table *)existing;
                        }
                        free(part);
                    }
                    currentTable = target;
                    line = next;
                    continue;
                }

                // Table: [...]
                if (*trimmed == '[') {
                    const char *p = trimmed + 1;
                    Table *target = root;
                    while (*p && *p != ']') {
                        trim_leading(&p);
                        if (*p == ']') break;
                        char *part = [Parser parseKey:&p];
                        if (!part) break;
                        trim_leading(&p);
                        if (*p == '.') {
                            p++;
                            trim_leading(&p);
                        }
                        id existing = [target get:part];
                        if (!existing || ![existing isKindOf:[Table class]]) {
                            existing = [[Table alloc] init];
                            [target set:existing forKey:part];
                            [existing release];
                        }
                        target = (Table *)existing;
                        free(part);
                    }
                    currentTable = target;
                    line = next;
                    continue;
                }

                // Key = value
                const char *p = trimmed;
                char *key = [Parser parseKey:&p];
                if (key) {
                    trim_leading(&p);
                    if (*p == '=') {
                        p++;
                        trim_leading(&p);
                        id val = nil;
                        // Multi-line strings
                        if (starts_with(p, "\"\"\"")) {
                            p += 3;
                            if (*p == '\n') p++;
                            int cap = 512, len = 0;
                            char *sb = (char *)malloc(cap);
                            while (*p) {
                                if (starts_with(p, "\"\"\"")) {
                                    p += 3;
                                    break;
                                }
                                if (*p == '\\' && *(p+1) == '\n') {
                                    p += 2;
                                    continue;
                                }
                                if (*p == '\\' && *(p+1)) {
                                    p++;
                                    switch (*p) {
                                        case '"':
                                            sb[len++]='"';
                                            break;
                                        case 'n':
                                            sb[len++]='\n';
                                            break;
                                        case 't':
                                            sb[len++]='\t';
                                            break;
                                        default:
                                            sb[len++]=*p;
                                            break;
                                    }
                                } else {
                                    sb[len++] = *p;
                                }
                                p++;
                                if (len >= cap-8) {
                                    cap *= 2;
                                    sb = (char *)realloc(sb, cap);
                                }
                            }
                            sb[len] = '\0';
                            val = [[String alloc] initWithString:sb];
                            free(sb);
                        } else if (starts_with(p, "'''")) {
                            p += 3;
                            if (*p == '\n') p++;
                            int cap = 512, len = 0;
                            char *sb = (char *)malloc(cap);
                            while (*p) {
                                if (starts_with(p, "'''")) {
                                    p += 3;
                                    break;
                                }
                                sb[len++] = *p;
                                p++;
                                if (len >= cap-8) {
                                    cap *= 2;
                                    sb = (char *)realloc(sb, cap);
                                }
                            }
                            sb[len] = '\0';
                            val = [[String alloc] initWithString:sb];
                            free(sb);
                        } else {
                            val = [Parser parseValue:p];
                        }
                        if (val) {
                            [currentTable set:val forKey:key];
                            [val release];
                        }
                    }
                    free(key);
                }

            } @catch (ParseError *e) {
                printf("  \xe2\x9a\xa0 Parse warning at line: %s\n", [e message]);
                printf("  Skipping: %s\n", line);
            }

            line = next;
        }

        free(buf);
        return root;
    }

    // ── Emitter ──────────────────────────────────────────────────────────────

    static int emit_value(id val, int isArrayElement, char *buf, int size);

    static int emit_table_kvs(Table *t, char *buf, int size, int depth) {
        int pos = 0;
        for (int i = 0; i < [t count]; i++) {
            const char *key = [t atKey:i];
            id val = [t atVal:i];
            for (int j = 0; j < depth && pos < size-1; j++) {
                buf[pos++] = ' ';
                buf[pos] = '\0';
            }
            int needQuote = 0;
            for (const char *c = key; *c; c++) {
                if (!isalnum(*c) && *c != '_' && *c != '-') {
                    needQuote = 1;
                    break;
                }
            }
            if (needQuote) {
                buf[pos++] = '"';
                buf[pos] = '\0';
                for (const char *c = key; *c; c++) {
                    if (pos < size-1) {
                        buf[pos++] = *c;
                        buf[pos] = '\0';
                    }
                }
                buf[pos++] = '"';
                buf[pos] = '\0';
            } else {
                for (const char *c = key; *c; c++) {
                    if (pos < size-1) {
                        buf[pos++] = *c;
                        buf[pos] = '\0';
                    }
                }
            }
            if ([val isKindOf:[Table class]]) {
                buf[pos++] = '\n';
                buf[pos] = '\0';
                int subPos = emit_table_kvs(val, buf + pos, size - pos, depth + 1);
                pos += subPos;
            } else if ([val isKindOf:[Array class]]) {
                Array *arr = (Array *)val;
                if ([arr count] > 0 && [[arr at:0] isKindOf:[Table class]]) {
                    for (int j = 0; j < [arr count]; j++) {
                        if (pos < size-1) {
                            buf[pos++] = '\n';
                            buf[pos] = '\0';
                        }
                        buf[pos++] = '[';
                        buf[pos] = '\0';
                        buf[pos++] = '[';
                        buf[pos] = '\0';
                        if (needQuote) {
                            buf[pos++] = '"';
                            buf[pos] = '\0';
                        }
                        for (const char *c = key; *c; c++) {
                            if (pos < size-1) {
                                buf[pos++] = *c;
                                buf[pos] = '\0';
                            }
                        }
                        if (needQuote) {
                            buf[pos++] = '"';
                            buf[pos] = '\0';
                        }
                        buf[pos++] = ']';
                        buf[pos] = '\0';
                        buf[pos++] = ']';
                        buf[pos] = '\0';
                        buf[pos++] = '\n';
                        buf[pos] = '\0';
                        int subPos = emit_table_kvs((Table *)[arr at:j], buf + pos, size - pos, 0);
                        pos += subPos;
                    }
                } else {
                    buf[pos++] = ' ';
                    buf[pos++] = '=';
                    buf[pos++] = ' ';
                    buf[pos] = '\0';
                    int subPos = emit_value(val, 0, buf + pos, size - pos);
                    pos += subPos;
                    if (pos < size-1) {
                        buf[pos++] = '\n';
                        buf[pos] = '\0';
                    }
                }
            } else {
                buf[pos++] = ' ';
                buf[pos++] = '=';
                buf[pos++] = ' ';
                buf[pos] = '\0';
                int subPos = emit_value(val, 0, buf + pos, size - pos);
                pos += subPos;
                if (pos < size-1) {
                    buf[pos++] = '\n';
                    buf[pos] = '\0';
                }
            }
        }
        return pos;
    }

    static int emit_value(id val, int isArrayElement, char *buf, int size) {
        int pos = 0;
        if ([val isKindOf:[String class]]) {
            const char *s = [val value];
            if (strchr(s, '\n') || strlen(s) > 80) {
                buf[pos++] = '"';
                buf[pos++] = '"';
                buf[pos++] = '"';
                buf[pos++] = '\n';
                buf[pos] = '\0';
                for (const char *c = s; *c; c++) {
                    if (pos < size-1) {
                        buf[pos++] = *c;
                        buf[pos] = '\0';
                    }
                }
                if (pos < size-1) {
                    buf[pos++] = '\n';
                    buf[pos] = '\0';
                }
                buf[pos++] = '"';
                buf[pos++] = '"';
                buf[pos++] = '"';
                buf[pos] = '\0';
            } else {
                int needQuotes = 1;
                for (const char *c = s; *c; c++) {
                    if (!isalnum(*c) && *c != '_' && *c != '-' && *c != '.' && *c != '/') {
                        needQuotes = 1;
                        break;
                    }
                    needQuotes = 0;
                }
                if (needQuotes) {
                    buf[pos++] = '"';
                    buf[pos] = '\0';
                    for (const char *c = s; *c; c++) {
                        if (*c == '"' || *c == '\\') {
                            if (pos < size-1) {
                                buf[pos++] = '\\';
                                buf[pos] = '\0';
                            }
                        }
                        if (pos < size-1) {
                            buf[pos++] = *c;
                            buf[pos] = '\0';
                        }
                    }
                    buf[pos++] = '"';
                    buf[pos] = '\0';
                } else {
                    for (const char *c = s; *c; c++) {
                        if (pos < size-1) {
                            buf[pos++] = *c;
                            buf[pos] = '\0';
                        }
                    }
                }
            }
        } else if ([val isKindOf:[Integer class]]) {
            char tmp[32];
            snprintf(tmp, sizeof(tmp), "%lld", [val value]);
            for (char *c = tmp; *c; c++) {
                if (pos < size-1) {
                    buf[pos++] = *c;
                    buf[pos] = '\0';
                }
            }
        } else if ([val isKindOf:[Float class]]) {
            char tmp[32];
            snprintf(tmp, sizeof(tmp), "%g", [val value]);
            for (char *c = tmp; *c; c++) {
                if (pos < size-1) {
                    buf[pos++] = *c;
                    buf[pos] = '\0';
                }
            }
        } else if ([val isKindOf:[Bool class]]) {
            const char *s = [val value] ? "true" : "false";
            for (const char *c = s; *c; c++) {
                if (pos < size-1) {
                    buf[pos++] = *c;
                    buf[pos] = '\0';
                }
            }
        } else if ([val isKindOf:[Array class]]) {
            Array *arr = (Array *)val;
            buf[pos++] = '[';
            buf[pos] = '\0';
            for (int i = 0; i < [arr count]; i++) {
                if (i > 0) {
                    buf[pos++] = ',';
                    buf[pos++] = ' ';
                    buf[pos] = '\0';
                }
                pos += emit_value([arr at:i], 1, buf + pos, size - pos);
            }
            buf[pos++] = ']';
            buf[pos] = '\0';
        } else if ([val isKindOf:[Table class]]) {
            buf[pos++] = '{';
            buf[pos] = '\0';
            Table *t = (Table *)val;
            for (int i = 0; i < [t count]; i++) {
                if (i > 0) {
                    buf[pos++] = ',';
                    buf[pos++] = ' ';
                    buf[pos] = '\0';
                }
                const char *k = [t atKey:i];
                for (const char *c = k; *c; c++) {
                    if (pos < size-1) {
                        buf[pos++] = *c;
                        buf[pos] = '\0';
                    }
                }
                buf[pos++] = ' ';
                buf[pos++] = '=';
                buf[pos++] = ' ';
                buf[pos] = '\0';
                pos += emit_value([t atVal:i], 0, buf + pos, size - pos);
            }
            buf[pos++] = '}';
            buf[pos] = '\0';
        }
        return pos;
    }

    + (void)emit:(id)root into:(char *)buf size:(int)size {
        buf[0] = '\0';
        int pos = 0;
        if ([root isKindOf:[Table class]]) {
            pos += emit_table_kvs((Table *)root, buf, size, 0);
        } else {
            pos += emit_value(root, 0, buf + pos, size - pos);
        }
        if (pos < size-1) { buf[pos] = '\0'; }
    }

    @end

@endnamespace // @namespace TOML

// ── @implementation: Editor ─────────────────────────────────────────────────

@namespace TOML

    @implementation Editor

    - (instancetype)initWithPath:(const char *)path {
        if (self = [super init]) {
            _root = nil;
            _running = NO;
            _filePath[0] = '\0';
            if (path) strncpy(_filePath, path, 1023);
            _editBuf[0] = '\0';
            _cursorLine = 0;
        }
        return self;
    }

    - (void)dealloc {
        [_root release];
        [super dealloc];
    }

    - (void)loadFile {
        @try {
            if (!_filePath[0]) return;
            FILE *f = fopen(_filePath, "r");
            if (!f) {
                printf("  \xe2\x9c\x97 Cannot open: %s (%s)\n", _filePath, strerror(errno));
                return;
            }
            fseek(f, 0, SEEK_END);
            long fsize = ftell(f);
            fseek(f, 0, SEEK_SET);
            if (fsize <= 0) {
                fclose(f);
                return;
            }
            char *content = (char *)malloc(fsize + 1);
            if (!content) {
                fclose(f);
                return;
            }
            size_t n = fread(content, 1, fsize, f);
            content[n] = '\0';
            [_root release];
            _root = [Parser parse:content];
            [_root retain];
            free(content);
            fclose(f);
            printf("  \xe2\x9c\x93 Loaded %ld bytes from %s\n", fsize, _filePath);
        } @catch (id e) {
            printf("  \xe2\x9c\x97 Load error: %s\n", [e message]);
        }
    }

    - (void)saveFile {
        @try {
            if (!_filePath[0]) {
                printf("  \xe2\x9c\x97 No file path\n");
                return;
            }
            char outBuf[131072];
            [Parser emit:_root into:outBuf size:sizeof(outBuf)];
            FILE *f = fopen(_filePath, "w");
            if (!f) {
                printf("  \xe2\x9c\x97 Cannot write: %s (%s)\n", _filePath, strerror(errno));
                return;
            }
            fputs(outBuf, f);
            fclose(f);
            printf("  \xe2\x9c\x93 Saved %s (%zu bytes)\n", _filePath, strlen(outBuf));
        } @catch (id e) {
            printf("  \xe2\x9c\x97 Save error: %s\n", [e message]);
        }
    }

    - (void)refresh {
        if (isatty(STDIN_FILENO)) printf("\033[2J\033[H");
        printf("╔══════════════════════════════════════════════╗\n");
        if (_filePath[0])
            printf("║  TOML Preview — %-27s  ║\n", _filePath);
        else
            printf("║  TOML Preview                                ║\n");
        printf("╚══════════════════════════════════════════════╝\n");

        if (_root && [_root isKindOf:[Table class]]) {
            Table *t = (Table *)_root;
            for (int i = 0; i < [t count]; i++) {
                const char *key = [t atKey:i];
                id val = [t atVal:i];
                if ([val isKindOf:[Table class]]) {
                    printf("  [%s]\n", key);
                } else if ([val isKindOf:[Array class]]) {
                    Array *arr = (Array *)val;
                    if ([arr count] > 0 && [[arr at:0] isKindOf:[Table class]]) {
                        printf("  [[%s]]  %d entries\n", key, [arr count]);
                    } else {
                        printf("  %s = ", key);
                        [val printOn:0];
                        printf("\n");
                    }
                } else {
                    printf("  %s = ", key);
                    [val printOn:0];
                    printf("\n");
                }
            }
        } else {
            printf("  (empty — use 'set key = value' to add)\n");
        }
        printf("\n");
        printf("╔══════════════════════════════════════════════╗\n");
        printf("║  Command                                     ║\n");
        printf("╚══════════════════════════════════════════════╝\n");
        printf(">>> ");
        fflush(stdout);
    }

    - (int)handleCommand:(const char *)cmd current:(Table **)current {
        while (*cmd == ' ' || *cmd == '\t') cmd++;
        if (!*cmd) return 0;

        // quit
        if (strcmp(cmd, "quit") == 0 || strcmp(cmd, "q") == 0) {
            _running = NO;
            return 1;
        }

        // save — state change → refresh immediately
        if (strcmp(cmd, "save") == 0) {
            [self saveFile];
            return 2;
        }

        // refresh / redraw
        if (strcmp(cmd, "refresh") == 0 || strcmp(cmd, "redraw") == 0) {
            [self refresh];
            return 2;
        }

        // print — serialize full TOML to stdout
        if (strcmp(cmd, "print") == 0 || strcmp(cmd, "p") == 0) {
            char buf[131072];
            [Parser emit:_root into:buf size:sizeof(buf)];
            printf("%s", buf);
            return 0;
        }

        // get <key>
        if (starts_with(cmd, "get ")) {
            const char *key = cmd + 4;
            while (*key == ' ' || *key == '\t') key++;
            id val = [*current get:key];
            if (val) {
                printf("  ");
                [val printOn:0];
                printf("\n");
                if ([val isKindOf:[Table class]]) {
                    Table *sub = (Table *)val;
                    printf("  (%d keys)\n", [sub count]);
                } else if ([val isKindOf:[Array class]]) {
                    printf("  (%d elements)\n", [(Array *)val count]);
                }
            } else {
                printf("  \xe2\x9c\x97 No key \"%s\"\n", key);
            }
            return 0;
        }

        // rm <key> — state change → refresh immediately
        if (starts_with(cmd, "rm ")) {
            const char *key = cmd + 3;
            while (*key == ' ' || *key == '\t') key++;
            if ([*current get:key]) {
                [*current remove:key];
                printf("  \xe2\x9c\x93 Removed \"%s\"\n", key);
            } else {
                printf("  \xe2\x9c\x97 No key \"%s\"\n", key);
            }
            return 2;
        }

        // set <key> = <value>  OR  set <key>=<value> — state change → refresh immediately
        if (starts_with(cmd, "set ")) {
            const char *p = cmd + 4;
            while (*p == ' ' || *p == '\t') p++;
            char *key = [Parser parseKey:&p];
            if (!key) {
                printf("  \xe2\x9c\x97 Invalid key\n");
                return 2;
            }
            while (*p == ' ' || *p == '\t') p++;
            if (*p == '=') {
                p++;
                while (*p == ' ' || *p == '\t') p++;
            }
            id val = [Parser parseValue:p];
            if (val) {
                [*current set:val forKey:key];
                printf("  \xe2\x9c\x93 Set %s to ", key);
                [val printOn:0];
                printf("\n");
                [val release];
            } else {
                // Fallback: raw string
                int cap = 256, len = 0;
                char *raw = (char *)malloc(cap);
                while (*p && *p != '\n' && *p != '\r') {
                    if (*p == '\\' && *(p+1)) {
                        p++;
                        switch (*p) {
                            case 'n':
                                raw[len++]='\n';
                                break;
                            case 't':
                                raw[len++]='\t';
                                break;
                            default:
                                raw[len++]=*p;
                                break;
                        }
                    } else {
                        raw[len++] = *p;
                    }
                    p++;
                    if (len >= cap-8) {
                        cap *= 2;
                        raw = (char *)realloc(raw, cap);
                    }
                }
                raw[len] = '\0';
                id s = [[String alloc] initWithString:raw];
                [*current set:s forKey:key];
                printf("  \xe2\x9c\x93 Set %s = \"%s\"\n", key, raw);
                [s release];
                free(raw);
            }
            free(key);
            return 2;
        }

        // help
        if (strcmp(cmd, "help") == 0 || strcmp(cmd, "h") == 0 || strcmp(cmd, "?") == 0) {
            printf("  ── Commands ──\n");
            printf("  get <key>     - show value\n");
            printf("  set <k>=<v>   - set value\n");
            printf("  rm <key>      - remove key\n");
            printf("  print, p      - print full TOML\n");
            printf("  save          - save to file\n");
            printf("  refresh       - redraw screen\n");
            printf("  help, h, ?    - show this help\n");
            printf("  quit, q       - exit\n");
            return 0;
        }

        printf("  \xe2\x9c\x97 Unknown: %s\n", cmd);
        printf("  Type 'help' for available commands.\n");
        return 0;
    }

    - (void)run {
        _root = [[Table alloc] init];
        _running = YES;

        [self loadFile];

        while (_running) {
            [self refresh];
            int len = read_line(_inputBuf, 4096);
            if (len <= 0) {
                _running = NO;
                break;
            }
            int result;
            @autoreleasepool {
                Table *current = (Table *)_root;
                result = [self handleCommand:_inputBuf current:&current];
            }
            if (result == 1) {
                _running = NO;
                break;
            }
            if (result == 2) {
                continue;
            }
            if (isatty(STDIN_FILENO)) {
                printf("  Press Return to continue...");
                fflush(stdout);
                read_line(_inputBuf, 4096);
            }
        }

        // Auto-save on exit
        [self saveFile];
    }

    @end

@endnamespace // @namespace TOML

// ── Buffer<T> + Watcher ─────────────────────────────────────────────────────

@implementation Buffer<T>

- (instancetype)init {
    if (self = [super init]) { _count = 0; }
    return self;
}
- (void)push:(T)item {
    if (_count < 16) { _storage[_count] = item; _count++; }
}
- (T)get:(int)index {
    return (index >= 0 && index < _count) ? _storage[index] : nil;
}
- (int)count { return _count; }

@end

@implementation Watcher

- (instancetype)initWithTarget:(id)t {
    if (self = [super init]) { _target = t; }
    return self;
}
- (id)target { return _target; }
- (void)setTarget:(id)t { _target = t; }

@end

// ── Main ─────────────────────────────────────────────────────────────────────

int main(int argc, const char **argv) {
    const char *path = NULL;
    if (argc > 1) path = argv[1];

    if (isatty(STDOUT_FILENO)) printf("\033[2J\033[H");
    printf("═══ TOML Editor ═══════════════════════════════════════════════\n");
    if (path) printf("  File: %s\n", path);
    else      printf("  Usage: %s <file.toml>\n", argc > 0 ? argv[0] : "toml_editor");
    printf("  Features: @namespace @protocol @category @selector\n");
    printf("            @try/@catch @autoreleasepool Buffer<T> Watcher\n");
    printf("═══════════════════════════════════════════════════════════════\n\n");

    @autoreleasepool {
        TOML::Editor *ed = [[TOML::Editor alloc] initWithPath:path];
        [ed run];
        [ed release];
    }

    printf("Goodbye!\n");
    return 0;
}
