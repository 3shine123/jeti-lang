// Regression guard for the ARC intern-table use-after-free (fixed 2026-10-02).
// Analysis and the fix: doc/arc_intern_uaf.md.
//
// An interned constant string ("first") is assigned straight to an object ivar
// and then released through the synthesised ARC dealloc. Before the fix the
// release consumed the intern table's only reference, freeing the constant and
// leaving the table dangling — the next interning lookup strcmp()d freed
// memory (heap-use-after-free). The intern table now retains its own reference.
//
// Needs AddressSanitizer to be meaningful (a plain build may or may not
// crash): tests/arc_intern/run_arc_intern_test.sh.
#import <Foundation/Foundation.hje>
#include <stdio.h>

@interface Holder : NPObject {
@public
    NPString *_s;
}
@end

@implementation Holder
@end

int main() {
    @autoreleasepool {
        {
            Holder *h = [[Holder alloc] init];
            h->_s = @"first";   /* direct ivar assign: no retain */
        }                       /* ARC scope exit releases h -> dealloc releases _s */
        NPString *k = @"second"; /* intern lookup strcmp()s the (now alive) "first" */
        printf("k=%s\n", [k UTF8String]);
    }
    return 0;
}
