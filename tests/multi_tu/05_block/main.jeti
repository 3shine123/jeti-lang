#import "model.hje"
#include <stdio.h>

/* client TU: hands a Jeti block to the lib TU, which stores and later fires
   it. If the block were not copied, this would crash or print garbage. The
   captured `total` is mutated inside the block, so it must be __block. */
int main() {
    Pump *p = [[Pump alloc] init];
    __block int total = 0;
    [p onTick:^void(int n) {
        total = total + n;
    }];
    [p fire:5];
    [p fire:7];
    printf("total=%d\n", total);
    printf("helper=%d\n", PumpHelper());
    jeti_release(p);
    return 0;
}
