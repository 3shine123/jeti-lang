#import <Foundation/Foundation.jeti>

/* NEGATIVE CASE — the suite asserts this one FAILS, loudly and legibly.
 *
 * Jeti's uniform vtable is built per translation unit from the set of instance
 * method names that TU sees. Here `model.hje` declares only `show`, so the
 * client TU's layout has one slot. The lib TU implements an EXTRA method that
 * the header never mentions, so its layout has two. The linker weak-merges the
 * two vtable instances into a single allocation, and dispatch through the
 * losing layout reads the wrong offset: silent garbage, or a segfault at some
 * unrelated line, days later.
 *
 * The generated code stamps a layout signature into every vtable instance and
 * verifies it from a per-TU constructor, so the mismatch is reported at load
 * time with both signatures, the full method list, and the source file — rather
 * than being discovered as a mystery crash.
 *
 * The extra method is defined directly in lib.jeti's @implementation, NOT in the
 * shared header: a method named in the header would be collected by BOTH TUs
 * (codegen's pre-pass records every @interface method name it sees), and the
 * layouts would agree — which is why declaring `extra` here would silently turn
 * this into a passing case.
 */

@interface Widget : NPObject
- (void)show;
@end
