#import <Foundation/Foundation.jeti>

/* Inheritance across TUs: the client allocates the subclass but only knows it
   through the base pointer, so dispatch must resolve through the subclass
   vtable that lives in the lib TU. */
@interface Shape : NPObject
- (int)area;
- (const char *)name;
@end

@interface Circle : Shape
- (int)radius;
@end

int ShapeHelper(void);
