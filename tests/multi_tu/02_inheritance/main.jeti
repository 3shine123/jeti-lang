#import "model.hje"
#include <stdio.h>

/* client TU: allocates Circle (lib TU) and drives it through a Shape pointer,
   so every send is a real cross-TU vtable dispatch. */
int main() {
    Circle *c = [[Circle alloc] init];
    Shape *s = c;
    printf("name=%s\n", [s name]);
    printf("area=%d\n", [s area]);
    printf("radius=%d\n", [c radius]);
    printf("helper=%d\n", ShapeHelper());
    jeti_release(c);
    return 0;
}
