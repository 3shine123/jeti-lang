#import "model.hje"

@implementation Factory : NPObject
+ (Factory *)make {
    /* ARC forbids a bare autorelease; the convention here is to hand the
       object back and let the caller's ARC deal with it. `+make` is named
       like an alloc-family method would be, so we return +1 and the caller
       releases. */
    return [[Factory alloc] init];
}
+ (int)magic { return 42; }
+ (const char *)tag { return "factory"; }
@end

@implementation Widget : NPObject
+ (Widget *)create { return [[Widget alloc] init]; }
- (int)widgetId { return 7; }
@end

int FactoryHelper(void) { return 8; }
