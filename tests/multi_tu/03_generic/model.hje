#import <Foundation/Foundation.jeti>

/* Generics across TUs: monomorphisation mangles `Stack<int *>` into a
   dedicated C struct + vtable. The client names the instantiation; the lib TU
   defines it. If the mangling or the vtable emission differs between the two,
   this is where it shows.

   Ivars live on the @interface (Jeti convention). The `T _storage[4]` slot is
   what monomorphisation substitutes: `int * _storage[4]` in the specialised
   C struct. */
@interface Stack<T> : NPObject {
    @public
    int _count;
    T _storage[4];
}
- (void)push:(T)item;
- (T)pop;
- (int)size;
@end

int StackHelper(void);
