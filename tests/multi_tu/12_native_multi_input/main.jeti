#import "model.hje"
#import <Foundation/Foundation.hje>
#include <stdio.h>

/* client TU: sees only the .hje, never lib.jeti */
int main() {
    Greeter *g = [[Greeter alloc] init];
    printf("%s\n", [g greeting:"world"]);
    printf("count=%d\n", [g count]);
    printf("helper=%d\n", GreeterHelper(41));
    jeti_release(g);
    return 0;
}
