#import <Foundation/Foundation.jeti>

/* Protocol conformance across TUs: the lib TU defines a class conforming to a
   protocol, the client declares a variable of the protocol-typed shape and
   sends messages to it. */
@protocol Greeter
- (const char *)greet:(const char *)who;
@end

@interface Rude : NPObject <Greeter>
- (const char *)mood;
@end

const char *GreetVia(id<Greeter> g, const char *who);
