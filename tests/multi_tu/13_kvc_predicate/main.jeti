#import "model.hje"
#include <stdio.h>

/* client TU: sees only the .hje. `size` and `label` are resolved by the
   predicate engine through the KVC table that lib.jeti owns — if the weak
   metadata from this TU won the merge, both lookups would come back empty and
   the predicates below would quietly evaluate to NO. */
int main() {
    Widget *a = MakeWidget(30, "alpha");
    Widget *b = MakeWidget(9, "beta");

    NPPredicate *big = [NPPredicate predicateWithFormat:@"size > 18"];
    printf("big a=%d b=%d\n", [big evaluateWithObject:a], [big evaluateWithObject:b]);

    NPPredicate *lab = [NPPredicate predicateWithFormat:@"label BEGINSWITH 'al'"];
    printf("lab a=%d b=%d\n", [lab evaluateWithObject:a], [lab evaluateWithObject:b]);

    id ws[2];
    ws[0] = a;
    ws[1] = b;
    NPArray *arr = [NPArray arrayWithObjects:ws count:2];
    NPArray *hits = [arr filteredArrayUsingPredicate:big];
    printf("hits=%d\n", (int)[hits count]);

    jeti_release(a);
    jeti_release(b);
    return 0;
}
