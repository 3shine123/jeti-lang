#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface VectorBuffer<T> : NPObject {
@public
    int _count;
}
- (id)init;
- (int)count;
@end

@implementation VectorBuffer
- (id)init {
    self = [super init];
    if (self) {
        _count = 0;
    }
    return self;
}
- (int)count {
    return _count;
}
@end

int main() {
    @autoreleasepool {
        VectorBuffer<int*> *buf = [[VectorBuffer<int*> alloc] init];
        printf("count=%d\n", [buf count]);
    }
    return 0;
}
