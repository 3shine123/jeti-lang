#include <stdio.h>
#import <Foundation/Foundation.hje>

int main() {
    @autoreleasepool {
        // 1. initWithUTF8String
        NPMutableString *m = [NPMutableString stringWithUTF8String:"Hello"];
        printf("1 initial: %s\n", [m UTF8String]);

        // 2. appendUTF8String
        [m appendUTF8String:", world"];
        printf("2 append: %s (len %zu)\n", [m UTF8String], [m length]);

        // 3. appendString
        NPMutableString *suffix = [NPMutableString stringWithUTF8String:"! again"];
        [m appendString:suffix];
        printf("3 appendString: %s\n", [m UTF8String]);

        // 4. insertString:atIndex:
        NPMutableString *ins = [NPMutableString stringWithUTF8String:"BIG "];
        [m insertString:ins atIndex:6];
        printf("4 insert: %s\n", [m UTF8String]);

        // 5. deleteCharactersInRange:
        [m deleteCharactersInRange:(NPRange){6, 4}];
        printf("5 delete: %s\n", [m UTF8String]);

        // 6. replaceCharactersInRange:withString:
        NPMutableString *rep = [NPMutableString stringWithUTF8String:"HELLO"];
        [m replaceCharactersInRange:(NPRange){0, 5} withString:rep];
        printf("6 replace: %s\n", [m UTF8String]);

        // 7. setString:
        [m setString:[NPMutableString stringWithUTF8String:"final"]];
        printf("7 setString: %s\n", [m UTF8String]);

        // 8. inherited methods still work
        printf("8 length=%zu hash=%u upper=%s\n",
            [m length], [m hash], [[m uppercaseString] UTF8String]);

        // 9. mutable append then inherited substring
        [m appendUTF8String:"-done"];
        NPString *sub = [m substringFromIndex:5];
        printf("9 substring: %s\n", [sub UTF8String]);

        // 10. empty initial
        NPMutableString *empty = [NPMutableString stringWithUTF8String:""];
        [empty appendUTF8String:"filled"];
        printf("10 empty->: %s\n", [empty UTF8String]);
    }
    printf("NPMutableString tests done\n");
    return 0;
}