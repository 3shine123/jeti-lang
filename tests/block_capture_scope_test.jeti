// Block capture rewriting must be function-granular:
// a __block var in main() must NOT corrupt same-named params/locals elsewhere.
#import <Foundation/Foundation.hje>

typedef int (^AddBlock)(int);

@interface Calc : NPObject
+ (int)scale:(int)base by:(int)factor;
@end

@implementation Calc
// `base` here is a PARAMETER — must not be rewritten to base.__forwarding->__value
// even though main() declares `__block int base`.
+ (int)scale:(int)base by:(int)factor {
    return base * factor;
}
@end

int main() {
    // 正向捕获：__block 变量在 block 内累加，改写必须生效
    __block int total = 0;
    AddBlock acc = ^(int v){ total += v; return total; };
    acc(3); acc(4);
    NPLog(@"total=%d", total);

    // 高危复现：main 里 __block int base；Calc::scale: 的参数 base 不得被污染
    __block int base = 10;
    AddBlock addBase = ^(int v){ base += v; return base; };
    addBase(5);
    NPLog(@"base=%d", base);
    NPLog(@"scaled=%d", [Calc scale:6 by:7]);

    return 0;
}
