// lang-test/static_generics_template_test.jeti
// Jeti 语言「静态泛型类与编译期类型擦除」全新机制压测
// 聚焦：编译期泛型特化、泛型方法类型推导、泛型对象的静态 ARC 内存管理安全

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.hje>

// ============================================================================
// 1. 泛型类声明与实现：智能数据包裹固定队列 (Capacity = 2)
// ============================================================================
@interface DataPack <T> : NPObject {
    @public
    int _count;
    T _storage[2]; // 静态泛型数组存储空间
}
@property (readonly) int count;

- (id)init;
- (void)pushItem:(T)item;
- (T)popItem;
@end

@implementation DataPack <T>
@synthesize count = _count;

- (id)init {
    self = [super init];
    if (self) {
        _count = 0;
        _storage[0] = nil;
        _storage[1] = nil;
    }
    return self;
}

// 压测点：泛型参数入队。静态 ARC 必须在此处对传入的 T 实施正确的 retain
- (void)pushItem:(T)item {
    if (_count < 2) {
        _storage[_count] = [item retain]; 
        _count++;
        printf("[泛型队列] 成功压入元素，当前队列大小: %d\n", _count);
    } else {
        printf("[泛型队列] 错误：队列已满，拒绝写入！\n");
    }
}

// 压测点：泛型参数出队。静态 ARC 必须保证返回的 T 在生命周期内的引用计数正确
- (T)popItem {
    if (_count > 0) {
        _count--;
        T item = _storage[_count];
        _storage[_count] = nil; // 移出存储槽
        // 遵循 ARC 约定：返回一个已 autorelease 或保持局部存活的对象
        return [item autorelease];
    }
    return nil;
}

- (void)dealloc {
    printf("[泛型析构] 正在清理泛型容器物理内存槽...\n");
    if (_storage[0]) [_storage[0] release];
    if (_storage[1]) [_storage[1] release];
    [super dealloc];
}
@end


// ============================================================================
// 2. 辅助测试元素类：量子字符串与加密数字
// ============================================================================
@interface QuantumToken : NPObject {
    @public
    const char* _tokenString;
}
@property (readonly) const char* tokenString;
- (id)initWithString:(const char*)str;
@end

@implementation QuantumToken
@synthesize tokenString = _tokenString;
- (id)initWithString:(const char*)str {
    self = [super init];
    if (self) _tokenString = str;
    return self;
}
- (void)dealloc {
    printf("[Token销毁] 物理字符串 [%s] 已被安全擦除。\n", _tokenString);
    [super dealloc];
}
@end


@interface EncryptedMetric : NPObject {
    @public
    int _rawCode;
}
@property int rawCode;
- (id)initWithCode:(int)code;
@end

@implementation EncryptedMetric
@synthesize rawCode = _rawCode;
- (id)initWithCode:(int)code {
    self = [super init];
    if (self) _rawCode = code;
    return self;
}
- (void)dealloc {
    printf("[Metric销毁] 加密度量值 (%d) 已被销毁。\n", _rawCode);
    [super dealloc];
}
@end


// ============================================================================
// 3. 主程序入口：全面检阅编译期泛型特化与静态类型约束
// ============================================================================
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("====================================================================\n");
        printf(">>>      jetic 编译器「静态泛型类与类型安全擦除」全新压测         <<<\n");
        printf("====================================================================\n\n");

        // ----------------------------------------------------
        // 测试点 1：实例化具体特化的泛型类
        printf("--- 1. 实例化特化泛型容器 DataPack<QuantumToken*> ---\n");
        
        // 编译器必须能通过静态类型推导，把这一句特化为专有符号
        DataPack<QuantumToken*>* tokenPack = [[DataPack<QuantumToken*> alloc] init];
        
        QuantumToken* t1 = [[QuantumToken alloc] initWithString:"Q-SECURE-ALPHA"];
        QuantumToken* t2 = [[QuantumToken alloc] initWithString:"Q-SECURE-BRAVO"];
        
        [tokenPack pushItem:t1];
        [tokenPack pushItem:t2];

        // 强引用使用完毕，本地 release 掉（由容器持有了）
        [t1 release];
        [t2 release];

        // ----------------------------------------------------
        // 测试点 2：测试另外一个类型的泛型特化，验证符号表的隔离性
        printf("\n--- 2. 实例化第二套特化泛型 DataPack<EncryptedMetric*> ---\n");
        
        DataPack<EncryptedMetric*>* metricPack = [[DataPack<EncryptedMetric*> alloc] init];
        
        EncryptedMetric* m1 = [[EncryptedMetric alloc] initWithCode:9999];
        [metricPack pushItem:m1];
        [m1 release];

        // 【关键类型安全断言】：
        // 如果在 Jeti 代码中尝试执行：[metricPack pushItem:t1]; 
        // 编译器应当在转译阶段直接抛出语义错误（Type Mismatch），证明其不是简单的 id 擦除，而是具有静态类型检查能力的泛型！

        // ----------------------------------------------------
        // 测试点 3：泛型出队时的静态类型还原与自动内存管理
        printf("\n--- 3. 验证泛型 PopItem 方法出队后的类型推导与 ARC 介入 ---\n");
        
        // 编译器必须知道这里返回的直接就是 QuantumToken*，不需要手动强转
        QuantumToken* poppedToken = [tokenPack popItem];
        printf("[类型解包断言] 成功取出特化类型数据: Token = %s\n", [poppedToken tokenString]);

        // ----------------------------------------------------
        // 测试点 4：将泛型对象作为 Block 参数进行高阶状态传递
        printf("\n--- 4. 测试特化泛型对象作为 Block 参数跨命名空间传递的稳定性 ---\n");

        __block int genericCallbackCount = 0;

        // 严格限定 Block 的参数为特化泛型类型
        void (^processPackBlock)(DataPack<QuantumToken*>*) = ^void(DataPack<QuantumToken*>* pack) {
            genericCallbackCount++;
            QuantumToken* innerToken = [pack popItem];
            printf("[泛型闭包内] 成功读取回调泛型包: 内含数据 = %s | 触发计数 = %d\n", 
                   innerToken ? [innerToken tokenString] : "NULL", genericCallbackCount);
        };

        // 执行闭包投递
        processPackBlock(tokenPack);

        // ----------------------------------------------------
        // 测试点 5：极限边界收敛——泛型方法调用 + 三元运算符 + 逗号表达式副作用
        // 将全新的“泛型编译期方法路由”带入你金刚不坏的结合律守门员中！
        printf("\n--- 5. 混合边界守门员：三元表达式内包含带副作用的泛型出队消息发送 ---\n");

        int isQuantumChannelReady = 1;
        int genericStepCounter = 77777;

        // 强迫转译器在极其复杂的特化 AST 树节点上解包：
        // 真分支内带括号自增副作用，右侧是通过【特化泛型对象】调用【泛型返回值方法】！
        EncryptedMetric* finalMetric = (isQuantumChannelReady > 0) ? 
            [((genericStepCounter++, metricPack)) popItem] : nil;

        printf("[终极泛型边界断言] 编译期泛型决议与自增优先级完美融合！\n");
        printf("          -> 副作用自增计数器最终值: %d (预期: 77778)\n", genericStepCounter);
        printf("          -> 动态抓取的泛型解密 Metric 码: %d (预期: 9999)\n", [finalMetric rawCode]);

        // ----------------------------------------------------
        // 6. 内存拓扑彻底销毁
        printf("\n--- 6. 正在释放所有静态特化泛型容器资产... ---\n");
        [tokenPack release];
        [metricPack release];

        printf("\n====================================================================\n");
        printf(">>> 奇迹！静态泛型类与编译期类型约束特性全新压测通关！          <<<\n");
        printf("====================================================================\n");
    }
    return 0;
}