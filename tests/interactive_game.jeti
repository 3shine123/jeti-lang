#import <stdio.h>
#import <stdlib.h>
#import <string.h>
#import <time.h>
#import <Foundation/Foundation.hje>
#include <stdio.h>

// ==========================================================
// 1. @protocol 声明：战斗契约
// ==========================================================
@protocol Fighter

- (void)takeDamage:(int)amount;
- (void)attack:(id)target;

@end


// ==========================================================
// 2. Base Class 基类声明：游戏角色基类
// ==========================================================
@interface GameEntity : NPObject <Fighter>

@property char *name;
@property int hp;
@property int maxHp;
@property int attackPower;

- (instancetype)initWithName:(char *)name hp:(int)hp attack:(int)attack;
- (void)displayStatus;

@end


// ==========================================================
// 3. Subclass 子类声明：玩家勇士
// ==========================================================
@interface Hero : GameEntity

@property int potions;

- (void)usePotion;

@end


// ==========================================================
// 4. Subclass 子类声明：深渊炎龙 (多态重写攻击逻辑)
// ==========================================================
@interface Dragon : GameEntity

@property int rage;

- (void)breatheFire:(id)target;

@end


// ==========================================================
// ==========================================================
// @implementation 类实现区
// ==========================================================
// ==========================================================

@implementation GameEntity

@synthesize name = _name;
@synthesize hp = _hp;
@synthesize maxHp = _maxHp;
@synthesize attackPower = _attackPower;

- (instancetype)initWithName:(char *)name hp:(int)hp attack:(int)attack {
    self = [super init];
    if (self) {
        _name = name;
        _hp = hp;
        _maxHp = hp;
        _attackPower = attack;
    }
    return self;
}

- (void)takeDamage:(int)amount {
    _hp -= amount;
    if (_hp < 0) _hp = 0;
    printf(" 💥 [%s] 受到 %d 点伤害！(剩余生命: %d/%d)\n", _name, amount, _hp, _maxHp);
}

- (void)attack:(id)target {
    printf(" ⚔️ [%s] 发动普通攻击，砍向 [%s]！\n", _name, [target name]);
    [target takeDamage:_attackPower];
}

- (void)displayStatus {
    printf(" [%s] HP: %d/%d | 基础ATK: %d\n", _name, _hp, _maxHp, _attackPower);
}

- (void)dealloc {
    printf(" 👻 [%s] 倒在了竞技场的沙尘之中...\n", _name);
}

@end


@implementation Hero

@synthesize potions = _potions;

- (void)usePotion {
    if (_potions <= 0) {
        printf(" ❌ 药水已经用尽了！\n");
        return;
    }
    _potions--;
    int healAmount = 40;
    int currentHp = [self hp];
    int maxHp = [self maxHp];
    
    int newHp = currentHp + healAmount;
    if (newHp > maxHp) newHp = maxHp;
    
    [self setHp:newHp];
    printf(" 🧪 [%s] 喝下圣光药水！恢复 %d 点生命值！(剩余药水: %d, 当前HP: %d/%d)\n", 
           [self name], healAmount, _potions, [self hp], [self maxHp]);
}

@end


@implementation Dragon

@synthesize rage = _rage;

- (void)breatheFire:(id)target {
    printf(" 🔥🔥🔥 [%s] 狂暴！对 [%s] 喷射出毁灭龙息！\n", [self name], [target name]);
    int fireDamage = [self attackPower] + _rage;
    [target takeDamage:fireDamage];
    _rage = 0; // 释放后怒气归零
}

// 💥 多态重写（Polymorphic Override）：炎龙攻击会积攒怒气
- (void)attack:(id)target {
    _rage += 10;
    printf(" 👹 [%s] 用巨爪横扫 [%s]！(积攒怒气: +10, 当前怒气: %d)\n", [self name], [target name], _rage);
    [target takeDamage:[self attackPower]];
}

@end


// ==========================================================
// 5. 游戏主控制台循环
// ==========================================================
int main(int argc, const char * argv[]) {
    @autoreleasepool {
        // 初始化随机种子
        srand((unsigned int)time(NULL));

        printf("\n======================================================\n");
        printf("       🏟️ 欢迎来到 Micrit 静态面向对象竞技场 🏟️\n");
        printf("======================================================\n\n");

        // 从控制台读取玩家名字 (使用纯 C char 数组)
        char inputBuffer[64];
        printf(" 请输入你的勇士名字: ");
        if (scanf("%63s", inputBuffer) != 1) {
            strcpy(inputBuffer, "无名英雄");
        }

        // 1. 初始化玩家 Hero
        Hero *hero = [[Hero alloc] initWithName:inputBuffer hp:150 attack:20];
        [hero setPotions:3]; // 赠送3瓶药水

        // 2. 初始化强敌 Boss
        Dragon *boss = [[Dragon alloc] initWithName:"红莲劫火·萨卡" hp:200 attack:15];
        [boss setRage:0];

        printf("\n ⚔️ 宿命的对决即将开始！\n");
        printf(" -----------------------------------------------------\n");
        [hero displayStatus];
        [boss displayStatus];
        printf(" -----------------------------------------------------\n\n");

        int turn = 1;
        
        // 3. 游戏主循环 (Turn-based Game Loop)
        while ([hero hp] > 0 && [boss hp] > 0) {
            printf("\n--- 【第 %d 回合】 ---\n", turn);
            [hero displayStatus];
            [boss displayStatus];
            printf("----------------------\n");
            printf("请做出你的抉择:\n");
            printf(" [1] 奋力一击 (普通攻击, ATK: %d)\n", [hero attackPower]);
            printf(" [2] 圣光治愈 (回复40点HP, 剩余药水: %d瓶)\n", [hero potions]);
            printf(" [3] 极意·苍穹破 (蓄力爆发, 捕获战局倍率!)\n");
            printf("请输入指令 (1-3): ");

            int choice = 0;
            if (scanf("%d", &choice) != 1) {
                // 清理输入流防止死循环
                while (getchar() != '\n');
                choice = 1; 
            }

            // 玩家回合逻辑
            if (choice == 1) {
                [hero attack:boss];
            } else if (choice == 2) {
                [hero usePotion];
            } else if (choice == 3) {
                // 💥 静态闭包降维演示！
                // 必杀技倍率由当前回合数决定（回合数越久，战意越高！）
                int turn_bonus = turn; 
                int base_multiplier = 2;

                // 定义闭包
                int (^megaSlash)(int) = ^int(int dmg) {
                    int final_multiplier = base_multiplier + (turn_bonus / 2);
                    printf(" 🔥 [极意·苍穹破] 战意爆发！捕获当前回合加成！(倍率: x%d)\n", final_multiplier);
                    return dmg * final_multiplier;
                };

                // 调用闭包计算伤害
                int finalDamage = megaSlash([hero attackPower]);
                printf(" 💥 苍穹破碎！对 [%s] 造成了巨大的 %d 点伤害！\n", [boss name], finalDamage);
                [boss takeDamage:finalDamage];
            } else {
                printf(" ❓ 犹豫不决让动作迟缓，你白白浪费了一回合！\n");
            }

            // 检查 Boss 是否倒下
            if ([boss hp] <= 0) {
                break;
            }

            // 炎龙 Boss 回合逻辑
            printf("\n 🐉 [%s] 的回合行动: \n", [boss name]);
            if ([boss rage] >= 20) {
                // 怒气满时释放龙息
                [boss breatheFire:hero];
            } else {
                // 普通攻击并积攒怒气
                [boss attack:hero];
            }

            turn++;
        }

        // 4. 战斗结算
        printf("\n======================================================\n");
        printf("                      战役终结\n");
        printf("======================================================\n\n");

        if ([hero hp] > 0) {
            printf(" 🎉 凯旋！[%s] 成功弑龙，成为了竞技场的传说！\n", [hero name]);
        } else {
            printf(" 💀 终局。[%s] 还是倒在了红莲龙息之下，竞技场归于死寂...\n", [hero name]);
        }

        printf("\n 感谢游玩 Micrit 纯静态自研引擎小游戏！\n\n");
    }
    return 0;
}