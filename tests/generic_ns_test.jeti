#import <Foundation/Foundation.hje>

@interface Box<T> : NPObject
- (instancetype)initWithValue:(T)v;
- (T)value;
@end

@implementation Box<T>
{
    T _storage;
}
- (instancetype)initWithValue:(T)v { self = [super init]; if (self) { _storage = v; } return self; }
- (T)value { return _storage; }
@end

@namespace Metal
@interface Wrapped : NPObject
+ (NPString *)unbox;
@end

@implementation Wrapped
+ (NPString *)unbox {
    Box<NPString *> *b = [[Box<NPString *> alloc] initWithValue:@"ns"];
    return [b value];
}
@endnamespace

int main() {
    NPLog(@"ns=%@", [Metal::Wrapped unbox]);
    // 顶层泛型（回归确认）
    Box<NPString *> *sb = [[Box<NPString *> alloc] initWithValue:@"top"];
    NPLog(@"top=%@", [sb value]);
    return 0;
}
