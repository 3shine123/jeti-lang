#include <stdio.h>
#import <Foundation/Foundation.hje>

// Minimal NSObject-like class for ARC weak ref test
@interface MyObject : NPObject
@end

@implementation MyObject
@end

@interface Watcher : NPObject {
    @public (weak) id _target;
}
@property (weak) id target;
@end

@implementation Watcher
@synthesize target = _target;
@end

int main() {
    @autoreleasepool {
        id obj = [[MyObject alloc] init];
        Watcher *w = [[Watcher alloc] init];
        w->_target = obj;  // weak assign, no retain
        [obj release];
        [w release];
    }
    return 0;
}