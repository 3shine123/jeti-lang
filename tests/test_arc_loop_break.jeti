#include <stdio.h>
#import <Foundation/Foundation.hje>

@interface Obj : NPObject
- (void)doSomething;
@end
@implementation Obj
- (void)doSomething { printf("done\n"); }
@end

int main() {
    @autoreleasepool {
        for (int i = 0; i < 10; i++) {
            id tmp = [[Obj alloc] init];
            if (i == 5) break;  // tmp must be released before break
            [tmp doSomething];
        }
    }
    return 0;
}