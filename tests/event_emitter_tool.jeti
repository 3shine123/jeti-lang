#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.hje>

// 定义一个 Block 类型：接收一个 id 类型的参数（触发事件时携带的数据）
typedef void (^NPEventBlock)(id data);

// ==========================================
// @interface: NPEventEmitter
// ==========================================
@interface NPEventEmitter : NPObject {
@private
    // 静态分配一个简易的槽位数组，用来存放注册的监听器
    NPEventBlock _listeners[10];
    unsigned int _eventIds[10];
    int _listenerCount;
}

- (instancetype)init;
- (void)dealloc;

// 核心工具方法
- (void)onEvent:(unsigned int)selectorId doAction:(NPEventBlock)block;
- (void)emitEvent:(unsigned int)selectorId withData:(id)data;

@end

// ==========================================
// @implementation: NPEventEmitter
// ==========================================
@implementation NPEventEmitter

- (instancetype)init {
    self = [super init];
    if (self) {
        self->_listenerCount = 0;
        for (int i = 0; i < 10; i++) {
            self->_listeners[i] = NULL;
            self->_eventIds[i] = 0;
        }
    }
    return self;
}

- (void)dealloc {
    // 释放所有持有的 Block
    // 注意：在标准 Clang Blocks 中，如果 Block 复制到了堆上，需要 Block_release
    // 在 Micrit 的纯静态架构中，此处主要用于观察对象自身的生命周期周期
    printf("[Tool Log] NPEventEmitter is destroying, breaking all event pipelines.\n");
}

// 注册监听器：这里测试了 Micrit 对 C 数组下标 `_listeners[i]` 与 ObjC 方括号的精确分流
- (void)onEvent:(unsigned int)selectorId doAction:(NPEventBlock)block {
    if (self->_listenerCount >= 10) {
        printf("[Error] Listener pool full!\n");
        return;
    }
    
    int index = self->_listenerCount;
    self->_eventIds[index] = selectorId;
    self->_listeners[index] = block; // 静态赋值/持有 Block
    self->_listenerCount++;
}

// 触发事件
- (void)emitEvent:(unsigned int)selectorId withData:(id)data {
    printf("[Emitter] Dispatching event ID: %u ...\n", selectorId);
    BOOL handled = NO;
    
    for (int i = 0; i < self->_listenerCount; i++) {
        if (self->_eventIds[i] == selectorId) {
            NPEventBlock action = self->_listeners[i];
            if (action) {
                // 执行 Block 回调
                action(data);
                handled = YES;
            }
        }
    }
    if (!handled) {
        printf("[Warning] No listener registered for event ID: %u\n", selectorId);
    }
}

@end

// ==========================================
// Main Function
// ==========================================
int main() {
    printf("=== Micrit Tooling Test: Event Emitter with Blocks ===\n\n");

    // 1. 初始化事件中心工具
    NPEventEmitter *emitter = [[NPEventEmitter alloc] init];

    // 2. 模拟局部上下文中需要被 Block 捕获的变量
    int __block_captured_counter = 100; 
    char *context_tag = "PRODUCTION_ENV";

    // 3. 注册事件
    [emitter onEvent:1 doAction:^void(id responseData) {
        // 测试 Block 的变量捕获和静态结构体充填
        printf("\n  [Block Callback] 'onSuccess' Triggered!\n");
        printf("  [Captured Context] Env: %s\n", context_tag);
        printf("  [Captured Context] Counter state: %d\n", __block_captured_counter);
        printf("  [Event Payload Data] %s\n\n", (char *)responseData);
    }];

    [emitter onEvent:2 doAction:^void(id errorData) {
        printf("\n  [Block Callback] 'onError' Critical alert!\n");
        printf("  [Event Payload Data] Error Code: %s\n\n", (char *)errorData);
    }];

    // 4. 模拟网络或系统工具异步流的回调触发
    printf("--- Simulating Workflow 1: Success Stream ---\n");
    __block_captured_counter += 50; // 修改局部变量，测试捕获的连带表现
    [emitter emitEvent:1 withData:(id)"{\"status\": 200, \"msg\": \"Fetch Config OK\"}"];

    printf("--- Simulating Workflow 2: Failure Stream ---\n");
    [emitter emitEvent:2 withData:(id)"504 Gateway Timeout"];

    printf("--- Simulating Workflow 3: Unregistered Event ---\n");
    [emitter emitEvent:3 withData:NULL];

    printf("\n=== Exiting Main (Emitter & Blocks will be ARC-released) ===\n");
    // emitter 离开作用域，CFG 数据流分析在这里插入 release 动作
    return 0;
}