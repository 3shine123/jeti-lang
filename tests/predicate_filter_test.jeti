// Predicate + KVC + host filtering — permanent integration coverage for
// doc/nppredicate_plan.md §3/§4 (the probes/ files were dev-time checks).
//
// Covered here: comparison / string / IN / BETWEEN / MATCHES / quantifier DSL
// forms, predicateFormat read-back, %@ placeholder substitution, the KVC class
// chain (boss.age) including a miss, and the container filter API.
//
// The program self-checks: a mismatch prints FAIL and the exit status is
// non-zero, so test_all.py reports a regression as a failure.
#import <Foundation/Foundation.hje>
#include <stdio.h>
#include <string.h>

static int failures = 0;
static int total = 0;

static void check(const char *what, int got, int want) {
    total++;
    if (got != want) {
        failures++;
        printf("FAIL %s: got %d want %d\n", what, got, want);
    }
}

static int streq(const char *a, const char *b) {
    if (!a || !b) return 0;
    return strcmp(a, b) == 0;
}

// `_boss` is NPObject * on purpose: KVC resolves keys by walking the isa
// chain, so the getter's static type is irrelevant to `boss.age`.
@interface Person : NPObject {
@public
    int _age;
    NPString *_name;
    NPArray *_tags;
    NPObject *_boss;
}
- (Person *)initWithAge:(int)age name:(const char *)name tags:(NPArray *)tags;
- (void)setBoss:(NPObject *)b;
- (int)age;
- (NPString *)name;
- (NPArray *)tags;
- (NPObject *)boss;
@end

@implementation Person
- (Person *)initWithAge:(int)age name:(const char *)name tags:(NPArray *)tags {
    self = [super init];
    if (self) {
        _age = age;
        _name = [NPString stringWithUTF8String:name];
        _tags = tags;
    }
    return self;
}
- (void)setBoss:(NPObject *)b { _boss = b; }
- (int)age { return _age; }
- (NPString *)name { return _name; }
- (NPArray *)tags { return _tags; }
- (NPObject *)boss { return _boss; }
@end

int main(void) {
    Person *alice = [[Person alloc] initWithAge:30 name:"alice" tags:@[ @"dev", @"ops" ]];
    Person *bob = [[Person alloc] initWithAge:15 name:"bob" tags:@[ @"qa" ]];
    Person *dave = [[Person alloc] initWithAge:40 name:"dave" tags:@[ @"dev" ]];
    [alice setBoss:dave];

    // ── 1. comparison + predicateFormat read-back ───────────────────────────
    NPPredicate *gt18 = [NPPredicate predicateWithFormat:@"age > 18"];
    check("cmp.gt.alice", [gt18 evaluateWithObject:alice], 1);
    check("cmp.gt.bob", [gt18 evaluateWithObject:bob], 0);
    check("fmt.readback", streq([[gt18 predicateFormat] UTF8String], "age > 18"), 1);

    // ── 2. string operators (BEGINSWITH with the [c] modifier, LIKE, MATCHES)
    NPPredicate *beg = [NPPredicate predicateWithFormat:@"name BEGINSWITH[c] 'BO'"];
    check("begins.c.alice", [beg evaluateWithObject:alice], 0);
    check("begins.c.bob", [beg evaluateWithObject:bob], 1);

    NPPredicate *like = [NPPredicate predicateWithFormat:@"name LIKE 'a*i*e'"];
    check("like.alice", [like evaluateWithObject:alice], 1);
    check("like.bob", [like evaluateWithObject:bob], 0);

    NPPredicate *matches = [NPPredicate predicateWithFormat:@"name MATCHES 'a.*e'"];
    check("matches.alice", [matches evaluateWithObject:alice], 1);
    check("matches.bob", [matches evaluateWithObject:bob], 0);

    // ── 3. IN / BETWEEN / NOT / AND ────────────────────────────────────────
    NPPredicate *in = [NPPredicate predicateWithFormat:@"name IN {'bob', 'zoe'}"];
    check("in.bob", [in evaluateWithObject:bob], 1);
    check("in.alice", [in evaluateWithObject:alice], 0);

    NPPredicate *between = [NPPredicate predicateWithFormat:@"age BETWEEN {10, 20}"];
    check("between.bob", [between evaluateWithObject:bob], 1);
    check("between.alice", [between evaluateWithObject:alice], 0);

    NPPredicate *not30 = [NPPredicate predicateWithFormat:@"NOT (age = 30)"];
    check("not.alice", [not30 evaluateWithObject:alice], 0);
    check("not.bob", [not30 evaluateWithObject:bob], 1);

    NPPredicate *andp = [NPPredicate predicateWithFormat:@"age > 18 AND name CONTAINS 'li'"];
    check("and.alice", [andp evaluateWithObject:alice], 1);
    check("and.bob", [andp evaluateWithObject:bob], 0);

    // ── 4. KVC class chain (boss.age) + a miss ─────────────────────────────
    NPPredicate *chain = [NPPredicate predicateWithFormat:@"boss.age >= 30"];
    check("kvc.chain.alice", [chain evaluateWithObject:alice], 1);
    check("kvc.chain.bob", [chain evaluateWithObject:bob], 0);  // nil boss

    // An unknown key has no table entry: the leaf resolves to nil, so a
    // comparison against a literal is false (and `= nil` is true) — the
    // evaluation path reports no match rather than aborting.
    check("kvc.miss.gt", [[NPPredicate predicateWithFormat:@"height > 100"]
                            evaluateWithObject:alice], 0);
    check("kvc.miss.nil", [[NPPredicate predicateWithFormat:@"height = nil"]
                            evaluateWithObject:alice], 1);

    // ── 5. %@ placeholder substitution ─────────────────────────────────────
    // The rendered form is what the parser sees and what _format keeps, so
    // predicateFormat returns the substituted string (source had `%@`).
    NPPredicate *ph = [NPPredicate predicateWithFormat:@"age > %@" object:@18];
    check("ph.alice", [ph evaluateWithObject:alice], 1);
    check("ph.bob", [ph evaluateWithObject:bob], 0);
    check("ph.readback", strstr([[ph predicateFormat] UTF8String], "18") != NULL, 1);

    // ── 6. quantifiers over an array-valued key ────────────────────────────
    NPPredicate *anyDev = [NPPredicate predicateWithFormat:@"ANY tags = 'dev'"];
    check("any.alice", [anyDev evaluateWithObject:alice], 1);
    check("any.bob", [anyDev evaluateWithObject:bob], 0);

    NPPredicate *noneDev = [NPPredicate predicateWithFormat:@"NONE tags = 'dev'"];
    check("none.alice", [noneDev evaluateWithObject:alice], 0);
    check("none.bob", [noneDev evaluateWithObject:bob], 1);

    NPPredicate *allA = [NPPredicate predicateWithFormat:@"ALL tags LIKE '*a*'"];
    check("all.alice", [allA evaluateWithObject:alice], 0);  // dev / ops
    check("all.bob", [allA evaluateWithObject:bob], 1);      // qa

    // ── 7. host API: filtered / index / in-place / set ─────────────────────
    id people[3];
    people[0] = alice;
    people[1] = bob;
    people[2] = dave;
    NPArray *all = [NPArray arrayWithObjects:people count:3];

    NPArray *grown = [all filteredArrayUsingPredicate:gt18];
    check("host.filter.count", (int)[grown count], 2);  // alice, dave
    check("host.filter.first",
          streq([[(Person *)[grown firstObject] name] UTF8String], "alice"), 1);

    check("host.index.first", (int)[all indexOfObjectMatchingPredicate:gt18], 0);
    NPPredicate *zed = [NPPredicate predicateWithFormat:@"name = 'zed'"];
    check("host.index.none", [all indexOfObjectMatchingPredicate:zed] == (size_t)-1, 1);

    NPMutableArray *mut = [NPMutableArray arrayWithObjects:people count:3];
    [mut filterUsingPredicate:gt18];
    check("host.mut.count", (int)[mut count], 2);
    check("host.mut.first",
          streq([[(Person *)[mut firstObject] name] UTF8String], "alice"), 1);

    NPSet *set = [NPSet setWithObjects:people count:3];
    NPArray *fromSet = [set filteredArrayUsingPredicate:gt18];
    check("host.set.count", (int)[fromSet count], 2);

    // A nil predicate filters nothing (identity), not an empty result.
    check("host.nil", (int)[[all filteredArrayUsingPredicate:nil] count], 3);

    if (failures == 0) {
        printf("predicate_filter_test: all %d checks passed\n", total);
    } else {
        printf("predicate_filter_test: %d of %d checks FAILED\n", failures, total);
    }
    return failures == 0 ? 0 : 1;
}
