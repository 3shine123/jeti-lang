#import <Foundation/Foundation.hje>

// Negative: an object-literal subject with a dangling-comparison arm and no
// object arm. `__auto_type __jeti_sw = @7;` still yields a *pointer*, so
// `__jeti_sw > 100` is an always-true pointer compare — the arm is taken for
// every value. Expected: exit=1 with
//   "switch subject is an object but a dangling comparison 'case' arm"
//
// Known M1 limit: the parser has no type information, so a *variable* subject
// holding an object (`id o = @7; switch (o) { case > 100: ... }`) cannot be
// caught here and still degrades to a pointer compare.
int main(void) {
    int r = 0;
    switch (@7) {
        case > 100:
            r = 1;
            break;
        default:
            r = 9;
    }
    NPLog(@"r=%d", r);
    return 0;
}
