// NEGATIVE test — must FAIL to compile.
//
// `@(...)` picks an NPNumber factory from the operand's static type, so only
// arithmetic and BOOL operands can be boxed. ObjC would box an NSNumber from an
// NSString, but Jeti has no string boxing; silently emitting the pointer where a
// number is expected would hide the mistake, so the checker rejects it.
#import <Foundation/Foundation.hje>

int main(void) {
    NPString *s = @"hi";
    NPNumber *n = @(s);   // error: illegal type 'NPString *' in a boxed expression
    NPLog(@"%@", n);
    return 0;
}
