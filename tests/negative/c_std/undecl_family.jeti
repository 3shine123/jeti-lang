// Undeclared-identifier family — jetic side of the probe (mirror of
// undecl_family.c). Measure with:
//   ./target/debug/jetic tests/negative/c_std/undecl_family.jeti -rewrite-jeti -o /tmp/x.c
int known(int v) { return v; }
int main(void) {
    int y = x + 1;        // ① undeclared identifier 'x' → error
    ghost_fn(1);          // ② implicit function declaration → error
    int z = known(2);     // ③ declared → silent
    return y + z;
}
