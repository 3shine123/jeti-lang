// NPTask negative: `async NPTask<...>` is rejected at EVERY type-argument
// shape. Under the soft-keyword design (docs/plans/async_soft_keywords_plan.md
// §6) the modifier takes the business type directly (`async T`); `NPTask<...>`
// after `async` is the legacy spelling and produces the migration error
// before any type-argument checking. (Historically this file asserted
// "exactly one type argument"; that constraint is subsumed by the
// legacy-spelling error under the new design.)

@interface A : NPObject
- (async NPTask<int, int>)f;
@end

@implementation A
- (async NPTask<int, int>)f { return 0; }
@end

int main() { return 0; }
