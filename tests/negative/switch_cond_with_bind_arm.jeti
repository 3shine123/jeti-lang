#import <Foundation/Foundation.hje>

// Negative: a dangling-comparison arm (`case > 10:`) coexisting with a
// type-binding or object-literal arm. The object arm forces the switch subject
// to be materialized as `NPObject *`, so the comparison lowers to
// `__jeti_sw > 10` — a POINTER vs integer compare, always true, with no
// diagnostic anywhere in the generated C. Expected: exit=1 with
//   "switch mixes a dangling comparison 'case' arm"
//
// The same degeneration happens when the subject is syntactically an object
// literal and the ONLY pattern arms are comparisons — see
// switch_cond_on_object_literal.jeti.
int main(void) {
    id o = @"x";
    int r = 0;
    switch (o) {
        case NPString *s:
            r = 1;
            break;
        case > 10:
            r = 2;
            break;
        default:
            r = 9;
    }
    NPLog(@"r=%d", r);
    return 0;
}
