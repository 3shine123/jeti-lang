/* tests/negative/ — this file MUST FAIL to compile, with a clear error.
 *
 * A `nullable` value passed to a `nonnull` parameter. The callee is entitled
 * to dereference without a check, so this is a latent nil dereference at
 * runtime — the whole point of the annotation is to make it a compile error.
 *
 * Expected (exit != 0):
 *
 *     Type checking failed:
 *     [checker] tests/negative/null_to_nonnull.jeti:32:16: nullable value passed
 *     to nonnull parameter 'NPString' — the callee may assume it is non-nil;
 *     guard with 'if (x)' or pass a non-null value
 *
 * (The diagnostic names the TYPE, not the parameter's spelling — the param
 * name is not carried on the AST type node the checker reads.)
 *
 * The fix is a guard: `if (s) { [sink need:s]; }` — see
 * tests/golden/45_nullability/nullability.jeti for the narrowing forms that
 * satisfy the checker.
 */
#import <Foundation/Foundation.hje>

@interface Sink : NPObject
- (void)need:(nonnull NPString *)v;
@end

@implementation Sink
- (void)need:(nonnull NPString *)v { NPLog(@"%s", [v UTF8String]); }
@end

static void unguarded(nonnull Sink *sink, nullable NPString *s) {
    [sink need:s];
}

int main(void) {
    Sink *k = [Sink new];
    unguarded(k, nil);
    return 0;
}
