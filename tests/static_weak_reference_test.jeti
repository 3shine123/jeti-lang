// lang-test/static_weak_reference_test.jeti
// Jeti 语言「静态弱引用与零污染销毁锚点」全新机制高压测试
// 聚焦：纯静态 ARC 下的 __weak 指针静态置空、多重弱引用绑定、Block 弱捕获打破循环引用

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.hje>

// 前置声明
@class MaintenanceDrone;

// ============================================================================
// 1. 核心类声明：太空空间站核心 (拥有指向无人机的强引用)
// ============================================================================
@interface SpaceStationCore : NPObject {
    @public
    int _stationId;
    const char* _stationName;
    MaintenanceDrone* _activeDrone; // 强引用无人机
}
@property int stationId;
@property (readonly) const char* stationName;
@property (nonatomic, retain) MaintenanceDrone* activeDrone;

- (id)initWithId:(int)sid name:(const char* )name;
- (void)triggerDeallocManually;
@end


// ============================================================================
// 2. 核心类声明：维修无人机 (需要弱引用指向空间站，防止循环引用)
// ============================================================================
@interface MaintenanceDrone : NPObject {
    @public
    int _droneId;
    // 关键压测点 1：__weak 关键字修饰。
    // 测试转译器是否能在底层静态识别该修饰符，不生成 retain/release，且将其注册到销毁锚点
    __weak SpaceStationCore* _parentStation; 
}
@property int droneId;
@property (nonatomic, weak) SpaceStationCore* parentStation;

- (id)initWithDroneId:(int)did;
- (void)performTelemetryCheck;
@end


// ============================================================================
// 3. 类实现区
// ============================================================================
@implementation SpaceStationCore
@synthesize stationId = _stationId;
@synthesize stationName = _stationName;
@synthesize activeDrone = _activeDrone;

- (id)initWithId:(int)sid name:(const char* )name {
    self = [super init];
    if (self) {
        _stationId = sid;
        _stationName = name;
        _activeDrone = nil;
    }
    return self;
}

// 模拟静态析构。在 Jeti 中，当执行 dealloc 或销毁强引用时，
// 编译器的静态 ARC 应该能感知到有哪些弱引用指向了它，并将其置为空
- (void)dealloc {
    printf("[核心销毁] 空间站「%s」正在静态释放物理资源...\n", _stationName);
    if (_activeDrone) {
        [_activeDrone release];
    }
    [super dealloc];
}

- (void)triggerDeallocManually {
    // 强制触发静态 ARC 释放链路的模拟方法
    printf("[主控系统] 正在关闭空间站能源核心...\n");
}
@end


@implementation MaintenanceDrone
@synthesize droneId = _droneId;
@synthesize parentStation = _parentStation;

- (id)initWithDroneId:(int)did {
    self = [super init];
    if (self) {
        _droneId = did;
        _parentStation = nil;
    }
    return self;
}

- (void)performTelemetryCheck {
    // 关键压测点 2：在方法内部穿透访问弱引用指针
    // 编译器必须保证，如果 _parentStation 已经被置空，这里不会触发野指针崩溃
    if (_parentStation) {
        printf("[无人机-%d] 遥测正常，当前弱引用母站依然存活: %s\n", 
               _droneId, [_parentStation stationName]);
    } else {
        printf("[无人机-%d] 警告！监测到弱引用母站已静态析构，弱指针自动清零(nil)！\n", _droneId);
    }
}

- (void)dealloc {
    printf("[无人机销毁] 无人机-%d 退出序列。\n", _droneId);
    [super dealloc];
}
@end


// ============================================================================
// 4. 主程序入口：全面检阅静态弱引用的生命周期与级联自动清零
// ============================================================================
int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("====================================================================\n");
        printf(">>>        jetic 编译器「静态弱引用 __weak 与零污染」全新压测       <<<\n");
        printf("====================================================================\n\n");

        // ----------------------------------------------------
        // 测试点 1：建立强弱引用环路，测试无 Runtime 环境下的内存拓扑
        printf("--- 1. 建立空间站与无人机的强弱错综引用 ---\n");
        
        SpaceStationCore* tianheCore = [[SpaceStationCore alloc] initWithId:1001 name:"天和核心舱"];
        MaintenanceDrone* hunterDrone = [[MaintenanceDrone alloc] initWithDroneId:77];
        
        // 强引用绑定：空间站持有无人机
        [tianheCore setActiveDrone:hunterDrone];
        // 弱引用绑定：无人机弱引用指向空间站 (防止强引用环导致内存泄漏)
        [hunterDrone setParentStation:tianheCore];

        // 验证初始状态
        [hunterDrone performTelemetryCheck];

        // ----------------------------------------------------
        // 测试点 2：多重局部弱引用静态绑定（Multiple Weak Aliasing）
        printf("\n--- 2. 验证多重局部变量 __weak 指针指向同一个强对象 ---\n");
        
        // 声明两个局部的弱引用指针，同时监控 tianheCore
        __weak SpaceStationCore* weakMonitorA = tianheCore;
        __weak SpaceStationCore* weakMonitorB = tianheCore;

        printf("[初始弱指针状态]：\n");
        printf("          -> weakMonitorA 指针地址有效性: %s\n", weakMonitorA ? "有效" : "nil");
        printf("          -> weakMonitorB 指针地址有效性: %s\n", weakMonitorB ? "有效" : "nil");

        // ----------------------------------------------------
        // 测试点 3：经典 Weak-Strong Dance 在静态 ARC 闭包中的规约
        printf("\n--- 3. 测试 Block 内部对 __weak 指针的静态安全捕获 ---\n");

        __block int telemetryFired = 0;

        // 闭包捕获局部弱引用 weakMonitorA
        void (^dockingStatusBlock)(void) = ^void() {
            telemetryFired++;
            // 在闭包运行时，安全读取弱引用
            if (weakMonitorA) {
                printf("[对接舱闭包] 执行第 %d 次监控，弱引用目标存活：%s\n", 
                       telemetryFired, [weakMonitorA stationName]);
            } else {
                printf("[对接舱闭包] 执行第 %d 次监控，目标已消亡，拒绝非法访问。\n", telemetryFired);
            }
        };

        // 第一次执行闭包：此时强对象还活着
        dockingStatusBlock();

        // ----------------------------------------------------
        // 测试点 4：核心高压点——强引用被彻底释放，压测弱引用静态“自动清零”
        printf("\n--- 4. 核心压测：彻底销毁强引用对象，验证所有相关弱引用静态自动清零 ---\n");
        
        [tianheCore triggerDeallocManually];
        
        // 强制销毁强引用对象（触发静态 ARC 或手动 release 释放）
        // 在这里，转译器必须在底层静态织入代码，将 hunterDrone->_parentStation、weakMonitorA、weakMonitorB 全部置为 nil！
        // 注意：tianheCore 的 dealloc 会释放 _activeDrone（hunterDrone），
        // 所以 hunterDrone 需要先 retain 才能在线程中存活。
        [hunterDrone retain];
        [tianheCore release]; 
        tianheCore = nil; 

        printf("\n[静态度量清除断言]：\n");
        // 再次触发无人机的状态检测，此时无人机内部的弱指针应该已经自动静态置空
        [hunterDrone performTelemetryCheck];

        printf("[局部弱指针清除断言]：\n");
        printf("          -> 销毁后 weakMonitorA 状态: %s (预期: nil)\n", weakMonitorA ? "未清空(Bug)" : "成功清零(nil)");
        printf("          -> 销毁后 weakMonitorB 状态: %s (预期: nil)\n", weakMonitorB ? "未清空(Bug)" : "成功清零(nil)");

        // 第二次执行闭包：此时强对象已死，测试闭包内部捕获的弱指针是否同步变为了 nil
        dockingStatusBlock();

        // ----------------------------------------------------
        // 测试点 5：极限边界回归——将弱引用的判定与置空逻辑送入“三元与逗号副作用”中
        // 这一步彻底将全新的“弱引用静态判定”带入之前的 Bug 回归测试中，达成融合收敛！
        printf("\n--- 5. 混合边界守门员：三元表达式内包含带副作用的弱指针置空逻辑判定 ---\n");

        int isTelemetryNetworkOnline = 1;
        int weakStepCounter = 12345;

        // 强迫转译器解析：三元真分支内，带括号自增副作用，右侧是可能已经被静态清空的弱指针消息发送！
        // 如果 weakMonitorB 已经成功清零(nil)，则消息发送应该静态安全返回 nil，而副作用计数器必须能正常自增！
        const char* finalStationReport = (isTelemetryNetworkOnline > 0) ? 
            [((weakStepCounter++, weakMonitorB)) stationName] : "OFFLINE";

        printf("[终极弱引用边界断言] 弱指针安全机制与自增副作用完美结合！\n");
        printf("          -> 副作用自增计数器: %d (预期: 12346)\n", weakStepCounter);
        printf("          -> 弱引用置空后的安全返回报告: %s (预期: (null) 或 空指针安全值)\n", 
               finalStationReport ? finalStationReport : "nil安全拦截");

        // ----------------------------------------------------
        // 6. 清理无人机
        printf("\n--- 6. 正在释放无人机实体... ---\n");
        [hunterDrone release];

        printf("\n====================================================================\n");
        printf(">>> 奇迹！静态弱引用 __weak 零污染清理全新特性高压测试结束！      <<<\n");
        printf("====================================================================\n");
    }
    return 0;
}