// lang-test/static_protocol_multi_dispatch_test.jeti
// Jeti 语言「静态协议多态、多协议复合与可选方法」全新机制压测
// 聚焦：无运行时环境下的协议限定类型转译、多协议强转、@optional 编译期安全决议

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#import <Foundation/Foundation.hje>

// ============================================================================
// 1. 协议声明区：定义核心生产与安全审计行为
// ============================================================================

// 协议 1：可序列化协议（所有方法必须实现）
@protocol DataSerializable
- (const char*)serializeToJSON;
@end

// 协议 2：云同步协议（包含可选方法）
@protocol CloudSyncable
@required
- (void)uploadToCloudWithEndpoint:(const char*)url;

@optional
// 可选方法：测试转译器在没有 respondsToSelector 时，如何静态安全调用
- (int)getLastSyncLatency;
@end

// 协议 3：安全审计协议
@protocol SecurityInspector
- (int)performSecurityAuditWithThreatLevel:(int)level;
@end


// ============================================================================
// 2. 类声明与实现：重型自动化机器人 (实现 Serializable 和 Syncable 协议)
// ============================================================================
@interface HeavyRobot : NPObject <DataSerializable, CloudSyncable> {
    @public
    int _robotId;
    int _payloadWeight;
}
@property int robotId;
@property int payloadWeight;

- (id)initWithId:(int)rid payload:(int)weight;
@end

@implementation HeavyRobot
@synthesize robotId = _robotId;
@synthesize payloadWeight = _payloadWeight;

- (id)initWithId:(int)rid payload:(int)weight {
    self = [super init];
    if (self) {
        _robotId = rid;
        _payloadWeight = weight;
    }
    return self;
}

// 实现 DataSerializable 协议
- (const char*)serializeToJSON {
    // 静态返回格式化模拟数据
    static char jsonBuffer[128];
    sprintf(jsonBuffer, "{\"robot_id\": %d, \"payload\": %d}", _robotId, _payloadWeight);
    return jsonBuffer;
}

// 实现 CloudSyncable 协议的 @required 方法
- (void)uploadToCloudWithEndpoint:(const char*)url {
    printf("[重型机器人-%d] 数据包已上传至云端端点: %s\n", _robotId, url);
}

// 实现 CloudSyncable 协议的 @optional 方法（测试实现该方法时的静态派发）
- (int)getLastSyncLatency {
    return 15; // 模拟 15ms 延迟
}
@end


// ============================================================================
// 3. 类声明与实现：AI 安全网关 (实现 Serializable 和 Inspector 协议)
// ============================================================================
@interface AISecurityGateway : NPObject <DataSerializable, SecurityInspector> {
    @public
    const char* _gatewayName;
    int _firewallRulesActive;
}
@property (readonly) const char* gatewayName;

- (id)initWithName:(const char*)name rules:(int)rules;
@end

@implementation AISecurityGateway
@synthesize gatewayName = _gatewayName;

- (id)initWithName:(const char*)name rules:(int)rules {
    self = [super init];
    if (self) {
        _gatewayName = name;
        _firewallRulesActive = rules;
    }
    return self;
}

// 实现 DataSerializable 协议
- (const char*)serializeToJSON {
    static char jsonBuffer[128];
    sprintf(jsonBuffer, "{\"gateway_name\": \"%s\", \"rules\": %d}", _gatewayName, _firewallRulesActive);
    return jsonBuffer;
}

// 实现 SecurityInspector 协议
- (int)performSecurityAuditWithThreatLevel:(int)level {
    printf("[安全网关-%s] 正在执行全盘扫描，注入威胁等级：%d\n", _gatewayName, level);
    // 模拟审计计算分数：规则数越多，防御力越强
    return _firewallRulesActive * 10 - level;
}
@end


// ============================================================================
// 4. 主程序入口：协议静态限制与多态派发大考
// ============================================================================

int main(int argc, const char* argv[])
{
    @autoreleasepool {
        printf("====================================================================\n");
        printf(">>>      jetic 编译器「静态协议多态与可选方法」全新特性压测        <<<\n");
        printf("====================================================================\n\n");

        // ----------------------------------------------------
        // 测试点 1：协议限定指针的静态多态转换
        printf("--- 1. 验证单协议限定指针 id<DataSerializable> 的静态派发 ---\n");
        
        HeavyRobot* robot = [[HeavyRobot alloc] initWithId:101 payload:500];
        AISecurityGateway* gateway = [[AISecurityGateway alloc] initWithName:"Quantum_Gate_Alpha" rules:45];

        // 静态强转为遵守 DataSerializable 协议的抽象类型
        id<DataSerializable> serializableA = (id<DataSerializable>)robot;
        id<DataSerializable> serializableB = (id<DataSerializable>)gateway;

        printf("[协议多态断言 1] 成功调用不同底层类的协议实现：\n");
        printf("          -> 机器人序列化结果: %s\n", [serializableA serializeToJSON]);
        printf("          -> 网关序列化结果: %s\n", [serializableB serializeToJSON]);

        // ----------------------------------------------------
        // 测试点 2：多协议复合限定（Protocol Composition）
        printf("\n--- 2. 验证多协议复合指针 id<DataSerializable, CloudSyncable> 的静态检验 ---\n");
        
        // 只有同时实现这两个协议的对象才能赋值给复合指针
        id<DataSerializable, CloudSyncable> compoundTarget = (id<DataSerializable, CloudSyncable>)robot;
        
        printf("[协议多态断言 2] 复合协议方法链式静态派发：\n");
        printf("          -> 调用 Serializable: %s\n", [compoundTarget serializeToJSON]);
        [compoundTarget uploadToCloudWithEndpoint:"https://api.jeti-cloud.org/v1/sync"];

        // ----------------------------------------------------
        // 测试点 3：协议 @optional 可选方法的静态编译期安全调用
        printf("\n--- 3. 压测协议 @optional 可选方法在静态环境下的安全决议 ---\n");

        // 我们将网关强转为 CloudSyncable。由于网关并没有实现 CloudSyncable，直接强转（仅作测试）
        // 在没有 respondsToSelector 的静态 Jeti 编译器中，如何安全调用 optional 方法？
        // 编译器必须支持在生成 C 代码时，将 optional 方法映射为：
        // 检查虚表函数指针是否为空，如果非空则调用，否则安全返回默认值。
        
        id<CloudSyncable> testSyncObj = (id<CloudSyncable>)robot;
        
        // 机器人实现了 getLastSyncLatency (可选方法)
        int latency = 0;
        
        // 编译器应当能够通过某种静态逻辑（例如在底层翻译为：vtable->getLastSyncLatency ? vtable->getLastSyncLatency(testSyncObj) : 0）
        // 这里模拟这个静态判定与安全执行机制
        printf("[可选方法断言] 静态调用遵守协议对象的 @optional 方法：\n");
        
        // 我们直接在 Jeti 代码里静态调用它
        latency = [testSyncObj getLastSyncLatency];
        printf("          -> 成功获取机器人延迟: %d ms (预期: 15)\n", latency);

        // ----------------------------------------------------
        // 测试点 4：协议指针作为方法/Block 的参数进行深度传递与 ARC 介入
        printf("\n--- 4. 测试协议类型作为 Block 闭包参数跨作用域捕获与安全传递 ---\n");

        __block int auditCount = 0;
        __block int finalSecScore = 0;

        // 声明一个高阶安全审计 Block，参数被严格限定为 id<SecurityInspector>
        void (^auditRunner)(id<SecurityInspector>) = ^void(id<SecurityInspector> inspector) {
            auditCount++;
            // 在闭包内部，静态执行协议定义的方法
            finalSecScore = [inspector performSecurityAuditWithThreatLevel:80];
            printf("[安全审计闭包] 审计次数: %d | 计算出最终安全系数: %d\n", auditCount, finalSecScore);
        };

        // 执行闭包并传递网关实例（网关实现了 SecurityInspector）
        auditRunner((id<SecurityInspector>)gateway);

        // ----------------------------------------------------
        // 测试点 5：极限边界回归——将协议多态方法置于“三元+自增自减副作用”中
        // 这一步彻底将协议多态调用与你之前修好的“恶魔结合律”Bug 进行混合高压测试！
        printf("\n--- 5. 极限混淆守门员：三元表达式内包含带副作用的协议指针方法调用 ---\n");

        int isSystemSecure = 1;
        int protocolStepCounter = 4444;

        // 强迫转译器解析：三元真分支内，带括号自增副作用，而消息接收者是一个 id<DataSerializable> 协议限定指针！
        const char* finalSerializedOutput = (isSystemSecure > 0) ? 
            [((protocolStepCounter++, serializableB)) serializeToJSON] : "{}";

        printf("[终极协议边界断言] 协议类型消息传递与自增副作用完美结合！\n");
        printf("          -> 副作用自增计数器: %d (预期: 4445)\n", protocolStepCounter);
        printf("          -> 通过复合表达式链抓取的网关序列化数据: %s\n", finalSerializedOutput);

        // ----------------------------------------------------
        // 6. 内存拓扑清理
        printf("\n--- 6. 正在释放智能工厂协议多态拓扑资源... ---\n");
        [robot release];
        [gateway release];

        printf("\n====================================================================\n");
        printf(">>> 奇迹！静态协议多态 (Protocols) 及多协议复合测试全线通关！   <<<\n");
        printf("====================================================================\n");
    }
    return 0;
}