// Probe: evaluation laziness through the checked-EH hoist pass.
// The untaken branch of `?:` and the right operand of `&&`/`||` are
// conditionally evaluated; hoisting a message send out of them runs it
// unconditionally (and can dispatch a NULL vtable slot on a receiver whose
// class does not implement the selector).
// Expect (C semantics):
//   ternary_then v=7 side=0
//   ternary_else v=9 side=0
//   and_short    v=0 side=0
#import <Foundation/Foundation.hje>
#include <stdio.h>

@interface Bumper : NPObject {
@public
    int _side;
}
- (int)bump;
- (int)side;
@end

@implementation Bumper
- (int)bump { _side = _side + 1; return 42; }
- (int)side { return _side; }
@end

int main() {
    Bumper *b = [[Bumper alloc] init];

    int v1 = 1 ? 7 : [b bump];
    printf("ternary_then v=%d side=%d\n", v1, [b side]);

    int v2 = 0 ? [b bump] : 9;
    printf("ternary_else v=%d side=%d\n", v2, [b side]);

    int v3 = (0 && ([b bump] != 0));
    printf("and_short    v=%d side=%d\n", v3, [b side]);

    return 0;
}
