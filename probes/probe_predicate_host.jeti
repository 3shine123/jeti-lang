// Host-API probe for NPPredicate filtering (not scanned by test_all.py).
// Exercises the container side of doc/nppredicate_plan.md §3:
//   NPArray     filteredArrayUsingPredicate: / indexOfObjectMatchingPredicate:
//   NPMutableArray filterUsingPredicate:            (in place)
//   NPSet       filteredArrayUsingPredicate:
//   nil predicate = no filtering
// Expect:
//   arr count=2 first=alice
//   idx alice=0 zed_none=1
//   mut count=2 first=alice
//   set count=2 first=alice
//   nilpred count=3
#import <Foundation/Foundation.hje>
#include <stdio.h>

@interface Person : NPObject {
@public
    int _age;
    NPString *_name;
}
- (Person *)initWithAge:(int)age name:(const char *)name;
- (int)age;
- (NPString *)name;
@end

@implementation Person
- (Person *)initWithAge:(int)age name:(const char *)name {
    self = [super init];
    if (self) {
        _age = age;
        _name = [NPString stringWithUTF8String:name];
    }
    return self;
}
- (int)age { return _age; }
- (NPString *)name { return _name; }
@end

int main() {
    Person *alice = [[Person alloc] initWithAge:30 name:"alice"];
    Person *bob = [[Person alloc] initWithAge:15 name:"bob"];
    Person *ann = [[Person alloc] initWithAge:22 name:"ann"];

    id objs[3];
    objs[0] = alice;
    objs[1] = bob;
    objs[2] = ann;
    NPArray *all = [NPArray arrayWithObjects:objs count:3];

    NPPredicate *p = [NPPredicate predicateWithFormat:@"age > 18"];

    NPArray *filtered = [all filteredArrayUsingPredicate:p];
    Person *f0 = (Person *)[filtered firstObject];
    printf("arr count=%zu first=%s\n", [filtered count], [[f0 name] UTF8String]);

    size_t ia = [all indexOfObjectMatchingPredicate:p];
    size_t iz = [all indexOfObjectMatchingPredicate:[NPPredicate predicateWithFormat:@"name = 'zed'"]];
    printf("idx alice=%zu zed_none=%d\n", ia, iz == (size_t)-1);

    NPMutableArray *mut = [NPMutableArray arrayWithObjects:objs count:3];
    [mut filterUsingPredicate:p];
    Person *m0 = (Person *)[mut firstObject];
    printf("mut count=%zu first=%s\n", [mut count], [[m0 name] UTF8String]);

    NPSet *set = [NPSet setWithObjects:objs count:3];
    NPArray *from_set = [set filteredArrayUsingPredicate:p];
    Person *s0 = (Person *)[from_set firstObject];
    printf("set count=%zu first=%s\n", [from_set count], [[s0 name] UTF8String]);

    NPArray *none = [all filteredArrayUsingPredicate:nil];
    printf("nilpred count=%zu\n", [none count]);

    return 0;
}
