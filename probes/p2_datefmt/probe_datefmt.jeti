#import <Foundation/Foundation.hje>
#include <stdio.h>
#include <string.h>

static NPDate *mk(double s) { return [NPDate dateWithTimeIntervalSince1970:s]; }
static const char *fmt(NPDateFormatter *f, double s) {
    NPDate *d = mk(s);
    NPString *r = [f stringFromDate:d];
    return r ? [r UTF8String] : "(nil)";
}
static void rt(NPDateFormatter *f, const char *in) {
    NPString *s = [NPString stringWithUTF8String:in];
    NPDate *d = [f dateFromString:s];
    if (!d) { printf("  rt %s -> nil\n", in); return; }
    double e = [d timeIntervalSince1970];
    NPString *back = [f stringFromDate:d];
    printf("  rt %s -> %.0f -> %s\n", in, e, back ? [back UTF8String] : "(nil)");
}

int main(void) {
    NPDateFormatter *iso = [NPDateFormatter iso8601Formatter];
    NPDateFormatter *day = [NPDateFormatter dateOnlyFormatter];
    NPDateFormatter *tim = [NPDateFormatter timeOnlyFormatter];

    printf("iso(0)      = %s\n", fmt(iso, 0));
    printf("iso(1761395696) = %s\n", fmt(iso, 1761395696));
    printf("iso(-1)     = %s\n", fmt(iso, -1));
    printf("day(0)      = %s\n", fmt(day, 0));
    printf("tim(0)      = %s\n", fmt(tim, 0));
    printf("tim(3661)   = %s\n", fmt(tim, 3661));

    NPDateFormatter *off = [NPDateFormatter iso8601Formatter];
    [off setUTCOffsetMinutes:480];
    printf("iso+08(0)   = %s\n", fmt(off, 0));

    printf("--- 解析往返 ---\n");
    rt(iso, "2026-10-25T12:34:56Z");
    rt(iso, "1970-01-01T00:00:00Z");
    rt(iso, "2026-10-25T12:34:56.789Z");
    rt(off, "1970-01-01T08:00:00+08:00");
    rt(day, "2026-10-25");
    rt(tim, "12:34:56");
    printf("--- 非法输入 ---\n");
    rt(iso, "2026-13-01T00:00:00Z");
    rt(iso, "not a date");
    rt(day, "2026-10-25x");

    NPDateFormatter *pat = [NPDateFormatter formatterWithPattern:[NPString stringWithUTF8String:"yyyy/MM/dd HH:mm"]];
    printf("pat(1761395696) = %s\n", fmt(pat, 1761395696));
    rt(pat, "2026/10/25 12:34");
    return 0;
}
