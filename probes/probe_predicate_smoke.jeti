// Smoke probe for NPPredicate (not scanned by test_all.py).
// Exercises the DSL: cmp ops, [c] modifier, NOT/parens, BETWEEN, LIKE.
// Expect:
//   p1 a=1 b=0   (age > 18)
//   p2 a=0 b=1   (name BEGINSWITH[c] 'BO')
//   p3 a=0 b=1   (NOT (age = 30))
//   p4 a=0 b=1   (age BETWEEN {10, 20})
//   p5 a=1 b=0   (name LIKE 'a*i*e')
#import <Foundation/Foundation.hje>
#include <stdio.h>

@interface Person : NPObject {
@public
    int _age;
    NPString *_name;
}
- (Person *)initWithAge:(int)age name:(const char *)name;
- (int)age;
- (NPString *)name;
@end

@implementation Person
- (Person *)initWithAge:(int)age name:(const char *)name {
    self = [super init];
    if (self) {
        _age = age;
        _name = [NPString stringWithUTF8String:name];
    }
    return self;
}
- (int)age { return _age; }
- (NPString *)name { return _name; }
@end

int main() {
    Person *a = [[Person alloc] initWithAge:30 name:"alice"];
    Person *b = [[Person alloc] initWithAge:15 name:"bob"];

    NPPredicate *p1 = [NPPredicate predicateWithFormat:@"age > 18"];
    printf("p1 a=%d b=%d\n", [p1 evaluateWithObject:a], [p1 evaluateWithObject:b]);

    NPPredicate *p2 = [NPPredicate predicateWithFormat:@"name BEGINSWITH[c] 'BO'"];
    printf("p2 a=%d b=%d\n", [p2 evaluateWithObject:a], [p2 evaluateWithObject:b]);

    NPPredicate *p3 = [NPPredicate predicateWithFormat:@"NOT (age = 30)"];
    printf("p3 a=%d b=%d\n", [p3 evaluateWithObject:a], [p3 evaluateWithObject:b]);

    NPPredicate *p4 = [NPPredicate predicateWithFormat:@"age BETWEEN {10, 20}"];
    printf("p4 a=%d b=%d\n", [p4 evaluateWithObject:a], [p4 evaluateWithObject:b]);

    NPPredicate *p5 = [NPPredicate predicateWithFormat:@"name LIKE 'a*i*e'"];
    printf("p5 a=%d b=%d\n", [p5 evaluateWithObject:a], [p5 evaluateWithObject:b]);

    return 0;
}
