// Probe: generic class-method return instantiation (ROADMAP gap).
// `+ (T)defaultValue` on Box<T> — when called as
// `[Box<NPString *> defaultValue]`, the result type must substitute to
// NPString *. Checker-side: `NPString *s = ...` must not error; codegen-side:
// the vtable cast must carry the specialized return type.

#import <Foundation/Foundation.hje>

@interface Box<T> : NPObject
+ (T)defaultValue;
- (T)value;
@end

@implementation Box
+ (T)defaultValue { return nil; }
- (T)value { return nil; }
@end

int main() {
    // Instance side (should already work — "instance-side signatures covered"):
    Box<NPString *> *b = nil;
    NPString *a = [b value];

    // Class side (the gap): result must be NPString *, not erased id.
    NPString *s = [Box<NPString *> defaultValue];

    // Scalar element check: assigning the class-method result to an int
    // must error once the return type is known.
    int bad = [Box<NPNumber *> defaultValue];
    return 0;
}
