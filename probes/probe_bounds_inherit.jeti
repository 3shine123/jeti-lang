// Probe: generic protocol bounds — INHERITANCE rules (§5.1/§5.2).
// Expected: exactly two errors —
//   1) 'MissingBox' must re-declare the bound on type parameter 'T'
//      (inherited bound 'Greetable' from 'Box')
//   2) bound 'Loud' on 'T' weakens the inherited bound 'Greetable' from 'Box'

#import <Foundation/Foundation.hje>

@protocol Greetable
- (NPString *)greeting;
@end

@protocol Loud
- (NPString *)shout;
@end

@interface Box<T : Greetable> : NPObject {
    T _value;
}
@end

@implementation Box
@end

// Violation 1: parent has a bound, subclass does not re-declare it.
@interface MissingBox<T> : Box<T>
@end

@implementation MissingBox
@end

// Violation 2: re-declared bound is unrelated — weaker than the inherited one.
@interface LoudBox<T : Loud> : Box<T>
@end

@implementation LoudBox
@end

int main() {
    return 0;
}
