/* NPSortDescriptor 探针（.hje 多 TU 正规流程：声明伞头 + 预编译库）。
 *
 * A1 单键升序：sortedArrayUsingDescriptors: 按比较块升序
 * A2 单键降序：ascending=0；reversedSortDescriptor 与之等价
 * A3 稳定性：首键平局的元素保持原相对顺序
 * A4 多键决胜：主键平局落到次键；次键也平局保持原序
 * A5 原地 sortUsingDescriptors:；nil/空描述符数组 no-op
 * A6 无比较块的描述符：身份退化（同对象 0）+ key/ascending 访问器
 * 期望输出：A1..A6 各一行 ok。
 */

#import <Foundation/Foundation.hje>
#include <stdio.h>
#include <string.h>

/* 双字段测试对象：primary/secondary 两个 int 键 + tag（稳定性验证） */
@interface Rec : NPObject {
@public
    int primary;
    int secondary;
    int tag;
}
+ (Rec *)rec:(int)p sec:(int)s tag:(int)t;
- (NPString *)desc;
@end

@implementation Rec
+ (Rec *)rec:(int)p sec:(int)s tag:(int)t {
    Rec *r = [[Rec alloc] init];
    r->primary = p;
    r->secondary = s;
    r->tag = t;
    return r;
}
- (NPString *)desc {
    char buf[32];
    sprintf(buf, "%d.%d.%d", primary, secondary, tag);
    return [NPString stringWithUTF8String:buf];
}
@end

int main(void) {
    /* A1 单键升序 */
    NPMutableArray *arr = [NPMutableArray array];
    [arr addObject:[Rec rec:3 sec:1 tag:0]];
    [arr addObject:[Rec rec:1 sec:9 tag:1]];
    [arr addObject:[Rec rec:2 sec:5 tag:2]];
    NPSortDescriptor *byPrimary = [NPSortDescriptor
        sortDescriptorWithKey:[NPString stringWithUTF8String:"primary"]
        ascending:1
        comparator:^int(id a, id b) {
            return ((Rec *)a)->primary - ((Rec *)b)->primary;
        }];
    NPMutableArray *descs = [NPMutableArray array];
    [descs addObject:byPrimary];
    NPArray *sorted = [arr sortedArrayUsingDescriptors:descs];
    NPString *d0 = [[sorted objectAtIndex:0] desc];
    NPString *d1 = [[sorted objectAtIndex:1] desc];
    NPString *d2 = [[sorted objectAtIndex:2] desc];
    int a1 = strcmp([d0 UTF8String], "1.9.1") == 0
        && strcmp([d1 UTF8String], "2.5.2") == 0
        && strcmp([d2 UTF8String], "3.1.0") == 0;
    printf("A1 %s\n", a1 ? "ok" : "FAIL");

    /* A2 降序 + reversed */
    NPMutableArray *descOnly = [NPMutableArray array];
    [descOnly addObject:[NPSortDescriptor
        sortDescriptorWithKey:[NPString stringWithUTF8String:"primary"]
        ascending:0
        comparator:^int(id a, id b) {
            return ((Rec *)a)->primary - ((Rec *)b)->primary;
        }]];
    NPArray *sortedDesc = [arr sortedArrayUsingDescriptors:descOnly];
    NPSortDescriptor *reversed = [byPrimary reversedSortDescriptor];
    NPMutableArray *revOnly = [NPMutableArray array];
    [revOnly addObject:reversed];
    NPArray *sortedRev = [arr sortedArrayUsingDescriptors:revOnly];
    int a2 = strcmp([[[sortedDesc objectAtIndex:0] desc] UTF8String], "3.1.0") == 0
        && strcmp([[[sortedDesc objectAtIndex:2] desc] UTF8String], "1.9.1") == 0
        && strcmp([[[sortedRev objectAtIndex:0] desc] UTF8String], "3.1.0") == 0
        && [reversed ascending] == 0 && [[byPrimary key] isKindOfClass:[NPString class]];
    printf("A2 %s\n", a2 ? "ok" : "FAIL");

    /* A3 稳定性：主键全平，tag 保原序 */
    NPMutableArray *ties = [NPMutableArray array];
    [ties addObject:[Rec rec:5 sec:0 tag:10]];
    [ties addObject:[Rec rec:5 sec:0 tag:11]];
    [ties addObject:[Rec rec:5 sec:0 tag:12]];
    NPMutableArray *tieDescs = [NPMutableArray array];
    [tieDescs addObject:[NPSortDescriptor
        sortDescriptorWithKey:[NPString stringWithUTF8String:"primary"]
        ascending:1
        comparator:^int(id a, id b) {
            return ((Rec *)a)->primary - ((Rec *)b)->primary;
        }]];
    NPArray *sortedTies = [ties sortedArrayUsingDescriptors:tieDescs];
    int a3 = ((Rec *)[sortedTies objectAtIndex:0])->tag == 10
        && ((Rec *)[sortedTies objectAtIndex:1])->tag == 11
        && ((Rec *)[sortedTies objectAtIndex:2])->tag == 12;
    printf("A3 %s\n", a3 ? "ok" : "FAIL");

    /* A4 多键决胜：primary 平局落 secondary；全平保序 */
    NPMutableArray *multi = [NPMutableArray array];
    [multi addObject:[Rec rec:2 sec:7 tag:20]];
    [multi addObject:[Rec rec:1 sec:9 tag:21]];
    [multi addObject:[Rec rec:2 sec:3 tag:22]];
    [multi addObject:[Rec rec:1 sec:9 tag:23]];
    NPMutableArray *md = [NPMutableArray array];
    [md addObject:[NPSortDescriptor
        sortDescriptorWithKey:[NPString stringWithUTF8String:"primary"]
        ascending:1
        comparator:^int(id a, id b) {
            return ((Rec *)a)->primary - ((Rec *)b)->primary;
        }]];
    [md addObject:[NPSortDescriptor
        sortDescriptorWithKey:[NPString stringWithUTF8String:"secondary"]
        ascending:1
        comparator:^int(id a, id b) {
            return ((Rec *)a)->secondary - ((Rec *)b)->secondary;
        }]];
    NPArray *sortedMulti = [multi sortedArrayUsingDescriptors:md];
    /* 期望：1.9.21, 1.9.23（次键平局保原序）, 2.3.22, 2.7.20 */
    int a4 = ((Rec *)[sortedMulti objectAtIndex:0])->tag == 21
        && ((Rec *)[sortedMulti objectAtIndex:1])->tag == 23
        && ((Rec *)[sortedMulti objectAtIndex:2])->tag == 22
        && ((Rec *)[sortedMulti objectAtIndex:3])->tag == 20;
    printf("A4 %s\n", a4 ? "ok" : "FAIL");

    /* A5 原地排序 + nil/空 no-op */
    NPMutableArray *inplace = [NPMutableArray array];
    [inplace addObject:[Rec rec:3 sec:0 tag:30]];
    [inplace addObject:[Rec rec:1 sec:0 tag:31]];
    NPMutableArray *one = [NPMutableArray array];
    [one addObject:byPrimary];
    [inplace sortUsingDescriptors:one];
    int a5 = ((Rec *)[inplace objectAtIndex:0])->tag == 31
        && ((Rec *)[inplace objectAtIndex:1])->tag == 30;
    [inplace sortUsingDescriptors:nil];
    NPMutableArray *emptyD = [NPMutableArray array];
    [inplace sortUsingDescriptors:emptyD];
    a5 = a5 && ((Rec *)[inplace objectAtIndex:0])->tag == 31;   /* 未动 */
    printf("A5 %s\n", a5 ? "ok" : "FAIL");

    /* A6 无比较块的身份退化 + 访问器 */
    NPSortDescriptor *bare = [NPSortDescriptor
        sortDescriptorWithKey:[NPString stringWithUTF8String:"k"]
        ascending:1];
    Rec *same = [Rec rec:1 sec:1 tag:40];
    int a6 = [bare compareObject:same toObject:same] == 0
        && [bare compareObject:same toObject:[Rec rec:1 sec:1 tag:41]] != 0
        && [[bare key] isKindOfClass:[NPString class]] && [bare ascending] == 1;
    printf("A6 %s\n", a6 ? "ok" : "FAIL");
    return 0;
}
