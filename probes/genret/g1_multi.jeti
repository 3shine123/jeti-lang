// g1 — 多实例化同 TU：两个特化的类方法返回类型互不串扰。
// 检查点（生成 C）：Box_NPString_ptr 与 Box_NPNumber_ptr 两套 vtable 的
// defaultValue cast 分别是 NPString * / NPNumber *，不是 erased id。
#import <Foundation/Foundation.hje>

@interface Box<T> : NPObject
+ (T)defaultValue;
- (T)value;
@end

@implementation Box
+ (T)defaultValue { return nil; }
- (T)value { return nil; }
@end

int main() {
    NPString *s = [Box<NPString *> defaultValue];
    NPNumber *n = [Box<NPNumber *> defaultValue];
    Box<NPString *> *bs = [[Box<NPString *> alloc] init];
    Box<NPNumber *> *bn = [[Box<NPNumber *> alloc] init];
    NPString *v1 = [bs value];
    NPNumber *v2 = [bn value];
    return (s == 0) && (n == 0) && (v1 == 0) && (v2 == 0) ? 0 : 1;
}
