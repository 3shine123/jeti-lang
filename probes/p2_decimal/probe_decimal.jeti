#import <Foundation/Foundation.jeti>
#import <Foundation/NPString.hje>
#include <stdio.h>

static void show(const char *tag, NPDecimalNumber *n) {
    printf("%s = %s\n", tag, [[n stringValue] UTF8String]);
}

int main(void) {
    // 本类存在的意义：0.1 + 0.2 精确等于 0.3
    NPDecimalNumber *a = [NPDecimalNumber decimalNumberWithString:[NPString stringWithUTF8String:"0.1"]];
    NPDecimalNumber *b = [NPDecimalNumber decimalNumberWithString:[NPString stringWithUTF8String:"0.2"]];
    show("0.1+0.2", [a decimalNumberByAdding:b]);

    // double 入口走十进制最短拼写
    show("dbl(0.1)", [NPDecimalNumber decimalNumberWithDouble:0.1]);

    // 乘法与除法
    NPDecimalNumber *c = [NPDecimalNumber decimalNumberWithString:[NPString stringWithUTF8String:"1.1"]];
    show("1.1*3", [c decimalNumberByMultiplyingBy:[NPDecimalNumber decimalNumberWithInt:3]]);
    show("10/4", [[NPDecimalNumber decimalNumberWithInt:10] decimalNumberByDividingBy:[NPDecimalNumber decimalNumberWithInt:4]]);
    show("1/3", [[NPDecimalNumber decimalNumberWithInt:1] decimalNumberByDividingBy:[NPDecimalNumber decimalNumberWithInt:3]]);

    // 大数与精度上限
    show("big+1", [[NPDecimalNumber decimalNumberWithString:[NPString stringWithUTF8String:"12345678901234567890123456789012345678"]]
                    decimalNumberByAdding:[NPDecimalNumber one]]);

    // 比较与负号
    printf("cmp(0.3,0.1+0.2) = %d\n", [[NPDecimalNumber decimalNumberWithString:[NPString stringWithUTF8String:"0.3"]]
                                         compare:[a decimalNumberByAdding:b]]);
    show("-5", [[NPDecimalNumber decimalNumberWithInt:5] decimalNumberByNegating]);

    // 非法输入与除零
    printf("bad isNaN = %d\n", [NPDecimalNumber decimalNumberWithString:[NPString stringWithUTF8String:"12x"]] != NULL
                                ? [[NPDecimalNumber decimalNumberWithString:[NPString stringWithUTF8String:"12x"]] isNotANumber] : -1);
    printf("1/0 isNaN = %d\n", [[[NPDecimalNumber one] decimalNumberByDividingBy:[NPDecimalNumber zero]] isNotANumber]);

    // 转换
    printf("doubleValue(0.1) = %.17g\n", [a doubleValue]);
    printf("longLongValue(3.9) = %lld\n", [[NPDecimalNumber decimalNumberWithString:[NPString stringWithUTF8String:"3.9"]] longLongValue]);
    return 0;
}
