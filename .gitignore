# Build outputs
*.o
*.obj
*.a
*.so
*.dylib
*.exe
*.out
*.tmp

# Per-suite binaries. Only the executables are outputs: the generated `.c`/`.h`
# next to them stay TRACKED on purpose — they are readable emitter output that
# anyone can browse without building anything. Never ignore `tests/**/*.c`,
# `examples/**` or `include/jeti/runtime*` here.
tests/stress/baremetal/build/baremetal_test
tests/stress/baremetal/build/freestanding_features
tests/golden/25_freestanding/build/freestanding
tests/golden/26_baremetal_stress/build/stress
tests/stress/interop/build/interop_test

# Generated by jetic — the root-level binary only.
# (Must be anchored: a bare `jetic` would also match and ignore the
#  `crates/jetic/` compiler crate source tree.)
/jetic

# Editor / IDE
.DS_Store
.idea/
.reasonix/
.mimocode/
.opencode/
.freebuff
.atomcode
.cache/
__pycache__/
*.swp
*.swo
*~

# VS Code extension packaging (`vsce package` writes the VSIX next to it; the
# extension itself has no npm dependencies, so node_modules should stay empty).
*.vsix
node_modules/

# Other
todo.md
mimo.sh

# Python env for test_all.py (`rich`) — test_all.sh bootstraps it on first use.
.venv/

# Rust build — cargo output directories, including the Zed editor extension's
# (a `git add -A` once swept ~2100 rlibs / 218 MB of it into history).
/target/
editors/zed/target/
target/probes/p2_threads/*.c
# Probe executables: the probe SOURCES stay tracked, their built binaries do not.
probes/layout_mismatch/probe
editors/zed/grammar/
editors/zed/grammars/jeti/
